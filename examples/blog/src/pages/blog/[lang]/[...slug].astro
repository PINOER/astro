---
// src/pages/blog/[lang]/[...slug].astro
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

// 获取所有文章并生成静态路由
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	
	return posts.map((post) => {
		// 剥离后缀得到纯 path (例如 "en/first-post.md" -> lang: "en", slug: "first-post")
		const parts = post.id.replace(/\.(md|mdx)$/, '').split('/');
		const lang = parts.length > 1 ? parts[0] : (post.data.lang || 'en');
		const slug = parts.length > 1 ? parts.slice(1).join('/') : parts[0];

		return {
			params: { lang, slug },
			props: post,
		};
	});
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data}>
	<Content />
</BlogPost>
