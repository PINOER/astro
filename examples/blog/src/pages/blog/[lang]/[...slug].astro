---
// src/pages/blog/[lang]/[...slug].astro
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

// ⚡ 1. 开启 SSR 动态渲染
export const prerender = false;

type Props = CollectionEntry<'blog'>;

// 提取 URL 参数：/blog/en/image-base64-converter-guide/ -> lang="en", slug="image-base64-converter-guide"
const { lang, slug = '' } = Astro.params;
const currentLang = lang || 'en';

// 彻底剥离 slug 中可能混入的多余语言前缀与后缀
const cleanSlug = slug
	.replace(/^(en|zh|es|de|ja|ko)\//, '')
	.replace(/\.(md|mdx)$/, '')
	.replace(/\/index$/, '');

// SSR 安全图片路径提取工具函数
function resolveImageUrl(imgSrc: any): string {
	if (!imgSrc) return '';
	if (typeof imgSrc === 'string') return imgSrc;
	if (typeof imgSrc === 'object') {
		if (imgSrc.src) return imgSrc.src;
		if (imgSrc.default) return typeof imgSrc.default === 'string' ? imgSrc.default : imgSrc.default.src || '';
	}
	return String(imgSrc);
}

// Markdown 转 HTML 辅助函数
function renderMarkdownToHtml(md: string): string {
	if (!md) return '';
	try {
		return md
			.replace(/!\[(.*?)\]\((.*?)\)/g, '<img src="$2" alt="$1" style="max-width:100%; height:auto; border-radius:8px; display:block; margin:1.2rem 0;" />')
			.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank" rel="noopener" style="color:#60a5fa; text-decoration:underline;">$1</a>')
			.replace(/^### (.*$)/gim, '<h3 style="margin-top:1.5em; font-size:1.25rem;">$1</h3>')
			.replace(/^## (.*$)/gim, '<h2 style="margin-top:1.8em; font-size:1.5rem;">$1</h2>')
			.replace(/^# (.*$)/gim, '<h1 style="margin-top:2em; font-size:1.75rem;">$1</h1>')
			.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
			.replace(/`(.*?)`/g, '<code style="background:rgba(255,255,255,0.1); padding:0.2em 0.4em; border-radius:4px;">$1</code>')
			.split('\n\n')
			.map((p) => {
				const trimmed = p.trim();
				if (!trimmed) return '';
				if (trimmed.startsWith('<h') || trimmed.startsWith('<img')) return trimmed;
				return `<p style="line-height:1.75; margin-bottom:1.2em;">${trimmed.replace(/\n/g, '<br/>')}</p>`;
			})
			.join('');
	} catch (e) {
		return md;
	}
}

// -------------------------------------------------------------
// 🔍 第一步：首先判断并尝试读取 Cloudflare KV 数据（KV 优先）
// -------------------------------------------------------------
let kvArticle: any = null;

try {
	const locals = Astro.locals as any;
	const kv = locals?.runtime?.env?.ADMIN_KV || (globalThis as any)?.ADMIN_KV;

	if (kv) {
		const rawList = await kv.get(`articles_v1_${currentLang}`);
		if (rawList) {
			const articlesList = JSON.parse(rawList);
			// 全维度精准匹配 KV 数据
			kvArticle = articlesList.find((item: any) => {
				if (!item) return false;
				const itemPureId = item.id ? item.id.replace(/^(en|zh|es|de|ja|ko)\//, '').replace(/\.(md|mdx)$/, '') : '';
				return (
					item.slug === cleanSlug ||
					itemPureId === cleanSlug ||
					item.id === `${currentLang}/${cleanSlug}.md` ||
					item.id === `${currentLang}/${cleanSlug}`
				);
			});
		}
	}
} catch (e) {
	console.warn('读取 Cloudflare KV 异常，准备降级回退到本地 Markdown:', e);
}

// -------------------------------------------------------------
// 🔍 第二步：如果 KV 没有数据/读取失败，再读取本地 Markdown（本地兜底）
// -------------------------------------------------------------
let localPost: any = null;
let LocalContentComponent: any = null;

// 只有在 KV 缺乏有效 content 正文时，才需要去渲染本地 Markdown
if (!kvArticle || !kvArticle.content || kvArticle.content.trim() === '') {
	const posts = await getCollection('blog');
	localPost = posts.find((p) => {
		const pPureId = p.id.replace(/^(en|zh|es|de|ja|ko)\//, '').replace(/\.(md|mdx)$/, '');
		const pSlug = p.slug ? p.slug.replace(/^(en|zh|es|de|ja|ko)\//, '') : '';
		const isLangMatch = p.id.startsWith(`${currentLang}/`) || (p.data as any)?.lang === currentLang;

		return isLangMatch && (pPureId === cleanSlug || pSlug === cleanSlug || p.id.includes(cleanSlug));
	});

	if (localPost) {
		const rendered = await render(localPost);
		LocalContentComponent = rendered.Content;
	}
}

// -------------------------------------------------------------
// 🎯 第三步：合并数据（KV 字段优先覆盖本地字段）
// -------------------------------------------------------------

// 1. 标题：KV > 本地 MD > cleanSlug 兜底
const finalTitle = kvArticle?.title || localPost?.data?.title || cleanSlug;

// 2. 封面图：KV > 本地 MD > 空字符串
const rawHeroImage = (kvArticle?.heroImage !== undefined && kvArticle?.heroImage !== '')
	? kvArticle.heroImage
	: localPost?.data?.heroImage;
const finalHeroImage = resolveImageUrl(rawHeroImage);

// 3. 正文 HTML：KV 渲染 HTML > 本地 MD
const kvHtmlContent = kvArticle?.content ? renderMarkdownToHtml(kvArticle.content) : null;

// 组装传给 <BlogPost> Layout 的最终属性
const finalPostData = {
	...(localPost ? localPost.data : {}),
	title: finalTitle,
	heroImage: finalHeroImage,
	pubDate: localPost?.data?.pubDate || new Date()
};
---

<BlogPost {...finalPostData}>
	{
		// 优先判断展示 KV 里的正文 HTML
		kvHtmlContent ? (
			<div class="markdown-body" set:html={kvHtmlContent} />
		) : LocalContentComponent ? (
			/* KV 没正文时，展示本地 Markdown 编译出的组件 */
			<LocalContentComponent />
		) : (
			/* KV 和本地都找不到该文章时的友好提示 */
			<div style="padding: 4rem 1rem; text-align: center; color: #94a3b8;">
				<h2>⚠️ 文章未找到 / 暂无内容</h2>
				<p>无法在后台 KV 数据库或本地 <code>src/content/blog/{currentLang}/</code> 路径下找到此文章。</p>
				<p>请求语言: <code>{currentLang}</code> | 文章 Slug: <code>{cleanSlug}</code></p>
				<a href="/blog/" style="color: #60a5fa; text-decoration: underline;">返回博客列表</a>
			</div>
		)
	}
</BlogPost>
