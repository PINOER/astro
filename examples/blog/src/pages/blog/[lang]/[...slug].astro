---
// src/pages/blog/[lang]/[...slug].astro
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

// ⚡ 核心：开启 SSR 动态渲染
export const prerender = false;

type Props = CollectionEntry<'blog'>;

// 从 URL 参数提取：/blog/en/image-base64-converter-guide/ -> lang="en", slug="image-base64-converter-guide"
const { lang, slug = '' } = Astro.params;
const currentLang = lang || 'en';

// ⚡ 1. 彻底剥离 slug 中可能混入的一切语言前缀和文件后缀
const cleanSlug = slug
	.replace(/^(en|zh|es|de|ja|ko)\//, '')
	.replace(/\.(md|mdx)$/, '')
	.replace(/\/index$/, '');

// 2. 获取本地 Content Collections
const posts = await getCollection('blog');

// ⚡ 3. 强效多模式精准查找本地文章
let post = posts.find((p) => {
	// 剥离 p.id 里的语言前缀和后缀，拿到最纯粹的文件名
	const pPureId = p.id.replace(/^(en|zh|es|de|ja|ko)\//, '').replace(/\.(md|mdx)$/, '');
	const pSlug = p.slug ? p.slug.replace(/^(en|zh|es|de|ja|ko)\//, '') : '';

	// 判断语言是否匹配
	const isLangMatch = p.id.startsWith(`${currentLang}/`) || (p.data as any)?.lang === currentLang;

	return isLangMatch && (pPureId === cleanSlug || pSlug === cleanSlug || p.id.includes(cleanSlug));
});

// SSR 安全图片路径提取函数
function resolveImageUrl(imgSrc: any): string {
	if (!imgSrc) return '';
	if (typeof imgSrc === 'string') return imgSrc;
	if (typeof imgSrc === 'object') {
		if (imgSrc.src) return imgSrc.src;
		if (imgSrc.default) return typeof imgSrc.default === 'string' ? imgSrc.default : imgSrc.default.src || '';
	}
	return String(imgSrc);
}

// 4. 从 Cloudflare KV 读取最新保存的数据
let updatedContent: string | null = null;
let updatedTitle = post ? post.data.title : '';
let rawHeroImage: any = post ? post.data.heroImage : '';

try {
	const locals = Astro.locals as any;
	const kv = locals?.runtime?.env?.ADMIN_KV || (globalThis as any)?.ADMIN_KV;

	if (kv) {
		const rawList = await kv.get(`articles_v1_${currentLang}`);
		if (rawList) {
			const articlesList = JSON.parse(rawList);
			
			// 全维度击中 KV 记录
			const kvArticle = articlesList.find((item: any) => {
				if (!item) return false;
				const itemPureId = item.id ? item.id.replace(/^(en|zh|es|de|ja|ko)\//, '').replace(/\.(md|mdx)$/, '') : '';
				return (
					item.slug === cleanSlug ||
					itemPureId === cleanSlug ||
					(post && item.id === post.id) ||
					item.id === `${currentLang}/${cleanSlug}.md`
				);
			});

			if (kvArticle) {
				if (kvArticle.title) updatedTitle = kvArticle.title;
				if (kvArticle.heroImage !== undefined && kvArticle.heroImage !== '') {
					rawHeroImage = kvArticle.heroImage;
				}
				if (kvArticle.content && kvArticle.content.trim() !== '') {
					updatedContent = kvArticle.content;
				}
			}
		}
	}
} catch (e) {
	console.warn('SSR 读取 KV 失败:', e);
}

const finalHeroImage = resolveImageUrl(rawHeroImage);

// 5. Markdown 渲染为 HTML
function renderMarkdownToHtml(md: string): string {
	if (!md) return '';
	try {
		return md
			.replace(/!\[(.*?)\]\((.*?)\)/g, '<img src="$2" alt="$1" style="max-width:100%; height:auto; border-radius:8px; display:block; margin:1.2rem 0;" />')
			.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank" rel="noopener" style="color:#60a5fa; text-decoration:underline;">$1</a>')
			.replace(/^### (.*$)/gim, '<h3 style="margin-top:1.5em; font-size:1.25rem;">$1</h3>')
			.replace(/^## (.*$)/gim, '<h2 style="margin-top:1.8em; font-size:1.5rem;">$1</h2>')
			.replace(/^# (.*$)/gim, '<h1 style="margin-top:2em; font-size:1.75rem;">$1</h1>')
			.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
			.replace(/`(.*?)`/g, '<code style="background:rgba(255,255,255,0.1); padding:0.2em 0.4em; border-radius:4px;">$1</code>')
			.split('\n\n')
			.map((p) => {
				const trimmed = p.trim();
				if (!trimmed) return '';
				if (trimmed.startsWith('<h') || trimmed.startsWith('<img')) return trimmed;
				return `<p style="line-height:1.75; margin-bottom:1.2em;">${trimmed.replace(/\n/g, '<br/>')}</p>`;
			})
			.join('');
	} catch (e) {
		return md;
	}
}

// 渲染本地 MD 的 Content 组件
let ContentComponent: any = null;
if (post) {
	const rendered = await render(post);
	ContentComponent = rendered.Content;
}

const renderedKvHtml = updatedContent ? renderMarkdownToHtml(updatedContent) : null;

const finalPostData = {
	...(post ? post.data : {}),
	title: updatedTitle || post?.data?.title || cleanSlug,
	heroImage: finalHeroImage
};
---

<BlogPost {...finalPostData}>
	{
		renderedKvHtml ? (
			<div class="markdown-body" set:html={renderedKvHtml} />
		) : ContentComponent ? (
			<ContentComponent />
		) : (
			<div style="padding: 3rem 0; text-align: center; color: #94a3b8;">
				<h3>⚠️ 暂无文章正文内容</h3>
				<p>无法在本地 Markdown 或 Cloudflare KV 中检索到此文章的正文。</p>
			</div>
		)
	}
</BlogPost>
