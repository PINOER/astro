---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// ⚡ 1. 强制关闭预渲染，开启动态 SSR 模式，每次访问实时拉取 KV 数据
export const prerender = false;

// ⚡ 2. 动态获取当前 URL 参数里的语言（如访问 /blog/zh 时取 zh，无参默认 zh）
const { lang } = Astro.params;
const currentLang = lang || 'zh';

// ⚡ 3. 获取 blog 集合下的所有文章并进行语言筛选
const allPosts = await getCollection('blog');
const filteredPosts = allPosts
	.filter((post) => {
		const isLangMatch = (post.data as any)?.lang === currentLang;
		const isPathMatch = post.id.startsWith(`${currentLang}/`);
		return isLangMatch || isPathMatch;
	})
	.sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

// ⚡ 4. 从 Cloudflare KV 中动态读取后台保存的最新 heroImage 与标题等配置
let kvMap = new Map<string, any>();
try {
	const locals = Astro.locals as any;
	const kv = locals?.runtime?.env?.ADMIN_KV || (globalThis as any)?.ADMIN_KV;

	if (kv) {
		const raw = await kv.get(`articles_v1_${currentLang}`);
		if (raw) {
			const list = JSON.parse(raw);
			list.forEach((item: any) => {
				if (item.id) kvMap.set(item.id, item);
				if (item.slug) kvMap.set(item.slug, item);
			});
		}
	}
} catch (e) {
	console.warn('列表页 SSR 读取 KV 失败，回退使用本地 MD:', e);
}

// ⚡ 5. 组装最终展示的数据列表（优先使用 KV 中的 heroImage 和 title）
const posts = filteredPosts.map((post) => {
	const cleanSlug = post.id
		.replace(new RegExp(`^${currentLang}/`), '')
		.replace(/\.(md|mdx)$/, '')
		.replace(/\/index$/, '');

	const kvData = kvMap.get(post.id) || kvMap.get(cleanSlug) || {};

	// 获取最终封面图：优先取 KV 保存的，退而求其次取本地 MD 中的 heroImage
	let finalHeroImage = kvData.heroImage !== undefined && kvData.heroImage !== '' 
		? kvData.heroImage 
		: post.data.heroImage;

	// 处理本地静态图片导入对象转为字符串 src 路径
	if (finalHeroImage && typeof finalHeroImage === 'object' && finalHeroImage.src) {
		finalHeroImage = finalHeroImage.src;
	}

	return {
		id: post.id,
		slug: cleanSlug,
		title: kvData.title || post.data.title || cleanSlug,
		heroImage: finalHeroImage,
		pubDate: post.data.pubDate,
		url: `/blog/${currentLang}/${cleanSlug}/`
	};
});
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
				width: 100%;
				height: 240px;
				object-fit: cover;
			}
			ul li:first-child img {
				height: 380px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
				ul li img,
				ul li:first-child img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={post.url}>
									{/* ⚡ 使用原生态 <img> 标签兼容网络 URL 与 Base64 图片 */}
									{post.heroImage && (
										<img src={post.heroImage} alt={post.title} loading="lazy" />
									)}
									<h4 class="title">{post.title}</h4>
									<p class="date">
										{post.pubDate && <FormattedDate date={post.pubDate} />}
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
