---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// ⚡ 1. 强制开启动态 SSR 模式，实时查询 Cloudflare KV
export const prerender = false;

// ⚡ 2. 动态读取当前语言环境 (默认英文 'en')
const { lang } = Astro.params;
const currentLang = lang || 'en';

// ⚡ 3. 抓取文章并按语言精准筛选
const allPosts = await getCollection('blog');
const filteredPosts = allPosts
	.filter((post) => {
		const isLangMatch = (post.data as any)?.lang === currentLang;
		const isPathMatch = post.id.startsWith(`${currentLang}/`);
		return isLangMatch || isPathMatch;
	})
	.sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

// ⚡ 4. 建立万能 Key 匹配 Map（全面兼容带有/不带有语言前缀、.md后缀的各种 KV 保存格式）
let kvMap = new Map<string, any>();
try {
	const locals = Astro.locals as any;
	const kv = locals?.runtime?.env?.ADMIN_KV || (globalThis as any)?.ADMIN_KV;

	if (kv) {
		const raw = await kv.get(`articles_v1_${currentLang}`);
		if (raw) {
			const list = JSON.parse(raw);
			list.forEach((item: any) => {
				if (item.id) {
					kvMap.set(item.id, item); // 规则 1: 存原始全名 (如 zh/fire.md 或 en/fire.md)
					const pureName = item.id.replace(/^(en|zh|es|de|ja|ko)\//, '').replace(/\.(md|mdx)$/, '');
					kvMap.set(pureName, item); // 规则 2: 存纯名称 (如 fire)
				}
				if (item.slug) {
					kvMap.set(item.slug, item); // 规则 3: 存 slug 字段
				}
			});
		}
	}
} catch (e) {
	console.warn('列表页 SSR 读取 Cloudflare KV 失败，降级回退本地 MD:', e);
}

// ⚡ 5. 组合展示数据，修正图片解析与标准 URL 生成
const posts = filteredPosts.map((post) => {
	// 提取纯粹的文章 slug，剥离路径中的语言前缀和文件后缀
	const cleanSlug = post.id
		.replace(/^(en|zh|es|de|ja|ko)\//, '')
		.replace(/\.(md|mdx)$/, '')
		.replace(/\/index$/, '');

	// 万能匹配：多维度尝试获取 KV 覆盖数据
	const kvData = kvMap.get(post.id) || 
	               kvMap.get(`${currentLang}/${cleanSlug}.md`) || 
	               kvMap.get(`${currentLang}/${cleanSlug}`) || 
	               kvMap.get(cleanSlug) || {};

	// 1️⃣ 优先取 KV 中保存的 heroImage
	let finalHeroImage = kvData.heroImage !== undefined && kvData.heroImage !== '' ? kvData.heroImage : null;

	// 2️⃣ 若 KV 无数据，降级解析本地 Markdown 的 heroImage (兼容 src/assets 静态图片导入对象与字符串路径)
	if (!finalHeroImage && post.data.heroImage) {
		if (typeof post.data.heroImage === 'object' && (post.data.heroImage as any).src) {
			finalHeroImage = (post.data.heroImage as any).src;
		} else if (typeof post.data.heroImage === 'string') {
			finalHeroImage = post.data.heroImage;
		}
	}

	// ⚡ 核心修复 1：英文与多语言统一输出标准 URL 规范 `/blog/${currentLang}/${cleanSlug}/`
	const postUrl = `/blog/${currentLang}/${cleanSlug}/`;

	return {
		id: post.id,
		slug: cleanSlug,
		title: kvData.title || post.data.title || cleanSlug,
		heroImage: finalHeroImage || '',
		pubDate: post.data.pubDate,
		url: postUrl
	};
});
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={`${SITE_TITLE} - Blog`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				margin: 0 auto;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
				width: 100%;
				height: 240px;
				object-fit: cover;
				background: #1f2937;
			}
			ul li:first-child img {
				height: 380px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
			}
			.date {
				margin: 0.4rem 0 0 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
				ul li img,
				ul li:first-child img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={post.url}>
									{/* ⚡ 使用标准 <img> 标签，原生兼容网络 URL、Base64 以及静态构建提取出的 src 路径 */}
									{post.heroImage ? (
										<img src={post.heroImage} alt={post.title} loading="lazy" />
									) : (
										<div style="width:100%; height:240px; background:#1e293b; border-radius:12px; display:flex; align-items:center; justify-content:center; color:#64748b;">
											🖼️ No Cover Image
										</div>
									)}
									<h4 class="title">{post.title}</h4>
									<p class="date">
										{post.pubDate && <FormattedDate date={post.pubDate} />}
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
