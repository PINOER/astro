---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// ⚡ 1. 开启动态 SSR 模式
export const prerender = false;

// ⚡ 2. 动态获取当前语言
const { lang } = Astro.params;
const currentLang = lang || 'en';

// ⚡ 3. 抓取文章并按语言精准筛选
const allPosts = await getCollection('blog');
const filteredPosts = allPosts
	.filter((post) => {
		const isLangMatch = (post.data as any)?.lang === currentLang;
		const isPathMatch = post.id.startsWith(`${currentLang}/`);
		return isLangMatch || isPathMatch;
	})
	.sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

// ⚡ 4. 从 Cloudflare KV 中拉取数据，全维度构建 Map
let kvMap = new Map<string, any>();
try {
	const locals = Astro.locals as any;
	const kv = locals?.runtime?.env?.ADMIN_KV || (globalThis as any)?.ADMIN_KV;

	if (kv) {
		const raw = await kv.get(`articles_v1_${currentLang}`);
		if (raw) {
			const list = JSON.parse(raw);
			list.forEach((item: any) => {
				if (item.id) {
					kvMap.set(item.id, item);
					const pureName = item.id.replace(/^(en|zh|es|de|ja|ko)\//, '').replace(/\.(md|mdx)$/, '');
					kvMap.set(pureName, item);
				}
				if (item.slug) {
					kvMap.set(item.slug, item);
				}
			});
		}
	}
} catch (e) {
	console.warn('列表页 SSR 读取 KV 失败，降级回退本地 MD:', e);
}

// ⚡ SSR 图片安全转换工具函数：完美解开 Astro 本地 Asset 对象、网络 URL、Base64 与相对路径
function resolveImageUrl(imgSrc: any): string {
	if (!imgSrc) return '';
	if (typeof imgSrc === 'string') return imgSrc;
	if (typeof imgSrc === 'object') {
		if (imgSrc.src) return imgSrc.src;
		if (imgSrc.default) return typeof imgSrc.default === 'string' ? imgSrc.default : imgSrc.default.src || '';
	}
	return String(imgSrc);
}

// ⚡ 5. 组合展示数据
const posts = filteredPosts.map((post) => {
	// 提取纯 Slug
	const cleanSlug = post.id
		.replace(/^(en|zh|es|de|ja|ko)\//, '')
		.replace(/\.(md|mdx)$/, '')
		.replace(/\/index$/, '');

	// 多重格式回溯检索 KV
	const kvData = kvMap.get(post.id) || 
	               kvMap.get(`${currentLang}/${cleanSlug}.md`) || 
	               kvMap.get(`${currentLang}/${cleanSlug}`) || 
	               kvMap.get(cleanSlug) || {};

	// 1️⃣ 优先使用 KV 中保存的 heroImage (支持 Base64 与网络 URL)
	let rawHeroImage = (kvData.heroImage !== undefined && kvData.heroImage !== '') 
		? kvData.heroImage 
		: post.data.heroImage;

	// 2️⃣ 转换解析出 100% 可用的 img 路径
	const finalHeroImage = resolveImageUrl(rawHeroImage);

	// 3️⃣ 标准多语言 URL 规范
	const postUrl = `/blog/${currentLang}/${cleanSlug}/`;

	return {
		id: post.id,
		slug: cleanSlug,
		title: kvData.title || post.data.title || cleanSlug,
		heroImage: finalHeroImage,
		pubDate: post.data.pubDate,
		url: postUrl
	};
});
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={`${SITE_TITLE} - Blog`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				margin: 0 auto;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
				width: 100%;
				height: 240px;
				object-fit: cover;
				background: #1f2937;
			}
			ul li:first-child img {
				height: 380px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
			}
			.date {
				margin: 0.4rem 0 0 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
				ul li img,
				ul li:first-child img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={post.url}>
									{/* ⚡ 核心渲染：resolveImageUrl 转换后的有效图片地址 */}
									{post.heroImage ? (
										<img src={post.heroImage} alt={post.title} loading="lazy" />
									) : (
										<div style="width:100%; height:240px; background:#1e293b; border-radius:12px; display:flex; align-items:center; justify-content:center; color:#64748b;">
											🖼️ No Cover Image
										</div>
									)}
									<h4 class="title">{post.title}</h4>
									<p class="date">
										{post.pubDate && <FormattedDate date={post.pubDate} />}
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
