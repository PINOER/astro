---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// ⚡ 1. 强制开启动态 SSR 模式，确保实时拉取 Cloudflare KV 中的数据
export const prerender = false;

// ⚡ 2. 确定当前语言环境（优先读取 URL 参数，未定义时默认 'en'）
const { lang } = Astro.params;
const currentLang = lang || 'en';

// ⚡ 3. 读取 Content Collection 并精准过滤对应语言的文章
const allPosts = await getCollection('blog');
const filteredPosts = allPosts
	.filter((post) => {
		const isLangMatch = (post.data as any)?.lang === currentLang;
		const isPathMatch = post.id.startsWith(`${currentLang}/`);
		return isLangMatch || isPathMatch;
	})
	.sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

// ⚡ 4. 从 Cloudflare KV 动态拉取数据，并建立多维全格式 Key 映射表
let kvMap = new Map<string, any>();
try {
	const locals = Astro.locals as any;
	const kv = locals?.runtime?.env?.ADMIN_KV || (globalThis as any)?.ADMIN_KV;

	if (kv) {
		const raw = await kv.get(`articles_v1_${currentLang}`);
		if (raw) {
			const list = JSON.parse(raw);
			list.forEach((item: any) => {
				if (item.id) {
					kvMap.set(item.id, item); // 1. 存全量 ID (如 zh/fire.md 或 en/fire.md)
					const pureSlug = item.id.replace(new RegExp(`^${currentLang}/`), '').replace(/\.(md|mdx)$/, '');
					kvMap.set(pureSlug, item); // 2. 存纯 slug
				}
				if (item.slug) {
					kvMap.set(item.slug, item); // 3. 存 slug 字段
				}
			});
		}
	}
} catch (e) {
	console.warn('列表页 SSR 读取 KV 失败，回退使用本地 MD:', e);
}

// ⚡ 5. 组装数据，深度修复图片解析与 URL 路径
const posts = filteredPosts.map((post) => {
	// 提取不带语言和后缀的纯 slug (例如 "en/first-post.md" -> "first-post")
	const cleanSlug = post.id
		.replace(new RegExp(`^${currentLang}/`), '')
		.replace(/\.(md|mdx)$/, '')
		.replace(/\/index$/, '');

	// 全格式模糊匹配 KV 中的数据覆盖层
	const kvData = kvMap.get(post.id) || 
	               kvMap.get(`${currentLang}/${cleanSlug}.md`) || 
	               kvMap.get(cleanSlug) || {};

	// 优先取 KV 的 heroImage，没有则取本地 MD 的 heroImage
	let rawHeroImage = (kvData.heroImage !== undefined && kvData.heroImage !== '') 
		? kvData.heroImage 
		: post.data.heroImage;

	// 解析图片路径（兼容对象、相对路径、网络 URL 和 Base64）
	let imgUrl = '';
	if (rawHeroImage) {
		if (typeof rawHeroImage === 'string') {
			imgUrl = rawHeroImage;
		} else if (typeof rawHeroImage === 'object') {
			imgUrl = (rawHeroImage as any).src || '';
		}
	}

	// 统一生成路由链接路径
	const postUrl = currentLang === 'en' 
		? `/blog/${cleanSlug}/` 
		: `/blog/${currentLang}/${cleanSlug}/`;

	return {
		id: post.id,
		slug: cleanSlug,
		title: kvData.title || post.data.title || cleanSlug,
		heroImage: imgUrl,
		pubDate: post.data.pubDate,
		url: postUrl
	};
});
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={`${SITE_TITLE} - 博客`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				margin: 0 auto;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
				width: 100%;
				height: 240px;
				object-fit: cover;
				background: #1f2937;
			}
			ul li:first-child img {
				height: 380px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
			}
			.date {
				margin: 0.4rem 0 0 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
				ul li img,
				ul li:first-child img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={post.url}>
									{/* ⚡ 核心渲染：标准 <img> 完美展示 KV Base64 图片与本地解析出的图片路径 */}
									{post.heroImage ? (
										<img src={post.heroImage} alt={post.title} loading="lazy" />
									) : (
										<div style="width:100%; height:240px; background:#1e293b; border-radius:12px; display:flex; align-items:center; justify-content:center; color:#64748b;">
											🖼️ No Cover Image
										</div>
									)}
									<h4 class="title">{post.title}</h4>
									<p class="date">
										{post.pubDate && <FormattedDate date={post.pubDate} />}
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
