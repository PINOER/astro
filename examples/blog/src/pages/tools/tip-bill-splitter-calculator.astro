---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Tip & Bill Splitter Calculator",
	description: "Fast, 100% private online calculator to compute restaurant tips and split bills evenly among groups.",
	icon: "🍽️",
	tag: "Finance",
	keywords: "tip calculator bill splitter restaurant tip calculator split bill calculator gratuity calculator",
	pinned: false,
	priority: 87
};

const faqList = [
	{
		question: "What is the standard tip rate in US restaurants?",
		answer: "In the United States, standard tipping ranges between 15% and 20% for good service. 18% is typical for standard sit-down dining, while 20%+ is awarded for exceptional service."
	},
	{
		question: "Should I calculate the tip before or after tax?",
		answer: "By standard etiquette, tips are calculated based on the pre-tax bill subtotal. However, many people simply tip on the final total for simplicity."
	},
	{
		question: "Is my financial calculation private?",
		answer: "Yes, 100% private. All calculations run client-side inside your web browser. No bill amounts or guest counts are ever uploaded to any server."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.calc-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.section-title {
			font-size: 1.15rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1rem;
		}
		.field-group {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
			margin-bottom: 1rem;
		}
		label {
			font-size: 0.88rem;
			font-weight: 600;
			color: var(--text-main);
		}
		input[type="number"] {
			width: 100%;
			padding: 0.7em 0.9em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.95rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		input[type="number"]:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		.tip-presets {
			display: flex;
			gap: 0.5rem;
			margin-top: 0.3rem;
		}
		.preset-btn {
			flex: 1;
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			color: var(--text-main);
			padding: 0.5em;
			border-radius: 6px;
			font-size: 0.85rem;
			font-weight: 600;
			cursor: pointer;
			transition: all 0.2s;
		}
		.preset-btn.active, .preset-btn:hover {
			background: var(--badge-bg);
			color: var(--accent);
			border-color: var(--accent);
		}
		.metrics-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.8rem;
			margin-bottom: 1.2rem;
		}
		.metric-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			padding: 1rem;
			border-radius: 10px;
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
		}
		.metric-card.primary {
			border-color: var(--accent);
			background: var(--badge-bg);
		}
		.metric-label {
			font-size: 0.78rem;
			color: var(--text-muted);
			font-weight: 600;
		}
		.metric-value {
			font-size: 1.4rem;
			font-weight: 800;
			color: var(--accent);
		}
		.breakdown-list {
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
			background: var(--code-bg);
			padding: 1rem;
			border-radius: 10px;
			border: 1px solid var(--card-border);
		}
		.breakdown-item {
			display: flex;
			justify-content: space-between;
			font-size: 0.88rem;
			color: var(--text-muted);
		}
		.breakdown-item strong {
			color: var(--text-main);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			.calc-grid, .metrics-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<!-- 工具主体计算卡片 -->
	<div class="tool-box">
		<div class="calc-grid">
			<!-- Input Column -->
			<div class="input-section">
				<div class="section-title">Bill & Party Details</div>
				
				<div class="field-group">
					<label for="billAmount">Total Bill Amount ($)</label>
					<input type="number" id="billAmount" value="120.00" step="0.01" min="0" placeholder="Bill total before tip" />
				</div>

				<div class="field-group">
					<label for="tipPercent">Tip Percentage (%)</label>
					<input type="number" id="tipPercent" value="18" step="1" min="0" placeholder="e.g. 18%" />
					<div class="tip-presets">
						<button class="preset-btn" data-tip="15">15%</button>
						<button class="preset-btn active" data-tip="18">18%</button>
						<button class="preset-btn" data-tip="20">20%</button>
						<button class="preset-btn" data-tip="25">25%</button>
					</div>
				</div>

				<div class="field-group">
					<label for="numPeople">Number of People (Split)</label>
					<input type="number" id="numPeople" value="4" step="1" min="1" placeholder="Number of guests" />
				</div>
			</div>

			<!-- Output Column -->
			<div class="output-section">
				<div class="section-title">Split Calculation</div>

				<div class="metrics-grid">
					<div class="metric-card primary">
						<span class="metric-label">Total per Person</span>
						<span class="metric-value" id="valPerPerson">$0.00</span>
					</div>

					<div class="metric-card">
						<span class="metric-label">Tip per Person</span>
						<span class="metric-value" id="valTipPerPerson">$0.00</span>
					</div>
				</div>

				<div class="breakdown-list">
					<div class="breakdown-item">
						<span>Total Tip Amount</span>
						<strong id="valTotalTip">$0.00</strong>
					</div>
					<div class="breakdown-item">
						<span>Grand Total (Bill + Tip)</span>
						<strong id="valGrandTotal">$0.00</strong>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽，添加 DOMContentLoaded 机制) -->
	<script slot="scripts">
		function initTool() {
			const billAmountIn = document.getElementById('billAmount');
			const tipPercentIn = document.getElementById('tipPercent');
			const numPeopleIn = document.getElementById('numPeople');

			const valPerPerson = document.getElementById('valPerPerson');
			const valTipPerPerson = document.getElementById('valTipPerPerson');
			const valTotalTip = document.getElementById('valTotalTip');
			const valGrandTotal = document.getElementById('valGrandTotal');
			const presetBtns = document.querySelectorAll('.preset-btn');

			function calculateTip() {
				const bill = parseFloat(billAmountIn?.value) || 0;
				const tipRate = (parseFloat(tipPercentIn?.value) || 0) / 100;
				const people = Math.max(1, parseInt(numPeopleIn?.value) || 1);

				const totalTip = bill * tipRate;
				const grandTotal = bill + totalTip;
				const perPersonTotal = grandTotal / people;
				const perPersonTip = totalTip / people;

				if (valPerPerson) valPerPerson.textContent = `$${perPersonTotal.toFixed(2)}`;
				if (valTipPerPerson) valTipPerPerson.textContent = `$${perPersonTip.toFixed(2)}`;
				if (valTotalTip) valTotalTip.textContent = `$${totalTip.toFixed(2)}`;
				if (valGrandTotal) valGrandTotal.textContent = `$${grandTotal.toFixed(2)}`;
			}

			[billAmountIn, tipPercentIn, numPeopleIn].forEach(input => {
				input?.addEventListener('input', calculateTip);
			});

			presetBtns.forEach(btn => {
				btn.addEventListener('click', (e) => {
					presetBtns.forEach(b => b.classList.remove('active'));
					const target = e.currentTarget;
					target?.classList.add('active');
					const tip = target?.getAttribute('data-tip');
					if (tip && tipPercentIn) {
						tipPercentIn.value = tip;
						calculateTip();
					}
				});
			});

			calculateTip();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initTool);
		} else {
			initTool();
		}
	</script>
</ToolLayout>
