---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Markdown & Text Cleaner",
	description: "Fast, 100% private, client-side tool to strip HTML tags, normalize line breaks, and clean AI-generated Markdown text.",
	icon: "🧹",
	tag: "Productivity",
	keywords: "markdown cleaner text formatter ai text cleanup html strip",
	pinned: false,
	priority: 90
};

const faqList = [
	{
		question: "How does the Markdown & Text Cleaner help format AI-generated text?",
		answer: "AI tools (like ChatGPT or Claude) often include excessive blank lines, unnecessary HTML tags, or code fences (```markdown). This tool instantly strips those elements and normalizes paragraph breaks for clean pasting into blogs or docs."
	},
	{
		question: "Does removing HTML tags affect my text content?",
		answer: "Stripping HTML tags removes raw code formatting tags (like <span>, <div>, or <b>) while preserving line breaks and paragraph spacing, keeping only the plain text content."
	},
	{
		question: "Is my text data safe and private when using this tool?",
		answer: "Yes, 100% private. All text processing and cleaning functions execute locally in your web browser using JavaScript. No text is ever uploaded or transmitted to external servers."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.options-panel {
			background: var(--bg-card);
			backdrop-filter: blur(12px);
			border: 1px solid var(--card-border);
			border-radius: 14px;
			padding: 1rem 1.2rem;
			margin-bottom: 1.5rem;
			display: flex;
			flex-wrap: wrap;
			gap: 1rem 1.5rem;
			align-items: center;
		}
		.option-label {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			font-size: 0.88rem;
			color: var(--text-main);
			cursor: pointer;
			user-select: none;
		}
		.option-label input[type="checkbox"] {
			accent-color: var(--accent);
			width: 16px;
			height: 16px;
			cursor: pointer;
		}

		.editor-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1.2rem;
			margin-bottom: 1.5rem;
		}
		@media (max-width: 768px) {
			.editor-grid {
				grid-template-columns: 1fr;
			}
		}

		.editor-box {
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
		}
		.editor-top {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}
		.editor-title {
			font-size: 0.9rem;
			font-weight: 700;
			color: var(--text-main);
		}
		.editor-stats {
			font-size: 0.78rem;
			color: var(--text-muted);
		}

		textarea {
			width: 100%;
			height: 380px;
			padding: 1rem;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 12px;
			color: var(--text-main);
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 0.88rem;
			line-height: 1.6;
			resize: vertical;
			outline: none;
			box-sizing: border-box;
			transition: border-color 0.2s ease;
		}
		textarea:focus {
			border-color: var(--accent);
		}

		.action-bar {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.btn-group {
			display: flex;
			gap: 0.8rem;
		}
		.btn {
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-size: 0.88rem;
			font-weight: 600;
			cursor: pointer;
			border: 1px solid var(--card-border);
			transition: all 0.2s ease;
		}
		.btn-primary {
			background: var(--accent);
			color: #ffffff !important;
			border-color: var(--accent);
		}
		.btn-primary:hover {
			opacity: 0.9;
			transform: translateY(-1px);
		}
		.btn-secondary {
			background: var(--gray-light);
			color: var(--text-main);
		}
		.btn-secondary:hover {
			border-color: var(--accent);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 清洗选项控制面板 -->
	<div class="options-panel">
		<label class="option-label">
			<input type="checkbox" id="optStripHtml" checked />
			Strip HTML Tags (`&lt;span&gt;`, `&lt;div&gt;`, etc.)
		</label>
		<label class="option-label">
			<input type="checkbox" id="optMergeLines" checked />
			Compress Multiple Blank Lines
		</label>
		<label class="option-label">
			<input type="checkbox" id="optTrimSpaces" checked />
			Trim Leading & Trailing Spaces
		</label>
		<label class="option-label">
			<input type="checkbox" id="optStripCodeFences" />
			Remove Surrounding ```markdown Fences
		</label>
	</div>

	<!-- 输入输出与统计卡片 -->
	<div class="tool-box">
		<div class="editor-grid">
			<div class="editor-box">
				<div class="editor-top">
					<span class="editor-title">Raw Text / AI Output</span>
					<span id="inputStats" class="editor-stats">0 chars | 0 lines</span>
				</div>
				<textarea id="inputText" placeholder="Paste your raw text or AI Markdown output here..."></textarea>
			</div>

			<div class="editor-box">
				<div class="editor-top">
					<span class="editor-title">Cleaned Output</span>
					<span id="outputStats" class="editor-stats">0 chars | 0 lines</span>
				</div>
				<textarea id="outputText" placeholder="Cleaned text will appear here automatically..." readonly></textarea>
			</div>
		</div>

		<div class="action-bar">
			<div class="btn-group">
				<button id="btnSample" class="btn btn-secondary">Load Sample</button>
				<button id="btnClear" class="btn btn-secondary">Clear</button>
			</div>
			<button id="btnCopy" class="btn btn-primary">📋 Copy Cleaned Text</button>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const inputText = document.getElementById('inputText');
		const outputText = document.getElementById('outputText');
		const inputStats = document.getElementById('inputStats');
		const outputStats = document.getElementById('outputStats');
		const btnCopy = document.getElementById('btnCopy');
		const btnClear = document.getElementById('btnClear');
		const btnSample = document.getElementById('btnSample');

		const optStripHtml = document.getElementById('optStripHtml');
		const optMergeLines = document.getElementById('optMergeLines');
		const optTrimSpaces = document.getElementById('optTrimSpaces');
		const optStripCodeFences = document.getElementById('optStripCodeFences');

		function cleanText(text) {
			if (!text) return '';

			let result = text;

			if (optStripCodeFences?.checked) {
				result = result.replace(/^```[a-zA-Z]*\n/gm, '').replace(/\n```$/gm, '');
			}

			if (optStripHtml?.checked) {
				result = result.replace(/<br\s*\/?>/gi, '\n');
				result = result.replace(/<\/p>/gi, '\n\n');
				result = result.replace(/<[^>]+>/g, '');
			}

			if (optTrimSpaces?.checked) {
				result = result.split('\n').map(line => line.trim()).join('\n');
			}

			if (optMergeLines?.checked) {
				result = result.replace(/\n{3,}/g, '\n\n');
			}

			return result.trim();
		}

		function process() {
			const raw = inputText.value;
			const cleaned = cleanText(raw);

			outputText.value = cleaned;

			const inLines = raw ? raw.split('\n').length : 0;
			const outLines = cleaned ? cleaned.split('\n').length : 0;

			inputStats.textContent = `${raw.length} chars | ${inLines} lines`;
			outputStats.textContent = `${cleaned.length} chars | ${outLines} lines`;
		}

		inputText?.addEventListener('input', process);
		[optStripHtml, optMergeLines, optTrimSpaces, optStripCodeFences].forEach(opt => {
			opt?.addEventListener('change', process);
		});

		btnCopy?.addEventListener('click', () => {
			if (!outputText.value) return;
			navigator.clipboard.writeText(outputText.value).then(() => {
				const originalText = btnCopy.textContent;
				btnCopy.textContent = 'Copied!';
				setTimeout(() => { btnCopy.textContent = originalText; }, 2000);
			});
		});

		btnClear?.addEventListener('click', () => {
			inputText.value = '';
			process();
		});

		btnSample?.addEventListener('click', () => {
			inputText.value = `\`\`\`markdown
<span>Here is an AI response:</span>

###   1. Introduction  

This is an<b>example text</b> with<br>unnecessary HTML tags.    


Excessive blank lines below...




Done!
\`\`\``;
			process();
		});
	</script>
</ToolLayout>
