---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "Open Graph (OG) Meta Tag & Social Preview Generator",
	description: "Fast, 100% private online tool to generate Open Graph and Twitter Card HTML meta tags with live social media previews.",
	icon: "🖼️",
	tag: "Marketing",
	keywords: "open graph generator og meta tags twitter card generator social card preview website preview tags"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.calc-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
			}
			.section-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1rem;
			}
			.field-group {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				margin-bottom: 1rem;
			}
			label {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--text-main);
			}
			input[type="text"], textarea {
				width: 100%;
				padding: 0.7em 0.9em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 0.95rem;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			input[type="text"]:focus, textarea:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			textarea {
				height: 70px;
				resize: vertical;
			}

			/* Social Card Live Preview Styles */
			.preview-card-container {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				overflow: hidden;
				margin-bottom: 1.2rem;
			}
			.preview-card-img {
				width: 100%;
				height: 180px;
				background-color: var(--gray-light);
				background-size: cover;
				background-position: center;
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--text-muted);
				font-size: 0.85rem;
			}
			.preview-card-body {
				padding: 1rem;
			}
			.preview-card-domain {
				font-size: 0.75rem;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.5px;
				margin-bottom: 0.3rem;
			}
			.preview-card-title {
				font-size: 0.98rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.preview-card-desc {
				font-size: 0.82rem;
				color: var(--text-muted);
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			code-output {
				display: block;
			}
			textarea.code-area {
				height: 160px;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.85rem;
				line-height: 1.4;
			}

			.btn-group {
				display: flex;
				gap: 0.8rem;
				margin-top: 1.2rem;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* Content Sections */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.calc-grid, .related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🖼️ {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="calc-grid">
					<!-- Input Column -->
					<div class="input-section">
						<div class="section-title">Open Graph Metadata</div>

						<div class="field-group">
							<label for="ogTitle">Page Title (og:title)</label>
							<input type="text" id="ogTitle" value="HelpMini — Small Tools, Big Impact" placeholder="e.g. My Product Launch" />
						</div>

						<div class="field-group">
							<label for="ogDesc">Page Description (og:description)</label>
							<textarea id="ogDesc" placeholder="e.g. Discover 100% private online micro tools for remote workers.">Free, fast, 100% private online micro tools designed for solopreneurs, remote workers, and marketers.</textarea>
						</div>

						<div class="field-group">
							<label for="ogUrl">Canonical Page URL (og:url)</label>
							<input type="text" id="ogUrl" value="https://helpmini.com/" placeholder="e.g. https://example.com/page" />
						</div>

						<div class="field-group">
							<label for="ogImage">Image URL (og:image)</label>
							<input type="text" id="ogImage" value="https://helpmini.com/og-banner.png" placeholder="e.g. https://example.com/og-image.png" />
						</div>

						<div class="field-group">
							<label for="ogSiteName">Site Name (og:site_name)</label>
							<input type="text" id="ogSiteName" value="HelpMini" placeholder="e.g. HelpMini" />
						</div>
					</div>

					<!-- Live Preview & Code Column -->
					<div class="output-section">
						<div class="section-title">Live Social Card Preview</div>

						<div class="preview-card-container">
							<div class="preview-card-img" id="cardImgBox">
								<span>Image Preview</span>
							</div>
							<div class="preview-card-body">
								<div class="preview-card-domain" id="cardDomain">HELPMINI.COM</div>
								<div class="preview-card-title" id="cardTitle">HelpMini — Small Tools, Big Impact</div>
								<div class="preview-card-desc" id="cardDesc">Free, fast, 100% private online micro tools designed for solopreneurs...</div>
							</div>
						</div>

						<div class="field-group">
							<label for="codeOutput">Generated HTML Meta Tags:</label>
							<textarea class="code-area" id="codeOutput" readonly></textarea>
						</div>

						<div class="btn-group">
							<button class="btn btn-secondary" id="btnClear">Clear</button>
							<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy Meta Code</button>
						</div>
					</div>
				</div>
			</div>

			<!-- FAQ Section -->
			<section class="content-section">
				<h2>Frequently Asked Questions (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>What is Open Graph (OG) and why do I need it?</h3>
						<p>Open Graph is a protocol created by Facebook that turns any webpage into a rich social object. Adding OG meta tags ensures your website looks professional with custom titles, descriptions, and thumbnails when shared on Facebook, LinkedIn, Twitter, Slack, or WhatsApp.</p>
					</div>
					<div class="faq-item">
						<h3>What is the recommended size for og:image?</h3>
						<p>The recommended image dimensions for Open Graph images are <strong>1200 x 630 pixels</strong> (an aspect ratio of 1.91:1) with a file size under 8MB to ensure optimal rendering across mobile and desktop feeds.</p>
					</div>
					<div class="faq-item">
						<h3>Is my metadata stored or uploaded anywhere?</h3>
						<p><strong>No.</strong> All tag generation and card preview rendering happen 100% locally in your web browser. No URLs or descriptions leave your device.</p>
					</div>
				</div>
			</section>

			<!-- Related Tools Section -->
			<section class="content-section">
				<h2>You Might Also Like</h2>
				<div class="related-grid">
					<a href="/tools/utm-builder-url-generator/" class="related-card">
						<span class="card-icon">🔗</span>
						<div>
							<h4>UTM Builder & Tracking URL Generator</h4>
							<p>Create custom UTM tracking links for Google Analytics 4 campaigns.</p>
						</div>
					</a>
					<a href="/tools/number-to-words-converter/" class="related-card">
						<span class="card-icon">🔢</span>
						<div>
							<h4>Number to English Words Converter</h4>
							<p>Convert numbers and invoice amounts into written English words.</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "What is Open Graph (OG) and why do I need it?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Open Graph tags ensure your website shows custom titles, descriptions, and thumbnails when shared on social media platforms."
						}
					},
					{
						"@type": "Question",
						"name": "What is the recommended size for og:image?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "The recommended image dimensions for Open Graph images are 1200 x 630 pixels."
						}
					}
				]
			}
		</script>

		<script>
			const ogTitleIn = document.getElementById('ogTitle') as HTMLInputElement;
			const ogDescIn = document.getElementById('ogDesc') as HTMLTextAreaElement;
			const ogUrlIn = document.getElementById('ogUrl') as HTMLInputElement;
			const ogImageIn = document.getElementById('ogImage') as HTMLInputElement;
			const ogSiteNameIn = document.getElementById('ogSiteName') as HTMLInputElement;

			const cardImgBox = document.getElementById('cardImgBox');
			const cardDomain = document.getElementById('cardDomain');
			const cardTitle = document.getElementById('cardTitle');
			const cardDesc = document.getElementById('cardDesc');
			const codeOutput = document.getElementById('codeOutput') as HTMLTextAreaElement;

			function updateOg() {
				const title = ogTitleIn.value.trim();
				const desc = ogDescIn.value.trim();
				const url = ogUrlIn.value.trim();
				const image = ogImageIn.value.trim();
				const siteName = ogSiteNameIn.value.trim();

				// Card Live Preview Updates
				if (cardTitle) cardTitle.textContent = title || 'Page Title Preview';
				if (cardDesc) cardDesc.textContent = desc || 'Page description preview will appear here...';

				try {
					const parsedUrl = new URL(url.startsWith('http') ? url : 'https://' + url);
					if (cardDomain) cardDomain.textContent = parsedUrl.hostname.toUpperCase();
				} catch (e) {
					if (cardDomain) cardDomain.textContent = 'EXAMPLE.COM';
				}

				if (cardImgBox) {
					if (image) {
						cardImgBox.style.backgroundImage = `url('${image}')`;
						cardImgBox.innerHTML = '';
					} else {
						cardImgBox.style.backgroundImage = 'none';
						cardImgBox.innerHTML = '<span>Image Preview</span>';
					}
				}

				// Code Output Builder
				const tags = [
					'<!-- HTML Meta Tags -->',
					`<title>${title}</title>`,
					`<meta name="description" content="${desc}">`,
					'',
					'<!-- Facebook / Open Graph Meta Tags -->',
					`<meta property="og:type" content="website">`,
					`<meta property="og:url" content="${url}">`,
					`<meta property="og:title" content="${title}">`,
					`<meta property="og:description" content="${desc}">`,
					`<meta property="og:image" content="${image}">`,
					siteName ? `<meta property="og:site_name" content="${siteName}">` : '',
					'',
					'<!-- Twitter / X Meta Tags -->',
					`<meta name="twitter:card" content="summary_large_image">`,
					`<meta property="twitter:domain" content="${cardDomain ? cardDomain.textContent?.toLowerCase() : ''}">`,
					`<meta property="twitter:url" content="${url}">`,
					`<meta name="twitter:title" content="${title}">`,
					`<meta name="twitter:description" content="${desc}">`,
					`<meta name="twitter:image" content="${image}">`
				].filter(line => line !== null && line !== undefined).join('\n');

				codeOutput.value = tags;
			}

			[ogTitleIn, ogDescIn, ogUrlIn, ogImageIn, ogSiteNameIn].forEach(input => {
				input?.addEventListener('input', updateOg);
			});

			document.getElementById('btnClear')?.addEventListener('click', () => {
				ogTitleIn.value = '';
				ogDescIn.value = '';
				ogUrlIn.value = '';
				ogImageIn.value = '';
				ogSiteNameIn.value = '';
				updateOg();
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!codeOutput.value) return;
				navigator.clipboard.writeText(codeOutput.value);
				const btn = e.target as HTMLButtonElement;
				btn.textContent = 'Copied!';
				setTimeout(() => { btn.textContent = 'Copy Meta Code'; }, 2000);
			});

			updateOg();
		</script>
	</body>
</html>
