---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Open Graph (OG) Meta Tag & Social Preview Generator",
	description: "Fast, 100% private online tool to generate Open Graph and Twitter Card HTML meta tags with live social media previews.",
	icon: "🖼️",
	tag: "Marketing",
	keywords: "open graph generator og meta tags twitter card generator social card preview website preview tags",
	pinned: false,
	priority: 89
};

const faqList = [
	{
		question: "What is Open Graph (OG) and why do I need it?",
		answer: "Open Graph is a protocol created by Facebook that turns any webpage into a rich social object. Adding OG meta tags ensures your website looks professional with custom titles, descriptions, and thumbnails when shared on Facebook, LinkedIn, Twitter, Slack, or WhatsApp."
	},
	{
		question: "What is the recommended size for og:image?",
		answer: "The recommended image dimensions for Open Graph images are 1200 x 630 pixels (an aspect ratio of 1.91:1) with a file size under 8MB to ensure optimal rendering across mobile and desktop feeds."
	},
	{
		question: "Is my metadata stored or uploaded anywhere?",
		answer: "No. All tag generation and card preview rendering happen 100% locally in your web browser. No URLs or descriptions leave your device."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.calc-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.section-title {
			font-size: 1.15rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1rem;
		}
		.field-group {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
			margin-bottom: 1rem;
		}
		label {
			font-size: 0.88rem;
			font-weight: 600;
			color: var(--text-main);
		}
		input[type="text"], textarea {
			width: 100%;
			padding: 0.7em 0.9em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.95rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		input[type="text"]:focus, textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		textarea {
			height: 70px;
			resize: vertical;
		}

		/* Social Card Live Preview Styles */
		.preview-card-container {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			overflow: hidden;
			margin-bottom: 1.2rem;
		}
		.preview-card-img {
			width: 100%;
			height: 180px;
			background-color: var(--gray-light);
			background-size: cover;
			background-position: center;
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--text-muted);
			font-size: 0.85rem;
		}
		.preview-card-body {
			padding: 1rem;
		}
		.preview-card-domain {
			font-size: 0.75rem;
			color: var(--text-muted);
			text-transform: uppercase;
			letter-spacing: 0.5px;
			margin-bottom: 0.3rem;
		}
		.preview-card-title {
			font-size: 0.98rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 0.3rem;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.preview-card-desc {
			font-size: 0.82rem;
			color: var(--text-muted);
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		textarea.code-area {
			height: 160px;
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 0.85rem;
			line-height: 1.4;
		}

		.btn-group {
			display: flex;
			gap: 0.8rem;
			margin-top: 1.2rem;
		}
		.btn {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-weight: 600;
			cursor: pointer;
			transition: background 0.2s;
		}
		.btn:hover { background: var(--accent-hover); }
		.btn-secondary {
			background: var(--gray-light);
			border: 1px solid var(--card-border);
			color: var(--text-main);
		}
		.btn-secondary:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			.calc-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<!-- 工具主体计算卡片 -->
	<div class="tool-box">
		<div class="calc-grid">
			<!-- Input Column -->
			<div class="input-section">
				<div class="section-title">Open Graph Metadata</div>

				<div class="field-group">
					<label for="ogTitle">Page Title (og:title)</label>
					<input type="text" id="ogTitle" value="HelpMini — Small Tools, Big Impact" placeholder="e.g. My Product Launch" />
				</div>

				<div class="field-group">
					<label for="ogDesc">Page Description (og:description)</label>
					<textarea id="ogDesc" placeholder="e.g. Discover 100% private online micro tools for remote workers.">Free, fast, 100% private online micro tools designed for solopreneurs, remote workers, and marketers.</textarea>
				</div>

				<div class="field-group">
					<label for="ogUrl">Canonical Page URL (og:url)</label>
					<input type="text" id="ogUrl" value="https://helpmini.com/" placeholder="e.g. https://example.com/page" />
				</div>

				<div class="field-group">
					<label for="ogImage">Image URL (og:image)</label>
					<input type="text" id="ogImage" value="https://helpmini.com/og-banner.png" placeholder="e.g. https://example.com/og-image.png" />
				</div>

				<div class="field-group">
					<label for="ogSiteName">Site Name (og:site_name)</label>
					<input type="text" id="ogSiteName" value="HelpMini" placeholder="e.g. HelpMini" />
				</div>
			</div>

			<!-- Live Preview & Code Column -->
			<div class="output-section">
				<div class="section-title">Live Social Card Preview</div>

				<div class="preview-card-container">
					<div class="preview-card-img" id="cardImgBox">
						<span>Image Preview</span>
					</div>
					<div class="preview-card-body">
						<div class="preview-card-domain" id="cardDomain">HELPMINI.COM</div>
						<div class="preview-card-title" id="cardTitle">HelpMini — Small Tools, Big Impact</div>
						<div class="preview-card-desc" id="cardDesc">Free, fast, 100% private online micro tools designed for solopreneurs...</div>
					</div>
				</div>

				<div class="field-group">
					<label for="codeOutput">Generated HTML Meta Tags:</label>
					<textarea class="code-area" id="codeOutput" readonly></textarea>
				</div>

				<div class="btn-group">
					<button class="btn btn-secondary" id="btnClear">Clear</button>
					<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy Meta Code</button>
				</div>
			</div>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const ogTitleIn = document.getElementById('ogTitle') as HTMLInputElement;
		const ogDescIn = document.getElementById('ogDesc') as HTMLTextAreaElement;
		const ogUrlIn = document.getElementById('ogUrl') as HTMLInputElement;
		const ogImageIn = document.getElementById('ogImage') as HTMLInputElement;
		const ogSiteNameIn = document.getElementById('ogSiteName') as HTMLInputElement;

		const cardImgBox = document.getElementById('cardImgBox');
		const cardDomain = document.getElementById('cardDomain');
		const cardTitle = document.getElementById('cardTitle');
		const cardDesc = document.getElementById('cardDesc');
		const codeOutput = document.getElementById('codeOutput') as HTMLTextAreaElement;

		function updateOg() {
			const title = ogTitleIn.value.trim();
			const desc = ogDescIn.value.trim();
			const url = ogUrlIn.value.trim();
			const image = ogImageIn.value.trim();
			const siteName = ogSiteNameIn.value.trim();

			// Card Live Preview Updates
			if (cardTitle) cardTitle.textContent = title || 'Page Title Preview';
			if (cardDesc) cardDesc.textContent = desc || 'Page description preview will appear here...';

			try {
				const parsedUrl = new URL(url.startsWith('http') ? url : 'https://' + url);
				if (cardDomain) cardDomain.textContent = parsedUrl.hostname.toUpperCase();
			} catch (e) {
				if (cardDomain) cardDomain.textContent = 'EXAMPLE.COM';
			}

			if (cardImgBox) {
				if (image) {
					cardImgBox.style.backgroundImage = `url('${image}')`;
					cardImgBox.innerHTML = '';
				} else {
					cardImgBox.style.backgroundImage = 'none';
					cardImgBox.innerHTML = '<span>Image Preview</span>';
				}
			}

			// Code Output Builder
			const tags = [
				'<!-- HTML Meta Tags -->',
				`<title>${title}</title>`,
				`<meta name="description" content="${desc}">`,
				'',
				'<!-- Facebook / Open Graph Meta Tags -->',
				`<meta property="og:type" content="website">`,
				`<meta property="og:url" content="${url}">`,
				`<meta property="og:title" content="${title}">`,
				`<meta property="og:description" content="${desc}">`,
				`<meta property="og:image" content="${image}">`,
				siteName ? `<meta property="og:site_name" content="${siteName}">` : '',
				'',
				'<!-- Twitter / X Meta Tags -->',
				`<meta name="twitter:card" content="summary_large_image">`,
				`<meta property="twitter:domain" content="${cardDomain ? cardDomain.textContent?.toLowerCase() : ''}">`,
				`<meta property="twitter:url" content="${url}">`,
				`<meta name="twitter:title" content="${title}">`,
				`<meta name="twitter:description" content="${desc}">`,
				`<meta name="twitter:image" content="${image}">`
			].filter(line => line !== null && line !== undefined).join('\n');

			codeOutput.value = tags;
		}

		[ogTitleIn, ogDescIn, ogUrlIn, ogImageIn, ogSiteNameIn].forEach(input => {
			input?.addEventListener('input', updateOg);
		});

		document.getElementById('btnClear')?.addEventListener('click', () => {
			ogTitleIn.value = '';
			ogDescIn.value = '';
			ogUrlIn.value = '';
			ogImageIn.value = '';
			ogSiteNameIn.value = '';
			updateOg();
		});

		document.getElementById('btnCopy')?.addEventListener('click', (e) => {
			if (!codeOutput.value) return;
			navigator.clipboard.writeText(codeOutput.value);
			const btn = e.target as HTMLButtonElement;
			const originalText = btn.textContent;
			btn.textContent = 'Copied!';
			setTimeout(() => { btn.textContent = originalText; }, 2000);
		});

		updateOg();
	</script>
</ToolLayout>
