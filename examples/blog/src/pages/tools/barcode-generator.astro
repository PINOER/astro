---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Retail & E-commerce Barcode Generator (UPC-A, EAN-13, Code 128)",
	description: "Generate instant, scannable retail barcodes (UPC-A, EAN-13, Code 128, Code 39) for Amazon, Etsy, and Shopify products. Export high-res PNG or vector SVG files. 100% free.",
	icon: "📊",
	tag: "E-commerce & Product Shoot",
	keywords: "barcode generator, UPC-A barcode, EAN-13 barcode generator, code 128 generator, amazon barcode printer, retail barcode creator, SKU barcode generator",
	pinned: false,
	priority: 80
};

const faqList = [
	{
		question: "What is the difference between UPC-A and EAN-13 barcodes?",
		answer: "UPC-A is a 12-digit barcode standard primarily used in North America (US & Canada). EAN-13 is a 13-digit standard used globally across Europe, Asia, and other regions. Most modern scanner systems read both interchangeably."
	},
	{
		question: "Which barcode format should I use for custom product SKUs and inventory?",
		answer: "Code 128 is the best choice for custom internal SKUs, logistics, and inventory management because it supports both numbers and uppercase/lowercase letters."
	},
	{
		question: "Are generated barcodes safe for thermal sticky-label printing?",
		answer: "Yes! You can download the generated barcode as a crisp PNG or vector SVG file, ensuring ultra-sharp black lines for smooth scanning on thermal label printers."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};

const barcodeTypes = [
	{ code: "CODE128", name: "Code 128 (Universal - Letters & Numbers)", defaultVal: "SKU-2026-PROD" },
	{ code: "UPC", name: "UPC-A (North America - 12 Digits)", defaultVal: "012345678905" },
	{ code: "EAN13", name: "EAN-13 (Global Retail - 13 Digits)", defaultVal: "5901234123457" },
	{ code: "CODE39", name: "Code 39 (Alphanumeric Industrial)", defaultVal: "ITEM1234" },
	{ code: "EAN8", name: "EAN-8 (Small Package - 8 Digits)", defaultVal: "96385074" }
];
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- FAQ Schema.org -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- JsBarcode CDN -->
	<script slot="head" src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

	<style slot="head">
		.barcode-container {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			margin-bottom: 2rem;
		}

		.editor-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}

		.panel-card {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 16px;
			padding: 1.5rem;
			display: flex;
			flex-direction: column;
			gap: 1rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		}

		.panel-title {
			font-size: 1.05rem;
			font-weight: 700;
			color: var(--text-main);
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--card-border);
		}

		.form-group {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
		}

		label {
			font-size: 0.88rem;
			font-weight: 700;
			color: var(--text-main);
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.sub-tag {
			font-size: 0.75rem;
			color: var(--text-muted);
			font-weight: normal;
		}

		input[type="text"], select, input[type="number"] {
			width: 100%;
			padding: 0.75em 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.92rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}

		input:focus, select:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}

		.preview-card {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 16px;
			padding: 1.5rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1.2rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		}

		.barcode-wrapper {
			padding: 1.5rem;
			background: #ffffff;
			border-radius: 12px;
			border: 1px solid var(--card-border);
			display: flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			max-width: 360px;
			box-sizing: border-box;
		}

		#barcodeSvg {
			max-width: 100%;
			height: auto;
		}

		.btn-group {
			display: flex;
			gap: 0.8rem;
			width: 100%;
			max-width: 360px;
		}

		.btn-download {
			flex: 1;
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.8em 1em;
			border-radius: 10px;
			font-size: 0.9rem;
			font-weight: 700;
			cursor: pointer;
			transition: all 0.2s ease;
			text-align: center;
		}

		.btn-download:hover {
			background: var(--accent-hover);
			transform: translateY(-1px);
		}

		.btn-secondary {
			background: var(--code-bg);
			color: var(--text-main);
			border: 1px solid var(--card-border);
		}

		.error-msg {
			color: #ef4444;
			font-size: 0.82rem;
			display: none;
		}

		.error-msg.active {
			display: block;
		}

		/* FAQ Section */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<div class="tool-box">
		<div class="barcode-container">
			<div class="editor-grid">
				<!-- Input Form Panel -->
				<div class="panel-card">
					<span class="panel-title">⚙️ Barcode Type & Value</span>

					<div class="form-group">
						<label for="barcodeType">Standard Symbology</label>
						<select id="barcodeType">
							{barcodeTypes.map((t) => (
								<option value={t.code} data-default={t.defaultVal}>{t.name}</option>
							))}
						</select>
					</div>

					<div class="form-group">
						<label for="barcodeValue">
							<span>Barcode Value *</span>
							<span class="sub-tag" id="valHint">Numbers or Letters</span>
						</label>
						<input type="text" id="barcodeValue" value="SKU-2026-PROD" />
						<span class="error-msg" id="errorMsg">⚠️ Invalid format for selected barcode type.</span>
					</div>

					<div class="form-group">
						<label for="barHeight">Bar Height (px)</label>
						<input type="number" id="barHeight" min="30" max="150" value="70" />
					</div>
				</div>

				<!-- Live Preview Panel -->
				<div class="preview-card">
					<span class="panel-title" style="border:none; padding:0;">✨ Scannable Barcode Preview</span>

					<div class="barcode-wrapper">
						<svg id="barcodeSvg"></svg>
					</div>

					<div class="btn-group">
						<button class="btn-download" id="btnDownloadPng">⬇️ Download PNG</button>
						<button class="btn-download btn-secondary" id="btnDownloadSvg">⬇️ Download SVG</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- FAQ Section -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<script slot="scripts">
		function initBarcodeGenerator() {
			const barcodeType = document.getElementById('barcodeType');
			const barcodeValue = document.getElementById('barcodeValue');
			const barHeight = document.getElementById('barHeight');
			const barcodeSvg = document.getElementById('barcodeSvg');
			const errorMsg = document.getElementById('errorMsg');

			const btnDownloadPng = document.getElementById('btnDownloadPng');
			const btnDownloadSvg = document.getElementById('btnDownloadSvg');

			function renderBarcode() {
				if (typeof JsBarcode === 'undefined' || !barcodeSvg) return;

				const format = barcodeType?.value || 'CODE128';
				const val = barcodeValue?.value.trim() || '';
				const h = parseInt(barHeight?.value || '70', 10);

				if (!val) {
					if (errorMsg) errorMsg.classList.remove('active');
					return;
				}

				try {
					JsBarcode(barcodeSvg, val, {
						format: format,
						lineColor: "#000000",
						width: 2,
						height: h,
						displayValue: true,
						fontSize: 16,
						margin: 10
					});
					if (errorMsg) errorMsg.classList.remove('active');
				} catch (e) {
					if (errorMsg) {
						errorMsg.textContent = `⚠️ Invalid input for ${format}. Please check required digits.`;
						errorMsg.classList.add('active');
					}
				}
			}

			// Listeners
			barcodeType?.addEventListener('change', (e) => {
				const selectedOption = barcodeType.options[barcodeType.selectedIndex];
				const defaultVal = selectedOption.getAttribute('data-default');
				if (defaultVal && barcodeValue) {
					barcodeValue.value = defaultVal;
				}
				renderBarcode();
			});

			barcodeValue?.addEventListener('input', renderBarcode);
			barHeight?.addEventListener('input', renderBarcode);

			// Download SVG
			btnDownloadSvg?.addEventListener('click', () => {
				if (!barcodeSvg) return;
				const serializer = new XMLSerializer();
				const svgStr = serializer.serializeToString(barcodeSvg);
				const blob = new Blob([svgStr], { type: 'image/svg+xml;charset=utf-8' });
				const link = document.createElement('a');
				link.href = URL.createObjectURL(blob);
				link.download = `barcode-${barcodeValue?.value || 'export'}.svg`;
				link.click();
			});

			// Download High-Res PNG via Canvas
			btnDownloadPng?.addEventListener('click', () => {
				if (!barcodeSvg) return;
				const serializer = new XMLSerializer();
				const svgStr = serializer.serializeToString(barcodeSvg);
				const img = new Image();
				
				img.onload = () => {
					const canvas = document.createElement('canvas');
					canvas.width = img.width * 2; // High DPI
					canvas.height = img.height * 2;
					const ctx = canvas.getContext('2d');
					if (ctx) {
						ctx.fillStyle = "#ffffff";
						ctx.fillRect(0, 0, canvas.width, canvas.height);
						ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
						const link = document.createElement('a');
						link.download = `barcode-${barcodeValue?.value || 'export'}.png`;
						link.href = canvas.toDataURL('image/png');
						link.click();
					}
				};

				img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgStr)));
			});

			setTimeout(renderBarcode, 150);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initBarcodeGenerator);
		} else {
			initBarcodeGenerator();
		}
	</script>
</ToolLayout>
