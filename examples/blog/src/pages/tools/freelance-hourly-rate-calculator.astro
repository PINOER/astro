---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Freelance Hourly Rate Calculator",
	description: "Fast, 100% private online calculator to compute your ideal freelance hourly rate based on expenses, taxes, and desired income.",
	icon: "💼",
	tag: "Finance",
	keywords: "freelance hourly rate calculator freelancer pricing tool target income calculator consulting rate",
	pinned: false,
	priority: 88
};

const faqList = [
	{
		question: "What is a Billable Utilization Rate?",
		answer: "Your billable utilization rate represents the percentage of working time spent directly on paid client work versus unpaid admin, sales, marketing, and invoicing tasks. Most freelancers average between 50% and 70%."
	},
	{
		question: "Why is my required hourly rate higher than an employee salary?",
		answer: "As a freelancer, you must personally cover health insurance, taxes, software tools, unpaid vacation days, and client acquisition time that employers normally subsidize."
	},
	{
		question: "Is my financial data saved or transmitted?",
		answer: "No. All calculations run 100% locally in your web browser. No personal income details or figures leave your device."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.calc-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.section-title {
			font-size: 1.15rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1rem;
		}
		.field-group {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
			margin-bottom: 1rem;
		}
		label {
			font-size: 0.88rem;
			font-weight: 600;
			color: var(--text-main);
		}
		input[type="number"] {
			width: 100%;
			padding: 0.7em 0.9em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.95rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		input[type="number"]:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		.metrics-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.8rem;
			margin-bottom: 1.2rem;
		}
		.metric-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			padding: 1rem;
			border-radius: 10px;
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
		}
		.metric-card.primary {
			border-color: var(--accent);
			background: var(--badge-bg);
		}
		.metric-label {
			font-size: 0.78rem;
			color: var(--text-muted);
			font-weight: 600;
		}
		.metric-value {
			font-size: 1.4rem;
			font-weight: 800;
			color: var(--accent);
		}
		.breakdown-list {
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
			background: var(--code-bg);
			padding: 1rem;
			border-radius: 10px;
			border: 1px solid var(--card-border);
		}
		.breakdown-item {
			display: flex;
			justify-content: space-between;
			font-size: 0.88rem;
			color: var(--text-muted);
		}
		.breakdown-item strong {
			color: var(--text-main);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			.calc-grid, .metrics-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<!-- 工具主体计算卡片 -->
	<div class="tool-box">
		<div class="calc-grid">
			<!-- Input Column -->
			<div class="input-section">
				<div class="section-title">Target Income & Expenses</div>
				
				<div class="field-group">
					<label for="desiredIncome">Desired Net Income / Year ($)</label>
					<input type="number" id="desiredIncome" value="80000" step="1000" min="0" placeholder="Target take-home pay" />
				</div>

				<div class="field-group">
					<label for="annualExpenses">Annual Business Expenses ($)</label>
					<input type="number" id="annualExpenses" value="10000" step="500" min="0" placeholder="Software, hardware, insurance" />
				</div>

				<div class="field-group">
					<label for="taxRate">Estimated Tax Rate (%)</label>
					<input type="number" id="taxRate" value="25" step="1" min="0" placeholder="e.g. 25%" />
				</div>

				<div class="field-group">
					<label for="weeklyHours">Target Work Hours / Week</label>
					<input type="number" id="weeklyHours" value="40" step="1" min="1" placeholder="e.g. 40 hours" />
				</div>

				<div class="field-group">
					<label for="billablePercent">Billable Utilization Rate (%)</label>
					<input type="number" id="billablePercent" value="65" step="5" min="10" max="100" placeholder="e.g. 65% client billable" />
				</div>

				<div class="field-group">
					<label for="weeksOff">Weeks Off / Year (Vacation/Sick)</label>
					<input type="number" id="weeksOff" value="4" step="1" min="0" max="52" placeholder="e.g. 4 weeks" />
				</div>
			</div>

			<!-- Output Column -->
			<div class="output-section">
				<div class="section-title">Calculated Rate Summary</div>

				<div class="metrics-grid">
					<div class="metric-card primary">
						<span class="metric-label">Min. Hourly Rate</span>
						<span class="metric-value" id="valHourlyRate">$0.00</span>
					</div>

					<div class="metric-card">
						<span class="metric-label">Min. Daily Rate (8h)</span>
						<span class="metric-value" id="valDailyRate">$0.00</span>
					</div>
				</div>

				<div class="breakdown-list">
					<div class="breakdown-item">
						<span>Target Gross Revenue Needed</span>
						<strong id="valGrossRevenue">$0.00</strong>
					</div>
					<div class="breakdown-item">
						<span>Total Taxes Payable</span>
						<strong id="valTotalTax">$0.00</strong>
					</div>
					<div class="breakdown-item">
						<span>Total Billable Hours / Year</span>
						<strong id="valBillableHours">0 hrs</strong>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽，添加 DOMContentLoaded 机制) -->
	<script slot="scripts">
		function initTool() {
			const desiredIncomeIn = document.getElementById('desiredIncome');
			const annualExpensesIn = document.getElementById('annualExpenses');
			const taxRateIn = document.getElementById('taxRate');
			const weeklyHoursIn = document.getElementById('weeklyHours');
			const billablePercentIn = document.getElementById('billablePercent');
			const weeksOffIn = document.getElementById('weeksOff');

			const valHourlyRate = document.getElementById('valHourlyRate');
			const valDailyRate = document.getElementById('valDailyRate');
			const valGrossRevenue = document.getElementById('valGrossRevenue');
			const valTotalTax = document.getElementById('valTotalTax');
			const valBillableHours = document.getElementById('valBillableHours');

			function calculateRate() {
				const netIncome = parseFloat(desiredIncomeIn?.value) || 0;
				const expenses = parseFloat(annualExpensesIn?.value) || 0;
				const taxRate = (parseFloat(taxRateIn?.value) || 0) / 100;
				const weeklyHours = Math.max(1, parseFloat(weeklyHoursIn?.value) || 40);
				const billableRate = Math.min(100, Math.max(1, parseFloat(billablePercentIn?.value) || 65)) / 100;
				const weeksOff = Math.min(52, parseFloat(weeksOffIn?.value) || 0);

				const taxableExpensesBenefit = expenses * taxRate;
				const requiredPreTaxRevenue = (1 - taxRate) > 0 ? (netIncome + expenses - taxableExpensesBenefit) / (1 - taxRate) : 0;
				const totalTax = Math.max(0, (requiredPreTaxRevenue - expenses) * taxRate);

				const workingWeeks = Math.max(0, 52 - weeksOff);
				const totalWorkingHours = workingWeeks * weeklyHours;
				const totalBillableHours = totalWorkingHours * billableRate;

				const hourlyRate = totalBillableHours > 0 ? requiredPreTaxRevenue / totalBillableHours : 0;
				const dailyRate = hourlyRate * 8;

				if (valHourlyRate) valHourlyRate.textContent = `$${hourlyRate.toFixed(2)}`;
				if (valDailyRate) valDailyRate.textContent = `$${dailyRate.toFixed(2)}`;
				if (valGrossRevenue) valGrossRevenue.textContent = `$${requiredPreTaxRevenue.toFixed(2)}`;
				if (valTotalTax) valTotalTax.textContent = `$${totalTax.toFixed(2)}`;
				if (valBillableHours) valBillableHours.textContent = `${Math.round(totalBillableHours)} hrs`;
			}

			[desiredIncomeIn, annualExpensesIn, taxRateIn, weeklyHoursIn, billablePercentIn, weeksOffIn].forEach(input => {
				input?.addEventListener('input', calculateRate);
			});

			calculateRate();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initTool);
		} else {
			initTool();
		}
	</script>
</ToolLayout>
