---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "Freelance Hourly Rate Calculator",
	description: "Fast, 100% private online calculator to compute your ideal freelance hourly rate based on expenses, taxes, and desired income.",
	icon: "💼",
	tag: "Finance",
	keywords: "freelance hourly rate calculator freelancer pricing tool target income calculator consulting rate"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.calc-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
			}
			.section-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1rem;
			}
			.field-group {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				margin-bottom: 1rem;
			}
			label {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--text-main);
			}
			input[type="number"] {
				width: 100%;
				padding: 0.7em 0.9em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 0.95rem;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			input[type="number"]:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			.metrics-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
				margin-bottom: 1.2rem;
			}
			.metric-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				padding: 1rem;
				border-radius: 10px;
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}
			.metric-card.primary {
				border-color: var(--accent);
				background: var(--badge-bg);
			}
			.metric-label {
				font-size: 0.78rem;
				color: var(--text-muted);
				font-weight: 600;
			}
			.metric-value {
				font-size: 1.4rem;
				font-weight: 800;
				color: var(--accent);
			}
			.breakdown-list {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				background: var(--code-bg);
				padding: 1rem;
				border-radius: 10px;
				border: 1px solid var(--card-border);
			}
			.breakdown-item {
				display: flex;
				justify-content: space-between;
				font-size: 0.88rem;
				color: var(--text-muted);
			}
			.breakdown-item strong {
				color: var(--text-main);
			}

			/* Content Sections */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.calc-grid, .metrics-grid, .related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>💼 {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="calc-grid">
					<!-- Input Column -->
					<div class="input-section">
						<div class="section-title">Target Income & Expenses</div>
						
						<div class="field-group">
							<label for="desiredIncome">Desired Net Income / Year ($)</label>
							<input type="number" id="desiredIncome" value="80000" step="1000" min="0" placeholder="Target take-home pay" />
						</div>

						<div class="field-group">
							<label for="annualExpenses">Annual Business Expenses ($)</label>
							<input type="number" id="annualExpenses" value="10000" step="500" min="0" placeholder="Software, hardware, insurance" />
						</div>

						<div class="field-group">
							<label for="taxRate">Estimated Tax Rate (%)</label>
							<input type="number" id="taxRate" value="25" step="1" min="0" placeholder="e.g. 25%" />
						</div>

						<div class="field-group">
							<label for="weeklyHours">Target Work Hours / Week</label>
							<input type="number" id="weeklyHours" value="40" step="1" min="1" placeholder="e.g. 40 hours" />
						</div>

						<div class="field-group">
							<label for="billablePercent">Billable Utilization Rate (%)</label>
							<input type="number" id="billablePercent" value="65" step="5" min="10" max="100" placeholder="e.g. 65% client billable" />
						</div>

						<div class="field-group">
							<label for="weeksOff">Weeks Off / Year (Vacation/Sick)</label>
							<input type="number" id="weeksOff" value="4" step="1" min="0" max="52" placeholder="e.g. 4 weeks" />
						</div>
					</div>

					<!-- Output Column -->
					<div class="output-section">
						<div class="section-title">Calculated Rate Summary</div>

						<div class="metrics-grid">
							<div class="metric-card primary">
								<span class="metric-label">Min. Hourly Rate</span>
								<span class="metric-value" id="valHourlyRate">$0.00</span>
							</div>

							<div class="metric-card">
								<span class="metric-label">Min. Daily Rate (8h)</span>
								<span class="metric-value" id="valDailyRate">$0.00</span>
							</div>
						</div>

						<div class="breakdown-list">
							<div class="breakdown-item">
								<span>Target Gross Revenue Needed</span>
								<strong id="valGrossRevenue">$0.00</strong>
							</div>
							<div class="breakdown-item">
								<span>Total Taxes Payable</span>
								<strong id="valTotalTax">$0.00</strong>
							</div>
							<div class="breakdown-item">
								<span>Total Billable Hours / Year</span>
								<strong id="valBillableHours">0 hrs</strong>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- FAQ Section -->
			<section class="content-section">
				<h2>Frequently Asked Questions (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>What is a Billable Utilization Rate?</h3>
						<p>Your <strong>billable utilization rate</strong> represents the percentage of working time spent directly on paid client work versus unpaid admin, sales, marketing, and invoicing tasks. Most freelancers average between <strong>50% and 70%</strong>.</p>
					</div>
					<div class="faq-item">
						<h3>Why is my required hourly rate higher than an employee salary?</h3>
						<p>As a freelancer, you must personally cover health insurance, taxes, software tools, unpaid vacation days, and client acquisition time that employers normally subsidize.</p>
					</div>
					<div class="faq-item">
						<h3>Is my financial data saved or transmitted?</h3>
						<p><strong>No.</strong> All calculations run 100% locally in your web browser. No personal income details or figures leave your device.</p>
					</div>
				</div>
			</section>

			<!-- Related Tools Section -->
			<section class="content-section">
				<h2>You Might Also Like</h2>
				<div class="related-grid">
					<a href="/tools/tip-bill-splitter-calculator/" class="related-card">
						<span class="card-icon">🍽️</span>
						<div>
							<h4>Tip & Bill Splitter Calculator</h4>
							<p>Compute restaurant tips and split group dining bills evenly.</p>
						</div>
					</a>
					<a href="/tools/ecommerce-profit-margin-calculator/" class="related-card">
						<span class="card-icon">🧮</span>
						<div>
							<h4>E-commerce Profit Margin Calculator</h4>
							<p>Calculate net profit margins and breakeven sale prices.</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "What is a Billable Utilization Rate?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Billable utilization rate represents the percentage of working time spent directly on paid client work versus unpaid admin tasks."
						}
					},
					{
						"@type": "Question",
						"name": "Why is my required hourly rate higher than an employee salary?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Freelancers must cover health insurance, taxes, software tools, unpaid vacation days, and marketing time."
						}
					}
				]
			}
		</script>

		<script>
			const desiredIncomeIn = document.getElementById('desiredIncome') as HTMLInputElement;
			const annualExpensesIn = document.getElementById('annualExpenses') as HTMLInputElement;
			const taxRateIn = document.getElementById('taxRate') as HTMLInputElement;
			const weeklyHoursIn = document.getElementById('weeklyHours') as HTMLInputElement;
			const billablePercentIn = document.getElementById('billablePercent') as HTMLInputElement;
			const weeksOffIn = document.getElementById('weeksOff') as HTMLInputElement;

			const valHourlyRate = document.getElementById('valHourlyRate');
			const valDailyRate = document.getElementById('valDailyRate');
			const valGrossRevenue = document.getElementById('valGrossRevenue');
			const valTotalTax = document.getElementById('valTotalTax');
			const valBillableHours = document.getElementById('valBillableHours');

			function calculateRate() {
				const netIncome = parseFloat(desiredIncomeIn.value) || 0;
				const expenses = parseFloat(annualExpensesIn.value) || 0;
				const taxRate = (parseFloat(taxRateIn.value) || 0) / 100;
				const weeklyHours = Math.max(1, parseFloat(weeklyHoursIn.value) || 40);
				const billableRate = Math.min(100, Math.max(1, parseFloat(billablePercentIn.value) || 65)) / 100;
				const weeksOff = Math.min(52, parseFloat(weeksOffIn.value) || 0);

				// Gross Revenue needed before tax & expenses
				// Gross - Tax(Gross - Expenses) - Expenses = Net
				// Gross = (Net + Expenses * (1 - Tax)) / (1 - Tax)
				const taxableExpensesBenefit = expenses * taxRate;
				const requiredPreTaxRevenue = (1 - taxRate) > 0 ? (netIncome + expenses - taxableExpensesBenefit) / (1 - taxRate) : 0;
				const totalTax = Math.max(0, (requiredPreTaxRevenue - expenses) * taxRate);

				const workingWeeks = Math.max(0, 52 - weeksOff);
				const totalWorkingHours = workingWeeks * weeklyHours;
				const totalBillableHours = totalWorkingHours * billableRate;

				const hourlyRate = totalBillableHours > 0 ? requiredPreTaxRevenue / totalBillableHours : 0;
				const dailyRate = hourlyRate * 8;

				if (valHourlyRate) valHourlyRate.textContent = `$${hourlyRate.toFixed(2)}`;
				if (valDailyRate) valDailyRate.textContent = `$${dailyRate.toFixed(2)}`;
				if (valGrossRevenue) valGrossRevenue.textContent = `$${requiredPreTaxRevenue.toFixed(2)}`;
				if (valTotalTax) valTotalTax.textContent = `$${totalTax.toFixed(2)}`;
				if (valBillableHours) valBillableHours.textContent = `${Math.round(totalBillableHours)} hrs`;
			}

			[desiredIncomeIn, annualExpensesIn, taxRateIn, weeklyHoursIn, billablePercentIn, weeksOffIn].forEach(input => {
				input?.addEventListener('input', calculateRate);
			});

			calculateRate();
		</script>
	</body>
</html>
