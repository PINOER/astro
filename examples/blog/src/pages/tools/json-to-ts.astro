---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "JSON to TypeScript Interface Converter",
	description: "Fast, 100% private online tool to convert complex JSON data into structured TypeScript interfaces instantly.",
	icon: "💻",
	tag: "Developer",
	keywords: "json to typescript interface converter type definition developer tools",
	pinned: false,
	priority: 93
};

const faqList = [
	{
		question: "How does the JSON to TypeScript converter handle nested objects and arrays?",
		answer: "The tool recursively inspects nested JSON objects and arrays, automatically generating standalone sub-interfaces for inner objects and inferring array item types (e.g., string[], number[], or CustomType[])."
	},
	{
		question: "Is my JSON data uploaded or processed on any remote server?",
		answer: "No, 100% private. All parsing, type inference, and TypeScript interface generation happen locally within your browser using JavaScript. No payload is ever sent to an external server."
	},
	{
		question: "Can I use the generated TypeScript interfaces directly in my React, Vue, or Astro projects?",
		answer: "Yes, absolutely! Simply copy the generated TypeScript interfaces and paste them into your .ts or .tsx source files or type definition modules (.d.ts) for full type-checking and autocompletion."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.status-bar {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 0.8rem 1.2rem;
			margin-bottom: 1.2rem;
			display: flex;
			justify-content: space-between;
			align-items: center;
			font-size: 0.88rem;
		}
		.status-success { color: #10b981; font-weight: 600; }
		.status-error { color: #ef4444; font-weight: 600; }

		.editor-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1.2rem;
			margin-bottom: 1.5rem;
		}
		@media (max-width: 768px) {
			.editor-grid {
				grid-template-columns: 1fr;
			}
		}

		.editor-box {
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
		}
		.editor-top {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}
		.editor-title {
			font-size: 0.9rem;
			font-weight: 700;
			color: var(--text-main);
		}
		.btn-text {
			background: none;
			border: none;
			color: var(--accent);
			font-size: 0.82rem;
			cursor: pointer;
			font-weight: 600;
		}
		.btn-text:hover {
			text-decoration: underline;
		}

		textarea {
			width: 100%;
			height: 400px;
			padding: 1rem;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 12px;
			color: var(--text-main);
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 0.88rem;
			line-height: 1.6;
			resize: vertical;
			outline: none;
			box-sizing: border-box;
			transition: border-color 0.2s ease;
		}
		textarea:focus {
			border-color: var(--accent);
		}

		.action-bar {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.btn-group {
			display: flex;
			gap: 0.8rem;
		}
		.btn {
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-size: 0.88rem;
			font-weight: 600;
			cursor: pointer;
			border: 1px solid var(--card-border);
			transition: all 0.2s ease;
		}
		.btn-primary {
			background: var(--accent);
			color: #ffffff !important;
			border-color: var(--accent);
		}
		.btn-primary:hover {
			opacity: 0.9;
			transform: translateY(-1px);
		}
		.btn-secondary {
			background: var(--gray-light);
			color: var(--text-main);
		}
		.btn-secondary:hover {
			border-color: var(--accent);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 工具主体计算卡片 -->
	<div class="tool-box">
		<div class="status-bar">
			<span id="statusText" class="status-success">✓ Ready (Type or paste JSON to generate)</span>
			<span style="color: var(--text-muted); font-size: 0.82rem;">Mode: JSON ➔ TypeScript Interface</span>
		</div>

		<div class="editor-grid">
			<div class="editor-box">
				<div class="editor-top">
					<span class="editor-title">JSON Input</span>
					<button id="btnClear" class="btn-text">Clear</button>
				</div>
				<textarea id="jsonInput" placeholder='Paste your raw JSON here... e.g. {"id": 1, "name": "HelpMini", "active": true}'></textarea>
			</div>

			<div class="editor-box">
				<div class="editor-top">
					<span class="editor-title">TypeScript Output</span>
					<button id="btnCopy" class="btn-text">📋 Copy Result</button>
				</div>
				<textarea id="tsOutput" placeholder="Converted TypeScript interfaces will appear here automatically..." readonly></textarea>
			</div>
		</div>

		<div class="action-bar">
			<div class="btn-group">
				<button id="btnSample" class="btn btn-secondary">Load Sample</button>
			</div>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const jsonInput = document.getElementById('jsonInput');
		const tsOutput = document.getElementById('tsOutput');
		const statusText = document.getElementById('statusText');
		const btnClear = document.getElementById('btnClear');
		const btnCopy = document.getElementById('btnCopy');
		const btnSample = document.getElementById('btnSample');

		function capitalize(str) {
			return str.charAt(0).toUpperCase() + str.slice(1);
		}

		function inferType(val, keyName = 'Item', interfaces = []) {
			if (val === null) return 'null';
			const type = typeof val;

			if (type === 'string') return 'string';
			if (type === 'number') return 'number';
			if (type === 'boolean') return 'boolean';

			if (Array.isArray(val)) {
				if (val.length === 0) return 'any[]';
				const subType = inferType(val[0], keyName, interfaces);
				return `${subType}[]`;
			}

			if (type === 'object') {
				const interfaceName = capitalize(keyName) + 'Interface';
				const fields = [];
				for (const k of Object.keys(val)) {
					const subTypeName = inferType(val[k], k, interfaces);
					fields.push(`  ${k}: ${subTypeName};`);
				}
				interfaces.push(`interface ${interfaceName} {\n${fields.join('\n')}\n}`);
				return interfaceName;
			}

			return 'any';
		}

		function convertJSONToTS() {
			const val = jsonInput.value.trim();
			if (!val) {
				tsOutput.value = '';
				statusText.className = 'status-success';
				statusText.textContent = '✓ Ready';
				return;
			}

			try {
				const jsonObj = JSON.parse(val);
				const interfaces = [];
				const rootType = inferType(jsonObj, 'RootObject', interfaces);

				const uniqueInterfaces = [...new Set(interfaces)].reverse();
				
				let finalResult = uniqueInterfaces.join('\n\n');
				if (finalResult) {
					finalResult += '\n\n';
				}
				finalResult += `type RootObject = ${rootType};`;

				tsOutput.value = finalResult;
				statusText.className = 'status-success';
				statusText.textContent = '✓ JSON parsed and TypeScript interface generated successfully';
			} catch (err) {
				tsOutput.value = '';
				statusText.className = 'status-error';
				statusText.textContent = `❌ Syntax Error: ${err.message}`;
			}
		}

		jsonInput?.addEventListener('input', convertJSONToTS);

		btnClear?.addEventListener('click', () => {
			jsonInput.value = '';
			convertJSONToTS();
		});

		btnCopy?.addEventListener('click', () => {
			if (!tsOutput.value) return;
			navigator.clipboard.writeText(tsOutput.value).then(() => {
				const originalText = btnCopy.textContent;
				btnCopy.textContent = 'Copied!';
				setTimeout(() => { btnCopy.textContent = originalText; }, 2000);
			});
		});

		btnSample?.addEventListener('click', () => {
			jsonInput.value = JSON.stringify({
				id: 101,
				title: "HelpMini Developer Hub",
				published: true,
				tags: ["AI", "Astro", "TypeScript"],
				author: {
					name: "Alex",
					role: "Founder"
				},
				metrics: [
					{ views: 1200, clicks: 350 }
				]
			}, null, 2);
			convertJSONToTS();
		});
	</script>
</ToolLayout>
