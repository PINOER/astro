---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "Word & Character Counter with Reading Time Estimator",
	description: "Free, real-time online tool to count words, characters, sentences, paragraphs, and estimated reading time.",
	icon: "📝",
	tag: "Content",
	keywords: "word counter character counter reading time estimator word count tool online letter counter"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.stats-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
				margin-bottom: 1.5rem;
			}
			.stat-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				padding: 1rem;
				border-radius: 12px;
				text-align: center;
			}
			.stat-card.primary {
				border-color: var(--accent);
				background: var(--badge-bg);
			}
			.stat-label {
				font-size: 0.8rem;
				color: var(--text-muted);
				font-weight: 600;
				display: block;
				margin-bottom: 0.3rem;
			}
			.stat-value {
				font-size: 1.6rem;
				font-weight: 800;
				color: var(--accent);
			}
			.time-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
				margin-bottom: 1.5rem;
				background: var(--code-bg);
				padding: 0.8rem 1.2rem;
				border-radius: 10px;
				border: 1px solid var(--card-border);
			}
			.time-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.9rem;
				color: var(--text-muted);
			}
			.time-item strong {
				color: var(--text-main);
				font-weight: 700;
			}
			textarea {
				width: 100%;
				height: 280px;
				padding: 1em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 10px;
				color: var(--text-main);
				font-size: 0.95rem;
				font-family: inherit;
				box-sizing: border-box;
				outline: none;
				resize: vertical;
				line-height: 1.6;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			textarea:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			.btn-group {
				display: flex;
				gap: 0.8rem;
				margin-top: 1.2rem;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* Content Sections */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.stats-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.time-grid, .related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>📝 {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="stats-grid">
					<div class="stat-card primary">
						<span class="stat-label">Words</span>
						<span class="stat-value" id="valWords">0</span>
					</div>
					<div class="stat-card">
						<span class="stat-label">Characters (All)</span>
						<span class="stat-value" id="valChars">0</span>
					</div>
					<div class="stat-card">
						<span class="stat-label">Characters (No Space)</span>
						<span class="stat-value" id="valCharsNoSpace">0</span>
					</div>
					<div class="stat-card">
						<span class="stat-label">Paragraphs</span>
						<span class="stat-value" id="valParagraphs">0</span>
					</div>
				</div>

				<div class="time-grid">
					<div class="time-item">
						<span>Estimated Reading Time:</span>
						<strong id="valReadingTime">0 sec</strong>
					</div>
					<div class="time-item">
						<span>Estimated Speaking Time:</span>
						<strong id="valSpeakingTime">0 sec</strong>
					</div>
				</div>

				<textarea id="textInput" placeholder="Paste or type your content here to start counting..."></textarea>

				<div class="btn-group">
					<button class="btn btn-secondary" id="btnClear">Clear Text</button>
					<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy Text</button>
				</div>
			</div>

			<!-- FAQ Section -->
			<section class="content-section">
				<h2>Frequently Asked Questions (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>How is the estimated reading time calculated?</h3>
						<p>Reading time is calculated based on an average adult silent reading speed of <strong>200 words per minute (WPM)</strong>. Speaking time assumes an average presentation pace of <strong>130 WPM</strong>.</p>
					</div>
					<div class="faq-item">
						<h3>Is my text data saved or tracked?</h3>
						<p><strong>No.</strong> Your text is processed 100% locally in your web browser. Nothing is uploaded, stored, or analyzed on any server.</p>
					</div>
					<div class="faq-item">
						<h3>What is the ideal word count for blog posts and SEO?</h3>
						<p>For search engine optimization (SEO), long-form content ranging between <strong>1,500 to 2,500 words</strong> tends to rank better for comprehensive topics.</p>
					</div>
				</div>
			</section>

			<!-- Related Tools Section -->
			<section class="content-section">
				<h2>You Might Also Like</h2>
				<div class="related-grid">
					<a href="/tools/base64-url-encode-decode/" class="related-card">
						<span class="card-icon">🔤</span>
						<div>
							<h4>Base64 & URL Encoder/Decoder</h4>
							<p>Encode and decode Base64 strings and URL parameters securely.</p>
						</div>
					</a>
					<a href="/tools/json-formatter-validator/" class="related-card">
						<span class="card-icon">🛠️</span>
						<div>
							<h4>JSON Formatter & Validator</h4>
							<p>Format, beautify, and validate JSON data in real-time.</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "How is the estimated reading time calculated?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Reading time is calculated based on an average adult silent reading speed of 200 words per minute (WPM)."
						}
					},
					{
						"@type": "Question",
						"name": "Is my text data saved or tracked?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "No. Your text is processed 100% locally in your web browser. Nothing is uploaded or saved on any server."
						}
					}
				]
			}
		</script>

		<script>
			const textInput = document.getElementById('textInput') as HTMLTextAreaElement;
			const valWords = document.getElementById('valWords');
			const valChars = document.getElementById('valChars');
			const valCharsNoSpace = document.getElementById('valCharsNoSpace');
			const valParagraphs = document.getElementById('valParagraphs');
			const valReadingTime = document.getElementById('valReadingTime');
			const valSpeakingTime = document.getElementById('valSpeakingTime');

			function updateCounts() {
				const text = textInput.value;
				
				// Words count (handles multi-language & spaces)
				const wordsArray = text.trim().match(/[\u4e00-\u9fa5]|\b[a-zA-Z0-9'-]+\b/g) || [];
				const wordCount = wordsArray.length;

				// Characters count
				const charCount = text.length;
				const charNoSpaceCount = text.replace(/\s/g, '').length;

				// Paragraphs count
				const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0).length;

				// Reading & Speaking Time
				const readSecs = Math.ceil((wordCount / 200) * 60);
				const speakSecs = Math.ceil((wordCount / 130) * 60);

				function formatTime(seconds: number) {
					if (seconds < 60) return `${seconds} sec`;
					const mins = Math.floor(seconds / 60);
					const remSecs = seconds % 60;
					return `${mins} min ${remSecs} sec`;
				}

				if (valWords) valWords.textContent = wordCount.toLocaleString();
				if (valChars) valChars.textContent = charCount.toLocaleString();
				if (valCharsNoSpace) valCharsNoSpace.textContent = charNoSpaceCount.toLocaleString();
				if (valParagraphs) valParagraphs.textContent = paragraphs.toLocaleString();
				if (valReadingTime) valReadingTime.textContent = formatTime(readSecs);
				if (valSpeakingTime) valSpeakingTime.textContent = formatTime(speakSecs);
			}

			textInput?.addEventListener('input', updateCounts);

			document.getElementById('btnClear')?.addEventListener('click', () => {
				textInput.value = '';
				updateCounts();
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!textInput.value) return;
				navigator.clipboard.writeText(textInput.value);
				const btn = e.target as HTMLButtonElement;
				btn.textContent = 'Copied!';
				setTimeout(() => { btn.textContent = 'Copy Text'; }, 2000);
			});
		</script>
	</body>
</html>
