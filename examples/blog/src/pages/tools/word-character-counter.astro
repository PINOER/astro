---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Word & Character Counter with Reading Time Estimator",
	description: "Free, real-time online tool to count words, characters, sentences, paragraphs, and estimated reading time.",
	icon: "📝",
	tag: "Content",
	keywords: "word counter character counter reading time estimator word count tool online letter counter",
	pinned: false,
	priority: 88
};

const faqList = [
	{
		question: "How is the estimated reading and speaking time calculated?",
		answer: "Reading time is calculated based on an average adult silent reading speed of 200 words per minute (WPM). Speaking time assumes a standard presentation pace of 130 WPM."
	},
	{
		question: "Is my text data saved or tracked on any server?",
		answer: "No. Your text is processed 100% locally inside your web browser using JavaScript. Nothing is uploaded, saved, or analyzed on any external servers."
	},
	{
		question: "What is the ideal word count for SEO blog posts?",
		answer: "For search engine optimization (SEO), long-form content ranging between 1,500 to 2,500 words tends to rank better for comprehensive topics and higher organic visibility."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.stats-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		.stat-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			padding: 1rem;
			border-radius: 12px;
			text-align: center;
		}
		.stat-card.primary {
			border-color: var(--accent);
			background: var(--badge-bg);
		}
		.stat-label {
			font-size: 0.8rem;
			color: var(--text-muted);
			font-weight: 600;
			display: block;
			margin-bottom: 0.3rem;
		}
		.stat-value {
			font-size: 1.6rem;
			font-weight: 800;
			color: var(--accent);
		}
		.time-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
			margin-bottom: 1.5rem;
			background: var(--code-bg);
			padding: 0.8rem 1.2rem;
			border-radius: 10px;
			border: 1px solid var(--card-border);
		}
		.time-item {
			display: flex;
			justify-content: space-between;
			align-items: center;
			font-size: 0.9rem;
			color: var(--text-muted);
		}
		.time-item strong {
			color: var(--text-main);
			font-weight: 700;
		}
		textarea {
			width: 100%;
			height: 280px;
			padding: 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			color: var(--text-main);
			font-size: 0.95rem;
			font-family: inherit;
			box-sizing: border-box;
			outline: none;
			resize: vertical;
			line-height: 1.6;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		.btn-group {
			display: flex;
			gap: 0.8rem;
			margin-top: 1.2rem;
		}
		.btn {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-weight: 600;
			cursor: pointer;
			transition: background 0.2s;
		}
		.btn:hover { background: var(--accent-hover); }
		.btn-secondary {
			background: var(--gray-light);
			border: 1px solid var(--card-border);
			color: var(--text-main);
		}
		.btn-secondary:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			.stats-grid {
				grid-template-columns: repeat(2, 1fr);
			}
			.time-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<!-- 工具主体表单卡片 -->
	<div class="tool-box">
		<div class="stats-grid">
			<div class="stat-card primary">
				<span class="stat-label">Words</span>
				<span class="stat-value" id="valWords">0</span>
			</div>
			<div class="stat-card">
				<span class="stat-label">Characters (All)</span>
				<span class="stat-value" id="valChars">0</span>
			</div>
			<div class="stat-card">
				<span class="stat-label">Characters (No Space)</span>
				<span class="stat-value" id="valCharsNoSpace">0</span>
			</div>
			<div class="stat-card">
				<span class="stat-label">Paragraphs</span>
				<span class="stat-value" id="valParagraphs">0</span>
			</div>
		</div>

		<div class="time-grid">
			<div class="time-item">
				<span>Estimated Reading Time:</span>
				<strong id="valReadingTime">0 sec</strong>
			</div>
			<div class="time-item">
				<span>Estimated Speaking Time:</span>
				<strong id="valSpeakingTime">0 sec</strong>
			</div>
		</div>

		<textarea id="textInput" placeholder="Paste or type your content here to start counting..."></textarea>

		<div class="btn-group">
			<button class="btn btn-secondary" id="btnClear">Clear Text</button>
			<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy Text</button>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽，添加 DOMContentLoaded 机制) -->
	<script slot="scripts">
		function initTool() {
			const textInput = document.getElementById('textInput');
			const valWords = document.getElementById('valWords');
			const valChars = document.getElementById('valChars');
			const valCharsNoSpace = document.getElementById('valCharsNoSpace');
			const valParagraphs = document.getElementById('valParagraphs');
			const valReadingTime = document.getElementById('valReadingTime');
			const valSpeakingTime = document.getElementById('valSpeakingTime');

			function updateCounts() {
				const text = textInput?.value || '';
				
				const wordsArray = text.trim().match(/[\u4e00-\u9fa5]|\b[a-zA-Z0-9'-]+\b/g) || [];
				const wordCount = wordsArray.length;

				const charCount = text.length;
				const charNoSpaceCount = text.replace(/\s/g, '').length;

				const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0).length;

				const readSecs = Math.ceil((wordCount / 200) * 60);
				const speakSecs = Math.ceil((wordCount / 130) * 60);

				function formatTime(seconds) {
					if (seconds < 60) return `${seconds} sec`;
					const mins = Math.floor(seconds / 60);
					const remSecs = seconds % 60;
					return `${mins} min ${remSecs} sec`;
				}

				if (valWords) valWords.textContent = wordCount.toLocaleString();
				if (valChars) valChars.textContent = charCount.toLocaleString();
				if (valCharsNoSpace) valCharsNoSpace.textContent = charNoSpaceCount.toLocaleString();
				if (valParagraphs) valParagraphs.textContent = paragraphs.toLocaleString();
				if (valReadingTime) valReadingTime.textContent = formatTime(readSecs);
				if (valSpeakingTime) valSpeakingTime.textContent = formatTime(speakSecs);
			}

			textInput?.addEventListener('input', updateCounts);

			document.getElementById('btnClear')?.addEventListener('click', () => {
				if (textInput) textInput.value = '';
				updateCounts();
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!textInput || !textInput.value) return;
				navigator.clipboard.writeText(textInput.value);
				const btn = e.target;
				const originalText = btn.textContent;
				btn.textContent = 'Copied!';
				setTimeout(() => { btn.textContent = originalText; }, 2000);
			});

			updateCounts();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initTool);
		} else {
			initTool();
		}
	</script>
</ToolLayout>
