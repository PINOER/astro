---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Instagram & TikTok Caption Hashtag Generator & Cleaner",
	description: "Format social media captions with clean line breaks for Instagram and TikTok. Extract, sanitize, and count hashtags without text collapsing. 100% free and private.",
	icon: "💬",
	tag: "E-commerce & Social Media",
	keywords: "instagram caption generator, tiktok hashtag cleaner, instagram line break generator, social media caption formatter, hashtag extractor, social media formatting tool",
	pinned: false,
	priority: 82
};

const faqList = [
	{
		question: "Why does Instagram remove paragraph line breaks in captions?",
		answer: "Instagram's default text editor deletes standard blank line breaks. This tool inserts invisible Unicode spacing characters into your paragraphs so your line breaks stay clean and readable."
	},
	{
		question: "How many hashtags should I use on Instagram and TikTok?",
		answer: "While Instagram allows up to 30 hashtags, modern algorithm best practices suggest using 3 to 5 highly relevant niche hashtags. TikTok works best with 3 to 6 targeted hashtags."
	},
	{
		question: "Is my caption content stored on any server?",
		answer: "No. All text formatting, hashtag extraction, character counting, and line-break sanitization happen 100% locally in your web browser."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- FAQ Schema.org -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<style slot="head">
		.caption-container {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			margin-bottom: 2rem;
		}

		.editor-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}

		.panel-card {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 16px;
			padding: 1.5rem;
			display: flex;
			flex-direction: column;
			gap: 1rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		}

		.panel-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--card-border);
		}

		.panel-title {
			font-size: 1rem;
			font-weight: 700;
			color: var(--text-main);
		}

		.form-group {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
		}

		label {
			font-size: 0.88rem;
			font-weight: 700;
			color: var(--text-main);
			display: flex;
			justify-content: space-between;
		}

		.sub-tag {
			font-size: 0.75rem;
			color: var(--text-muted);
			font-weight: normal;
		}

		textarea {
			width: 100%;
			height: 220px;
			padding: 0.8em 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			color: var(--text-main);
			font-size: 0.92rem;
			font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
			line-height: 1.6;
			resize: vertical;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}

		textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}

		.stats-banner {
			display: flex;
			justify-content: space-around;
			align-items: center;
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 0.8rem;
			text-align: center;
		}

		.stat-item {
			display: flex;
			flex-direction: column;
		}

		.stat-val {
			font-size: 1.2rem;
			font-weight: 800;
			color: var(--accent);
		}

		.stat-lbl {
			font-size: 0.72rem;
			color: var(--text-muted);
			text-transform: uppercase;
		}

		.hashtag-chips {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
			background: var(--code-bg);
			padding: 0.8rem;
			border-radius: 10px;
			border: 1px solid var(--card-border);
			min-height: 50px;
		}

		.chip {
			background: rgba(59, 130, 246, 0.15);
			color: var(--accent);
			border: 1px solid rgba(59, 130, 246, 0.3);
			padding: 0.2em 0.6em;
			border-radius: 6px;
			font-size: 0.8rem;
			font-weight: 600;
		}

		.btn-copy {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-size: 0.88rem;
			font-weight: 700;
			cursor: pointer;
			transition: all 0.2s ease;
		}

		.btn-copy:hover {
			background: var(--accent-hover);
			transform: translateY(-1px);
		}

		/* FAQ Section */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<div class="tool-box">
		<div class="caption-container">
			<div class="editor-grid">
				<!-- Raw Input Panel -->
				<div class="panel-card">
					<div class="panel-header">
						<span class="panel-title">📝 Raw Caption Input</span>
					</div>

					<div class="form-group">
						<label for="rawInput">
							<span>Type or Paste Caption</span>
							<span class="sub-tag">Type standard line breaks</span>
						</label>
						<textarea id="rawInput" placeholder="Write your Instagram/TikTok caption here...&#10;&#10;Leave blank lines between paragraphs.&#10;&#10;#fashion #style #OOTD">✨ Unboxing our new summer collection! ☀️

Which look is your favorite? 1, 2, or 3? Let us know in the comments below! 👇

Drop a ❤️ if you want a discount code!

#summerfashion #OOTD #styleinspo #shoplocal #aesthetic</textarea>
					</div>

					<!-- Character & Hashtag Stats -->
					<div class="stats-banner">
						<div class="stat-item">
							<span class="stat-val" id="charCount">0</span>
							<span class="stat-lbl">Chars (Max 2,200)</span>
						</div>
						<div class="stat-item">
							<span class="stat-val" id="tagCount">0</span>
							<span class="stat-lbl">Hashtags</span>
						</div>
					</div>
				</div>

				<!-- Formatted Output Panel -->
				<div class="panel-card">
					<div class="panel-header">
						<span class="panel-title">✨ Formatted & Cleaned Output</span>
						<button class="btn-copy" id="btnCopy">📋 Copy Formatted Caption</button>
					</div>

					<div class="form-group">
						<textarea id="formattedOutput" readonly placeholder="Cleaned caption with preserved line breaks will appear here..."></textarea>
					</div>

					<div class="form-group">
						<label>Extracted Hashtags</label>
						<div class="hashtag-chips" id="tagChips"></div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- FAQ Section -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<script slot="scripts">
		function initCaptionCleaner() {
			const rawInput = document.getElementById('rawInput');
			const formattedOutput = document.getElementById('formattedOutput');
			const charCount = document.getElementById('charCount');
			const tagCount = document.getElementById('tagCount');
			const tagChips = document.getElementById('tagChips');
			const btnCopy = document.getElementById('btnCopy');

			// Invisible Unicode space for IG line break preservation: U+2800 (BRAILLE PATTERN BLANK)
			const INVISIBLE_SPACE = '\u2800';

			function process() {
				const text = rawInput?.value || '';

				// 1. Calculate stats
				if (charCount) charCount.textContent = text.length;

				const hashtags = (text.match(/#[a-zA-Z0-9_]+/g) || []).map(t => t.toLowerCase());
				const uniqueHashtags = [...new Set(hashtags)];

				if (tagCount) tagCount.textContent = uniqueHashtags.length;

				// Render hashtag chips
				if (tagChips) {
					tagChips.innerHTML = '';
					if (uniqueHashtags.length === 0) {
						tagChips.innerHTML = '<span style="font-size:0.8rem; color:var(--text-muted);">No hashtags detected</span>';
					} else {
						uniqueHashtags.forEach(tag => {
							const chip = document.createElement('span');
							chip.className = 'chip';
							chip.textContent = tag;
							tagChips.appendChild(chip);
						});
					}
				}

				// 2. Format caption with invisible spaces on blank lines
				const lines = text.split('\n');
				const formattedLines = lines.map(line => {
					if (line.trim() === '') {
						return INVISIBLE_SPACE;
					}
					return line;
				});

				if (formattedOutput) {
					formattedOutput.value = formattedLines.join('\n');
				}
			}

			// Listeners
			rawInput?.addEventListener('input', process);

			btnCopy?.addEventListener('click', () => {
				if (!formattedOutput || !formattedOutput.value) return;
				navigator.clipboard.writeText(formattedOutput.value).then(() => {
					const orig = btnCopy.textContent;
					btnCopy.textContent = 'Copied!';
					setTimeout(() => { btnCopy.textContent = orig; }, 2000);
				});
			});

			process();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initCaptionCleaner);
		} else {
			initCaptionCleaner();
		}
	</script>
</ToolLayout>
