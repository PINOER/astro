---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "UTM Builder & Tracking URL Generator",
	description: "Fast, 100% private online tool to create custom UTM tracking links for Google Analytics 4 (GA4) campaigns.",
	icon: "🔗",
	tag: "Marketing",
	keywords: "utm builder utm generator google analytics tracking link campaign url builder utm parameters",
	pinned: false,
	priority: 88
};

const faqList = [
	{
		question: "What is a UTM parameter and why is it important?",
		answer: "UTM (Urchin Tracking Module) parameters are tags added to the end of a URL. When someone clicks the link, these tags are sent to Google Analytics 4 (GA4) so you can track precisely which traffic source or ad campaign generated sales."
	},
	{
		question: "Are UTM codes case-sensitive?",
		answer: "Yes. UTM codes are case-sensitive. 'utm_source=Facebook' and 'utm_source=facebook' will appear as two separate sources in Google Analytics. It is best practice to always use lowercase letters."
	},
	{
		question: "Is my campaign data tracked or uploaded anywhere?",
		answer: "No. URL generation is performed 100% locally in your web browser. None of your website links or campaign tags leave your computer."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.preset-group {
			display: flex;
			gap: 0.5rem;
			margin-bottom: 1.5rem;
			flex-wrap: wrap;
			align-items: center;
		}
		.preset-label {
			font-size: 0.88rem;
			font-weight: 600;
			color: var(--text-main);
			margin-right: 0.5rem;
		}
		.preset-btn {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			color: var(--text-main);
			padding: 0.4em 0.8em;
			border-radius: 6px;
			font-size: 0.82rem;
			font-weight: 600;
			cursor: pointer;
			transition: all 0.2s;
		}
		.preset-btn:hover {
			background: var(--badge-bg);
			color: var(--accent);
			border-color: var(--accent);
		}
		.field-group {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
			margin-bottom: 1rem;
		}
		label {
			font-size: 0.88rem;
			font-weight: 600;
			color: var(--text-main);
		}
		label .req {
			color: #ef4444;
		}
		label .hint {
			font-size: 0.78rem;
			color: var(--text-muted);
			font-weight: normal;
			margin-left: 0.3rem;
		}
		input[type="text"] {
			width: 100%;
			padding: 0.7em 0.9em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.95rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		input[type="text"]:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		textarea {
			width: 100%;
			height: 90px;
			padding: 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			color: var(--text-main);
			font-size: 0.95rem;
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			box-sizing: border-box;
			outline: none;
			resize: vertical;
			line-height: 1.5;
		}
		.btn-group {
			display: flex;
			gap: 0.8rem;
			margin-top: 1.2rem;
		}
		.btn {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-weight: 600;
			cursor: pointer;
			transition: background 0.2s;
		}
		.btn:hover { background: var(--accent-hover); }
		.btn-secondary {
			background: var(--gray-light);
			border: 1px solid var(--card-border);
			color: var(--text-main);
		}
		.btn-secondary:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 工具主体表单卡片 -->
	<div class="tool-box">
		<div class="preset-group">
			<span class="preset-label">Quick Presets:</span>
			<button class="preset-btn" data-source="facebook" data-medium="cpc">Facebook Ads</button>
			<button class="preset-btn" data-source="google" data-medium="cpc">Google Ads</button>
			<button class="preset-btn" data-source="newsletter" data-medium="email">Newsletter</button>
			<button class="preset-btn" data-source="tiktok" data-medium="social">TikTok Profile</button>
			<button class="preset-btn" data-source="twitter" data-medium="social">Twitter/X</button>
		</div>

		<div class="field-group">
			<label for="targetUrl">Website URL <span class="req">*</span> <span class="hint">(e.g. https://example.com/product)</span></label>
			<input type="text" id="targetUrl" value="https://helpmini.com/" placeholder="https://example.com" />
		</div>

		<div class="field-group">
			<label for="utmSource">Campaign Source <span class="req">*</span> <span class="hint">(utm_source, e.g. google, newsletter, facebook)</span></label>
			<input type="text" id="utmSource" value="google" placeholder="e.g. google" />
		</div>

		<div class="field-group">
			<label for="utmMedium">Campaign Medium <span class="req">*</span> <span class="hint">(utm_medium, e.g. cpc, email, social, banner)</span></label>
			<input type="text" id="utmMedium" value="cpc" placeholder="e.g. cpc" />
		</div>

		<div class="field-group">
			<label for="utmCampaign">Campaign Name <span class="hint">(utm_campaign, e.g. summer_sale, promo_2026)</span></label>
			<input type="text" id="utmCampaign" value="summer_sale" placeholder="e.g. summer_sale" />
		</div>

		<div class="field-group">
			<label for="utmTerm">Campaign Term <span class="hint">(utm_term, e.g. running_shoes, keyword)</span></label>
			<input type="text" id="utmTerm" placeholder="e.g. running_shoes" />
		</div>

		<div class="field-group">
			<label for="utmContent">Campaign Content <span class="hint">(utm_content, e.g. logolink, sidebar_ad, video_cta)</span></label>
			<input type="text" id="utmContent" placeholder="e.g. banner_v1" />
		</div>

		<div class="field-group" style="margin-top: 1.5rem;">
			<label for="generatedUrl">Generated Tracking URL:</label>
			<textarea id="generatedUrl" readonly placeholder="Your generated campaign URL will appear here..."></textarea>
		</div>

		<div class="btn-group">
			<button class="btn btn-secondary" id="btnClear">Clear</button>
			<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy URL</button>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const targetUrlIn = document.getElementById('targetUrl') as HTMLInputElement;
		const utmSourceIn = document.getElementById('utmSource') as HTMLInputElement;
		const utmMediumIn = document.getElementById('utmMedium') as HTMLInputElement;
		const utmCampaignIn = document.getElementById('utmCampaign') as HTMLInputElement;
		const utmTermIn = document.getElementById('utmTerm') as HTMLInputElement;
		const utmContentIn = document.getElementById('utmContent') as HTMLInputElement;
		const generatedUrlOut = document.getElementById('generatedUrl') as HTMLTextAreaElement;
		const presetBtns = document.querySelectorAll('.preset-btn');

		function buildUtmUrl() {
			let rawUrl = targetUrlIn?.value.trim() || '';
			if (!rawUrl) {
				if (generatedUrlOut) generatedUrlOut.value = '';
				return;
			}

			if (!/^https?:\/\//i.test(rawUrl)) {
				rawUrl = 'https://' + rawUrl;
			}

			try {
				const urlObj = new URL(rawUrl);
				const source = utmSourceIn?.value.trim().toLowerCase() || '';
				const medium = utmMediumIn?.value.trim().toLowerCase() || '';
				const campaign = utmCampaignIn?.value.trim() || '';
				const term = utmTermIn?.value.trim() || '';
				const content = utmContentIn?.value.trim() || '';

				if (source) urlObj.searchParams.set('utm_source', source);
				if (medium) urlObj.searchParams.set('utm_medium', medium);
				if (campaign) urlObj.searchParams.set('utm_campaign', campaign);
				if (term) urlObj.searchParams.set('utm_term', term);
				if (content) urlObj.searchParams.set('utm_content', content);

				if (generatedUrlOut) generatedUrlOut.value = urlObj.toString();
			} catch (e) {
				if (generatedUrlOut) generatedUrlOut.value = 'Invalid URL format';
			}
		}

		[targetUrlIn, utmSourceIn, utmMediumIn, utmCampaignIn, utmTermIn, utmContentIn].forEach(input => {
			input?.addEventListener('input', buildUtmUrl);
		});

		presetBtns.forEach(btn => {
			btn.addEventListener('click', (e) => {
				const target = e.currentTarget as HTMLButtonElement;
				const src = target.getAttribute('data-source');
				const med = target.getAttribute('data-medium');
				if (src && utmSourceIn) utmSourceIn.value = src;
				if (med && utmMediumIn) utmMediumIn.value = med;
				buildUtmUrl();
			});
		});

		document.getElementById('btnClear')?.addEventListener('click', () => {
			if (targetUrlIn) targetUrlIn.value = '';
			if (utmSourceIn) utmSourceIn.value = '';
			if (utmMediumIn) utmMediumIn.value = '';
			if (utmCampaignIn) utmCampaignIn.value = '';
			if (utmTermIn) utmTermIn.value = '';
			if (utmContentIn) utmContentIn.value = '';
			if (generatedUrlOut) generatedUrlOut.value = '';
		});

		document.getElementById('btnCopy')?.addEventListener('click', (e) => {
			if (!generatedUrlOut || !generatedUrlOut.value) return;
			navigator.clipboard.writeText(generatedUrlOut.value);
			const btn = e.target as HTMLButtonElement;
			const originalText = btn.textContent;
			btn.textContent = 'Copied!';
			setTimeout(() => { btn.textContent = originalText; }, 2000);
		});

		buildUtmUrl();
	</script>
</ToolLayout>
