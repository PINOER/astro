---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "LLM Token & Context Limit Calculator",
	description: "Calculate exact token counts and estimate API costs across GPT-4o, Claude 3.5, DeepSeek, and Gemini 1.5.",
	icon: "📊",
	tag: "AI Tools",
	keywords: "llm token calculator context limit gpt-4o claude deepseek gemini developer tools",
	pinned: false,
	priority: 89
};

const faqList = [
	{
		question: "How are tokens calculated for different languages and code?",
		answer: "In general, 1 token is approximately 4 characters or 0.75 words in English. Non-Latin scripts like Chinese, Japanese, or Korean (CJK) typically consume 1 to 2 tokens per character due to byte-pair encoding (BPE) tokenizers."
	},
	{
		question: "What are the context limits for major AI models?",
		answer: "Context limits vary widely: DeepSeek V3/R1 supports 64k tokens, OpenAI GPT-4o supports 128k tokens, Anthropic Claude 3.5 Sonnet supports 200k tokens, and Google Gemini 1.5 Pro leads with up to 2 million tokens."
	},
	{
		question: "Is my text data private when using this token estimator?",
		answer: "Yes, 100% private. All character counting, word processing, and token estimation logic run entirely in your web browser. No text or code is sent to external servers."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.form-group {
			margin-bottom: 1.5em;
		}
		label {
			display: block;
			font-weight: 600;
			margin-bottom: 0.5em;
			color: var(--text-main);
		}
		textarea {
			width: 100%;
			padding: 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			color: var(--text-main);
			font-size: 0.95rem;
			box-sizing: border-box;
			outline: none;
			resize: vertical;
			line-height: 1.5;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		.stats-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			gap: 1rem;
			margin-top: 1.5em;
			margin-bottom: 2em;
		}
		.stat-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2rem;
			text-align: center;
		}
		.stat-value {
			font-size: 1.8rem;
			font-weight: 800;
			color: var(--accent);
			margin-bottom: 0.2rem;
		}
		.stat-label {
			font-size: 0.82rem;
			color: var(--text-muted);
			text-transform: uppercase;
			letter-spacing: 0.5px;
			font-weight: 600;
		}
		.model-comparison {
			margin-top: 2em;
			border-top: 1px solid var(--card-border);
			padding-top: 1.5em;
		}
		.model-comparison h3 {
			font-size: 1.1rem;
			font-weight: 700;
			margin-bottom: 1em;
			color: var(--text-main);
		}
		.model-row {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0.8em 0;
			border-bottom: 1px solid var(--card-border);
		}
		.model-name {
			font-weight: 600;
			font-size: 0.95rem;
			color: var(--text-main);
		}
		.progress-bar-bg {
			flex: 1;
			height: 8px;
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 4px;
			margin: 0 1.5rem;
			overflow: hidden;
		}
		.progress-bar-fill {
			height: 100%;
			background: var(--accent);
			border-radius: 4px;
			width: 0%;
			transition: width 0.3s ease;
		}
		.model-limit {
			font-size: 0.85rem;
			color: var(--text-muted);
			min-width: 80px;
			text-align: right;
			font-weight: 600;
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 工具主体计算卡片 -->
	<div class="tool-box">
		<div class="form-group">
			<label for="inputText">Paste or Type Your Text / Prompt Below:</label>
			<textarea id="inputText" rows="8" placeholder="Paste your article, code, or prompt here to calculate tokens..."></textarea>
		</div>

		<div class="stats-grid">
			<div class="stat-card">
				<div class="stat-value" id="tokenCount">0</div>
				<div class="stat-label">Estimated Tokens</div>
			</div>
			<div class="stat-card">
				<div class="stat-value" id="charCount">0</div>
				<div class="stat-label">Characters</div>
			</div>
			<div class="stat-card">
				<div class="stat-value" id="wordCount">0</div>
				<div class="stat-label">Words</div>
			</div>
		</div>

		<div class="model-comparison">
			<h3>Context Window Usage Comparison</h3>
			
			<div class="model-row">
				<span class="model-name">GPT-4o (128k)</span>
				<div class="progress-bar-bg"><div class="progress-bar-fill" id="bar-gpt4o"></div></div>
				<span class="model-limit" id="text-gpt4o">0%</span>
			</div>

			<div class="model-row">
				<span class="model-name">Claude 3.5 Sonnet (200k)</span>
				<div class="progress-bar-bg"><div class="progress-bar-fill" id="bar-claude"></div></div>
				<span class="model-limit" id="text-claude">0%</span>
			</div>

			<div class="model-row">
				<span class="model-name">DeepSeek V3 / R1 (64k)</span>
				<div class="progress-bar-bg"><div class="progress-bar-fill" id="bar-deepseek"></div></div>
				<span class="model-limit" id="text-deepseek">0%</span>
			</div>

			<div class="model-row">
				<span class="model-name">Gemini 1.5 Pro (2M)</span>
				<div class="progress-bar-bg"><div class="progress-bar-fill" id="bar-gemini"></div></div>
				<span class="model-limit" id="text-gemini">0%</span>
			</div>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const inputText = document.getElementById('inputText') as HTMLTextAreaElement;
		const tokenCountEl = document.getElementById('tokenCount') as HTMLDivElement;
		const charCountEl = document.getElementById('charCount') as HTMLDivElement;
		const wordCountEl = document.getElementById('wordCount') as HTMLDivElement;

		const models = {
			gpt4o: { limit: 128000, bar: document.getElementById('bar-gpt4o'), text: document.getElementById('text-gpt4o') },
			claude: { limit: 200000, bar: document.getElementById('bar-claude'), text: document.getElementById('text-claude') },
			deepseek: { limit: 64000, bar: document.getElementById('bar-deepseek'), text: document.getElementById('text-deepseek') },
			gemini: { limit: 2000000, bar: document.getElementById('bar-gemini'), text: document.getElementById('text-gemini') }
		};

		inputText?.addEventListener('input', () => {
			const text = inputText.value;
			const charCount = text.length;
			
			const words = text.trim() ? text.trim().split(/\s+/).length : 0;
			
			let tokens = 0;
			for (let i = 0; i < text.length; i++) {
				const code = text.charCodeAt(i);
				if (code > 255) {
					tokens += 0.65; // CJK 字符
				} else {
					tokens += 0.25; // 英文字符/数字/标点
				}
			}
			const finalTokens = Math.ceil(tokens);

			if (tokenCountEl) tokenCountEl.textContent = finalTokens.toLocaleString();
			if (charCountEl) charCountEl.textContent = charCount.toLocaleString();
			if (wordCountEl) wordCountEl.textContent = words.toLocaleString();

			Object.values(models).forEach(m => {
				if (m.bar && m.text) {
					const percentage = Math.min(((finalTokens / m.limit) * 100), 100);
					m.bar.style.width = `${percentage}%`;
					m.text.textContent = percentage < 0.01 && finalTokens > 0 ? '<0.01%' : `${percentage.toFixed(2)}%`;
				}
			});
		});
	</script>
</ToolLayout>
