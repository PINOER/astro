---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "E-commerce Profit Margin & Markup Calculator",
	description: "Calculate your true net profit, margin %, markup %, and breakeven sale price for Shopify, Amazon, Etsy, and WooCommerce stores.",
	icon: "🧮",
	tag: "E-commerce",
	keywords: "ecommerce profit calculator margin vs markup breakeven price calculator shopify profit margin etsy fee calculator"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.calc-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
			}
			.section-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1rem;
			}
			.field-group {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				margin-bottom: 1rem;
			}
			label {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--text-main);
			}
			input[type="number"] {
				width: 100%;
				padding: 0.7em 0.9em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 0.95rem;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			input[type="number"]:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			.field-divider {
				border: none;
				border-top: 1px solid var(--card-border);
				margin: 1.2rem 0;
			}
			.field-group.highlight input {
				border-color: var(--accent);
				font-weight: 700;
				font-size: 1.05rem;
			}
			.metrics-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
				margin-bottom: 1.2rem;
			}
			.metric-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				padding: 1rem;
				border-radius: 10px;
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}
			.metric-card.primary {
				border-color: var(--accent);
				background: var(--badge-bg);
			}
			.metric-label {
				font-size: 0.78rem;
				color: var(--text-muted);
				font-weight: 600;
			}
			.metric-value {
				font-size: 1.4rem;
				font-weight: 800;
				color: var(--accent);
			}
			.breakdown-list {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				background: var(--code-bg);
				padding: 1rem;
				border-radius: 10px;
				border: 1px solid var(--card-border);
			}
			.breakdown-item {
				display: flex;
				justify-content: space-between;
				font-size: 0.88rem;
				color: var(--text-muted);
			}
			.breakdown-item strong {
				color: var(--text-main);
			}

			/* FAQ & Related Tools Section */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.calc-grid, .metrics-grid, .related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🧮 {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="calc-grid">
					<!-- Input Column -->
					<div class="input-section">
						<div class="section-title">Input Costs & Price</div>
						
						<div class="field-group">
							<label for="cogs">Item Cost / COGS ($)</label>
							<input type="number" id="cogs" value="15.00" step="0.01" min="0" placeholder="Manufacturing/purchase cost" />
						</div>

						<div class="field-group">
							<label for="shipping">Shipping & Fulfilment ($)</label>
							<input type="number" id="shipping" value="5.00" step="0.01" min="0" placeholder="Packaging & shipping fee per item" />
						</div>

						<div class="field-group">
							<label for="adSpend">Marketing / Ad Cost ($)</label>
							<input type="number" id="adSpend" value="8.00" step="0.01" min="0" placeholder="Average CPA / CAC per unit" />
						</div>

						<div class="field-group">
							<label for="feeRate">Platform Fee (%)</label>
							<input type="number" id="feeRate" value="2.9" step="0.1" min="0" placeholder="e.g. Shopify/Stripe 2.9%" />
						</div>

						<div class="field-group">
							<label for="flatFee">Fixed Fee per Order ($)</label>
							<input type="number" id="flatFee" value="0.30" step="0.01" min="0" placeholder="e.g. $0.30 per transaction" />
						</div>

						<hr class="field-divider" />

						<div class="field-group highlight">
							<label for="sellingPrice">Selling Price ($)</label>
							<input type="number" id="sellingPrice" value="45.00" step="0.01" min="0" placeholder="Target retail sale price" />
						</div>
					</div>

					<!-- Output Column -->
					<div class="output-section">
						<div class="section-title">Profitability Summary</div>

						<div class="metrics-grid">
							<div class="metric-card primary">
								<span class="metric-label">Net Profit per Unit</span>
								<span class="metric-value" id="netProfitVal">$0.00</span>
							</div>

							<div class="metric-card">
								<span class="metric-label">Net Profit Margin</span>
								<span class="metric-value" id="marginVal">0.00%</span>
							</div>

							<div class="metric-card">
								<span class="metric-label">Markup Percentage</span>
								<span class="metric-value" id="markupVal">0.00%</span>
							</div>

							<div class="metric-card">
								<span class="metric-label">Breakeven Price</span>
								<span class="metric-value" id="breakevenVal">$0.00</span>
							</div>
						</div>

						<div class="breakdown-list">
							<div class="breakdown-item">
								<span>Total Cost per Unit</span>
								<strong id="totalCostVal">$0.00</strong>
							</div>
							<div class="breakdown-item">
								<span>Total Gateway Fees</span>
								<strong id="totalFeesVal">$0.00</strong>
							</div>
							<div class="breakdown-item">
								<span>ROI</span>
								<strong id="roiVal">0.00%</strong>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- FAQ Section -->
			<section class="content-section">
				<h2>Frequently Asked Questions (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>What is the difference between Profit Margin and Markup?</h3>
						<p>Profit Margin measures how much net profit you keep from your <strong>total revenue</strong> (Profit / Revenue). Markup measures how much you increased the price relative to your <strong>cost of goods</strong> (Profit / Total Cost).</p>
					</div>
					<div class="faq-item">
						<h3>How do I calculate the Breakeven Price for my product?</h3>
						<p>The breakeven price covers all COGS, shipping, ad costs, and processing percentage fees so your net profit is exactly $0. It ensures you don't lose money on promotion campaigns.</p>
					</div>
					<div class="faq-item">
						<h3>What is a good net profit margin for e-commerce stores?</h3>
						<p>For Shopify and Amazon sellers, a healthy net profit margin ranges between <strong>15% to 30%</strong> after factoring in marketing CPA and processing fees.</p>
					</div>
				</div>
			</section>

			<!-- Related Tools Section -->
			<section class="content-section">
				<h2>You Might Also Like</h2>
				<div class="related-grid">
					<a href="/tools/stripe-paypal-fee-calculator/" class="related-card">
						<span class="card-icon">💳</span>
						<div>
							<h4>Stripe & PayPal Fee Calculator</h4>
							<p>Calculate exact payment gateway processing fees and payout amounts.</p>
						</div>
					</a>
					<a href="/tools/image-to-webp-converter/" class="related-card">
						<span class="card-icon">🖼️</span>
						<div>
							<h4>Image to WebP Converter</h4>
							<p>Compress product photos client-side to speed up store load times.</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "What is the difference between Profit Margin and Markup?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Profit Margin measures how much net profit you keep from your total revenue. Markup measures how much you increased the price relative to your cost of goods."
						}
					},
					{
						"@type": "Question",
						"name": "How do I calculate the Breakeven Price for my product?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "The breakeven price covers all COGS, shipping, ad costs, and processing percentage fees so your net profit is exactly $0."
						}
					}
				]
			}
		</script>

		<script>
			const cogsIn = document.getElementById('cogs') as HTMLInputElement;
			const shippingIn = document.getElementById('shipping') as HTMLInputElement;
			const adSpendIn = document.getElementById('adSpend') as HTMLInputElement;
			const feeRateIn = document.getElementById('feeRate') as HTMLInputElement;
			const flatFeeIn = document.getElementById('flatFee') as HTMLInputElement;
			const sellingPriceIn = document.getElementById('sellingPrice') as HTMLInputElement;

			const netProfitVal = document.getElementById('netProfitVal');
			const marginVal = document.getElementById('marginVal');
			const markupVal = document.getElementById('markupVal');
			const breakevenVal = document.getElementById('breakevenVal');
			const totalCostVal = document.getElementById('totalCostVal');
			const totalFeesVal = document.getElementById('totalFeesVal');
			const roiVal = document.getElementById('roiVal');

			function calculateProfit() {
				const cogs = parseFloat(cogsIn.value) || 0;
				const shipping = parseFloat(shippingIn.value) || 0;
				const adSpend = parseFloat(adSpendIn.value) || 0;
				const feeRate = (parseFloat(feeRateIn.value) || 0) / 100;
				const flatFee = parseFloat(flatFeeIn.value) || 0;
				const price = parseFloat(sellingPriceIn.value) || 0;

				const baseCost = cogs + shipping + adSpend;
				const platformFee = (price * feeRate) + flatFee;
				const totalCost = baseCost + platformFee;
				const netProfit = price - totalCost;

				const margin = price > 0 ? (netProfit / price) * 100 : 0;
				const markup = baseCost > 0 ? (netProfit / baseCost) * 100 : 0;
				const roi = baseCost > 0 ? (netProfit / baseCost) * 100 : 0;

				const breakeven = (1 - feeRate) > 0 ? (baseCost + flatFee) / (1 - feeRate) : 0;

				if (netProfitVal) netProfitVal.textContent = `$${netProfit.toFixed(2)}`;
				if (marginVal) marginVal.textContent = `${margin.toFixed(2)}%`;
				if (markupVal) markupVal.textContent = `${markup.toFixed(2)}%`;
				if (breakevenVal) breakevenVal.textContent = `$${breakeven.toFixed(2)}`;
				if (totalCostVal) totalCostVal.textContent = `$${totalCost.toFixed(2)}`;
				if (totalFeesVal) totalFeesVal.textContent = `$${platformFee.toFixed(2)}`;
				if (roiVal) roiVal.textContent = `${roi.toFixed(2)}%`;

				if (netProfitVal) {
					netProfitVal.style.color = netProfit < 0 ? '#ef4444' : 'var(--accent, #6366f1)';
				}
			}

			[cogsIn, shippingIn, adSpendIn, feeRateIn, flatFeeIn, sellingPriceIn].forEach(input => {
				input?.addEventListener('input', calculateProfit);
			});

			calculateProfit();
		</script>
	</body>
</html>
