---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "E-commerce Profit Margin & Markup Calculator",
	description: "Calculate your true net profit, margin %, markup %, and breakeven sale price for Shopify, Amazon, Etsy, and WooCommerce stores.",
	icon: "🧮",
	tag: "E-commerce",
	keywords: "ecommerce profit calculator margin vs markup breakeven price calculator shopify profit margin etsy fee calculator",
	pinned: false,
	priority: 90
};

const faqList = [
	{
		question: "What is the difference between Profit Margin and Markup?",
		answer: "Profit Margin measures how much net profit you keep from your total revenue (Profit / Revenue). Markup measures how much you increased the price relative to your cost of goods (Profit / Total Cost)."
	},
	{
		question: "How do I calculate the Breakeven Price for my product?",
		answer: "The breakeven price covers all COGS, shipping, ad costs, and processing percentage fees so your net profit is exactly $0. It ensures you don't lose money on promotion campaigns."
	},
	{
		question: "What is a good net profit margin for e-commerce stores?",
		answer: "For Shopify and Amazon sellers, a healthy net profit margin ranges between 15% to 30% after factoring in marketing CPA and processing fees."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.calc-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.section-title {
			font-size: 1.15rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1rem;
		}
		.field-group {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
			margin-bottom: 1rem;
		}
		label {
			font-size: 0.88rem;
			font-weight: 600;
			color: var(--text-main);
		}
		input[type="number"] {
			width: 100%;
			padding: 0.7em 0.9em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.95rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		input[type="number"]:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		.field-divider {
			border: none;
			border-top: 1px solid var(--card-border);
			margin: 1.2rem 0;
		}
		.field-group.highlight input {
			border-color: var(--accent);
			font-weight: 700;
			font-size: 1.05rem;
		}
		.metrics-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.8rem;
			margin-bottom: 1.2rem;
		}
		.metric-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			padding: 1rem;
			border-radius: 10px;
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
		}
		.metric-card.primary {
			border-color: var(--accent);
			background: var(--badge-bg);
		}
		.metric-label {
			font-size: 0.78rem;
			color: var(--text-muted);
			font-weight: 600;
		}
		.metric-value {
			font-size: 1.4rem;
			font-weight: 800;
			color: var(--accent);
		}
		.breakdown-list {
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
			background: var(--code-bg);
			padding: 1rem;
			border-radius: 10px;
			border: 1px solid var(--card-border);
		}
		.breakdown-item {
			display: flex;
			justify-content: space-between;
			font-size: 0.88rem;
			color: var(--text-muted);
		}
		.breakdown-item strong {
			color: var(--text-main);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			.calc-grid, .metrics-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<!-- 计算器主体表单卡片 -->
	<div class="tool-box">
		<div class="calc-grid">
			<!-- Input Column -->
			<div class="input-section">
				<div class="section-title">Input Costs & Price</div>
				
				<div class="field-group">
					<label for="cogs">Item Cost / COGS ($)</label>
					<input type="number" id="cogs" value="15.00" step="0.01" min="0" placeholder="Manufacturing/purchase cost" />
				</div>

				<div class="field-group">
					<label for="shipping">Shipping & Fulfilment ($)</label>
					<input type="number" id="shipping" value="5.00" step="0.01" min="0" placeholder="Packaging & shipping fee per item" />
				</div>

				<div class="field-group">
					<label for="adSpend">Marketing / Ad Cost ($)</label>
					<input type="number" id="adSpend" value="8.00" step="0.01" min="0" placeholder="Average CPA / CAC per unit" />
				</div>

				<div class="field-group">
					<label for="feeRate">Platform Fee (%)</label>
					<input type="number" id="feeRate" value="2.9" step="0.1" min="0" placeholder="e.g. Shopify/Stripe 2.9%" />
				</div>

				<div class="field-group">
					<label for="flatFee">Fixed Fee per Order ($)</label>
					<input type="number" id="flatFee" value="0.30" step="0.01" min="0" placeholder="e.g. $0.30 per transaction" />
				</div>

				<hr class="field-divider" />

				<div class="field-group highlight">
					<label for="sellingPrice">Selling Price ($)</label>
					<input type="number" id="sellingPrice" value="45.00" step="0.01" min="0" placeholder="Target retail sale price" />
				</div>
			</div>

			<!-- Output Column -->
			<div class="output-section">
				<div class="section-title">Profitability Summary</div>

				<div class="metrics-grid">
					<div class="metric-card primary">
						<span class="metric-label">Net Profit per Unit</span>
						<span class="metric-value" id="netProfitVal">$0.00</span>
					</div>

					<div class="metric-card">
						<span class="metric-label">Net Profit Margin</span>
						<span class="metric-value" id="marginVal">0.00%</span>
					</div>

					<div class="metric-card">
						<span class="metric-label">Markup Percentage</span>
						<span class="metric-value" id="markupVal">0.00%</span>
					</div>

					<div class="metric-card">
						<span class="metric-label">Breakeven Price</span>
						<span class="metric-value" id="breakevenVal">$0.00</span>
					</div>
				</div>

				<div class="breakdown-list">
					<div class="breakdown-item">
						<span>Total Cost per Unit</span>
						<strong id="totalCostVal">$0.00</strong>
					</div>
					<div class="breakdown-item">
						<span>Total Gateway Fees</span>
						<strong id="totalFeesVal">$0.00</strong>
					</div>
					<div class="breakdown-item">
						<span>ROI</span>
						<strong id="roiVal">0.00%</strong>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端逻辑脚本 (挂载至 scripts 插槽，添加 DOMContentLoaded 机制) -->
	<script slot="scripts">
		function initTool() {
			const cogsIn = document.getElementById('cogs');
			const shippingIn = document.getElementById('shipping');
			const adSpendIn = document.getElementById('adSpend');
			const feeRateIn = document.getElementById('feeRate');
			const flatFeeIn = document.getElementById('flatFee');
			const sellingPriceIn = document.getElementById('sellingPrice');

			const netProfitVal = document.getElementById('netProfitVal');
			const marginVal = document.getElementById('marginVal');
			const markupVal = document.getElementById('markupVal');
			const breakevenVal = document.getElementById('breakevenVal');
			const totalCostVal = document.getElementById('totalCostVal');
			const totalFeesVal = document.getElementById('totalFeesVal');
			const roiVal = document.getElementById('roiVal');

			function calculateProfit() {
				const cogs = parseFloat(cogsIn?.value) || 0;
				const shipping = parseFloat(shippingIn?.value) || 0;
				const adSpend = parseFloat(adSpendIn?.value) || 0;
				const feeRate = (parseFloat(feeRateIn?.value) || 0) / 100;
				const flatFee = parseFloat(flatFeeIn?.value) || 0;
				const price = parseFloat(sellingPriceIn?.value) || 0;

				const baseCost = cogs + shipping + adSpend;
				const platformFee = (price * feeRate) + flatFee;
				const totalCost = baseCost + platformFee;
				const netProfit = price - totalCost;

				const margin = price > 0 ? (netProfit / price) * 100 : 0;
				const markup = baseCost > 0 ? (netProfit / baseCost) * 100 : 0;
				const roi = baseCost > 0 ? (netProfit / baseCost) * 100 : 0;

				const breakeven = (1 - feeRate) > 0 ? (baseCost + flatFee) / (1 - feeRate) : 0;

				if (netProfitVal) netProfitVal.textContent = `$${netProfit.toFixed(2)}`;
				if (marginVal) marginVal.textContent = `${margin.toFixed(2)}%`;
				if (markupVal) markupVal.textContent = `${markup.toFixed(2)}%`;
				if (breakevenVal) breakevenVal.textContent = `$${breakeven.toFixed(2)}`;
				if (totalCostVal) totalCostVal.textContent = `$${totalCost.toFixed(2)}`;
				if (totalFeesVal) totalFeesVal.textContent = `$${platformFee.toFixed(2)}`;
				if (roiVal) roiVal.textContent = `${roi.toFixed(2)}%`;

				if (netProfitVal) {
					netProfitVal.style.color = netProfit < 0 ? '#ef4444' : 'var(--accent, #6366f1)';
				}
			}

			[cogsIn, shippingIn, adSpendIn, feeRateIn, flatFeeIn, sellingPriceIn].forEach(input => {
				input?.addEventListener('input', calculateProfit);
			});

			calculateProfit();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initTool);
		} else {
			initTool();
		}
	</script>
</ToolLayout>
