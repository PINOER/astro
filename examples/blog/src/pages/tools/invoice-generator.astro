---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Free Freelance PDF Invoice Generator",
	description: "Create professional PDF invoices instantly in your browser. 100% client-side privacy, custom logos, tax calculations, and instant PDF download.",
	icon: "🧾",
	tag: "Finance",
	keywords: "invoice generator pdf invoice maker freelance invoicing GDPR compliant invoice client-side invoice creator",
	pinned: false,
	priority: 90
};

const faqList = [
	{
		question: "Is my client and banking information safe on this tool?",
		answer: "Yes, 100%. This tool operates entirely on client-side browser technology. Your financial figures, bank accounts, and client details are processed strictly on your local machine and never transmitted to any remote server, making it fully GDPR compliant."
	},
	{
		question: "How do I save the generated invoice as a PDF file?",
		answer: "Simply fill out the invoice fields and click 'Export to PDF / Print' at the bottom. Your browser's print preview window will pop up—choose 'Save as PDF' under the printer destinations to download your crisp PDF invoice."
	},
	{
		question: "Can I add my own business logo to the invoice?",
		answer: "Absolutely. Click on the designated Logo box at the top left to upload your personal or company image logo, which will automatically format inside the header."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.invoice-paper {
			background: #ffffff;
			color: #1e293b;
			border-radius: 8px;
			padding: 2.5em;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
			font-family: system-ui, -apple-system, sans-serif;
		}

		.invoice-header {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			gap: 1.5rem;
			border-bottom: 2px solid #e2e8f0;
			padding-bottom: 1.5em;
			margin-bottom: 1.5em;
		}

		.logo-upload {
			width: 140px;
			height: 70px;
			border: 2px dashed #cbd5e1;
			border-radius: 6px;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			background: #f8fafc;
			overflow: hidden;
			position: relative;
		}
		.logo-upload img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}
		.logo-upload span {
			font-size: 0.75rem;
			color: #64748b;
		}

		.invoice-title {
			text-align: right;
		}
		.invoice-title h2 {
			font-size: 2rem;
			font-weight: 900;
			color: #0f172a;
			margin: 0;
			letter-spacing: 1px;
		}
		.invoice-title input {
			text-align: right;
			font-size: 0.9rem;
			border: none;
			border-bottom: 1px solid #cbd5e1;
			outline: none;
			padding: 0.2em;
			margin-top: 0.3em;
		}

		.address-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 1.5rem;
			margin-bottom: 2em;
		}
		.address-block h4 {
			margin: 0 0 0.5rem 0;
			font-size: 0.85rem;
			color: #64748b;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}
		.address-block textarea, .address-block input {
			width: 100%;
			border: 1px solid #e2e8f0;
			border-radius: 6px;
			padding: 0.5em;
			font-size: 0.9rem;
			outline: none;
			box-sizing: border-box;
			background: #f8fafc;
			color: #1e293b;
		}
		.address-block textarea {
			height: 80px;
			resize: vertical;
		}

		.items-table {
			width: 100%;
			border-collapse: collapse;
			margin-bottom: 1.5em;
		}
		.items-table th {
			background: #f1f5f9;
			color: #475569;
			text-align: left;
			padding: 0.75em 0.5em;
			font-size: 0.85rem;
			font-weight: 700;
		}
		.items-table td {
			padding: 0.6em 0.5em;
			border-bottom: 1px solid #e2e8f0;
		}
		.items-table input {
			width: 100%;
			border: 1px solid #e2e8f0;
			border-radius: 4px;
			padding: 0.4em;
			font-size: 0.88rem;
			outline: none;
			box-sizing: border-box;
		}
		.btn-del-item {
			background: #fee2e2;
			color: #ef4444;
			border: none;
			padding: 0.3em 0.6em;
			border-radius: 4px;
			cursor: pointer;
			font-weight: 700;
		}

		.summary-section {
			display: flex;
			justify-content: space-between;
			gap: 2rem;
			flex-wrap: wrap;
		}
		.notes-block {
			flex: 1;
			min-width: 250px;
		}
		.notes-block textarea {
			width: 100%;
			height: 100px;
			border: 1px solid #e2e8f0;
			border-radius: 6px;
			padding: 0.5em;
			font-size: 0.85rem;
			background: #f8fafc;
			box-sizing: border-box;
		}

		.totals-block {
			width: 280px;
		}
		.total-row {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0.4em 0;
			font-size: 0.9rem;
		}
		.total-row.due {
			font-size: 1.15rem;
			font-weight: 800;
			border-top: 2px solid #0f172a;
			margin-top: 0.5em;
			padding-top: 0.6em;
			color: #0f172a;
		}
		.totals-block input {
			width: 70px;
			text-align: right;
			border: 1px solid #cbd5e1;
			border-radius: 4px;
			padding: 0.2em;
		}

		.action-bar {
			display: flex;
			gap: 1rem;
			justify-content: space-between;
			align-items: center;
			margin-top: 1.5em;
		}
		.btn {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.7em 1.4em;
			border-radius: 8px;
			font-weight: 700;
			cursor: pointer;
			transition: background 0.2s;
		}
		.btn:hover { background: var(--accent-hover); }
		.btn-secondary {
			background: var(--gray-light);
			border: 1px solid var(--card-border);
			color: var(--text-main);
		}

		@media print {
			body * {
				visibility: hidden;
			}
			.invoice-paper, .invoice-paper * {
				visibility: visible;
			}
			.invoice-paper {
				position: absolute;
				left: 0;
				top: 0;
				width: 100%;
				box-shadow: none;
				padding: 0;
			}
			.btn-del-item, #btnAddItem, .action-bar, Header, Footer, .faq-section, .tool-header {
				display: none !important;
			}
			.invoice-paper input, .invoice-paper textarea {
				border: none !important;
				background: transparent !important;
			}
		}

		/* FAQ Panel Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 工具主体计算卡片 -->
	<div class="tool-box">
		<div class="invoice-paper" id="invoicePaper">
			<div class="invoice-header">
				<div class="logo-upload" id="logoBox">
					<span id="logoText">Upload Logo</span>
					<img id="logoImg" style="display:none;" alt="Company Logo" />
					<input type="file" id="logoInput" accept="image/*" style="display:none;" />
				</div>

				<div class="invoice-title">
					<h2>INVOICE</h2>
					<div>Invoice #: <input type="text" id="invNumber" value="INV-2026-001" /></div>
					<div>Invoice Date: <input type="date" id="invDate" /></div>
					<div>Due Date: <input type="date" id="dueDate" /></div>
				</div>
			</div>

			<div class="address-grid">
				<div class="address-block">
					<h4>From:</h4>
					<textarea id="fromInfo" placeholder="Your Name / Business&#10;Address & Phone&#10;Tax ID / VAT Number"></textarea>
				</div>
				<div class="address-block">
					<h4>Bill To:</h4>
					<textarea id="toInfo" placeholder="Client Name / Business&#10;Client Billing Address&#10;Client Email"></textarea>
				</div>
			</div>

			<table class="items-table">
				<thead>
					<tr>
						<th style="width: 45%;">Description</th>
						<th style="width: 15%;">Qty</th>
						<th style="width: 20%;">Rate ($)</th>
						<th style="width: 15%;">Amount ($)</th>
						<th style="width: 5%;"></th>
					</tr>
				</thead>
				<tbody id="itemsBody">
					<tr>
						<td><input type="text" class="item-desc" value="Web UI/UX Design & Development Services" /></td>
						<td><input type="number" class="item-qty" value="1" min="1" /></td>
						<td><input type="number" class="item-rate" value="800.00" min="0" step="0.01" /></td>
						<td class="item-total" style="font-weight:600; text-align:right;">$800.00</td>
						<td><button class="btn-del-item">×</button></td>
					</tr>
				</tbody>
			</table>

			<button class="btn-secondary" id="btnAddItem" style="font-size:0.85rem; padding:0.4em 0.8em; margin-bottom:1.5em;">+ Add Item</button>

			<div class="summary-section">
				<div class="notes-block">
					<h4 style="margin:0 0 0.4rem 0; font-size:0.85rem; color:#64748b;">Payment Method & Terms:</h4>
					<textarea id="notesInput" placeholder="Enter bank details (IBAN/SWIFT), PayPal email, or payment terms..."></textarea>
				</div>

				<div class="totals-block">
					<div class="total-row">
						<span>Subtotal:</span>
						<span id="subTotalDisplay" style="font-weight:600;">$800.00</span>
					</div>
					<div class="total-row">
						<span>Discount (%):</span>
						<input type="number" id="discountInput" value="0" min="0" max="100" />
					</div>
					<div class="total-row">
						<span>Tax / VAT (%):</span>
						<input type="number" id="taxInput" value="0" min="0" />
					</div>
					<div class="total-row due">
						<span>Total Due:</span>
						<span id="grandTotalDisplay">$800.00</span>
					</div>
				</div>
			</div>
		</div>

		<div class="action-bar">
			<button class="btn btn-secondary" id="btnReset">Reset Form</button>
			<button class="btn" id="btnPrintPdf">📄 Export to PDF / Print</button>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const logoBox = document.getElementById('logoBox');
		const logoInput = document.getElementById('logoInput') as HTMLInputElement;
		const logoImg = document.getElementById('logoImg') as HTMLImageElement;
		const logoText = document.getElementById('logoText');

		const itemsBody = document.getElementById('itemsBody');
		const btnAddItem = document.getElementById('btnAddItem');
		const btnPrintPdf = document.getElementById('btnPrintPdf');
		const btnReset = document.getElementById('btnReset');

		const subTotalDisplay = document.getElementById('subTotalDisplay');
		const grandTotalDisplay = document.getElementById('grandTotalDisplay');
		const discountInput = document.getElementById('discountInput') as HTMLInputElement;
		const taxInput = document.getElementById('taxInput') as HTMLInputElement;

		const today = new Date().toISOString().split('T')[0];
		(document.getElementById('invDate') as HTMLInputElement).value = today;

		logoBox?.addEventListener('click', () => logoInput?.click());
		logoInput?.addEventListener('change', () => {
			if (logoInput.files?.length) {
				const file = logoInput.files[0];
				const reader = new FileReader();
				reader.onload = (e) => {
					if (logoImg && logoText) {
						logoImg.src = e.target?.result as string;
						logoImg.style.display = 'block';
						logoText.style.display = 'none';
					}
				};
				reader.readAsDataURL(file);
			}
		});

		btnAddItem?.addEventListener('click', () => {
			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td><input type="text" class="item-desc" placeholder="Item description..." /></td>
				<td><input type="number" class="item-qty" value="1" min="1" /></td>
				<td><input type="number" class="item-rate" value="0.00" min="0" step="0.01" /></td>
				<td class="item-total" style="font-weight:600; text-align:right;">$0.00</td>
				<td><button class="btn-del-item">×</button></td>
			`;
			itemsBody?.appendChild(tr);
			bindTableEvents();
			calculateTotals();
		});

		function bindTableEvents() {
			const qtyInputs = document.querySelectorAll('.item-qty');
			const rateInputs = document.querySelectorAll('.item-rate');
			const delBtns = document.querySelectorAll('.btn-del-item');

			qtyInputs.forEach(input => input.addEventListener('input', calculateTotals));
			rateInputs.forEach(input => input.addEventListener('input', calculateTotals));

			delBtns.forEach(btn => {
				btn.onclick = (e) => {
					const tr = (e.target as HTMLElement).closest('tr');
					tr?.remove();
					calculateTotals();
				};
			});
		}

		discountInput?.addEventListener('input', calculateTotals);
		taxInput?.addEventListener('input', calculateTotals);

		function calculateTotals() {
			let subtotal = 0;
			const rows = itemsBody?.querySelectorAll('tr');

			rows?.forEach(row => {
				const qty = parseFloat((row.querySelector('.item-qty') as HTMLInputElement)?.value || '0');
				const rate = parseFloat((row.querySelector('.item-rate') as HTMLInputElement)?.value || '0');
				const itemTotal = qty * rate;

				const totalTd = row.querySelector('.item-total');
				if (totalTd) totalTd.textContent = `$${itemTotal.toFixed(2)}`;

				subtotal += itemTotal;
			});

			const discount = parseFloat(discountInput?.value || '0') / 100;
			const tax = parseFloat(taxInput?.value || '0') / 100;

			const afterDiscount = subtotal * (1 - discount);
			const grandTotal = afterDiscount * (1 + tax);

			if (subTotalDisplay) subTotalDisplay.textContent = `$${subtotal.toFixed(2)}`;
			if (grandTotalDisplay) grandTotalDisplay.textContent = `$${grandTotal.toFixed(2)}`;
		}

		btnPrintPdf?.addEventListener('click', () => {
			window.print();
		});

		btnReset?.addEventListener('click', () => {
			if (confirm('Are you sure you want to reset the invoice form?')) {
				location.reload();
			}
		});

		bindTableEvents();
		calculateTotals();
	</script>
</ToolLayout>
