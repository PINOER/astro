---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "JSON Formatter, Validator & Beautifier",
	description: "Free, 100% private online tool to format, validate, beautify, and minify your JSON data in real-time.",
	icon: "🛠️",
	tag: "Developer",
	keywords: "json formatter json validator json beautifier json minifier online json editor",
	pinned: false,
	priority: 87
};

const faqList = [
	{
		question: "Is my JSON data uploaded to any server?",
		answer: "No. Processing is 100% client-side inside your web browser. Your confidential JSON payloads, API tokens, or data structures never leave your computer."
	},
	{
		question: "What are the most common JSON syntax errors?",
		answer: "Common errors include trailing commas at the end of objects/arrays, single quotes instead of double quotes around keys or strings, and unescaped special characters."
	},
	{
		question: "What is the difference between Beautify and Minify?",
		answer: "Beautify adds indents and line breaks for better human readability. Minify strips out unnecessary whitespace to reduce file size for network transfer."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.status-bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.6em 1em;
			border-radius: 8px;
			font-size: 0.88rem;
			font-weight: 600;
			margin-bottom: 1em;
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			color: var(--text-muted);
		}
		.status-bar.success {
			border-color: #10b981;
			color: #10b981;
			background: rgba(16, 185, 129, 0.08);
		}
		.status-bar.error {
			border-color: #ef4444;
			color: #ef4444;
			background: rgba(239, 68, 68, 0.08);
		}
		.editor-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1.2rem;
		}
		.editor-container {
			display: flex;
			flex-direction: column;
			gap: 0.5em;
		}
		label {
			font-weight: 600;
			color: var(--text-main);
			font-size: 0.9rem;
		}
		textarea {
			width: 100%;
			height: 380px;
			padding: 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			color: var(--text-main);
			font-size: 0.9rem;
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
			box-sizing: border-box;
			outline: none;
			resize: vertical;
			line-height: 1.5;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		.btn-group {
			display: flex;
			gap: 0.8rem;
			margin: 1.2rem 0 0;
			flex-wrap: wrap;
		}
		.btn {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-weight: 600;
			cursor: pointer;
			transition: background 0.2s;
		}
		.btn:hover { background: var(--accent-hover); }
		.btn-secondary {
			background: var(--gray-light);
			border: 1px solid var(--card-border);
			color: var(--text-main);
		}
		.btn-secondary:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			.editor-grid {
				grid-template-columns: 1fr;
			}
			textarea {
				height: 240px;
			}
		}
	</style>

	<!-- 工具主体计算卡片 -->
	<div class="tool-box">
		<div class="status-bar" id="statusBar">
			<span>Status: Ready to process JSON</span>
			<span id="charCount">0 chars</span>
		</div>

		<div class="editor-grid">
			<div class="editor-container">
				<label for="jsonInput">Input Raw JSON:</label>
				<textarea id="jsonInput" placeholder="Paste or type raw JSON here..."></textarea>
			</div>
			<div class="editor-container">
				<label for="jsonOutput">Formatted / Minified Output:</label>
				<textarea id="jsonOutput" readonly placeholder="Output will appear here..."></textarea>
			</div>
		</div>

		<div class="btn-group">
			<button class="btn" id="btnBeautify">Format (Beautify 2 Spaces)</button>
			<button class="btn" id="btnMinify">Minify (Compact)</button>
			<button class="btn btn-secondary" id="btnClear">Clear</button>
			<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy Output</button>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const jsonInput = document.getElementById('jsonInput') as HTMLTextAreaElement;
		const jsonOutput = document.getElementById('jsonOutput') as HTMLTextAreaElement;
		const statusBar = document.getElementById('statusBar');
		const charCount = document.getElementById('charCount');

		function updateStatus(isSuccess: boolean, message: string) {
			if (!statusBar) return;
			statusBar.className = `status-bar ${isSuccess ? 'success' : 'error'}`;
			const statusText = statusBar.querySelector('span');
			if (statusText) statusText.textContent = message;
		}

		function processJson(indent: number | null) {
			const val = jsonInput.value.trim();
			if (!val) {
				jsonOutput.value = '';
				updateStatus(true, 'Status: Ready to process JSON');
				if (charCount) charCount.textContent = '0 chars';
				return;
			}

			try {
				const parsed = JSON.parse(val);
				jsonOutput.value = indent !== null ? JSON.stringify(parsed, null, indent) : JSON.stringify(parsed);
				updateStatus(true, 'Status: Valid JSON Structure!');
				if (charCount) charCount.textContent = `${jsonOutput.value.length} chars`;
			} catch (e: any) {
				jsonOutput.value = '';
				updateStatus(false, `Syntax Error: ${e.message}`);
				if (charCount) charCount.textContent = 'Error';
			}
		}

		document.getElementById('btnBeautify')?.addEventListener('click', () => processJson(2));
		document.getElementById('btnMinify')?.addEventListener('click', () => processJson(null));

		document.getElementById('btnClear')?.addEventListener('click', () => {
			jsonInput.value = '';
			jsonOutput.value = '';
			updateStatus(true, 'Status: Ready to process JSON');
			if (charCount) charCount.textContent = '0 chars';
		});

		document.getElementById('btnCopy')?.addEventListener('click', (e) => {
			if (!jsonOutput.value) return;
			navigator.clipboard.writeText(jsonOutput.value);
			const btn = e.target as HTMLButtonElement;
			btn.textContent = 'Copied!';
			setTimeout(() => { btn.textContent = 'Copy Output'; }, 2000);
		});

		jsonInput?.addEventListener('input', () => {
			if (jsonInput.value.trim() === '') {
				jsonOutput.value = '';
				updateStatus(true, 'Status: Ready to process JSON');
				if (charCount) charCount.textContent = '0 chars';
			}
		});
	</script>
</ToolLayout>
