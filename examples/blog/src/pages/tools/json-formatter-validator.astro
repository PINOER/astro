---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "JSON Formatter, Validator & Beautifier",
	description: "Free, 100% private online tool to format, validate, beautify, and minify your JSON data in real-time.",
	icon: "🛠️",
	tag: "Developer",
	keywords: "json formatter json validator json beautifier json minifier online json editor"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.status-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.6em 1em;
				border-radius: 8px;
				font-size: 0.88rem;
				font-weight: 600;
				margin-bottom: 1em;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				color: var(--text-muted);
			}
			.status-bar.success {
				border-color: #10b981;
				color: #10b981;
				background: rgba(16, 185, 129, 0.08);
			}
			.status-bar.error {
				border-color: #ef4444;
				color: #ef4444;
				background: rgba(239, 68, 68, 0.08);
			}
			.editor-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.2rem;
			}
			.editor-container {
				display: flex;
				flex-direction: column;
				gap: 0.5em;
			}
			label {
				font-weight: 600;
				color: var(--text-main);
				font-size: 0.9rem;
			}
			textarea {
				width: 100%;
				height: 380px;
				padding: 1em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 10px;
				color: var(--text-main);
				font-size: 0.9rem;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
				box-sizing: border-box;
				outline: none;
				resize: vertical;
				line-height: 1.5;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			textarea:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			.btn-group {
				display: flex;
				gap: 0.8rem;
				margin: 1.2rem 0 0;
				flex-wrap: wrap;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* Content Sections */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.editor-grid, .related-grid {
					grid-template-columns: 1fr;
				}
				textarea {
					height: 240px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🛠️ {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="status-bar" id="statusBar">
					<span>Status: Ready to process JSON</span>
					<span id="charCount">0 chars</span>
				</div>

				<div class="editor-grid">
					<div class="editor-container">
						<label for="jsonInput">Input Raw JSON:</label>
						<textarea id="jsonInput" placeholder="Paste or type raw JSON here..."></textarea>
					</div>
					<div class="editor-container">
						<label for="jsonOutput">Formatted / Minified Output:</label>
						<textarea id="jsonOutput" readonly placeholder="Output will appear here..."></textarea>
					</div>
				</div>

				<div class="btn-group">
					<button class="btn" id="btnBeautify">Format (Beautify 2 Spaces)</button>
					<button class="btn" id="btnMinify">Minify (Compact)</button>
					<button class="btn btn-secondary" id="btnClear">Clear</button>
					<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy Output</button>
				</div>
			</div>

			<!-- FAQ Section -->
			<section class="content-section">
				<h2>Frequently Asked Questions (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>Is my JSON data uploaded to any server?</h3>
						<p><strong>No.</strong> Processing is 100% client-side inside your web browser. Your confidential JSON payloads, API tokens, or data structures never leave your computer.</p>
					</div>
					<div class="faq-item">
						<h3>What are the most common JSON syntax errors?</h3>
						<p>Common errors include trailing commas at the end of objects/arrays, single quotes instead of double quotes around keys or strings, and unescaped special characters.</p>
					</div>
					<div class="faq-item">
						<h3>What is the difference between Beautify and Minify?</h3>
						<p><strong>Beautify</strong> adds indents and line breaks for better human readability. <strong>Minify</strong> strips out unnecessary whitespace to reduce file size for network transfer.</p>
					</div>
				</div>
			</section>

			<!-- Related Tools Section -->
			<section class="content-section">
				<h2>You Might Also Like</h2>
				<div class="related-grid">
					<a href="/tools/base64-url-encode-decode/" class="related-card">
						<span class="card-icon">🔤</span>
						<div>
							<h4>Base64 & URL Encoder/Decoder</h4>
							<p>Encode and decode Base64 strings and URL parameters securely.</p>
						</div>
					</a>
					<a href="/tools/ecommerce-profit-margin-calculator/" class="related-card">
						<span class="card-icon">🧮</span>
						<div>
							<h4>E-commerce Margin & Profit Calculator</h4>
							<p>Calculate net profit margins and breakeven sale prices.</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "Is my JSON data uploaded to any server?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "No. Processing is 100% client-side inside your web browser. Your confidential JSON payloads never leave your computer."
						}
					},
					{
						"@type": "Question",
						"name": "What is the difference between Beautify and Minify?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Beautify adds indents for human readability, while Minify strips whitespace to minimize file size."
						}
					}
				]
			}
		</script>

		<script>
			const jsonInput = document.getElementById('jsonInput') as HTMLTextAreaElement;
			const jsonOutput = document.getElementById('jsonOutput') as HTMLTextAreaElement;
			const statusBar = document.getElementById('statusBar');
			const charCount = document.getElementById('charCount');

			function updateStatus(isSuccess: boolean, message: string) {
				if (!statusBar) return;
				statusBar.className = `status-bar ${isSuccess ? 'success' : 'error'}`;
				const statusText = statusBar.querySelector('span');
				if (statusText) statusText.textContent = message;
			}

			function processJson(indent: number | null) {
				const val = jsonInput.value.trim();
				if (!val) {
					jsonOutput.value = '';
					updateStatus(true, 'Status: Ready to process JSON');
					if (charCount) charCount.textContent = '0 chars';
					return;
				}

				try {
					const parsed = JSON.parse(val);
					jsonOutput.value = indent !== null ? JSON.stringify(parsed, null, indent) : JSON.stringify(parsed);
					updateStatus(true, 'Status: Valid JSON Structure!');
					if (charCount) charCount.textContent = `${jsonOutput.value.length} chars`;
				} catch (e: any) {
					jsonOutput.value = '';
					updateStatus(false, `Syntax Error: ${e.message}`);
					if (charCount) charCount.textContent = 'Error';
				}
			}

			document.getElementById('btnBeautify')?.addEventListener('click', () => processJson(2));
			document.getElementById('btnMinify')?.addEventListener('click', () => processJson(null));

			document.getElementById('btnClear')?.addEventListener('click', () => {
				jsonInput.value = '';
				jsonOutput.value = '';
				updateStatus(true, 'Status: Ready to process JSON');
				if (charCount) charCount.textContent = '0 chars';
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!jsonOutput.value) return;
				navigator.clipboard.writeText(jsonOutput.value);
				const btn = e.target as HTMLButtonElement;
				btn.textContent = 'Copied!';
				setTimeout(() => { btn.textContent = 'Copy Output'; }, 2000);
			});

			jsonInput?.addEventListener('input', () => {
				if (jsonInput.value.trim() === '') {
					jsonOutput.value = '';
					updateStatus(true, 'Status: Ready to process JSON');
					if (charCount) charCount.textContent = '0 chars';
				}
			});
		</script>
	</body>
</html>
