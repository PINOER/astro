---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "JSON Formatter & Validator",
	description: "Fast, secure, 100% client-side JSON formatter, validator, and minifier for developers and store owners.",
	icon: "⚙️",
	tag: "Developer",
	keywords: "json formatter validator minifier pretty print developer tools",
	pinned: false,
	priority: 87
};

const faqList = [
	{
		question: "Is my JSON data secure when using this online tool?",
		answer: "Yes, 100%. All parsing, validation, formatting, and minification processes take place entirely inside your web browser. No JSON strings or API payloads are sent to any external server."
	},
	{
		question: "What is the difference between Prettify and Minify?",
		answer: "Prettifying (formatting) adds indentation and line breaks to make structured JSON human-readable. Minifying removes all unnecessary whitespace and carriage returns to minimize file size for network transmission."
	},
	{
		question: "What happens when my JSON string has syntax errors?",
		answer: "The tool automatically detects syntax errors (such as trailing commas, missing quotes, or unmatched brackets) and displays a detailed error status message below the output editor."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.btn-group {
			display: flex;
			gap: 0.8rem;
			margin-bottom: 1rem;
			flex-wrap: wrap;
		}
		.btn {
			background: var(--gray-light);
			border: 1px solid var(--card-border);
			color: var(--text-main);
			padding: 0.5em 1em;
			border-radius: 8px;
			font-size: 0.88rem;
			font-weight: 600;
			cursor: pointer;
			transition: all 0.2s;
		}
		.btn:hover {
			border-color: var(--accent);
			color: var(--accent);
		}
		.btn-primary {
			background: var(--accent);
			border-color: var(--accent);
			color: #ffffff !important;
		}
		.btn-primary:hover {
			background: var(--accent-hover);
			border-color: var(--accent-hover);
			color: #ffffff !important;
		}
		.editor-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}
		textarea {
			width: 100%;
			height: 380px;
			padding: 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			color: var(--text-main);
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
			font-size: 0.88rem;
			box-sizing: border-box;
			outline: none;
			resize: vertical;
			line-height: 1.5;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		.status-bar {
			margin-top: 1rem;
			font-size: 0.85rem;
			font-weight: 600;
			padding: 0.6em 1em;
			border-radius: 6px;
			display: none;
		}
		.status-success {
			background: rgba(34, 197, 94, 0.12);
			color: #16a34a;
			border: 1px solid rgba(34, 197, 94, 0.3);
		}
		.status-error {
			background: rgba(239, 68, 68, 0.12);
			color: #dc2626;
			border: 1px solid rgba(239, 68, 68, 0.3);
		}
		
		:global([data-theme="dark"]) .status-success { color: #4ade80; }
		:global([data-theme="dark"]) .status-error { color: #f87171; }

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}

		@media (max-width: 720px) {
			.editor-grid { grid-template-columns: 1fr; }
		}
	</style>

	<!-- 工具主体计算卡片 -->
	<div class="tool-box">
		<div class="btn-group">
			<button class="btn btn-primary" id="btnFormat">Prettify (2 Spaces)</button>
			<button class="btn" id="btnMinify">Minify JSON</button>
			<button class="btn" id="btnClear">Clear</button>
			<button class="btn" id="btnCopy" style="margin-left: auto;">Copy Output</button>
		</div>

		<div class="editor-grid">
			<div>
				<label style="display: block; margin-bottom: 0.4rem; font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">Input JSON:</label>
				<textarea id="jsonInput" placeholder='Paste your raw JSON here... e.g. {"name": "HelpMini", "status": "active"}'></textarea>
			</div>
			<div>
				<label style="display: block; margin-bottom: 0.4rem; font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">Formatted / Validated Output:</label>
				<textarea id="jsonOutput" readonly placeholder="Output will appear here..."></textarea>
			</div>
		</div>

		<div id="statusBar" class="status-bar"></div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const jsonInput = document.getElementById('jsonInput') as HTMLTextAreaElement;
		const jsonOutput = document.getElementById('jsonOutput') as HTMLTextAreaElement;
		const statusBar = document.getElementById('statusBar') as HTMLDivElement;

		const btnFormat = document.getElementById('btnFormat');
		const btnMinify = document.getElementById('btnMinify');
		const btnClear = document.getElementById('btnClear');
		const btnCopy = document.getElementById('btnCopy');

		function showStatus(msg: string, isError = false) {
			statusBar.style.display = 'block';
			statusBar.className = `status-bar ${isError ? 'status-error' : 'status-success'}`;
			statusBar.textContent = msg;
		}

		btnFormat?.addEventListener('click', () => {
			try {
				const raw = jsonInput.value.trim();
				if (!raw) return;
				const parsed = JSON.parse(raw);
				jsonOutput.value = JSON.stringify(parsed, null, 2);
				showStatus('Valid JSON! Successfully formatted.');
			} catch (err: any) {
				jsonOutput.value = '';
				showStatus(`Invalid JSON Syntax: ${err.message}`, true);
			}
		});

		btnMinify?.addEventListener('click', () => {
			try {
				const raw = jsonInput.value.trim();
				if (!raw) return;
				const parsed = JSON.parse(raw);
				jsonOutput.value = JSON.stringify(parsed);
				showStatus('Valid JSON! Successfully minified.');
			} catch (err: any) {
				jsonOutput.value = '';
				showStatus(`Invalid JSON Syntax: ${err.message}`, true);
			}
		});

		btnClear?.addEventListener('click', () => {
			jsonInput.value = '';
			jsonOutput.value = '';
			statusBar.style.display = 'none';
		});

		btnCopy?.addEventListener('click', () => {
			if (!jsonOutput.value) return;
			navigator.clipboard.writeText(jsonOutput.value);
			btnCopy.textContent = 'Copied!';
			setTimeout(() => { btnCopy.textContent = 'Copy Output'; }, 2000);
		});
	</script>
</ToolLayout>
