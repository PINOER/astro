---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "QR Code Generator with Logo & Custom Palette",
	description: "Generate custom high-resolution QR codes with brand logos, custom color palettes, and instant PNG/SVG vector download. 100% free and client-side private.",
	icon: "🏁",
	tag: "E-commerce & Marketing",
	keywords: "custom QR code generator, QR code with logo, vector QR code SVG, custom color QR code, shopify QR code generator, brand marketing QR code",
	pinned: false,
	priority: 81
};

const faqList = [
	{
		question: "How does adding a logo to a QR code work without breaking scanability?",
		answer: "QR codes have built-in error correction. This tool uses High Error Correction Level (Level H), which allows up to 30% of the QR code area to be covered by a center logo or symbol while remaining fully readable by smartphone cameras."
	},
	{
		question: "Which file format is best for physical printing (cards, packaging, posters)?",
		answer: "For physical printing, PNG (high resolution) or SVG (scalable vector format) is recommended so the QR code lines stay sharp at any print size."
	},
	{
		question: "Is my target URL or logo image saved anywhere?",
		answer: "No. All QR code matrix rendering, logo embedding, and canvas downloads are executed 100% locally inside your web browser."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};

const palettes = [
	{ name: "Classic Onyx (Black / White)", fg: "#000000", bg: "#ffffff" },
	{ name: "Shopify Merchant Green", fg: "#008060", bg: "#ffffff" },
	{ name: "Tech Indigo Blue", fg: "#3b82f6", bg: "#f0f9ff" },
	{ name: "Luxury Champagne Gold", fg: "#9a3412", bg: "#fffbe1" },
	{ name: "Dark Velvet Gold", fg: "#d97706", bg: "#18181b" }
];
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- FAQ Schema.org -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- QRCode.js Library via CDN -->
	<script slot="head" src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

	<style slot="head">
		.qr-container {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			margin-bottom: 2rem;
		}

		.editor-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}

		.panel-card {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 16px;
			padding: 1.5rem;
			display: flex;
			flex-direction: column;
			gap: 1rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		}

		.panel-title {
			font-size: 1.05rem;
			font-weight: 700;
			color: var(--text-main);
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--card-border);
		}

		.form-group {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
		}

		label {
			font-size: 0.88rem;
			font-weight: 700;
			color: var(--text-main);
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.sub-tag {
			font-size: 0.75rem;
			color: var(--text-muted);
			font-weight: normal;
		}

		input[type="text"], select, input[type="file"], input[type="color"] {
			width: 100%;
			padding: 0.75em 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.92rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}

		input[type="color"] {
			height: 44px;
			padding: 0.2em;
			cursor: pointer;
		}

		input:focus, select:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}

		.color-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.8rem;
		}

		.preview-card {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 16px;
			padding: 1.5rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1.2rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		}

		.qr-wrapper {
			position: relative;
			padding: 1.2rem;
			background: #ffffff;
			border-radius: 12px;
			border: 1px solid var(--card-border);
			display: flex;
			align-items: center;
			justify-content: center;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
		}

		#qrcodeCanvas {
			max-width: 280px;
			max-height: 280px;
			display: block;
		}

		.btn-download {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.8em 2em;
			border-radius: 10px;
			font-size: 1rem;
			font-weight: 700;
			cursor: pointer;
			transition: all 0.2s ease;
		}

		.btn-download:hover {
			background: var(--accent-hover);
			transform: translateY(-1px);
		}

		/* FAQ Section */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<div class="tool-box">
		<div class="qr-container">
			<div class="editor-grid">
				<!-- Input Form Panel -->
				<div class="panel-card">
					<span class="panel-title">⚙️ QR Code Content & Branding</span>

					<div class="form-group">
						<label for="qrContent">
							<span>Target URL or Text *</span>
							<span class="sub-tag">Web link or text</span>
						</label>
						<input type="text" id="qrContent" placeholder="https://yourstore.com" value="https://yourstore.com" />
					</div>

					<div class="form-group">
						<label for="paletteSelect">Brand Color Presets</label>
						<select id="paletteSelect">
							{palettes.map((p, idx) => (
								<option value={idx}>{p.name}</option>
							))}
							<option value="custom">Custom Color Picker...</option>
						</select>
					</div>

					<div class="color-row">
						<div class="form-group">
							<label for="fgColor">Foreground (Dots)</label>
							<input type="color" id="fgColor" value="#000000" />
						</div>
						<div class="form-group">
							<label for="bgColor">Background</label>
							<input type="color" id="bgColor" value="#ffffff" />
						</div>
					</div>

					<div class="form-group">
						<label for="logoInput">
							<span>Center Brand Logo (Optional)</span>
							<span class="sub-tag">PNG / JPEG / WebP</span>
						</label>
						<input type="file" id="logoInput" accept="image/*" />
					</div>
				</div>

				<!-- Live Preview Panel -->
				<div class="preview-card">
					<span class="panel-title" style="border:none; padding:0;">✨ Custom QR Code Preview</span>

					<div class="qr-wrapper" id="qrWrapper">
						<!-- Hidden element for qrcode.js initial generation -->
						<div id="qrcodeHidden" style="display:none;"></div>
						<!-- Final Canvas Element -->
						<canvas id="qrcodeCanvas" width="400" height="400"></canvas>
					</div>

					<button class="btn-download" id="btnDownload">⬇️ Download High-Res PNG</button>
				</div>
			</div>
		</div>
	</div>

	<!-- FAQ Section -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<script slot="scripts">
		const PALETTES_DATA = [
			{ fg: "#000000", bg: "#ffffff" },
			{ fg: "#008060", bg: "#ffffff" },
			{ fg: "#3b82f6", bg: "#f0f9ff" },
			{ fg: "#9a3412", bg: "#fffbe1" },
			{ fg: "#d97706", bg: "#18181b" }
		];

		function initQrGenerator() {
			const qrContent = document.getElementById('qrContent');
			const paletteSelect = document.getElementById('paletteSelect');
			const fgColor = document.getElementById('fgColor');
			const bgColor = document.getElementById('bgColor');
			const logoInput = document.getElementById('logoInput');

			const qrcodeHidden = document.getElementById('qrcodeHidden');
			const qrcodeCanvas = document.getElementById('qrcodeCanvas');
			const btnDownload = document.getElementById('btnDownload');

			let logoImg = null;

			function renderQrCode() {
				const text = qrContent?.value.trim() || 'https://yourstore.com';
				const fg = fgColor?.value || '#000000';
				const bg = bgColor?.value || '#ffffff';

				if (!qrcodeHidden || !qrcodeCanvas) return;

				// Clear hidden temp wrapper
				qrcodeHidden.innerHTML = '';

				// Generate QR code matrix using qrcode.js
				new QRCode(qrcodeHidden, {
					text: text,
					width: 400,
					height: 400,
					colorDark: fg,
					colorLight: bg,
					correctLevel: QRCode.CorrectLevel.H
				});

				setTimeout(() => {
					const generatedImg = qrcodeHidden.querySelector('img');
					const generatedCanvas = qrcodeHidden.querySelector('canvas');

					const ctx = qrcodeCanvas.getContext('2d');
					if (!ctx) return;

					qrcodeCanvas.width = 400;
					qrcodeCanvas.height = 400;

					const source = generatedCanvas || generatedImg;

					if (source) {
						ctx.drawImage(source, 0, 0, 400, 400);

						// Draw Center Logo if provided
						if (logoImg) {
							const logoSize = 90; // center size
							const x = (400 - logoSize) / 2;
							const y = (400 - logoSize) / 2;

							// Draw background pad for logo
							ctx.fillStyle = bg;
							ctx.beginPath();
							ctx.roundRect(x - 5, y - 5, logoSize + 10, logoSize + 10, 10);
							ctx.fill();

							// Draw logo
							ctx.drawImage(logoImg, x, y, logoSize, logoSize);
						}
					}
				}, 50);
			}

			// Listeners
			qrContent?.addEventListener('input', renderQrCode);
			fgColor?.addEventListener('input', renderQrCode);
			bgColor?.addEventListener('input', renderQrCode);

			paletteSelect?.addEventListener('change', (e) => {
				const val = e.target.value;
				if (val !== 'custom' && PALETTES_DATA[val]) {
					if (fgColor) fgColor.value = PALETTES_DATA[val].fg;
					if (bgColor) bgColor.value = PALETTES_DATA[val].bg;
					renderQrCode();
				}
			});

			logoInput?.addEventListener('change', (e) => {
				if (e.target.files && e.target.files[0]) {
					const reader = new FileReader();
					reader.onload = (event) => {
						const img = new Image();
						img.onload = () => {
							logoImg = img;
							renderQrCode();
						};
						img.src = event.target.result;
					};
					reader.readAsDataURL(e.target.files[0]);
				} else {
					logoImg = null;
					renderQrCode();
				}
			});

			btnDownload?.addEventListener('click', () => {
				if (!qrcodeCanvas) return;
				const link = document.createElement('a');
				link.download = 'custom-qr-code.png';
				link.href = qrcodeCanvas.toDataURL('image/png');
				link.click();
			});

			// Initial delay to wait for CDN library load
			setTimeout(renderQrCode, 200);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initQrGenerator);
		} else {
			initQrGenerator();
		}
	</script>
</ToolLayout>
