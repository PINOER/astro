---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
    title: "Base64 & URL Encoder/Decoder",
    description: "Fast, 100% private online tool to encode and decode Base64 text and URL parameters.",
    icon: "🔤",
    tag: "Developer",
    keywords: "base64 url encode decode encoder decoder",
    pinned: false,
    priority: 85
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<style slot="head">
		.tab-group { display: flex; gap: 0.8rem; margin-bottom: 1.5em; border-bottom: 1px solid var(--card-border); padding-bottom: 0.8em; }
		.tab-btn { background: none; border: 1px solid transparent; color: var(--text-muted); font-size: 1rem; font-weight: 600; cursor: pointer; padding: 0.4em 0.9em; border-radius: 8px; }
		.tab-btn.active { background: var(--badge-bg); color: var(--accent); border-color: var(--badge-border); }
		.btn-group { display: flex; gap: 0.8rem; margin: 1.2rem 0; flex-wrap: wrap; }
		textarea { width: 100%; height: 160px; padding: 1em; background: var(--code-bg) !important; border: 1px solid var(--card-border); border-radius: 10px; color: var(--text-main); font-size: 0.95rem; font-family: monospace; box-sizing: border-box; outline: none; resize: vertical; line-height: 1.5; }
	</style>

	<div class="tool-box">
		<div class="tab-group">
			<button class="tab-btn active" id="modeBase64">Base64 Mode</button>
			<button class="tab-btn" id="modeURL">URL Mode</button>
		</div>

		<div>
			<label for="inputText">Input Text / Raw String:</label>
			<textarea id="inputText" placeholder="Type or paste text here..."></textarea>
		</div>

		<div class="btn-group">
			<button class="btn" id="btnEncode">Encode</button>
			<button class="btn" id="btnDecode">Decode</button>
			<button class="btn btn-secondary" id="btnClear">Clear</button>
			<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy Result</button>
		</div>

		<div>
			<label for="outputText">Output Result:</label>
			<textarea id="outputText" readonly placeholder="Output will appear here..."></textarea>
		</div>
	</div>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽，添加 DOMContentLoaded 机制) -->
	<script slot="scripts">
		function initTool() {
			let currentMode = 'base64';
			const modeBase64 = document.getElementById('modeBase64');
			const modeURL = document.getElementById('modeURL');
			const inputText = document.getElementById('inputText');
			const outputText = document.getElementById('outputText');

			modeBase64?.addEventListener('click', () => { 
				currentMode = 'base64'; 
				modeBase64.classList.add('active'); 
				modeURL?.classList.remove('active'); 
			});

			modeURL?.addEventListener('click', () => { 
				currentMode = 'url'; 
				modeURL.classList.add('active'); 
				modeBase64?.classList.remove('active'); 
			});

			document.getElementById('btnEncode')?.addEventListener('click', () => {
				if (!inputText || !outputText) return;
				const val = inputText.value;
				try {
					if (currentMode === 'base64') {
						outputText.value = btoa(encodeURIComponent(val).replace(/%([0-9A-F]{2})/g, (match, p1) => String.fromCharCode(parseInt(p1, 16))));
					} else { 
						outputText.value = encodeURIComponent(val); 
					}
				} catch (e) { 
					outputText.value = 'Encoding error: ' + e.message; 
				}
			});

			document.getElementById('btnDecode')?.addEventListener('click', () => {
				if (!inputText || !outputText) return;
				const val = inputText.value;
				try {
					if (currentMode === 'base64') {
						outputText.value = decodeURIComponent(Array.prototype.map.call(atob(val.trim()), (c) => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
					} else { 
						outputText.value = decodeURIComponent(val); 
					}
				} catch (e) { 
					outputText.value = 'Decoding error: Invalid input format.'; 
				}
			});

			document.getElementById('btnClear')?.addEventListener('click', () => { 
				if (inputText) inputText.value = ''; 
				if (outputText) outputText.value = ''; 
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!outputText || !outputText.value) return;
				navigator.clipboard.writeText(outputText.value);
				const btn = e.target;
				const originalText = btn.textContent;
				btn.textContent = 'Copied!';
				setTimeout(() => { btn.textContent = originalText; }, 2000);
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initTool);
		} else {
			initTool();
		}
	</script>
</ToolLayout>
