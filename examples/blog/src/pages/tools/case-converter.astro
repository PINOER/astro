---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Text Case & Naming Style Converter",
	description: "Fast, client-side tool to convert text case (UPPERCASE, lowercase, Title Case) and code variable formats (camelCase, snake_case, kebab-case).",
	icon: "🔤",
	tag: "Developer",
	keywords: "case converter camelCase snake_case kebab-case title case uppercase lowercase variable naming",
	pinned: false,
	priority: 85
};

const faqList = [
	{
		question: "Which code variable naming conventions are supported?",
		answer: "This tool supports all standard programming naming styles, including camelCase, PascalCase, snake_case, kebab-case, and CONSTANT_CASE."
	},
	{
		question: "What is Title Case used for?",
		answer: "Title Case capitalizes the first letter of every principal word. It is widely used for blog post titles, email subjects, and article headlines."
	},
	{
		question: "Is my text processed securely on the client side?",
		answer: "Yes, 100%. All string transformations are executed locally in your web browser. Zero text data is transmitted to external servers."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.input-label {
			display: flex;
			justify-content: space-between;
			align-items: center;
			font-weight: 600;
			margin-bottom: 0.5em;
			color: var(--text-main);
		}
		.text-stats {
			font-size: 0.85rem;
			color: var(--text-muted);
		}

		textarea {
			width: 100%;
			height: 180px;
			padding: 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			color: var(--text-main);
			font-size: 0.95rem;
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			box-sizing: border-box;
			outline: none;
			resize: vertical;
			line-height: 1.5;
			transition: border-color 0.2s;
		}
		textarea:focus {
			border-color: var(--accent);
		}

		.grid-actions {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			gap: 0.8rem;
			margin: 1.5rem 0;
		}

		.btn-action {
			background: var(--gray-light);
			border: 1px solid var(--card-border);
			color: var(--text-main);
			padding: 0.7em 0.9em;
			border-radius: 8px;
			font-weight: 600;
			font-size: 0.88rem;
			cursor: pointer;
			text-align: center;
			transition: all 0.2s ease;
		}
		.btn-action:hover {
			border-color: var(--accent);
			color: var(--accent);
			background: var(--badge-bg);
		}

		.control-bar {
			display: flex;
			gap: 0.8rem;
			justify-content: flex-end;
			margin-top: 1rem;
		}
		.btn {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-weight: 600;
			cursor: pointer;
			transition: background 0.2s;
		}
		.btn:hover { background: var(--accent-hover); }
		.btn-secondary {
			background: var(--gray-light);
			border: 1px solid var(--card-border);
			color: var(--text-main);
		}

		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 工具卡片 UI 主体 -->
	<div class="tool-box">
		<div class="input-label">
			<span>Input Text / Variable:</span>
			<span class="text-stats" id="statsText">Characters: 0 | Words: 0</span>
		</div>
		<textarea id="inputText" placeholder="Paste or type text here, e.g. hello_world or user-name..."></textarea>

		<div class="grid-actions">
			<button class="btn-action" data-type="upper">UPPERCASE</button>
			<button class="btn-action" data-type="lower">lowercase</button>
			<button class="btn-action" data-type="title">Title Case</button>
			<button class="btn-action" data-type="sentence">Sentence case</button>
			<button class="btn-action" data-type="camel">camelCase</button>
			<button class="btn-action" data-type="pascal">PascalCase</button>
			<button class="btn-action" data-type="snake">snake_case</button>
			<button class="btn-action" data-type="kebab">kebab-case</button>
			<button class="btn-action" data-type="constant">CONSTANT_CASE</button>
			<button class="btn-action" data-type="toggle">tOGGLE cASE</button>
		</div>

		<div class="control-bar">
			<button class="btn btn-secondary" id="btnClear">Clear</button>
			<button class="btn" id="btnCopy">Copy Result</button>
		</div>
	</div>

	<!-- FAQ 面板区 (挂载至 FAQ 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const inputText = document.getElementById('inputText') as HTMLTextAreaElement;
		const statsText = document.getElementById('statsText');
		const btnCopy = document.getElementById('btnCopy') as HTMLButtonElement;
		const btnClear = document.getElementById('btnClear');
		const actionBtns = document.querySelectorAll('.btn-action');

		inputText?.addEventListener('input', updateStats);

		function updateStats() {
			const text = inputText.value;
			const chars = text.length;
			const words = text.trim() ? text.trim().split(/\s+/).length : 0;
			if (statsText) statsText.textContent = `Characters: ${chars} | Words: ${words}`;
		}

		function getWords(str: string): string[] {
			return str
				.replace(/([a-z])([A-Z])/g, '$1 $2')
				.replace(/[_-]+/g, ' ')
				.trim()
				.split(/\s+/);
		}

		actionBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const type = (btn as HTMLElement).dataset.type;
				const val = inputText.value;
				if (!val) return;

				switch (type) {
					case 'upper':
						inputText.value = val.toUpperCase();
						break;
					case 'lower':
						inputText.value = val.toLowerCase();
						break;
					case 'title':
						inputText.value = val.toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
						break;
					case 'sentence':
						inputText.value = val.toLowerCase().replace(/(^\s*\w|[\.\!\?]\s*\w)/g, c => c.toUpperCase());
						break;
					case 'camel':
						inputText.value = getWords(val)
							.map((w, i) => i === 0 ? w.toLowerCase() : w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
							.join('');
						break;
					case 'pascal':
						inputText.value = getWords(val)
							.map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
							.join('');
						break;
					case 'snake':
						inputText.value = getWords(val).map(w => w.toLowerCase()).join('_');
						break;
					case 'kebab':
						inputText.value = getWords(val).map(w => w.toLowerCase()).join('-');
						break;
					case 'constant':
						inputText.value = getWords(val).map(w => w.toUpperCase()).join('_');
						break;
					case 'toggle':
						inputText.value = val.split('').map(c => c === c.toUpperCase() ? c.toLowerCase() : c.toUpperCase()).join('');
						break;
				}
				updateStats();
			});
		});

		btnClear?.addEventListener('click', () => {
			inputText.value = '';
			updateStats();
		});

		btnCopy?.addEventListener('click', () => {
			if (!inputText.value) return;
			navigator.clipboard.writeText(inputText.value);
			btnCopy.textContent = 'Copied!';
			setTimeout(() => { btnCopy.textContent = 'Copy Result'; }, 2000);
		});
	</script>
</ToolLayout>
