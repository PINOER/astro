---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "SEO Meta Title & Description Generator",
	description: "Generate CTR-optimized Google Meta Titles and Meta Descriptions instantly with real-time character limit checks.",
	icon: "🔍",
	tag: "SEO Tools",
	keywords: "seo meta title description generator serp preview high ctr developer tools",
	pinned: false,
	priority: 92
};

const faqList = [
	{
		question: "What are the ideal character lengths for Meta Titles and Descriptions on Google?",
		answer: "Google typically displays the first 50–60 characters (~600 pixels) of a Meta Title and 150–160 characters (~960 pixels) for a Meta Description. Keeping within these limits prevents your text from being truncated with ellipses (...) in search results."
	},
	{
		question: "How does adding a brand name affect CTR?",
		answer: "Appending your brand name (e.g., '| HelpMini') at the end of titles builds brand authority, improves domain trust over time, and makes search snippets look official."
	},
	{
		question: "Is my target keyword data processed on remote servers?",
		answer: "No, 100% private. All title and description templates, character count checks, and SERP preview renderings execute locally in your web browser."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.form-group {
			margin-bottom: 1.2em;
		}
		label {
			display: block;
			font-weight: 600;
			margin-bottom: 0.5em;
			color: var(--text-main);
		}
		input[type="text"], textarea, select {
			width: 100%;
			padding: 0.8em 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.95rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		input[type="text"]:focus, textarea:focus, select:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		.btn-generate {
			width: 100%;
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.9em;
			font-size: 1rem;
			font-weight: 700;
			border-radius: 8px;
			cursor: pointer;
			transition: background 0.2s;
			margin-top: 1em;
		}
		.btn-generate:hover {
			background: var(--accent-hover);
		}
		.results-wrapper {
			margin-top: 2em;
			display: none;
		}
		.results-wrapper h3 {
			font-size: 1.1rem;
			font-weight: 700;
			margin-bottom: 1em;
			color: var(--text-main);
		}
		.result-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2rem;
			margin-bottom: 1.2rem;
		}
		.result-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 0.5rem;
		}
		.result-tag {
			font-size: 0.75rem;
			color: var(--accent);
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}
		.btn-copy-sm {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			color: var(--text-main);
			padding: 0.35em 0.7em;
			border-radius: 6px;
			cursor: pointer;
			font-size: 0.8rem;
			font-weight: 600;
			transition: all 0.2s ease;
		}
		.btn-copy-sm:hover {
			border-color: var(--accent);
			color: var(--accent);
		}
		/* Google SERP 模拟预览区 */
		.serp-preview {
			background: #ffffff !important;
			padding: 1.2rem;
			border-radius: 8px;
			border: 1px solid #dadce0;
			margin-top: 0.8rem;
			font-family: arial, sans-serif;
			box-shadow: 0 1px 6px rgba(32, 33, 36, 0.1);
		}
		.serp-title {
			color: #1a0dab !important;
			font-size: 18px;
			line-height: 1.3;
			cursor: pointer;
			text-decoration: none;
			display: block;
			margin-bottom: 2px;
			font-weight: 400;
		}
		.serp-title:hover {
			text-decoration: underline;
		}
		.serp-url {
			color: #202124 !important;
			font-size: 12px;
			line-height: 1.3;
			margin-bottom: 4px;
		}
		.serp-desc {
			color: #4d5156 !important;
			font-size: 14px;
			line-height: 1.58;
		}
		.char-counter {
			font-size: 0.8rem;
			color: var(--text-muted);
			margin-top: 0.6rem;
			display: flex;
			justify-content: space-between;
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 工具主体表单卡片 -->
	<div class="tool-box">
		<div class="form-group">
			<label for="topicInput">Page Topic / Focus Keyword:</label>
			<input type="text" id="topicInput" placeholder="e.g., Best Shopify Apps for Increasing Sales" />
		</div>

		<div class="form-group">
			<label for="brandInput">Brand Name / Website Name (Optional):</label>
			<input type="text" id="brandInput" placeholder="e.g., HelpMini" />
		</div>

		<button class="btn-generate" id="generateBtn">Generate High-CTR Meta Tags ✨</button>

		<div class="results-wrapper" id="resultsWrapper">
			<h3>Generated Meta Tag Options</h3>

			<!-- Option 1: High CTR -->
			<div class="result-card">
				<div class="result-header">
					<div class="result-tag">🔥 High-CTR / Engagement Focus</div>
					<button class="btn-copy-sm" data-target="opt1">Copy Tags</button>
				</div>
				<div class="serp-preview">
					<a class="serp-title" id="title1">Title Output...</a>
					<div class="serp-url">https://example.com/page</div>
					<div class="serp-desc" id="desc1">Description Output...</div>
				</div>
				<div class="char-counter">
					<span id="lenTitle1">Title: 0 / 60 chars</span>
					<span id="lenDesc1">Desc: 0 / 155 chars</span>
				</div>
			</div>

			<!-- Option 2: Authority & Professional -->
			<div class="result-card">
				<div class="result-header">
					<div class="result-tag">🎓 Professional & Authority Focus</div>
					<button class="btn-copy-sm" data-target="opt2">Copy Tags</button>
				</div>
				<div class="serp-preview">
					<a class="serp-title" id="title2">Title Output...</a>
					<div class="serp-url">https://example.com/page</div>
					<div class="serp-desc" id="desc2">Description Output...</div>
				</div>
				<div class="char-counter">
					<span id="lenTitle2">Title: 0 / 60 chars</span>
					<span id="lenDesc2">Desc: 0 / 155 chars</span>
				</div>
			</div>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽) -->
	<script slot="scripts">
		const generateBtn = document.getElementById('generateBtn');
		const topicInput = document.getElementById('topicInput') as HTMLInputElement;
		const brandInput = document.getElementById('brandInput') as HTMLInputElement;
		const resultsWrapper = document.getElementById('resultsWrapper') as HTMLDivElement;

		function updateOption(id: string, title: string, desc: string) {
			const titleEl = document.getElementById(`title${id}`);
			const descEl = document.getElementById(`desc${id}`);
			const lenTitleEl = document.getElementById(`lenTitle${id}`);
			const lenDescEl = document.getElementById(`lenDesc${id}`);

			if (titleEl) titleEl.textContent = title;
			if (descEl) descEl.textContent = desc;

			if (lenTitleEl) lenTitleEl.textContent = `Title: ${title.length} / 60 chars ${title.length > 60 ? '⚠️ Too long' : '✅'}`;
			if (lenDescEl) lenDescEl.textContent = `Desc: ${desc.length} / 155 chars ${desc.length > 155 ? '⚠️ Too long' : '✅'}`;
		}

		generateBtn?.addEventListener('click', () => {
			const topic = topicInput?.value.trim();
			const brand = brandInput?.value.trim();

			if (!topic) {
				alert('Please enter a page topic or primary keyword!');
				return;
			}

			const brandSuffix = brand ? ` | ${brand}` : '';

			// Option 1: High CTR / Guide
			const t1 = `10+ Proven ${topic} (Step-by-Step Guide)${brandSuffix}`;
			const d1 = `Looking for the best ${topic}? Discover actionable tips, expert strategies, and top recommendations to boost your results today!`;

			// Option 2: Professional / Ultimate
			const t2 = `The Ultimate Guide to ${topic} [Updated]${brandSuffix}`;
			const d2 = `Master ${topic} with our comprehensive framework. Learn proven techniques and avoid common pitfalls with expert insights.`;

			updateOption('1', t1, d1);
			updateOption('2', t2, d2);

			if (resultsWrapper) resultsWrapper.style.display = 'block';
		});

		document.querySelectorAll('.btn-copy-sm').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const target = (e.target as HTMLElement).getAttribute('data-target');
				const id = target === 'opt1' ? '1' : '2';
				const titleText = document.getElementById(`title${id}`)?.textContent || '';
				const descText = document.getElementById(`desc${id}`)?.textContent || '';

				const textToCopy = `Meta Title: ${titleText}\nMeta Description: ${descText}`;
				navigator.clipboard.writeText(textToCopy);

				const originalText = btn.textContent;
				btn.textContent = 'Copied!';
				setTimeout(() => { btn.textContent = originalText; }, 2000);
			});
		});
	</script>
</ToolLayout>
