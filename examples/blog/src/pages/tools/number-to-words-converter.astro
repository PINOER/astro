---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "Number to English Words & Currency Converter",
	description: "Fast, 100% private online tool to convert numbers and currency amounts into English words for invoices and checks.",
	icon: "🔢",
	tag: "Finance",
	keywords: "number to words converter currency to words generator invoice number in words check spelling",
	pinned: false,
	priority: 88
};

const faqList = [
	{
		question: "Why write invoice amounts in words?",
		answer: "Writing currency amounts in full English words on official invoices or financial checks prevents fraud, tampering, and misinterpretation of decimal points."
	},
	{
		question: "How are cents represented in invoice format?",
		answer: "For amounts like $1,250.50, standard commercial format converts it to 'One Thousand Two Hundred Fifty Dollars and Fifty Cents'."
	},
	{
		question: "Is my financial data private?",
		answer: "Yes. All conversions are executed 100% locally in your web browser. No numbers or financial values leave your device."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="en">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		.option-group {
			display: flex;
			gap: 1rem;
			margin-bottom: 1.2rem;
			flex-wrap: wrap;
		}
		.radio-label {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			font-size: 0.9rem;
			color: var(--text-main);
			cursor: pointer;
			font-weight: 600;
		}
		.field-group {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
			margin-bottom: 1.2rem;
		}
		label {
			font-size: 0.88rem;
			font-weight: 600;
			color: var(--text-main);
		}
		input[type="number"] {
			width: 100%;
			padding: 0.7em 0.9em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 1.1rem;
			font-weight: 700;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		input[type="number"]:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}
		textarea {
			width: 100%;
			height: 120px;
			padding: 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			color: var(--text-main);
			font-size: 1rem;
			font-weight: 600;
			font-family: inherit;
			box-sizing: border-box;
			outline: none;
			resize: vertical;
			line-height: 1.5;
		}
		.btn-group {
			display: flex;
			gap: 0.8rem;
			margin-top: 1.2rem;
		}
		.btn {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-weight: 600;
			cursor: pointer;
			transition: background 0.2s;
		}
		.btn:hover { background: var(--accent-hover); }
		.btn-secondary {
			background: var(--gray-light);
			border: 1px solid var(--card-border);
			color: var(--text-main);
		}
		.btn-secondary:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 工具主体计算卡片 -->
	<div class="tool-box">
		<div class="option-group">
			<label class="radio-label">
				<input type="radio" name="fmtType" value="currency" checked /> Currency Format (Dollars & Cents)
			</label>
			<label class="radio-label">
				<input type="radio" name="fmtType" value="plain" /> Plain Number Words
			</label>
		</div>

		<div class="field-group">
			<label for="numInput">Input Amount or Number:</label>
			<input type="number" id="numInput" value="1250.50" step="any" placeholder="Type a number, e.g. 1250.50" />
		</div>

		<div class="field-group">
			<label for="wordsOutput">Converted Words Result:</label>
			<textarea id="wordsOutput" readonly placeholder="Resulting English words will appear here..."></textarea>
		</div>

		<div class="btn-group">
			<button class="btn btn-secondary" id="btnClear">Clear</button>
			<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy Result</button>
		</div>
	</div>

	<!-- FAQ 模块区 (挂载至 ToolLayout 的 faq 插槽) -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ Frequently Asked Questions (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端脚本 (挂载至 scripts 插槽，添加 DOMContentLoaded 机制) -->
	<script slot="scripts">
		function initTool() {
			const numInput = document.getElementById('numInput');
			const wordsOutput = document.getElementById('wordsOutput');
			const fmtRadios = document.querySelectorAll('input[name="fmtType"]');

			const units = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
			const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

			function convertChunk(num) {
				let str = '';
				if (num >= 100) {
					str += units[Math.floor(num / 100)] + ' Hundred ';
					num %= 100;
				}
				if (num >= 20) {
					str += tens[Math.floor(num / 10)] + (num % 10 > 0 ? ' ' + units[num % 10] : '');
				} else if (num > 0) {
					str += units[num];
				}
				return str.trim();
			}

			function numberToWords(num) {
				if (num === 0) return 'Zero';
				let integerPart = Math.floor(Math.abs(num));
				let result = '';

				const thousands = ['', 'Thousand', 'Million', 'Billion', 'Trillion'];
				let i = 0;

				while (integerPart > 0) {
					let chunk = integerPart % 1000;
					if (chunk > 0) {
						let chunkText = convertChunk(chunk);
						result = chunkText + (thousands[i] ? ' ' + thousands[i] : '') + (result ? ' ' + result : '');
					}
					integerPart = Math.floor(integerPart / 1000);
					i++;
				}

				return result.trim();
			}

			function updateConversion() {
				const val = parseFloat(numInput?.value);
				if (isNaN(val)) {
					if (wordsOutput) wordsOutput.value = '';
					return;
				}

				const isCurrency = document.querySelector('input[name="fmtType"]:checked')?.value === 'currency';

				const absVal = Math.abs(val);
				const dollars = Math.floor(absVal);
				const cents = Math.round((absVal - dollars) * 100);

				const dollarsText = numberToWords(dollars);

				if (isCurrency) {
					let finalStr = `${dollarsText} ${dollars === 1 ? 'Dollar' : 'Dollars'}`;
					if (cents > 0) {
						const centsText = numberToWords(cents);
						finalStr += ` and ${centsText} ${cents === 1 ? 'Cent' : 'Cents'}`;
					}
					if (wordsOutput) wordsOutput.value = finalStr;
				} else {
					let finalStr = dollarsText;
					if (cents > 0) {
						finalStr += ` Point ${numberToWords(cents)}`;
					}
					if (wordsOutput) wordsOutput.value = finalStr;
				}
			}

			numInput?.addEventListener('input', updateConversion);
			fmtRadios.forEach(radio => radio.addEventListener('change', updateConversion));

			document.getElementById('btnClear')?.addEventListener('click', () => {
				if (numInput) numInput.value = '';
				if (wordsOutput) wordsOutput.value = '';
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!wordsOutput || !wordsOutput.value) return;
				navigator.clipboard.writeText(wordsOutput.value);
				const btn = e.target;
				const originalText = btn.textContent;
				btn.textContent = 'Copied!';
				setTimeout(() => { btn.textContent = originalText; }, 2000);
			});

			updateConversion();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initTool);
		} else {
			initTool();
		}
	</script>
</ToolLayout>
