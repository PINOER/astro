---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "Number to English Words & Currency Converter",
	description: "Fast, 100% private online tool to convert numbers and currency amounts into English words for invoices and checks.",
	icon: "🔢",
	tag: "Finance",
	keywords: "number to words converter currency to words generator invoice number in words check spelling"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.option-group {
				display: flex;
				gap: 1rem;
				margin-bottom: 1.2rem;
				flex-wrap: wrap;
			}
			.radio-label {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.9rem;
				color: var(--text-main);
				cursor: pointer;
				font-weight: 600;
			}
			.field-group {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				margin-bottom: 1.2rem;
			}
			label {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--text-main);
			}
			input[type="number"] {
				width: 100%;
				padding: 0.7em 0.9em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 1.1rem;
				font-weight: 700;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			input[type="number"]:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			textarea {
				width: 100%;
				height: 120px;
				padding: 1em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 10px;
				color: var(--text-main);
				font-size: 1rem;
				font-weight: 600;
				font-family: inherit;
				box-sizing: border-box;
				outline: none;
				resize: vertical;
				line-height: 1.5;
			}
			.btn-group {
				display: flex;
				gap: 0.8rem;
				margin-top: 1.2rem;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* Content Sections */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🔢 {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="option-group">
					<label class="radio-label">
						<input type="radio" name="fmtType" value="currency" checked /> Currency Format (Dollars & Cents)
					</label>
					<label class="radio-label">
						<input type="radio" name="fmtType" value="plain" /> Plain Number Words
					</label>
				</div>

				<div class="field-group">
					<label for="numInput">Input Amount or Number:</label>
					<input type="number" id="numInput" value="1250.50" step="any" placeholder="Type a number, e.g. 1250.50" />
				</div>

				<div class="field-group">
					<label for="wordsOutput">Converted Words Result:</label>
					<textarea id="wordsOutput" readonly placeholder="Resulting English words will appear here..."></textarea>
				</div>

				<div class="btn-group">
					<button class="btn btn-secondary" id="btnClear">Clear</button>
					<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">Copy Result</button>
				</div>
			</div>

			<!-- FAQ Section -->
			<section class="content-section">
				<h2>Frequently Asked Questions (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>Why write invoice amounts in words?</h3>
						<p>Writing currency amounts in full English words on official invoices or financial checks prevents fraud, tampering, and misinterpretation of decimal points.</p>
					</div>
					<div class="faq-item">
						<h3>How are cents represented in invoice format?</h3>
						<p>For amounts like `$1,250.50`, standard commercial format converts it to <strong>"One Thousand Two Hundred Fifty Dollars and Fifty Cents"</strong>.</p>
					</div>
					<div class="faq-item">
						<h3>Is my data private?</h3>
						<p><strong>Yes.</strong> All conversions are executed 100% locally in your web browser. No numbers or financial values leave your device.</p>
					</div>
				</div>
			</section>

			<!-- Related Tools Section -->
			<section class="content-section">
				<h2>You Might Also Like</h2>
				<div class="related-grid">
					<a href="/tools/freelance-hourly-rate-calculator/" class="related-card">
						<span class="card-icon">💼</span>
						<div>
							<h4>Freelance Hourly Rate Calculator</h4>
							<p>Compute required hourly rates based on target annual income.</p>
						</div>
					</a>
					<a href="/tools/ecommerce-profit-margin-calculator/" class="related-card">
						<span class="card-icon">🧮</span>
						<div>
							<h4>E-commerce Margin Calculator</h4>
							<p>Calculate net profit margins and breakeven sale prices.</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "Why write invoice amounts in words?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Writing currency amounts in full English words on invoices prevents fraud and misinterpretation of decimal points."
						}
					},
					{
						"@type": "Question",
						"name": "Is my data private?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes. All conversions are executed 100% locally in your web browser."
						}
					}
				]
			}
		</script>

		<script>
			const numInput = document.getElementById('numInput') as HTMLInputElement;
			const wordsOutput = document.getElementById('wordsOutput') as HTMLTextAreaElement;
			const fmtRadios = document.querySelectorAll('input[name="fmtType"]');

			const units = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
			const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

			function convertChunk(num: number): string {
				let str = '';
				if (num >= 100) {
					str += units[Math.floor(num / 100)] + ' Hundred ';
					num %= 100;
				}
				if (num >= 20) {
					str += tens[Math.floor(num / 10)] + (num % 10 > 0 ? ' ' + units[num % 10] : '');
				} else if (num > 0) {
					str += units[num];
				}
				return str.trim();
			}

			function numberToWords(num: number): string {
				if (num === 0) return 'Zero';
				let integerPart = Math.floor(Math.abs(num));
				let result = '';

				const thousands = ['', 'Thousand', 'Million', 'Billion', 'Trillion'];
				let i = 0;

				while (integerPart > 0) {
					let chunk = integerPart % 1000;
					if (chunk > 0) {
						let chunkText = convertChunk(chunk);
						result = chunkText + (thousands[i] ? ' ' + thousands[i] : '') + (result ? ' ' + result : '');
					}
					integerPart = Math.floor(integerPart / 1000);
					i++;
				}

				return result.trim();
			}

			function updateConversion() {
				const val = parseFloat(numInput.value);
				if (isNaN(val)) {
					wordsOutput.value = '';
					return;
				}

				const isCurrency = (document.querySelector('input[name="fmtType"]:checked') as HTMLInputElement)?.value === 'currency';

				const absVal = Math.abs(val);
				const dollars = Math.floor(absVal);
				const cents = Math.round((absVal - dollars) * 100);

				const dollarsText = numberToWords(dollars);

				if (isCurrency) {
					let finalStr = `${dollarsText} ${dollars === 1 ? 'Dollar' : 'Dollars'}`;
					if (cents > 0) {
						const centsText = numberToWords(cents);
						finalStr += ` and ${centsText} ${cents === 1 ? 'Cent' : 'Cents'}`;
					}
					wordsOutput.value = finalStr;
				} else {
					let finalStr = dollarsText;
					if (cents > 0) {
						finalStr += ` Point ${numberToWords(cents)}`;
					}
					wordsOutput.value = finalStr;
				}
			}

			numInput?.addEventListener('input', updateConversion);
			fmtRadios.forEach(radio => radio.addEventListener('change', updateConversion));

			document.getElementById('btnClear')?.addEventListener('click', () => {
				numInput.value = '';
				wordsOutput.value = '';
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!wordsOutput.value) return;
				navigator.clipboard.writeText(wordsOutput.value);
				const btn = e.target as HTMLButtonElement;
				btn.textContent = 'Copied!';
				setTimeout(() => { btn.textContent = 'Copy Result'; }, 2000);
			});

			updateConversion();
		</script>
	</body>
</html>
