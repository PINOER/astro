---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_DESCRIPTION } from 'src/consts';
import { getCollection } from 'astro:content';
import { sponsorItems } from 'src/data/tools'; // 专门用于广告赞助卡片

export const prerender = false;

// 1. SSR 阶段尝试读取后台 KV 自定义覆盖配置 (config_tools_v2_zh)
let kvToolsConfigMap = new Map();
try {
	const runtime = (Astro.locals as any).runtime;
	const kv = runtime?.env?.ADMIN_KV;
	if (kv) {
		const raw = await kv.get('config_tools_v2_zh');
		if (raw) {
			const list = JSON.parse(raw);
			list.forEach((item: any) => {
				if (item.slug) kvToolsConfigMap.set(item.slug, item);
			});
		}
	}
} catch (e) {
	console.warn('SSR 读取 Cloudflare KV 失败，全量保持原生前端配置:', e);
}

// 2. 自动化扫描与源码精准解析，获取原生初始 display
const toolFilesRaw = import.meta.glob('/src/pages/zh/tools/*.astro', { query: '?raw', eager: true });
const toolFiles = import.meta.glob('/src/pages/zh/tools/*.astro', { eager: true });

const zhTools = Object.entries(toolFiles).map(([path, file]: [string, any]) => {
	const slug = path.split('/').pop().replace('.astro', '');
	
	// 从 .astro 页面提取元数据并结合源码正则
	let rawFm: any = file.frontmatter || file.toolMeta || file.toolInfo || {};
	const rawContent = (toolFilesRaw[path] as any)?.default || '';
	
	if (rawContent) {
		try {
			const match = rawContent.match(/(?:export\s+)?const\s+(?:frontmatter|toolMeta|toolInfo|meta)\s*=\s*(\{[\s\S]*?\});/);
			if (match && match[1]) {
				const parsed = new Function(`return ${match[1]}`)();
				rawFm = { ...rawFm, ...parsed };
			}
		} catch (e) {}
	}
	
	// ⚡ 1. 提取前端原生默认配置
	const defaultTitle = rawFm.title || rawFm.name || slug;
	const defaultDesc = rawFm.description || rawFm.desc || '';
	const defaultIcon = rawFm.icon || '⚡';
	const defaultTag = rawFm.tag || rawFm.category || '工具';
	const defaultPriority = rawFm.priority || rawFm.defaultPriority || 0;

	// ⚡ 2. 获取 KV 中的配置
	const kvConfig = kvToolsConfigMap.get(slug) || {};

	// ⚡ 3. 字段级精准覆盖：只有在 KV 中显式修改过且不为空时才使用 KV 值；未修改 100% 使用源码定义
	const finalTitle = (kvConfig.name && kvConfig.name.trim() !== '' && kvConfig.name !== slug) ? kvConfig.name : defaultTitle;
	const finalDesc = (kvConfig.description && kvConfig.description.trim() !== '') ? kvConfig.description : defaultDesc;
	const finalIcon = (kvConfig.icon && kvConfig.icon.trim() !== '' && kvConfig.icon !== '🛠️') ? kvConfig.icon : defaultIcon;
	const finalTag = (kvConfig.category && kvConfig.category.trim() !== '' && kvConfig.category !== 'general') ? kvConfig.category : defaultTag;
	const finalPriority = kvConfig.priority !== undefined ? kvConfig.priority : defaultPriority;

	return {
		id: kvConfig.id || rawFm.id || slug,
		slug: slug,
		title: finalTitle,
		desc: finalDesc,
		url: `/zh/tools/${slug}/`,
		type: 'tool',
		icon: finalIcon,
		tag: finalTag,
		keywords: `${finalTitle} ${rawFm.keywords || ''}`,
		pinned: kvConfig.isFeatured || rawFm.pinned || false,
		priority: finalPriority,
		status: kvConfig.status || 'active'
	};
}).filter(t => t.status !== 'disabled');

// 3. 自动从 Content Collection 获取中文博客
const allPosts = await getCollection('blog');
const zhPosts = allPosts.filter((post) => post.data?.lang === 'zh' || post.id.startsWith('zh/'));

// 4. 组装全量搜索项 (Tools + Blogs + Sponsors)
const rawItems = [
	...zhTools,
	...zhPosts.map((post) => ({
		id: post.id,
		slug: post.id,
		title: post.data.title,
		desc: post.data.description,
		url: `/blog/${post.id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '')}/`,
		type: 'blog',
		icon: '📚',
		tag: '教程指南',
		keywords: `${post.data.title} ${post.data.description}`,
		pinned: (post.data as any).pinned || false,
		priority: (post.data as any).priority || 0,
		status: 'active'
	})),
	...(sponsorItems.zh || []).map((sponsor) => ({
		id: sponsor.url,
		slug: sponsor.url,
		title: sponsor.title,
		desc: sponsor.desc,
		url: sponsor.url,
		type: 'sponsor',
		icon: sponsor.icon,
		tag: sponsor.tag,
		keywords: sponsor.keywords,
		pinned: sponsor.pinned,
		priority: sponsor.priority,
		status: 'active'
	}))
];

// 静态初始排序：置顶优先 -> Priority 降序
const allSearchableItems = rawItems.sort((a, b) => {
	if (a.pinned && !b.pinned) return -1;
	if (!a.pinned && b.pinned) return 1;
	return (b.priority || 0) - (a.priority || 0);
});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`微帮工具箱 - 免费在线高效 AI 工具箱 | 提示词、创作者、站长 SEO & 金融计算工具 - HelpMini`} description={'HelpMini 是专为跨境卖家、内容创作者与开发者打造的免费在线 AI 工具箱。提供专业级男装/女装 AI 商拍提示词生成器、社媒文案生成、Google SEO 与 GEO 结构化代码工具、以及跨境电商利润与金融计算器。无需注册，即用即走，为你提升数倍生产力效率！'} />
		<style>
			/* 🛡️ 强制全屏盒模型，防止横向或纵向坍塌 */
			:global(html, body) {
				width: 100% !important;
				min-height: 100vh !important;
				margin: 0 !important;
				padding: 0 !important;
				box-sizing: border-box !important;
			}

			:global(body) {
				display: flex !important;
				flex-direction: column !important;
				align-items: center !important; /* 保持子元素居中对齐 */
			}

			/* ⚡ 核心修复：强制 Header 和 Footer 宽度 100% 占满全屏，禁止缩小 */
			:global(header), :global(footer) {
				width: 100% !important;
				max-width: 100% !important;
				flex-shrink: 0 !important;
				box-sizing: border-box !important;
			}

			/* 🛡️ 限定 Main 内容区居中并占据剩余高度 */
			main {
				flex: 1 0 auto;
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 1em 4em;
				box-sizing: border-box;
			}

			.hero {
				text-align: center;
				padding: 2em 0 2.5em;
				position: relative;
			}
			.badge {
				display: inline-block;
				background: var(--badge-bg);
				color: var(--badge-color);
				border: 1px solid var(--badge-border);
				padding: 0.4em 1.2em;
				border-radius: 20px;
				font-size: 0.85rem;
				font-weight: 600;
				margin-bottom: 1.5em;
				box-shadow: 0 0 15px rgba(99, 102, 241, 0.15);
				transition: all 0.3s ease;
			}
			.hero h1 {
				font-size: 3.5rem;
				font-weight: 800;
				margin-bottom: 0.4em;
				line-height: 1.2;
				letter-spacing: -1px;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.hero p {
				font-size: 0.95rem;
				color: var(--text-muted);
				max-width: 600px;
				margin: 0 auto 2em;
				line-height: 1.6;
			}

			/* 🔍 中央搜索框 */
			.search-wrapper {
				max-width: 640px;
				margin: 0 auto 2.5em;
				position: relative;
			}
			.search-input-box {
				width: 100%;
				padding: 1.1em 1.5em 1.1em 3.2em;
				background: var(--search-bg);
				backdrop-filter: blur(16px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				color: var(--text-main);
				font-size: 1.05rem;
				outline: none;
				box-sizing: border-box;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
				transition: all 0.3s ease;
			}
			.search-input-box:focus {
				border-color: var(--accent);
				box-shadow: 0 0 25px var(--accent-glow);
			}
			.search-icon {
				position: absolute;
				left: 1.2em;
				top: 50%;
				transform: translateY(-50%);
				font-size: 1.2rem;
				opacity: 0.6;
				pointer-events: none;
			}

			/* 📦 标头区 */
			.section-title-wrapper {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.2rem;
			}
			.section-title {
				font-size: 1.35rem;
				font-weight: 700;
				letter-spacing: -0.5px;
				color: var(--text-main);
				margin: 0;
			}
			.result-count-badge {
				font-size: 0.82rem;
				color: var(--text-muted);
				font-weight: 600;
				background: var(--gray-light);
				padding: 0.25em 0.7em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
			}

			/* ⚡ 3列网格 */
			.tool-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
			}

			.tool-card {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 1.8rem;
				text-decoration: none !important;
				color: var(--text-main);
				display: flex;
				flex-direction: column;
				position: relative;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
				transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
				box-sizing: border-box;
			}

			.tool-card:hover {
				transform: translateY(-6px);
				border-color: var(--accent);
				box-shadow: 0 12px 30px -5px var(--accent-glow);
			}

			.tool-icon {
				font-size: 2.2rem;
				margin-bottom: 1rem;
				line-height: 1;
			}

			.tool-card h3 {
				font-size: 1.25rem;
				font-weight: 700;
				margin-bottom: 0.6rem;
				color: var(--text-main);
				line-height: 1.3;
			}

			.tool-card p {
				font-size: 0.92rem;
				color: var(--text-muted);
				flex: 1;
				margin-bottom: 1.2rem;
				line-height: 1.6;
			}

			.tool-card-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: auto;
			}

			.tool-tag {
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			.tag-tool { color: var(--cyan); }
			.tag-blog { color: var(--accent); }
			.tag-sponsor { color: #f59e0b; }

			.type-badge {
				font-size: 0.7rem;
				padding: 0.2em 0.6em;
				border-radius: 6px;
				font-weight: 700;
				text-transform: uppercase;
			}
			.badge-tool { background: rgba(6, 182, 212, 0.15); color: var(--cyan); border: 1px solid rgba(6, 182, 212, 0.25); }
			.badge-blog { background: rgba(99, 102, 241, 0.15); color: var(--accent); border: 1px solid rgba(99, 102, 241, 0.25); }
			.badge-sponsor { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }

			.pinned-icon {
				position: absolute;
				top: 1rem;
				right: 1rem;
				font-size: 0.9rem;
				opacity: 0.8;
			}

			.pagination-wrapper {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 1rem;
				margin-top: 3em;
			}
			.page-btn {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.6em 1.2em;
				border-radius: 10px;
				font-weight: 600;
				font-size: 0.9rem;
				cursor: pointer;
				transition: all 0.2s ease;
			}
			.page-btn:hover:not(:disabled) {
				border-color: var(--accent);
				color: var(--accent);
				transform: translateY(-2px);
			}
			.page-btn:disabled {
				opacity: 0.4;
				cursor: not-allowed;
			}
			.page-info {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--text-muted);
			}

			.no-results {
				text-align: center;
				padding: 4em 1em;
				color: var(--text-muted);
				grid-column: 1 / -1;
				display: none;
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<section class="hero">
				<div class="badge">🚀 微帮 AI 工具箱，为生产力提速</div>
				<h1>HelpMini</h1>
				
				<div class="search-wrapper">
					<span class="search-icon">🔍</span>
					<input
						type="text"
						id="searchInput"
						class="search-input-box"
						placeholder="搜索工具、教程文档或关键词... (例如 SEO、Token、JSON)"
						autocomplete="off"
					/>
				</div>
			</section>

			<section>
				<div class="section-title-wrapper">
					<h2 id="sectionTitle" class="section-title">精选微工具</h2>
					<span id="resultCount" class="result-count-badge"></span>
				</div>
				
				<div id="contentGrid" class="tool-grid">
					{allSearchableItems.map((item) => (
						<a 
							href={item.url} 
							class="tool-card searchable-item"
							data-id={item.id}
							data-slug={item.slug}
							data-type={item.type}
							data-priority={item.priority}
							data-pinned={item.pinned ? 'true' : 'false'}
							data-title={item.title.toLowerCase()}
							data-desc={item.desc.toLowerCase()}
							data-keywords={item.keywords.toLowerCase()}
							target={item.url.startsWith('http') ? '_blank' : '_self'}
							rel={item.url.startsWith('http') ? 'noopener' : ''}
						>
							<span class="pinned-icon" style={item.pinned ? 'display:block' : 'display:none'} title="已置顶">📌</span>
							<div class="tool-icon">{item.icon}</div>
							<h3>{item.title}</h3>
							<p>{item.desc}</p>
							<div class="tool-card-footer">
								<span class={`tool-tag tag-${item.type}`}>{item.tag || '工具'}</span>
								<span class={`type-badge badge-${item.type}`}>{item.type === 'sponsor' ? '赞助' : (item.type === 'blog' ? '博客' : '工具')}</span>
							</div>
						</a>
					))}

					<div id="noResults" class="no-results">
						<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔍</div>
						<p style="font-size: 1.1rem; font-weight: 600;">未找到匹配的工具或文档</p>
						<p style="font-size: 0.85rem; opacity: 0.8;">尝试搜索其他关键词，例如 "SEO"、"JSON" 或 "Token"</p>
					</div>
				</div>

				<div id="pagination" class="pagination-wrapper">
					<button id="prevBtn" class="page-btn">← 上一页</button>
					<span id="pageInfo" class="page-info">第 1 页</span>
					<button id="nextBtn" class="page-btn">下一页 →</button>
				</div>
			</section>

			<section class="hero" style="padding-top: 4em;">
				<p>轻量、即时且强劲的 AI 辅助工具，为你的生产力效率提升数倍。</p>
			</section>
		</main>
		<Footer lang="zh" />

		<!-- 客户端 JS -->
		<script is:inline>
			const ITEMS_PER_PAGE = 21;
			let currentPage = 1;
			let filteredItems = [];

			const searchInput = document.getElementById('searchInput');
			const sectionTitle = document.getElementById('sectionTitle');
			const resultCount = document.getElementById('resultCount');
			let items = Array.from(document.querySelectorAll('.searchable-item'));
			const noResults = document.getElementById('noResults');

			const pagination = document.getElementById('pagination');
			const prevBtn = document.getElementById('prevBtn');
			const nextBtn = document.getElementById('nextBtn');
			const pageInfo = document.getElementById('pageInfo');

			function renderPage() {
				const query = searchInput?.value.toLowerCase().trim() || '';
				const totalItems = filteredItems.length;
				const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

				if (currentPage > totalPages) currentPage = totalPages;
				if (currentPage < 1) currentPage = 1;

				const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
				const endIndex = startIndex + ITEMS_PER_PAGE;

				items.forEach(item => item.style.display = 'none');
				
				const visibleItems = filteredItems.slice(startIndex, endIndex);
				visibleItems.forEach(item => item.style.display = 'flex');

				if (sectionTitle) sectionTitle.textContent = query ? '搜索结果' : '精选微工具';
				if (resultCount) resultCount.textContent = `共 ${totalItems} 个工具/文档`;

				if (noResults) {
					noResults.style.display = totalItems === 0 ? 'block' : 'none';
				}

				if (pagination) {
					if (totalItems <= ITEMS_PER_PAGE) {
						pagination.style.display = 'none';
					} else {
						pagination.style.display = 'flex';
						if (pageInfo) pageInfo.textContent = `第 ${currentPage} / ${totalPages} 页`;
						if (prevBtn) prevBtn.disabled = currentPage === 1;
						if (nextBtn) nextBtn.disabled = currentPage === totalPages;
					}
				}
			}

			function handleSearch() {
				const query = searchInput?.value.toLowerCase().trim() || '';

				filteredItems = items.filter(item => {
					if (item.dataset.disabled === 'true') return false;

					const title = item.getAttribute('data-title') || '';
					const desc = item.getAttribute('data-desc') || '';
					const keywords = item.getAttribute('data-keywords') || '';
					return title.includes(query) || desc.includes(query) || keywords.includes(query);
				});

				currentPage = 1;
				renderPage();
			}

			async function syncKvManagementAndSorting() {
				try {
					const toolsRes = await fetch('/api/admin/config?type=tools_v2_zh');
					const toolsJson = await toolsRes.json();
					
					if (toolsJson.success && Array.isArray(toolsJson.data)) {
						const kvToolMap = new Map();
						toolsJson.data.forEach(t => kvToolMap.set(t.slug, t));

						items.forEach(card => {
							if (card.dataset.type === 'tool') {
								const slug = card.dataset.slug;
								const conf = kvToolMap.get(slug);

								if (conf) {
									if (conf.status === 'disabled') {
										card.dataset.disabled = 'true';
									} else {
										card.dataset.disabled = 'false';
										
										if (conf.name && conf.name.trim() !== '' && conf.name !== slug) {
											const h3 = card.querySelector('h3');
											if (h3) h3.textContent = conf.name;
											card.setAttribute('data-title', conf.name.toLowerCase());
										}
										if (conf.icon && conf.icon.trim() !== '' && conf.icon !== '🛠️') {
											const iconEl = card.querySelector('.tool-icon');
											if (iconEl) iconEl.textContent = conf.icon;
										}
										if (conf.description && conf.description.trim() !== '') {
											const p = card.querySelector('p');
											if (p) p.textContent = conf.description;
											card.setAttribute('data-desc', conf.description.toLowerCase());
										}
										if (conf.category && conf.category.trim() !== '' && conf.category !== 'general') {
											const tagEl = card.querySelector('.tool-tag');
											if (tagEl) tagEl.textContent = conf.category;
										}
									}
								}
							}
						});
					}

					const res = await fetch('/api/admin/config?type=sorting_v3');
					const result = await res.json();

					if (result.success && result.data) {
						const kvConfig = result.data;
						const grid = document.getElementById('contentGrid');
						const now = new Date().getTime();

						items.forEach((card) => {
							const id = card.dataset.id;
							const conf = kvConfig[id];

							if (conf) {
								let isExpired = false;
								if (conf.expiresAt) {
									const expTime = new Date(conf.expiresAt).getTime();
									if (now > expTime) isExpired = true;
								}

								if (conf.status === 'disabled') {
									card.dataset.disabled = 'true';
								} else {
									if (isExpired) {
										card.dataset.pinned = 'false';
									} else {
										card.dataset.priority = conf.priority;
										card.dataset.pinned = conf.pinned ? 'true' : 'false';
									}

									const pinnedIcon = card.querySelector('.pinned-icon');
									if (pinnedIcon) {
										pinnedIcon.style.display = (conf.pinned && !isExpired) ? 'block' : 'none';
									}
								}
							}
						});

						items.sort((a, b) => {
							const isPinnedA = a.dataset.pinned === 'true';
							const isPinnedB = b.dataset.pinned === 'true';

							if (isPinnedA !== isPinnedB) return isPinnedA ? -1 : 1;
							return Number(b.dataset.priority || 0) - Number(a.dataset.priority || 0);
						});

						items.forEach((card) => {
							if (noResults) grid.insertBefore(card, noResults);
						});
					}

					handleSearch();
				} catch (e) {
					console.warn('同步后台配置失败，使用前台默认规则');
				}
			}

			prevBtn?.addEventListener('click', () => {
				if (currentPage > 1) {
					currentPage--;
					renderPage();
					window.scrollTo({ top: 300, behavior: 'smooth' });
				}
			});

			nextBtn?.addEventListener('click', () => {
				const totalPages = Math.ceil(filteredItems.length / ITEMS_PER_PAGE);
				if (currentPage < totalPages) {
					currentPage++;
					renderPage();
					window.scrollTo({ top: 300, behavior: 'smooth' });
				}
			});

			searchInput?.addEventListener('input', handleSearch);

			filteredItems = [...items];
			renderPage();

			syncKvManagementAndSorting();
		</script>
	</body>
</html>
