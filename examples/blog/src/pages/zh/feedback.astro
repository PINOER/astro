---
export const prerender = false;

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const pageTitle = `发送反馈 — ${SITE_TITLE}`;
const pageDescription = "提交您的意见、建议或 Bug 反馈，帮助我们将 HelpMini 打造得更好。";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 700px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.page-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.form-box {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.form-group {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				margin-bottom: 1.2rem;
			}
			.form-group label {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--text-main);
			}
			input[type="text"], input[type="email"], select, textarea {
				width: 100%;
				padding: 0.7em 0.9em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 0.92rem;
				outline: none;
				box-sizing: border-box;
			}
			textarea {
				height: 120px;
				resize: vertical;
			}
			.btn-submit {
				background: var(--accent);
				color: #fff;
				border: none;
				padding: 0.7em 1.5em;
				border-radius: 8px;
				font-weight: 700;
				cursor: pointer;
				width: 100%;
				transition: opacity 0.2s;
			}
			.btn-submit:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="page-header">
				<h1>💬 发送意见与反馈</h1>
				<p style="color:var(--text-muted);">告诉我们您希望增加的新工具，或提交遇到的问题。</p>
			</div>

			<div class="form-box">
				<form id="feedbackForm">
					<div class="form-group">
						<label for="feedbackType">反馈类型</label>
						<select id="feedbackType">
							<option value="提议新功能/新工具">提议新功能 / 新工具</option>
							<option value="提交 Bug 报告">提交 Bug 报告</option>
							<option value="其他综合建议">其他综合建议</option>
						</select>
					</div>

					<div class="form-group">
						<label for="contactEmail">您的联系邮箱（选填）</label>
						<input type="email" id="contactEmail" placeholder="name@example.com" />
					</div>

					<div class="form-group">
						<label for="feedbackContent">反馈详情</label>
						<textarea id="feedbackContent" required placeholder="请详细描述您的想法或遇到的问题..."></textarea>
					</div>

					<button type="submit" class="btn-submit" id="btnSubmit">提交反馈</button>
				</form>
			</div>
		</main>
		<Footer lang="zh" />

<script>
	document.getElementById('feedbackForm')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const btn = document.getElementById('btnSubmit') as HTMLButtonElement;
		
		const typeEl = document.getElementById('feedbackType') as HTMLSelectElement;
		const emailEl = document.getElementById('contactEmail') as HTMLInputElement;
		const contentEl = document.getElementById('feedbackContent') as HTMLTextAreaElement;

		const payload = {
			type: typeEl?.value || '其他综合建议',
			email: emailEl?.value || '',
			content: contentEl?.value || '',
		};

		if (btn) {
			btn.textContent = '提交中...';
			btn.disabled = true;
		}

		try {
			const res = await fetch('/api/feedback', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload)
			});

			// ⚡ 先读取文本，防止服务器返回 HTML 导致 JSON 解析崩溃
			const responseText = await res.text();
			let result;

			try {
				result = JSON.parse(responseText);
			} catch (parseErr) {
				// 如果后端返回的不是 JSON（比如 Cloudflare 的 404 HTML 页面）
				throw new Error(`服务器未正确响应 JSON (状态码: ${res.status})。原始内容: ${responseText.substring(0, 150)}`);
			}

			if (res.ok && result.success) {
				btn.textContent = '感谢您的反馈！数据已成功提交。';
			} else {
				alert('后端业务报错：' + (result.error || '未知错误'));
				if (btn) {
					btn.textContent = '重新提交';
					btn.disabled = false;
				}
			}
		} catch (err: any) {
			// ⚡ 这里会弹出最真实的底层错误（一眼就能看出是 404 还是 KV 挂载问题）
			alert('【排查捕获】' + err.message);
			if (btn) {
				btn.textContent = '重新提交';
				btn.disabled = false;
			}
		}
	});
</script>
	</body>
</html>
