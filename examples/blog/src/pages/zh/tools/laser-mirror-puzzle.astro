---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: '儿童编程互动游戏：激光折射大挑战（Laser & Mirror Reflex）',
	description: '免安装！通过旋转与调整平面镜角度，控制激光束绕过障碍物并精确击中目标感应靶心，培养孩子空间几何预判、物理光学与逆向推理能力。',
	icon: '🧭',
	tag: '儿童编程',
	keywords: '激光折射 激光迷宫 光学反射 空间几何 逆向思维 物理小游戏 少儿编程',
	pinned: false,
	priority: 86
};

const pageTitle = `儿童编程互动游戏：激光折射大挑战 — ${SITE_TITLE}`;
const pageDescription = '通过旋转平面镜引导激光束避开障碍物并精准点亮感应靶心，体验空间几何与光学反射的乐趣！';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1120px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em 3em;
				box-sizing: border-box;
			}

			.tool-header {
				text-align: center;
				margin-bottom: 1.2em;
			}

			.tool-header h1 {
				font-size: clamp(1.3rem, 4vw, 2.1rem);
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.tool-header p {
				color: var(--text-muted);
				font-size: clamp(0.85rem, 2.2vw, 0.95rem);
			}

			.game-container {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 320px;
				gap: 1.2rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.2rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
				box-sizing: border-box;
			}

			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.8rem;
				width: 100%;
			}

			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.8rem;
				width: 100%;
				background: var(--search-bg);
				padding: 0.5em 0.8em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.88rem;
				box-sizing: border-box;
			}

			.level-select {
				max-width: 180px;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.35em 0.5em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.85rem;
				outline: none;
				cursor: pointer;
			}

			.laser-board {
				position: relative;
				width: 100%;
				aspect-ratio: 1 / 1;
				max-height: 48vh;
				background: #090d16;
				border: 2px solid #334155;
				border-radius: 16px;
				overflow: hidden;
				display: flex;
				justify-content: center;
				align-items: center;
				box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
				cursor: pointer;
			}

			#laserCanvas {
				width: 100%;
				height: 100%;
				display: block;
			}

			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 0.8rem;
				min-width: 0;
				width: 100%;
			}

			.panel-section {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.7rem;
				box-sizing: border-box;
			}

			.section-title {
				font-size: 0.82rem;
				font-weight: 700;
				color: var(--text-muted);
				margin-bottom: 0.5rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.target-card {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 0.6rem 0.8rem;
				font-size: 0.82rem;
				color: var(--text-muted);
				line-height: 1.4;
			}

			.btn-action {
				width: 100%;
				padding: 0.65em;
				border-radius: 10px;
				font-weight: 800;
				font-size: 0.88rem;
				cursor: pointer;
				border: none;
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				transition: all 0.15s ease;
			}

			.btn-action:hover {
				border-color: var(--accent);
			}

			.game-message {
				min-height: 1.2em;
				padding: 0.5rem 0.8rem;
				border-radius: 10px;
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				font-size: 0.82rem;
				font-weight: 700;
				text-align: center;
				color: var(--text-muted);
			}

			.game-message.success {
				color: #10b981;
				border-color: rgba(16, 185, 129, 0.5);
			}

			@media (max-width: 900px) {
				.game-container {
					grid-template-columns: 1fr;
				}

				.editor-box {
					max-width: 520px;
					margin: 0 auto;
				}
			}

			/* 📱 手机端视口自适应压缩 */
			@media (max-width: 600px) {
				main {
					padding: 0.2em 0.5em 1em;
				}

				.tool-header p {
					display: none;
				}

				.tool-header h1 {
					font-size: 1.15rem;
					margin-bottom: 0;
				}

				.game-container {
					padding: 0.5rem;
					gap: 0.5rem;
				}

				.level-bar {
					padding: 0.35em 0.6em;
					font-size: 0.78rem;
				}

				.level-select {
					max-width: 130px;
					padding: 0.2em 0.3em;
					font-size: 0.78rem;
				}

				.laser-board {
					max-height: 38vh !important;
				}

				.target-card {
					padding: 0.4rem 0.6rem;
					font-size: 0.78rem;
				}

				.btn-action {
					padding: 0.5em;
					font-size: 0.82rem;
				}
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>🧭 儿童编程小工具：激光折射大挑战</h1>
				<p>点击网格中的平面镜旋转朝向，引导发射器发出的红光绕过障碍物，精确击中绿色目标靶心！</p>
			</div>

			<div class="game-container">
				<div class="stage-box">
					<div class="level-bar">
						<label>
							关卡：
							<select id="levelSelect" class="level-select" aria-label="选择关卡"></select>
						</label>
						<span>🎯 目标状态：<span id="targetStatus" style="color:#ef4444;">未点亮</span></span>
					</div>

					<div class="laser-board">
						<canvas id="laserCanvas" width="600" height="600"></canvas>
					</div>
				</div>

				<div class="editor-box">
					<div class="panel-section">
						<div class="section-title">💡 玩法说明</div>
						<div class="target-card" id="levelGoalText">点击地图上的平面镜可以切换其朝向角度（/ 或 \）。改变光束传播路径，点亮靶心即可通关！</div>
					</div>

					<button class="btn-action" id="btnResetLevel" type="button">🔄 重置镜子朝向</button>

					<div class="game-message" id="gameMessage" aria-live="polite">请点击镜子调整激光折射方向！</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			const GRID_SIZE = 6;
			const LEVELS = [
				{
					id: 1,
					title: '第 1 关：单镜折射入门',
					laser: { x: 0, y: 2, dir: 'RIGHT' }, // dir: 'UP', 'RIGHT', 'DOWN', 'LEFT'
					target: { x: 2, y: 5, inDir: 'UP' },
					walls: [],
					mirrors: [{ x: 2, y: 2, orient: 'BACK' }], // orient: 'SLASH' (/), 'BACK' (\)
					goal: '点击旋转镜子，将水平激光折射向下击中底部的靶心。'
				},
				{
					id: 2,
					title: '第 2 关：双重折射绕路',
					laser: { x: 1, y: 0, dir: 'DOWN' },
					target: { x: 4, y: 5, inDir: 'UP' },
					walls: [{ x: 1, y: 3 }],
					mirrors: [
						{ x: 1, y: 2, orient: 'SLASH' },
						{ x: 4, y: 2, orient: 'SLASH' }
					],
					goal: '利用两块平面镜把向下发射的激光进行两次 90° 折射，避开墙壁。'
				},
				{
					id: 3,
					title: '第 3 关：S型光轨迷宫',
					laser: { x: 0, y: 1, dir: 'RIGHT' },
					target: { x: 5, y: 4, inDir: 'LEFT' },
					walls: [{ x: 2, y: 1 }, { x: 3, y: 4 }],
					mirrors: [
						{ x: 1, y: 1, orient: 'BACK' },
						{ x: 1, y: 4, orient: 'SLASH' },
						{ x: 4, y: 4, orient: 'BACK' },
						{ x: 4, y: 1, orient: 'BACK' }
					],
					goal: '调整 4 块平面镜的角度，引导激光穿过复杂通道击中目标。'
				},
				{
					id: 4,
					title: '第 4 关：窄缝穿梭预判',
					laser: { x: 2, y: 0, dir: 'DOWN' },
					target: { x: 2, y: 5, inDir: 'UP' },
					walls: [{ x: 2, y: 2 }],
					mirrors: [
						{ x: 2, y: 1, orient: 'SLASH' },
						{ x: 0, y: 1, orient: 'SLASH' },
						{ x: 0, y: 3, orient: 'SLASH' },
						{ x: 2, y: 3, orient: 'SLASH' }
					],
					goal: '利用四周镜子绕开中间的墙壁阻挡，精准回归原路线。'
				},
				{
					id: 5,
					title: '第 5 关：终极光影挑战',
					laser: { x: 0, y: 0, dir: 'RIGHT' },
					target: { x: 5, y: 5, inDir: 'UP' },
					walls: [{ x: 2, y: 0 }, { x: 3, y: 3 }],
					mirrors: [
						{ x: 1, y: 0, orient: 'SLASH' },
						{ x: 1, y: 3, orient: 'SLASH' },
						{ x: 5, y: 3, orient: 'BACK' }
					],
					goal: '考验空间预判能力，找到光束完美反射的唯一角度模式！'
				}
			];

			const canvas = document.getElementById('laserCanvas');
			const ctx = canvas.getContext('2d');
			const levelSelect = document.getElementById('levelSelect');
			const targetStatusEl = document.getElementById('targetStatus');
			const levelGoalTextEl = document.getElementById('levelGoalText');
			const gameMessageEl = document.getElementById('gameMessage');
			const btnResetLevel = document.getElementById('btnResetLevel');

			let currentLevelIdx = 0;
			let levelState = null;
			let isHitTarget = false;

			LEVELS.forEach((lvl, idx) => {
				const opt = document.createElement('option');
				opt.value = String(idx);
				opt.textContent = lvl.title;
				levelSelect.appendChild(opt);
			});

			function initLevel(idx) {
				currentLevelIdx = idx;
				levelSelect.value = String(idx);
				const template = LEVELS[idx];

				levelState = {
					...template,
					mirrors: template.mirrors.map((m) => ({ ...m }))
				};

				levelGoalTextEl.textContent = levelState.goal;
				isHitTarget = false;
				targetStatusEl.textContent = '未点亮';
				targetStatusEl.style.color = '#ef4444';
				gameMessageEl.textContent = '点击平面镜旋转朝向，调整折射角度！';
				gameMessageEl.classList.remove('success');

				renderBoard();
			}

			function computeLaserPath() {
				const path = [];
				let currX = levelState.laser.x;
				let currY = levelState.laser.y;
				let currDir = levelState.laser.dir;

				path.push({ x: currX, y: currY });

				const dirMap = {
					UP: { dx: 0, dy: -1 },
					RIGHT: { dx: 1, dy: 0 },
					DOWN: { dx: 0, dy: 1 },
					LEFT: { dx: -1, dy: 0 }
				};

				const reflectMap = {
					SLASH: { // '/'
						UP: 'RIGHT',
						RIGHT: 'UP',
						DOWN: 'LEFT',
						LEFT: 'DOWN'
					},
					BACK: { // '\'
						UP: 'LEFT',
						LEFT: 'UP',
						DOWN: 'RIGHT',
						RIGHT: 'DOWN'
					}
				};

				let stepLimit = 30;
				isHitTarget = false;

				while (stepLimit-- > 0) {
					const delta = dirMap[currDir];
					const nextX = currX + delta.dx;
					const nextY = currY + delta.dy;

					// 超出边界
					if (nextX < 0 || nextX >= GRID_SIZE || nextY < 0 || nextY >= GRID_SIZE) {
						path.push({ x: nextX, y: nextY });
						break;
					}

					// 遇到墙壁
					const hitWall = levelState.walls.some((w) => w.x === nextX && w.y === nextY);
					if (hitWall) {
						path.push({ x: nextX, y: nextY });
						break;
					}

					currX = nextX;
					currY = nextY;
					path.push({ x: currX, y: currY });

					// 命中目标靶心
					if (currX === levelState.target.x && currY === levelState.target.y) {
						if (currDir === levelState.target.inDir) {
							isHitTarget = true;
						}
						break;
					}

					// 遇到镜子折射
					const mirror = levelState.mirrors.find((m) => m.x === currX && m.y === currY);
					if (mirror) {
						currDir = reflectMap[mirror.orient][currDir];
					}
				}

				return path;
			}

			function renderBoard() {
				const cellWidth = canvas.width / GRID_SIZE;
				const cellHeight = canvas.height / GRID_SIZE;

				ctx.fillStyle = '#090d16';
				ctx.fillRect(0, 0, canvas.width, canvas.height);

				// 绘制网格背景
				ctx.strokeStyle = '#1e293b';
				ctx.lineWidth = 1;
				for (let i = 0; i <= GRID_SIZE; i++) {
					ctx.beginPath();
					ctx.moveTo(i * cellWidth, 0);
					ctx.lineTo(i * cellWidth, canvas.height);
					ctx.stroke();

					ctx.beginPath();
					ctx.moveTo(0, i * cellHeight);
					ctx.lineTo(canvas.width, i * cellHeight);
					ctx.stroke();
				}

				// 绘制墙壁
				levelState.walls.forEach((w) => {
					ctx.fillStyle = '#334155';
					ctx.fillRect(w.x * cellWidth + 4, w.y * cellHeight + 4, cellWidth - 8, cellHeight - 8);
					ctx.fillStyle = '#475569';
					ctx.font = '20px sans-serif';
					ctx.textAlign = 'center';
					ctx.textBaseline = 'middle';
					ctx.fillText('🧱', (w.x + 0.5) * cellWidth, (w.y + 0.5) * cellHeight);
				});

				// 计算并绘制激光路径
				const path = computeLaserPath();
				if (path.length > 1) {
					ctx.strokeStyle = '#ef4444';
					ctx.shadowColor = '#ef4444';
					ctx.shadowBlur = 12;
					ctx.lineWidth = 5;
					ctx.lineCap = 'round';
					ctx.beginPath();

					path.forEach((pt, idx) => {
						const cx = (pt.x + 0.5) * cellWidth;
						const cy = (pt.y + 0.5) * cellHeight;
						if (idx === 0) ctx.moveTo(cx, cy);
						else ctx.lineTo(cx, cy);
					});
					ctx.stroke();
					ctx.shadowBlur = 0;
				}

				// 绘制激光发射器
				const lX = (levelState.laser.x + 0.5) * cellWidth;
				const lY = (levelState.laser.y + 0.5) * cellHeight;
				ctx.fillStyle = '#ef4444';
				ctx.shadowColor = '#ef4444';
				ctx.shadowBlur = 10;
				ctx.beginPath();
				ctx.arc(lX, lY, 14, 0, Math.PI * 2);
				ctx.fill();
				ctx.shadowBlur = 0;
				ctx.fillStyle = '#fff';
				ctx.font = '12px sans-serif';
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';
				ctx.fillText('🔫', lX, lY);

				// 绘制感应靶心
				const tX = (levelState.target.x + 0.5) * cellWidth;
				const tY = (levelState.target.y + 0.5) * cellHeight;
				ctx.fillStyle = isHitTarget ? '#10b981' : '#f59e0b';
				ctx.shadowColor = ctx.fillStyle;
				ctx.shadowBlur = isHitTarget ? 20 : 5;
				ctx.beginPath();
				ctx.arc(tX, tY, 16, 0, Math.PI * 2);
				ctx.fill();
				ctx.shadowBlur = 0;
				ctx.fillStyle = '#fff';
				ctx.font = '14px sans-serif';
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';
				ctx.fillText(isHitTarget ? '🎯' : '⭐', tX, tY);

				// 绘制平面镜
				levelState.mirrors.forEach((m) => {
					const mx = (m.x + 0.5) * cellWidth;
					const my = (m.y + 0.5) * cellHeight;
					const offset = cellWidth * 0.3;

					ctx.strokeStyle = '#06b6d4';
					ctx.shadowColor = '#06b6d4';
					ctx.shadowBlur = 8;
					ctx.lineWidth = 6;
					ctx.lineCap = 'round';
					ctx.beginPath();

					if (m.orient === 'SLASH') { // '/'
						ctx.moveTo(mx - offset, my + offset);
						ctx.lineTo(mx + offset, my - offset);
					} else { // '\'
						ctx.moveTo(mx - offset, my - offset);
						ctx.lineTo(mx + offset, my + offset);
					}
					ctx.stroke();
					ctx.shadowBlur = 0;
				});

				// 状态响应
				if (isHitTarget) {
					targetStatusEl.textContent = '已点亮';
					targetStatusEl.style.color = '#10b981';
					gameMessageEl.textContent = '🎉 成功点亮目标靶心！过关！';
					gameMessageEl.classList.add('success');
				} else {
					targetStatusEl.textContent = '未点亮';
					targetStatusEl.style.color = '#ef4444';
					gameMessageEl.classList.remove('success');
				}
			}

			// 点击旋转平面镜
			canvas.addEventListener('click', (e) => {
				const rect = canvas.getBoundingClientRect();
				const clickX = ((e.clientX - rect.left) / rect.width) * canvas.width;
				const clickY = ((e.clientY - rect.top) / rect.height) * canvas.height;

				const cellWidth = canvas.width / GRID_SIZE;
				const cellHeight = canvas.height / GRID_SIZE;

				const gx = Math.floor(clickX / cellWidth);
				const gy = Math.floor(clickY / cellHeight);

				const mirror = levelState.mirrors.find((m) => m.x === gx && m.y === gy);
				if (mirror) {
					mirror.orient = mirror.orient === 'SLASH' ? 'BACK' : 'SLASH';
					renderBoard();
				}
			});

			levelSelect.addEventListener('change', (e) => {
				initLevel(Number.parseInt(e.target.value, 10));
			});

			btnResetLevel.addEventListener('click', () => {
				initLevel(currentLevelIdx);
			});

			initLevel(0);
		</script>
	</body>
</html>
