---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
    title: "儿童 C 语言与 Arduino 趣味编程 AI 教程生成器",
    description: "专为青少年与家长设计的 C 语言/C++ 趣味启蒙小工具！将枯燥的 C 语言语法、变量与指针转化为童话冒险关卡、Arduino 硬件项目与信奥赛入门教案。",
    icon: "⚙️",
    tag: "儿童编程",
    keywords: "儿童C语言 C++少儿编程 Arduino硬件编程 信奥赛CSP-J 语法童话化 编程教案生成器",
    pinned: true,
    priority: 89
};

const pageTitle = `儿童 C 语言与 Arduino 趣味编程 AI 教程生成器 — ${SITE_TITLE}`;
const pageDescription = "专为青少年设计的 C 语言趣味启蒙工具！将枯燥语法转化为童话冒险关卡与 Arduino 机器人实践。";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.5rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			.form-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.2rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 1.8rem;
				backdrop-filter: blur(12px);
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
				margin-bottom: 2rem;
			}
			.form-group {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.form-group.full-width {
				grid-column: 1 / -1;
			}
			label {
				font-size: 0.88rem;
				font-weight: 700;
				color: var(--text-main);
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			label .sub-tag {
				font-size: 0.75rem;
				color: var(--text-muted);
				font-weight: normal;
			}

			input[type="text"], select, textarea {
				width: 100%;
				padding: 0.75em 1em;
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 0.92rem;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			input[type="text"]:focus, select:focus, textarea:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}

			.output-card {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 1.5rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
				margin-bottom: 1.5rem;
			}
			.output-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1rem;
			}
			.output-title {
				font-size: 1.05rem;
				font-weight: 700;
				color: var(--text-main);
			}
			.btn-copy {
				background: var(--accent);
				color: #ffffff;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-size: 0.88rem;
				font-weight: 700;
				cursor: pointer;
				transition: all 0.2s ease;
			}
			.btn-copy:hover {
				background: var(--accent-hover);
				transform: translateY(-1px);
			}
			.prompt-output {
				width: 100%;
				height: 160px;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 10px;
				padding: 1rem;
				color: var(--text-main);
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.9rem;
				line-height: 1.6;
				resize: vertical;
				box-sizing: border-box;
				outline: none;
			}

			.toast {
				position: fixed;
				bottom: 2rem;
				right: 2rem;
				background: var(--accent);
				color: #fff;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-size: 0.88rem;
				font-weight: 600;
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
				opacity: 0;
				transform: translateY(10px);
				transition: all 0.3s ease;
				pointer-events: none;
				z-index: 100;
			}
			.toast.show {
				opacity: 1;
				transform: translateY(0);
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>⚙️ 儿童 C 语言与 Arduino 趣味编程 AI 教程生成器</h1>
				<p>把抽象的 C 语言语法（变量、指针、循环、分支）转译为童话游戏、Arduino 智能小车与信奥赛入门关卡，助孩子无痛掌握硬核代码。</p>
			</div>

			<div class="form-grid">
				<!-- 应用场景与学习方向 -->
				<div class="form-group">
					<label for="modeSelect">学习方向与实践平台 (Learning Path)</label>
					<select id="modeSelect">
						<option value="C 语言纯软件趣味编程 (控制台小游戏)">C 语言纯软件 (字符小游戏 / 控制台冒险，适合 9-12 岁)</option>
						<option value="Arduino 硬件智能控制 (LED/蜂鸣器/小车)">Arduino 智能硬件 (控制 LED 闪烁 / 超声波测距小车)</option>
						<option value="C++ 与信奥赛 (CSP-J) 基础思维训练">C++ 与信奥赛 CSP-J (基础算法 / 逻辑解题入门)</option>
					</select>
				</div>

				<!-- 核心知识点 -->
				<div class="form-group">
					<label for="conceptSelect">核心 C 语言知识点 (C Language Concept)</label>
					<select id="conceptSelect">
						<option value="变量与数据类型 (int/float/char) 比作不同大小的魔法盒子">变量与数据类型 (int, float, char - 魔法盒子)</option>
						<option value="输入与输出 (printf/scanf) 比作小喇叭与魔法接收器">输入输出 (printf/scanf - 魔法喇叭与耳麦)</option>
						<option value="逻辑分支 (if-else) 比作森林分叉路口的守卫">逻辑分支 (if-else - 城堡分叉路口)</option>
						<option value="循环控制 (for/while) 比作小骑士的魔法重复诅咒">循环结构 (for/while - 魔法定时圈)</option>
						<option value="数组与列表 (Arrays) 比作一排有编号的宝藏格子">一维数组 (Array - 连体宝箱格)</option>
						<option value="指针与内存地址 (Pointers) 比作藏宝图上的地图坐标">指针概念 (Pointers - 门牌号与地图坐标)</option>
					</select>
				</div>

				<!-- 趣味冒险主题 -->
				<div class="form-group">
					<label for="themeSelect">关卡故事包装 (Gamified Theme)</label>
					<select id="themeSelect">
						<option value="🏰 魔法城堡通关 (用 C 语言解开门禁密码)">🏰 魔法城堡解谜 (密码与逻辑判断)</option>
						<option value="🏎️ 赛车场智能仪表盘 (用 Arduino 控制速度与灯光)">🏎️ 赛车控制台 (测速与灯光闪烁)</option>
						<option value="🤖 机器人保镖养成 (用函数和循环赋予动作)">🤖 机器人保镖 (指令集与函数封装)</option>
						<option value="🏴‍☠️ 金银岛寻宝记 (用数组和指针寻找藏宝坐标)">🏴‍☠️ 金银岛寻宝 (数组与坐标寻址)</option>
					</select>
				</div>

				<!-- 年龄与认知水平 -->
				<div class="form-group">
					<label for="ageSelect">孩子年龄段 (Target Age Group)</label>
					<select id="ageSelect">
						<option value="9-11 岁 (初次接触文本代码，需要极度故事化和图解)">9-11 岁 (需高度比喻、极简代码与图解)</option>
						<option value="12-14 岁 (具备基础逻辑，注重硬核语法与项目实操)">12-14 岁 (注重规范语法、调试技巧与实战项目)</option>
					</select>
				</div>

				<!-- 可选：遇到报错/具体难题 -->
				<div class="form-group full-width">
					<label for="bugInput">
						代码答疑或报错辅助 (Optional: C Error Assistance)
						<span class="sub-tag">可选：输入孩子遇到的报错信息（如 segmentation fault 或缺少分号），生成儿童听得懂的解释</span>
					</label>
					<input type="text" id="bugInput" placeholder="例如：提示 expected ';' before 'return'，或者不知道怎么用 for 循环画金字塔" />
				</div>
			</div>

			<!-- 结果输出 -->
			<div class="output-card">
				<div class="output-header">
					<span class="output-title">✨ 生成的儿童 C 语言趣味 AI 教学 Prompt (粘贴给 ChatGPT / 豆包)</span>
					<button class="btn-copy" id="btnCopy">📋 一键复制 Prompt</button>
				</div>
				<textarea id="promptOutput" class="prompt-output" readonly></textarea>
			</div>
		</main>

		<div id="toast" class="toast">Prompt 已成功复制到剪贴板！</div>

		<Footer lang="zh" />

		<Script is:inline>
			const modeSelect = document.getElementById('modeSelect');
			const conceptSelect = document.getElementById('conceptSelect');
			const themeSelect = document.getElementById('themeSelect');
			const ageSelect = document.getElementById('ageSelect');
			const bugInput = document.getElementById('bugInput');

			const promptOutput = document.getElementById('promptOutput');
			const btnCopy = document.getElementById('btnCopy');
			const toast = document.getElementById('toast');

			function buildPrompt() {
				const mode = modeSelect.value;
				const concept = conceptSelect.value;
				const theme = themeSelect.value;
				const age = ageSelect.value;
				const bug = bugInput.value.trim();

				const bugText = bug ? `\n【孩子遇到的问题/报错】: ${bug}\n请针对这个报错用极其温柔幽默、孩子能听懂的方式进行答疑，不要使用晦涩的专业术语。` : '';

				const prompt = `你是一位精通 C/C++ 语言且极其擅长少儿 STEM 启蒙的高级教育专家。

请为我设计一份适合 ${age} 儿童学习的 C 语言趣味教学教案。

【教学设定与要求】：
1. 学习路径/平台: ${mode}
2. 本节核心知识点: ${concept}
3. 故事包装主题: ${theme}${bugText}

【请按以下儿童友好型结构输出】：

一、🪄 概念趣味化大白话比喻 (把抽象 C 语法变具象)：
- 用生动的故事或生活中的物品（如收纳盒、快递地址、分叉路口）来解释这个 C 语言概念，严禁直接堆砌术语。

二、🎮 关卡冒险任务与极简 C 代码：
- 给出一段符合 C 语言/C++ 规范、极其干净且带丰富童趣注释的代码（不超过 15-20 行）。
- 如果涉及 Arduino，请注明管脚引脚接法（如 LED 接 Pin 13）。

三、🔍 语法小避坑 (小精灵提醒)：
- 提醒孩子容易遗漏的 C 语言小细节（例如：句尾的“分号 ;”、大括号 {} 的匹配、或者 printf 中的 %d 占位符），比作“防止代码魔法失效的小秘密”。

四、🏆 挑战升级 (动手小实践)：
- 留 1 个简单的改代码挑战，鼓励孩子动手修改数字或参数，观察程序的有趣变化。`;

				promptOutput.value = prompt;
			}

			// 监听所有输入与下拉框
			[modeSelect, conceptSelect, themeSelect, ageSelect, bugInput].forEach(el => {
				el?.addEventListener('input', buildPrompt);
				el?.addEventListener('change', buildPrompt);
			});

			buildPrompt();

			// 一键复制
			btnCopy?.addEventListener('click', () => {
				if (!promptOutput.value) return;
				navigator.clipboard.writeText(promptOutput.value).then(() => {
					toast.classList.add('show');
					setTimeout(() => toast.classList.remove('show'), 2000);
				});
			});
		</script>
	</body>
</html>
