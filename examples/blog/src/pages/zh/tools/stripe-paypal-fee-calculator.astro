---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "Stripe & PayPal 手续费与净收入计算器",
	description: "免费在线计算 Stripe 和 PayPal 交易手续费、扣费后净收入，以及反推实收目标金额所需向客户开具的报价金额。",
	icon: "💳",
	tag: "财务工具",
	keywords: "Stripe手续费计算器 PayPal手续费计算器 跨境支付扣费 净收入计算 提成计算器 独立站收款",
	pinned: false,
	priority: 88
};

const pageTitle = `Stripe & PayPal 手续费计算器 — ${SITE_TITLE}`;
const pageDescription = "免费在线计算 Stripe 和 PayPal 交易手续费、扣费后净收入，以及反推实收目标金额所需向客户开具的报价金额。";

const faqList = [
	{
		question: "Stripe 的标准交易手续费是多少？",
		answer: "Stripe 在美国的标准费率为 2.9% + $0.30（每笔成功交易）。如果使用国际银行卡或涉及货币转换，通常会额外增加 1% 的国际卡转换费。"
	},
	{
		question: "什么是“反向推算报价金额（Ask Amount）”？",
		answer: "当您希望最终到手刚好拿到 $100 净收入时，如果直接向客户收取 $100，扣除手续费后您实际到手会小于 $100。反向推算可以计算出您需要向客户开具多少金额的账单（如 $103.30），才能在扣除手续费后刚好净收 $100。"
	},
	{
		question: "这个计算器的计算结果准确吗？",
		answer: "计算器内置了 Stripe 和 PayPal 的官方标准费率公式。但不同国家/地区、不同账户级别（如大客户优惠费率）或微支付（Micropayments）可能会有微小差异，建议以最终支付网关账单为准。"
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<style>
			main {
				width: 850px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}

			/* 参数配置区域 */
			.preset-row {
				display: flex;
				gap: 0.6rem;
				margin-bottom: 1.5rem;
				flex-wrap: wrap;
			}
			.preset-btn {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.5em 0.9em;
				border-radius: 8px;
				font-size: 0.85rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s;
			}
			.preset-btn:hover, .preset-btn.active {
				border-color: var(--accent);
				color: var(--accent);
				background: var(--badge-bg);
			}

			.form-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1.2rem;
				margin-bottom: 1.5rem;
			}
			.form-group {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}
			.form-group label {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--text-main);
			}
			input[type="number"], select {
				width: 100%;
				padding: 0.6em 0.8em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 0.95rem;
				outline: none;
				box-sizing: border-box;
				transition: border-color 0.2s;
			}
			input[type="number"]:focus, select:focus {
				border-color: var(--accent);
			}

			/* 结果双卡片展示 */
			.results-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 1.2rem;
				margin-top: 1.5rem;
			}
			.result-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 1.5em;
			}
			.result-card h3 {
				margin: 0 0 1rem 0;
				font-size: 1.05rem;
				color: var(--text-main);
				display: flex;
				align-items: center;
				justify-content: space-between;
			}
			.result-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0.5rem 0;
				border-bottom: 1px dashed var(--card-border);
				font-size: 0.9rem;
			}
			.result-row:last-child {
				border-bottom: none;
				padding-top: 0.8rem;
				font-weight: 700;
				font-size: 1.05rem;
			}
			.val-highlight {
				color: var(--accent);
			}
			.val-fee {
				color: #ef4444;
			}

			.faq-section {
				margin-top: 3.5em;
				padding-top: 2em;
				border-top: 1px solid var(--card-border);
			}
			.faq-title {
				font-size: 1.4rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1em;
			}
			.faq-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
				gap: 1.2rem;
			}
			.faq-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 1.2em;
			}
			.faq-card h3 {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-main);
				margin: 0 0 0.5rem 0;
			}
			.faq-card p {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.6;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>💳 Stripe & PayPal 手续费计算器</h1>
				<p>精确计算交易手续费、实际净到手金额，以及将手续费包含在内的客户报价需求</p>
			</div>

			<div class="tool-box">
				<!-- 快速费率预设 -->
				<div class="form-group" style="margin-bottom: 0.8rem;">
					<label>快捷预设费率：</label>
					<div class="preset-row">
						<button class="preset-btn active" data-fee="2.9" data-fix="0.30">Stripe 美国标准 (2.9% + $0.30)</button>
						<button class="preset-btn" data-fee="3.9" data-fix="0.30">Stripe 国际卡 (3.9% + $0.30)</button>
						<button class="preset-btn" data-fee="3.49" data-fix="0.49">PayPal 标准商户 (3.49% + $0.49)</button>
						<button class="preset-btn" data-fee="4.99" data-fix="0.49">PayPal 跨境交易 (4.99% + $0.49)</button>
					</div>
				</div>

				<!-- 参数输入区域 -->
				<div class="form-grid">
					<div class="form-group">
						<label for="amountInput">金额（美元 $）</label>
						<input type="number" id="amountInput" value="100" min="0" step="any" placeholder="输入计算金额" />
					</div>
					<div class="form-group">
						<label for="feePercent">百分比费率 (%)</label>
						<input type="number" id="feePercent" value="2.9" min="0" step="0.01" />
					</div>
					<div class="form-group">
						<label for="feeFixed">每笔固定续费 ($)</label>
						<input type="number" id="feeFixed" value="0.30" min="0" step="0.01" />
					</div>
				</div>

				<!-- 计算结果面板 -->
				<div class="results-grid">
					<!-- 场景 A: 收到指定总额后扣除的费用 -->
					<div class="result-card">
						<h3>向客户收取 <span id="cardA_Amount">$100.00</span> 时：</h3>
						<div class="result-row">
							<span>扣除手续费 (Fees)</span>
							<span class="val-fee" id="cardA_Fee">-$3.20</span>
						</div>
						<div class="result-row">
							<span>实际净到手金额 (You Receive)</span>
							<span class="val-highlight" id="cardA_Net">$96.80</span>
						</div>
					</div>

					<!-- 场景 B: 想要实收目标金额所需向客户开出的报价 -->
					<div class="result-card">
						<h3>若想实收净拿 <span id="cardB_Target">$100.00</span>：</h3>
						<div class="result-row">
							<span>需向客户报价/账单填 (You Should Ask)</span>
							<span class="val-highlight" id="cardB_Ask">$103.30</span>
						</div>
						<div class="result-row">
							<span>其中预计产生的总手续费</span>
							<span class="val-fee" id="cardB_Fee">-$3.30</span>
						</div>
					</div>
				</div>
			</div>

			<section class="faq-section">
				<div class="faq-title">❓ 常见问题解答 (FAQ)</div>
				<div class="faq-grid">
					{faqList.map(item => (
						<div class="faq-card">
							<h3>{item.question}</h3>
							<p>{item.answer}</p>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const amountInput = document.getElementById('amountInput') as HTMLInputElement;
			const feePercent = document.getElementById('feePercent') as HTMLInputElement;
			const feeFixed = document.getElementById('feeFixed') as HTMLInputElement;
			const presetBtns = document.querySelectorAll('.preset-btn');

			// 结果节点
			const cardA_Amount = document.getElementById('cardA_Amount');
			const cardA_Fee = document.getElementById('cardA_Fee');
			const cardA_Net = document.getElementById('cardA_Net');

			const cardB_Target = document.getElementById('cardB_Target');
			const cardB_Ask = document.getElementById('cardB_Ask');
			const cardB_Fee = document.getElementById('cardB_Fee');

			// 预设点击
			presetBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					presetBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');

					const fee = (btn as HTMLElement).dataset.fee || '2.9';
					const fix = (btn as HTMLElement).dataset.fix || '0.30';

					feePercent.value = fee;
					feeFixed.value = fix;
					calculate();
				});
			});

			amountInput?.addEventListener('input', calculate);
			feePercent?.addEventListener('input', calculate);
			feeFixed?.addEventListener('input', calculate);

			function calculate() {
				const amount = parseFloat(amountInput.value) || 0;
				const rate = (parseFloat(feePercent.value) || 0) / 100;
				const fixed = parseFloat(feeFixed.value) || 0;

				// 场景 A: 接收指定总额 Amount
				const feeA = amount * rate + fixed;
				const netA = amount - feeA;

				if (cardA_Amount) cardA_Amount.textContent = `$${amount.toFixed(2)}`;
				if (cardA_Fee) cardA_Fee.textContent = `-$${Math.max(0, feeA).toFixed(2)}`;
				if (cardA_Net) cardA_Net.textContent = `$${Math.max(0, netA).toFixed(2)}`;

				// 场景 B: 想要净拿 Target
				// Target = Ask - (Ask * rate + fixed)  =>  Ask = (Target + fixed) / (1 - rate)
				let askB = 0;
				let feeB = 0;

				if (rate < 1) {
					askB = (amount + fixed) / (1 - rate);
					feeB = askB - amount;
				}

				if (cardB_Target) cardB_Target.textContent = `$${amount.toFixed(2)}`;
				if (cardB_Ask) cardB_Ask.textContent = `$${Math.max(0, askB).toFixed(2)}`;
				if (cardB_Fee) cardB_Fee.textContent = `-$${Math.max(0, feeB).toFixed(2)}`;
			}

			// 初始化计算
			calculate();
		</script>
	</body>
</html>
