---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "小费与聚餐 AA 账单平摊计算器",
	description: "免费且 100% 保护隐私的在线计算器，快速计算餐厅小费金额与多人聚餐 AA 平摊费用。",
	icon: "🍽️",
	tag: "实用工具",
	keywords: "小费计算器 账单平摊 AA制计算器 餐厅小费计算 海外聚餐AA"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.calc-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
			}
			.section-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1rem;
			}
			.field-group {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				margin-bottom: 1rem;
			}
			label {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--text-main);
			}
			input[type="number"] {
				width: 100%;
				padding: 0.7em 0.9em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 0.95rem;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			input[type="number"]:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			.tip-presets {
				display: flex;
				gap: 0.5rem;
				margin-top: 0.3rem;
			}
			.preset-btn {
				flex: 1;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.5em;
				border-radius: 6px;
				font-size: 0.85rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s;
			}
			.preset-btn.active, .preset-btn:hover {
				background: var(--badge-bg);
				color: var(--accent);
				border-color: var(--accent);
			}
			.metrics-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
				margin-bottom: 1.2rem;
			}
			.metric-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				padding: 1rem;
				border-radius: 10px;
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}
			.metric-card.primary {
				border-color: var(--accent);
				background: var(--badge-bg);
			}
			.metric-label {
				font-size: 0.78rem;
				color: var(--text-muted);
				font-weight: 600;
			}
			.metric-value {
				font-size: 1.4rem;
				font-weight: 800;
				color: var(--accent);
			}
			.breakdown-list {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				background: var(--code-bg);
				padding: 1rem;
				border-radius: 10px;
				border: 1px solid var(--card-border);
			}
			.breakdown-item {
				display: flex;
				justify-content: space-between;
				font-size: 0.88rem;
				color: var(--text-muted);
			}
			.breakdown-item strong {
				color: var(--text-main);
			}

			/* FAQ 与相关工具样式 */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.calc-grid, .metrics-grid, .related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🍽️ {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="calc-grid">
					<!-- 输入列 -->
					<div class="input-section">
						<div class="section-title">账单与用餐人数</div>
						
						<div class="field-group">
							<label for="billAmount">账单总金额 ($/￥)</label>
							<input type="number" id="billAmount" value="120.00" step="0.01" min="0" placeholder="未含小费的账单金额" />
						</div>

						<div class="field-group">
							<label for="tipPercent">小费比例 (%)</label>
							<input type="number" id="tipPercent" value="18" step="1" min="0" placeholder="如 18%" />
							<div class="tip-presets">
								<button class="preset-btn" data-tip="15">15%</button>
								<button class="preset-btn active" data-tip="18">18%</button>
								<button class="preset-btn" data-tip="20">20%</button>
								<button class="preset-btn" data-tip="25">25%</button>
							</div>
						</div>

						<div class="field-group">
							<label for="numPeople">聚餐平摊人数 (AA制)</label>
							<input type="number" id="numPeople" value="4" step="1" min="1" placeholder="用餐总人数" />
						</div>
					</div>

					<!-- 输出列 -->
					<div class="output-section">
						<div class="section-title">平摊计算结果</div>

						<div class="metrics-grid">
							<div class="metric-card primary">
								<span class="metric-label">每人应付总额</span>
								<span class="metric-value" id="valPerPerson">$0.00</span>
							</div>

							<div class="metric-card">
								<span class="metric-label">每人应付小费</span>
								<span class="metric-value" id="valTipPerPerson">$0.00</span>
							</div>
						</div>

						<div class="breakdown-list">
							<div class="breakdown-item">
								<span>小费总金额</span>
								<strong id="valTotalTip">$0.00</strong>
							</div>
							<div class="breakdown-item">
								<span>消费总计 (账单 + 小费)</span>
								<strong id="valGrandTotal">$0.00</strong>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- FAQ 模块 -->
			<section class="content-section">
				<h2>常见问题解答 (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>欧美餐厅的小费标准通常是多少？</h3>
						<p>在美国和加拿大，传统堂食服务的小费标准通常在 <strong>15% ~ 20%</strong> 之间。服务正常给 18%，服务非常出色给 20% 及以上。</p>
					</div>
					<div class="faq-item">
						<h3>小费应该按税前还是税后金额计算？</h3>
						<p>按照标准社交礼仪，小费通常基于<strong>税前消费小计（Subtotal）</strong>计算。但在日常支付时，许多人为了简便也会直接按最终含税总额乘以小费比例。</p>
					</div>
					<div class="faq-item">
						<h3>输入的账单金额会被上传吗？</h3>
						<p><strong>绝对不会。</strong> 所有计算均在您的手机或电脑浏览器本地完成，没有任何数据会发送至云端服务器。</p>
					</div>
				</div>
			</section>

			<!-- 相关工具推荐 -->
			<section class="content-section">
				<h2>你可能也会用到</h2>
				<div class="related-grid">
					<a href="/zh/tools/ecommerce-profit-margin-calculator/" class="related-card">
						<span class="card-icon">🧮</span>
						<div>
							<h4>独立站与跨境电商利润计算器</h4>
							<p>精准测算商品净利润率与保本售价。</p>
						</div>
					</a>
					<a href="/zh/tools/word-character-counter/" class="related-card">
						<span class="card-icon">📝</span>
						<div>
							<h4>字数与字符统计工具</h4>
							<p>统计词数、字符数及预估阅读时长。</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ 结构化数据 -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "欧美餐厅的小费标准通常是多少？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "在美国和加拿大，传统堂食服务的小费标准通常在 15% ~ 20% 之间。"
						}
					},
					{
						"@type": "Question",
						"name": "小费应该按税前还是税后金额计算？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "按照标准社交礼仪，小费通常基于税前消费小计（Subtotal）计算。"
						}
					}
				]
			}
		</script>

		<script>
			const billAmountIn = document.getElementById('billAmount') as HTMLInputElement;
			const tipPercentIn = document.getElementById('tipPercent') as HTMLInputElement;
			const numPeopleIn = document.getElementById('numPeople') as HTMLInputElement;

			const valPerPerson = document.getElementById('valPerPerson');
			const valTipPerPerson = document.getElementById('valTipPerPerson');
			const valTotalTip = document.getElementById('valTotalTip');
			const valGrandTotal = document.getElementById('valGrandTotal');
			const presetBtns = document.querySelectorAll('.preset-btn');

			function calculateTip() {
				const bill = parseFloat(billAmountIn.value) || 0;
				const tipRate = (parseFloat(tipPercentIn.value) || 0) / 100;
				const people = Math.max(1, parseInt(numPeopleIn.value) || 1);

				const totalTip = bill * tipRate;
				const grandTotal = bill + totalTip;
				const perPersonTotal = grandTotal / people;
				const perPersonTip = totalTip / people;

				if (valPerPerson) valPerPerson.textContent = `$${perPersonTotal.toFixed(2)}`;
				if (valTipPerPerson) valTipPerPerson.textContent = `$${perPersonTip.toFixed(2)}`;
				if (valTotalTip) valTotalTip.textContent = `$${totalTip.toFixed(2)}`;
				if (valGrandTotal) valGrandTotal.textContent = `$${grandTotal.toFixed(2)}`;
			}

			[billAmountIn, tipPercentIn, numPeopleIn].forEach(input => {
				input?.addEventListener('input', calculateTip);
			});

			presetBtns.forEach(btn => {
				btn.addEventListener('click', (e) => {
					presetBtns.forEach(b => b.classList.remove('active'));
					const target = e.currentTarget as HTMLButtonElement;
					target.classList.add('active');
					const tip = target.getAttribute('data-tip');
					if (tip && tipPercentIn) {
						tipPercentIn.value = tip;
						calculateTip();
					}
				});
			});

			calculateTip();
		</script>
	</body>
</html>
