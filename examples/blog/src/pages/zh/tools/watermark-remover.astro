---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "图片在线去水印工具",
	description: "免费、100% 本地运行的纯前端图片去水印工具，支持涂抹擦除文字、Logo 及仿制图章修复。",
	icon: "🧹",
	tag: "媒体工具",
	keywords: "图片去水印 消除笔 仿制图章 去 Logo 图片修图 纯前端去水印",
	pinned: false,
	priority: 88
};

const pageTitle = `图片在线去水印工具 — ${SITE_TITLE}`;
const pageDescription = "免费、100% 本地运行的纯前端图片去水印工具，支持涂抹擦除文字、Logo 及仿制图章修复。";

// ⚡ 针对去水印工具定制的 SEO FAQ 问答库
const faqList = [
	{
		question: "在线去水印会把我的图片上传到远程服务器吗？",
		answer: "绝对不会。本工具基于 HTML5 Canvas 纯前端技术开发，所有的涂抹、像素分析与图像修复均 100% 在您的浏览器本地完成。您的图片和私密数据永远不会离开您的设备。"
	},
	{
		question: "什么样的图片去水印效果最好？",
		answer: "对于纯色背景、单色渐变或背景纹理规则的图片（例如表格截图、公文印章、角落账号 ID、日期标记等），智能填充模式可以做到近乎完美的无痕擦除；对于带有特定纹理的背景，建议使用“仿制图章”模式按住 Alt 键取样后覆盖。"
	},
	{
		question: "为什么有些复杂背景图片去水印后会出现模糊或光斑？",
		answer: "纯前端算法主要通过分析选区外围的像素进行边缘均值平滑与重组。当背景过于复杂（如人脸、复杂的风景线条）时，传统算法无法生成不存在的细节。建议分批次、小范围涂抹，或配合仿制图章模式多次精细修复。"
	},
	{
		question: "使用本去水印工具是否限制图片大小或收取费用？",
		answer: "完全免费，且没有任何图片数量或导出次数限制。您无需注册或登录账号，打开网页即可无限次使用。"
	}
];

// ⚡ 生成给 Google 爬虫阅读的 Schema.org 结构化数据代码
const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<!-- 注入 Schema 结构化数据，提升 Google 富文本展台展示几率 -->
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 1.8em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}

			/* 控制条设置 */
			.control-bar {
				display: flex;
				gap: 1rem;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				padding-bottom: 1.2em;
				margin-bottom: 1.2em;
				border-bottom: 1px solid var(--card-border);
			}
			.control-group {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}
			.control-group label {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--text-main);
			}
			select, input[type="range"] {
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				padding: 0.4em 0.6em;
				outline: none;
			}

			/* Canvas 工作台区域 */
			.stage-container {
				position: relative;
				width: 100%;
				min-height: 320px;
				background: var(--code-bg);
				border: 2px dashed var(--card-border);
				border-radius: 12px;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				user-select: none;
			}
			.stage-container.has-image {
				border-style: solid;
			}
			.drop-prompt {
				text-align: center;
				cursor: pointer;
				padding: 3em 1em;
			}
			.drop-icon {
				font-size: 2.5rem;
				margin-bottom: 0.4em;
			}
			.drop-text {
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.drop-text span {
				color: var(--accent);
				font-weight: 600;
			}

			/* 画板堆叠层 */
			.canvas-wrapper {
				position: relative;
				display: inline-block;
				max-width: 100%;
				max-height: 550px;
			}
			.canvas-wrapper canvas {
				display: block;
				max-width: 100%;
				max-height: 550px;
				object-fit: contain;
			}
			#maskCanvas {
				position: absolute;
				top: 0;
				left: 0;
				cursor: crosshair;
			}

			/* 底部按钮栏 */
			.btn-group {
				display: flex;
				gap: 0.8rem;
				margin-top: 1.2rem;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s, opacity 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.tip-box {
				font-size: 0.82rem;
				color: var(--text-muted);
				margin-top: 1em;
				line-height: 1.5;
			}

			/* ⚡ 定制 FAQ 样式块 */
			.faq-section {
				margin-top: 3.5em;
				padding-top: 2em;
				border-top: 1px solid var(--card-border);
			}
			.faq-title {
				font-size: 1.4rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1em;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.faq-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
				gap: 1.2rem;
			}
			.faq-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 1.2em;
			}
			.faq-card h3 {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-main);
				margin: 0 0 0.5rem 0;
			}
			.faq-card p {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.6;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🧹 图片在线去水印工具</h1>
				<p>100% 纯浏览器本地处理，快速涂抹擦除图片上的多余文字、Logo 或日期标记</p>
			</div>

			<div class="tool-box">
				<!-- 参数控制栏 -->
				<div class="control-bar" id="controlBar" style="display: none;">
					<div class="control-group">
						<label for="modeSelect">修复模式：</label>
						<select id="modeSelect">
							<option value="smooth" selected>智能填充 (边缘平滑融合)</option>
							<option value="stamp">仿制图章 (取样纹理覆盖)</option>
						</select>
					</div>

					<div class="control-group">
						<label for="brushSize">画笔大小：</label>
						<input type="range" id="brushSize" min="5" max="100" value="25" />
						<span id="brushSizeVal" style="font-size:0.85rem; color:var(--text-muted); width:25px;">25</span>
					</div>

					<div class="control-group" id="stampInfo" style="display: none; font-size: 0.82rem; color: var(--accent);">
						💡 按住 Alt 键并点击图片可设置复制取样点。
					</div>
				</div>

				<!-- 画板主体 -->
				<div class="stage-container" id="stageContainer">
					<div class="drop-prompt" id="dropPrompt">
						<div class="drop-icon">📁</div>
						<div class="drop-text">将图片拖拽至此处，或 <span>点击选择文件</span></div>
						<input type="file" id="fileInput" accept="image/png, image/jpeg, image/webp" style="display: none;" />
					</div>

					<div class="canvas-wrapper" id="canvasWrapper" style="display: none;">
						<canvas id="imageCanvas"></canvas>
						<canvas id="maskCanvas"></canvas>
					</div>
				</div>

				<!-- 底部操作按钮 -->
				<div class="btn-group" id="actionGroup" style="display: none;">
					<div style="display: flex; gap: 0.6rem;">
						<button class="btn btn-secondary" id="btnUndo">撤销涂抹</button>
						<button class="btn btn-secondary" id="btnReset">还原原图</button>
					</div>
					<div style="display: flex; gap: 0.6rem;">
						<button class="btn btn-secondary" id="btnNew">重新传图</button>
						<button class="btn" id="btnDownload">下载处理后的图片</button>
					</div>
				</div>

				<div class="tip-box">
					📌 <strong>使用小技巧：</strong><br/>
					• <strong>智能填充模式：</strong> 适合纯色或渐变背景上的水印（如角落文字、公文印章、日期等），直接涂抹即可。<br/>
					• <strong>仿制图章模式：</strong> 适合有纹理的背景，按住 <code>Alt</code> 键并点击一块干净背景作为源点，再涂抹水印区域进行纹理复制。
				</div>
			</div>

			<!-- ⚡ 页面底部定制 FAQ 区域 -->
			<section class="faq-section">
				<div class="faq-title">❓ 常见问题解答 (FAQ)</div>
				<div class="faq-grid">
					{faqList.map(item => (
						<div class="faq-card">
							<h3>{item.question}</h3>
							<p>{item.answer}</p>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const dropPrompt = document.getElementById('dropPrompt');
			const fileInput = document.getElementById('fileInput') as HTMLInputElement;
			const stageContainer = document.getElementById('stageContainer');
			const canvasWrapper = document.getElementById('canvasWrapper');
			const controlBar = document.getElementById('controlBar');
			const actionGroup = document.getElementById('actionGroup');

			const imageCanvas = document.getElementById('imageCanvas') as HTMLCanvasElement;
			const maskCanvas = document.getElementById('maskCanvas') as HTMLCanvasElement;
			const imgCtx = imageCanvas.getContext('2d')!;
			const maskCtx = maskCanvas.getContext('2d')!;

			const modeSelect = document.getElementById('modeSelect') as HTMLSelectElement;
			const brushSize = document.getElementById('brushSize') as HTMLInputElement;
			const brushSizeVal = document.getElementById('brushSizeVal');
			const stampInfo = document.getElementById('stampInfo');

			const btnUndo = document.getElementById('btnUndo') as HTMLButtonElement;
			const btnReset = document.getElementById('btnReset') as HTMLButtonElement;
			const btnNew = document.getElementById('btnNew') as HTMLButtonElement;
			const btnDownload = document.getElementById('btnDownload') as HTMLButtonElement;

			let loadedImg: HTMLImageElement | null = null;
			let historyStack: ImageData[] = [];
			let isDrawing = false;
			let stampSource: { x: number; y: number } | null = null;

			// 切换模式提示
			modeSelect?.addEventListener('change', () => {
				if (stampInfo) {
					stampInfo.style.display = modeSelect.value === 'stamp' ? 'inline-block' : 'none';
				}
			});

			brushSize?.addEventListener('input', () => {
				if (brushSizeVal) brushSizeVal.textContent = brushSize.value;
			});

			// 上传与加载图片
			dropPrompt?.addEventListener('click', () => fileInput?.click());
			stageContainer?.addEventListener('dragover', (e) => e.preventDefault());
			stageContainer?.addEventListener('drop', (e) => {
				e.preventDefault();
				if (e.dataTransfer?.files.length) loadImage(e.dataTransfer.files[0]);
			});
			fileInput?.addEventListener('change', () => {
				if (fileInput.files?.length) loadImage(fileInput.files[0]);
			});

			function loadImage(file: File) {
				if (!file.type.startsWith('image/')) return;
				const reader = new FileReader();
				reader.onload = (e) => {
					const img = new Image();
					img.onload = () => {
						loadedImg = img;
						initCanvas(img);
					};
					img.src = e.target?.result as string;
				};
				reader.readAsDataURL(file);
			}

			function initCanvas(img: HTMLImageElement) {
				imageCanvas.width = img.width;
				imageCanvas.height = img.height;
				maskCanvas.width = img.width;
				maskCanvas.height = img.height;

				imgCtx.drawImage(img, 0, 0);
				saveState();

				if (dropPrompt && canvasWrapper && controlBar && actionGroup && stageContainer) {
					dropPrompt.style.display = 'none';
					canvasWrapper.style.display = 'block';
					controlBar.style.display = 'flex';
					actionGroup.style.display = 'flex';
					stageContainer.classList.add('has-image');
				}
			}

			function saveState() {
				historyStack.push(imgCtx.getImageData(0, 0, imageCanvas.width, imageCanvas.height));
				if (btnUndo) btnUndo.disabled = historyStack.length <= 1;
			}

			// 画笔涂抹交互
			maskCanvas?.addEventListener('mousedown', (e) => {
				const pos = getCanvasPos(e);
				if (e.altKey && modeSelect.value === 'stamp') {
					stampSource = pos;
					alert(`取样点已设置在坐标 (${Math.round(pos.x)}, ${Math.round(pos.y)})`);
					return;
				}
				isDrawing = true;
				maskCtx.clearRect(0, 0, maskCanvas.width, maskCanvas.height);
				drawStroke(e);
			});

			maskCanvas?.addEventListener('mousemove', (e) => {
				if (!isDrawing) return;
				drawStroke(e);
			});

			window.addEventListener('mouseup', () => {
				if (!isDrawing) return;
				isDrawing = false;
				applyRemover();
				maskCtx.clearRect(0, 0, maskCanvas.width, maskCanvas.height);
				saveState();
			});

			function getCanvasPos(e: MouseEvent) {
				const rect = maskCanvas.getBoundingClientRect();
				const scaleX = maskCanvas.width / rect.width;
				const scaleY = maskCanvas.height / rect.height;
				return {
					x: (e.clientX - rect.left) * scaleX,
					y: (e.clientY - rect.top) * scaleY
				};
			}

			function drawStroke(e: MouseEvent) {
				const pos = getCanvasPos(e);
				const radius = parseInt(brushSize.value) / 2;

				maskCtx.fillStyle = 'rgba(239, 68, 68, 0.5)';
				maskCtx.beginPath();
				maskCtx.arc(pos.x, pos.y, radius, 0, Math.PI * 2);
				maskCtx.fill();
			}

			// 核心去水印算法逻辑
			function applyRemover() {
				const mode = modeSelect.value;
				const size = parseInt(brushSize.value);

				if (mode === 'stamp') {
					if (!stampSource) {
						alert('请先按住 Alt 键并点击图片干净区域设置取样源点！');
						return;
					}
					// 仿制图章算法
					const maskData = maskCtx.getImageData(0, 0, maskCanvas.width, maskCanvas.height);
					const sourceData = imgCtx.getImageData(0, 0, imageCanvas.width, imageCanvas.height);
					const targetData = imgCtx.getImageData(0, 0, imageCanvas.width, imageCanvas.height);

					for (let i = 3; i < maskData.data.length; i += 4) {
						if (maskData.data[i] > 0) { // 涂抹区域
							const pixelIdx = i / 4;
							const x = pixelIdx % maskCanvas.width;
							const y = Math.floor(pixelIdx / maskCanvas.width);

							const srcX = Math.min(Math.max(0, Math.round(stampSource.x + (x - stampSource.x))), imageCanvas.width - 1);
							const srcY = Math.min(Math.max(0, Math.round(stampSource.y + (y - stampSource.y))), imageCanvas.height - 1);
							const srcIdx = (srcY * imageCanvas.width + srcX) * 4;

							targetData.data[i - 3] = sourceData.data[srcIdx];
							targetData.data[i - 2] = sourceData.data[srcIdx + 1];
							targetData.data[i - 1] = sourceData.data[srcIdx + 2];
						}
					}
					imgCtx.putImageData(targetData, 0, 0);
				} else {
					// 智能填充 / 边缘均值平滑算法
					const maskData = maskCtx.getImageData(0, 0, maskCanvas.width, maskCanvas.height);
					const imgData = imgCtx.getImageData(0, 0, imageCanvas.width, imageCanvas.height);
					const pixels = imgData.data;

					for (let y = 0; y < imageCanvas.height; y++) {
						for (let x = 0; x < imageCanvas.width; x++) {
							const idx = (y * imageCanvas.width + x) * 4;
							if (maskData.data[idx + 3] > 0) {
								let r = 0, g = 0, b = 0, count = 0;
								const radius = Math.max(2, Math.floor(size / 3));

								for (let dy = -radius; dy <= radius; dy++) {
									for (let dx = -radius; dx <= radius; dx++) {
										const nx = x + dx;
										const ny = y + dy;
										if (nx >= 0 && nx < imageCanvas.width && ny >= 0 && ny < imageCanvas.height) {
											const nIdx = (ny * imageCanvas.width + nx) * 4;
											// 提取未被涂抹的周围边缘像素
											if (maskData.data[nIdx + 3] === 0) {
												r += pixels[nIdx];
												g += pixels[nIdx + 1];
												b += pixels[nIdx + 2];
												count++;
											}
										}
									}
								}

								if (count > 0) {
									pixels[idx] = r / count;
									pixels[idx + 1] = g / count;
									pixels[idx + 2] = b / count;
								}
							}
						}
					}
					imgCtx.putImageData(imgData, 0, 0);
				}
			}

			// 撤销 / 重置 / 下载等操作
			btnUndo?.addEventListener('click', () => {
				if (historyStack.length > 1) {
					historyStack.pop();
					const prevState = historyStack[historyStack.length - 1];
					imgCtx.putImageData(prevState, 0, 0);
					btnUndo.disabled = historyStack.length <= 1;
				}
			});

			btnReset?.addEventListener('click', () => {
				if (loadedImg) {
					initCanvas(loadedImg);
				}
			});

			btnNew?.addEventListener('click', () => {
				if (dropPrompt && canvasWrapper && controlBar && actionGroup && stageContainer) {
					dropPrompt.style.display = 'block';
					canvasWrapper.style.display = 'none';
					controlBar.style.display = 'none';
					actionGroup.style.display = 'none';
					stageContainer.classList.remove('has-image');
					fileInput.value = '';
					historyStack = [];
					stampSource = null;
				}
			});

			btnDownload?.addEventListener('click', () => {
				const link = document.createElement('a');
				link.download = `erased_image_${Date.now()}.png`;
				link.href = imageCanvas.toDataURL('image/png');
				link.click();
			});
		</script>
	</body>
</html>
