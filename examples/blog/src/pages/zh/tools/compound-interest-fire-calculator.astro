---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: '实用金融小工具：复利与财务自由(FIRE)计算器 (Compound Interest & FIRE Calculator)',
	description: '免安装！直观推演时间与复利带来的滚雪球财富效应，基于4%提款法则诊断你的财务自由(FIRE)进度，支持动态图表与多参数实时计算。',
	icon: '📈',
	tag: '金融理财',
	keywords: '复利计算器 FIRE计算器 财务自由 定投收益率 滚雪球效应 理财规划 资产配置',
	pinned: false,
	priority: 88
};

const pageTitle = `复利与财务自由(FIRE)计算器 — ${SITE_TITLE}`;
const pageDescription = '滑动参数即可实时推演财富积累曲线，直观感受时间与复利的滚雪球力量！';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1120px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em 3em;
				box-sizing: border-box;
			}

			.tool-header {
				text-align: center;
				margin-bottom: 1.2em;
			}

			.tool-header h1 {
				font-size: clamp(1.3rem, 4vw, 2.1rem);
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.tool-header p {
				color: var(--text-muted);
				font-size: clamp(0.85rem, 2.2vw, 0.95rem);
			}

			.calc-container {
				display: grid;
				grid-template-columns: 360px minmax(0, 1fr);
				gap: 1.2rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.2rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
				box-sizing: border-box;
			}

			.input-panel {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.input-group {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem;
				box-sizing: border-box;
			}

			.input-label {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.82rem;
				font-weight: 700;
				color: var(--text-muted);
				margin-bottom: 0.4rem;
			}

			.input-val-tag {
				color: #10b981;
				font-size: 0.95rem;
				font-weight: 800;
			}

			.range-slider {
				width: 100%;
				accent-color: #10b981;
				cursor: pointer;
			}

			.result-panel {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				min-width: 0;
			}

			.kpi-row {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.8rem;
			}

			.kpi-card {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem;
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
			}

			.kpi-title {
				font-size: 0.78rem;
				color: var(--text-muted);
				font-weight: 700;
			}

			.kpi-val {
				font-size: clamp(1.1rem, 2vw, 1.4rem);
				font-weight: 800;
				color: var(--text-main);
			}

			.kpi-val.highlight {
				color: #10b981;
			}

			.kpi-val.sublight {
				color: #3b82f6;
			}

			.chart-card {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 9;
				max-height: 42vh;
				background: #090d16;
				border: 2px solid #334155;
				border-radius: 16px;
				overflow: hidden;
				display: flex;
				box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
			}

			#chartCanvas {
				width: 100%;
				height: 100%;
				display: block;
			}

			.fire-status-card {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem 1rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.82rem;
				line-height: 1.5;
			}

			.fire-badge {
				background: rgba(16, 185, 129, 0.15);
				border: 1px solid rgba(16, 185, 129, 0.4);
				color: #10b981;
				padding: 0.3em 0.8em;
				border-radius: 20px;
				font-weight: 800;
				white-space: nowrap;
			}

			@media (max-width: 900px) {
				.calc-container {
					grid-template-columns: 1fr;
				}

				.input-panel {
					max-width: 520px;
					margin: 0 auto;
					width: 100%;
				}
			}

			/* 📱 手机端视口自适应压缩 */
			@media (max-width: 600px) {
				main {
					padding: 0.2em 0.5em 1em;
				}

				.tool-header p {
					display: none;
				}

				.tool-header h1 {
					font-size: 1.15rem;
					margin-bottom: 0;
				}

				.calc-container {
					padding: 0.5rem;
					gap: 0.5rem;
				}

				.kpi-row {
					grid-template-columns: 1fr;
					gap: 0.4rem;
				}

				.kpi-card {
					padding: 0.5rem;
				}

				.chart-card {
					max-height: 32vh !important;
				}

				.fire-status-card {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>📈 滚雪球效应：复利与财务自由(FIRE)计算器</h1>
				<p>调整初始资金、每月定投和年化收益率，直观推演未来财富暴增的滚雪球曲线！</p>
			</div>

			<div class="calc-container">
				<div class="input-panel">
					<div class="input-group">
						<div class="input-label">
							<span>初始本金 (元)</span>
							<span class="input-val-tag" id="initPrincipalTag">¥ 50,000</span>
						</div>
						<input class="range-slider" id="initPrincipal" type="range" min="0" max="500000" step="5000" value="50000" />
					</div>

					<div class="input-group">
						<div class="input-label">
							<span>每月定投 (元)</span>
							<span class="input-val-tag" id="monthlyInvestTag">¥ 2,000</span>
						</div>
						<input class="range-slider" id="monthlyInvest" type="range" min="0" max="30000" step="500" value="2000" />
					</div>

					<div class="input-group">
						<div class="input-label">
							<span>预期年化收益率 (%)</span>
							<span class="input-val-tag" id="annualReturnTag">8.0 %</span>
						</div>
						<input class="range-slider" id="annualReturn" type="range" min="1" max="18" step="0.5" value="8" />
					</div>

					<div class="input-group">
						<div class="input-label">
							<span>投资时长 (年)</span>
							<span class="input-val-tag" id="yearsTag">20 年</span>
						</div>
						<input class="range-slider" id="years" type="range" min="1" max="40" step="1" value="20" />
					</div>
				</div>

				<div class="result-panel">
					<div class="kpi-row">
						<div class="kpi-card">
							<span class="kpi-title">最终资产预估总额</span>
							<span class="kpi-val highlight" id="kpiTotal">¥ 0</span>
						</div>
						<div class="kpi-card">
							<span class="kpi-title">累计投入本金总计</span>
							<span class="kpi-val" id="kpiPrincipal">¥ 0</span>
						</div>
						<div class="kpi-card">
							<span class="kpi-title">时间产生的复利收益</span>
							<span class="kpi-val sublight" id="kpiInterest">¥ 0</span>
						</div>
					</div>

					<div class="chart-card">
						<canvas id="chartCanvas" width="800" height="450"></canvas>
					</div>

					<div class="fire-status-card">
						<div>
							<div style="font-weight: 800; color: var(--text-main); margin-bottom: 0.2rem;">🔥 财务自由(FIRE)被动收入诊断</div>
							<div style="color: var(--text-muted);" id="fireDesc">基于 4% 安全提款法则计算中...</div>
						</div>
						<div class="fire-badge" id="fireBadge">FIRE 进度计算中</div>
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			const initPrincipalInput = document.getElementById('initPrincipal');
			const monthlyInvestInput = document.getElementById('monthlyInvest');
			const annualReturnInput = document.getElementById('annualReturn');
			const yearsInput = document.getElementById('years');

			const initPrincipalTag = document.getElementById('initPrincipalTag');
			const monthlyInvestTag = document.getElementById('monthlyInvestTag');
			const annualReturnTag = document.getElementById('annualReturnTag');
			const yearsTag = document.getElementById('yearsTag');

			const kpiTotal = document.getElementById('kpiTotal');
			const kpiPrincipal = document.getElementById('kpiPrincipal');
			const kpiInterest = document.getElementById('kpiInterest');
			const fireDesc = document.getElementById('fireDesc');
			const fireBadge = document.getElementById('fireBadge');

			const canvas = document.getElementById('chartCanvas');
			const ctx = canvas.getContext('2d');

			function formatMoney(num) {
				return '¥ ' + Math.round(num).toLocaleString('zh-CN');
			}

			function calculateData() {
				const P = Number.parseFloat(initPrincipalInput.value);
				const PMT = Number.parseFloat(monthlyInvestInput.value);
				const r = Number.parseFloat(annualReturnInput.value) / 100;
				const totalYears = Number.parseInt(yearsInput.value, 10);

				initPrincipalTag.textContent = formatMoney(P);
				monthlyInvestTag.textContent = formatMoney(PMT);
				annualReturnTag.textContent = r * 100 + ' %';
				yearsTag.textContent = totalYears + ' 年';

				const yearlyData = [];
				let currentBalance = P;
				let totalPrincipal = P;

				const rMonthly = r / 12;

				for (let year = 1; year <= totalYears; year++) {
					for (let month = 1; month <= 12; month++) {
						currentBalance = (currentBalance + PMT) * (1 + rMonthly);
						totalPrincipal += PMT;
					}
					yearlyData.push({
						year,
						total: currentBalance,
						principal: totalPrincipal,
						interest: currentBalance - totalPrincipal
					});
				}

				const finalObj = yearlyData[yearlyData.length - 1] || { total: P, principal: P, interest: 0 };
				kpiTotal.textContent = formatMoney(finalObj.total);
				kpiPrincipal.textContent = formatMoney(finalObj.principal);
				kpiInterest.textContent = formatMoney(finalObj.interest);

				// FIRE 诊断 (按 4% 安全提款率)
				const annualPassiveIncome = finalObj.total * 0.04;
				const monthlyPassiveIncome = annualPassiveIncome / 12;

				fireDesc.innerHTML = `到期后，按 4% 提款率每年可被动提取 <strong style="color:#10b981;">${formatMoney(annualPassiveIncome)}</strong>（相当于每月自由资金 <strong style="color:#10b981;">${formatMoney(monthlyPassiveIncome)}</strong>）。`;

				if (monthlyPassiveIncome >= 10000) {
					fireBadge.textContent = '🔥 达成完全财务自由';
					fireBadge.style.color = '#10b981';
					fireBadge.style.background = 'rgba(16, 185, 129, 0.15)';
				} else if (monthlyPassiveIncome >= 5000) {
					fireBadge.textContent = '⚡ 达成半财务自由';
					fireBadge.style.color = '#3b82f6';
					fireBadge.style.background = 'rgba(59, 130, 246, 0.15)';
				} else {
					fireBadge.textContent = '🌱 处于财富积累初期';
					fireBadge.style.color = '#f59e0b';
					fireBadge.style.background = 'rgba(245, 158, 11, 0.15)';
				}

				drawChart(yearlyData);
			}

			function drawChart(data) {
				ctx.fillStyle = '#090d16';
				ctx.fillRect(0, 0, canvas.width, canvas.height);

				if (!data || data.length === 0) return;

				const padding = { top: 40, right: 30, bottom: 50, left: 70 };
				const graphW = canvas.width - padding.left - padding.right;
				const graphH = canvas.height - padding.top - padding.bottom;

				const maxVal = data[data.length - 1].total * 1.1;

				// 网格线与 Y 轴刻度
				ctx.strokeStyle = '#1e293b';
				ctx.lineWidth = 1;
				ctx.fillStyle = '#64748b';
				ctx.font = '12px sans-serif';
				ctx.textAlign = 'right';

				const gridRows = 5;
				for (let i = 0; i <= gridRows; i++) {
					const yVal = (maxVal / gridRows) * i;
					const yPos = canvas.height - padding.bottom - (graphH / gridRows) * i;

					ctx.beginPath();
					ctx.moveTo(padding.left, yPos);
					ctx.lineTo(canvas.width - padding.right, yPos);
					ctx.stroke();

					let labelStr = '¥ ' + (yVal / 10000).toFixed(0) + '万';
					if (yVal >= 10000000) labelStr = '¥ ' + (yVal / 10000000).toFixed(1) + '千万';
					ctx.fillText(labelStr, padding.left - 10, yPos + 4);
				}

				// X 轴刻度
				ctx.textAlign = 'center';
				const step = Math.max(1, Math.floor(data.length / 8));
				data.forEach((d, idx) => {
					if (idx % step === 0 || idx === data.length - 1) {
						const xPos = padding.left + (graphW / (data.length - 1 || 1)) * idx;
						ctx.fillText(`${d.year}年`, xPos, canvas.height - padding.bottom + 20);
					}
				});

				// 绘制本金面积（蓝绿/深蓝色）
				ctx.fillStyle = 'rgba(59, 130, 246, 0.4)';
				ctx.beginPath();
				ctx.moveTo(padding.left, canvas.height - padding.bottom);
				data.forEach((d, idx) => {
					const xPos = padding.left + (graphW / (data.length - 1 || 1)) * idx;
					const yPos = canvas.height - padding.bottom - (d.principal / maxVal) * graphH;
					ctx.lineTo(xPos, yPos);
				});
				ctx.lineTo(canvas.width - padding.right, canvas.height - padding.bottom);
				ctx.closePath();
				ctx.fill();

				// 绘制利息面积（绿金色）
				ctx.fillStyle = 'rgba(16, 185, 129, 0.5)';
				ctx.beginPath();
				data.forEach((d, idx) => {
					const xPos = padding.left + (graphW / (data.length - 1 || 1)) * idx;
					const yTotalPos = canvas.height - padding.bottom - (d.total / maxVal) * graphH;
					if (idx === 0) ctx.moveTo(xPos, yTotalPos);
					else ctx.lineTo(xPos, yTotalPos);
				});
				for (let idx = data.length - 1; idx >= 0; idx--) {
					const xPos = padding.left + (graphW / (data.length - 1 || 1)) * idx;
					const yPrinPos = canvas.height - padding.bottom - (data[idx].principal / maxVal) * graphH;
					ctx.lineTo(xPos, yPrinPos);
				}
				ctx.closePath();
				ctx.fill();

				// 绘制顶部总收益折线 (绿色高亮)
				ctx.strokeStyle = '#10b981';
				ctx.lineWidth = 3;
				ctx.shadowBlur = 10;
				ctx.shadowColor = '#10b981';
				ctx.beginPath();
				data.forEach((d, idx) => {
					const xPos = padding.left + (graphW / (data.length - 1 || 1)) * idx;
					const yPos = canvas.height - padding.bottom - (d.total / maxVal) * graphH;
					if (idx === 0) ctx.moveTo(xPos, yPos);
					else ctx.lineTo(xPos, yPos);
				});
				ctx.stroke();
				ctx.shadowBlur = 0;

				// 图例
				ctx.fillStyle = '#10b981';
				ctx.fillRect(padding.left, 15, 12, 12);
				ctx.fillStyle = '#e2e8f0';
				ctx.textAlign = 'left';
				ctx.fillText('复利收益', padding.left + 18, 25);

				ctx.fillStyle = '#3b82f6';
				ctx.fillRect(padding.left + 100, 15, 12, 12);
				ctx.fillStyle = '#e2e8f0';
				ctx.fillText('投入本金', padding.left + 118, 25);
			}

			[initPrincipalInput, monthlyInvestInput, annualReturnInput, yearsInput].forEach((input) => {
				input.addEventListener('input', calculateData);
			});

			calculateData();
		</script>
	</body>
</html>
