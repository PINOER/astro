---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "AI 男装电商商拍与精准换装/换背景提示词生成器",
	description: "专为男装电商卖家设计的 AI 商拍工具！涵盖男装换装、背景切换、模特姿态视角控制、相机与焦段控制、模特换头、服装与鞋包穿搭组合，适用于 Midjourney, Flux, SDXL 与豆包。",
	icon: "👔",
	tag: "男装商拍",
	keywords: "AI 男装换装 电商商拍 模特角度 模特换头 男装换背景 鞋包穿搭 提示词生成器 midjourney flux 豆包",
	pinned: true,
	priority: 95
};

const faqList = [
	{
		question: "如何利用 AI 提示词实现双图男装精准换装？",
		answer: "在 Midjourney、Flux 或豆包中使用时，建议采用双图参考（Image-to-Image / ControlNet）模式。将目标服装图作为图一、模特原图作为图二，配合本工具生成的规范 Prompt，可精准将服饰纹理迁移至模特身上。"
	},
	{
		question: "如何保持原图模特背景不变，仅替换男装或模特头像？",
		answer: "在“拍摄与生活场景”下拉菜单中选择“🔒 默认原图背景 (preserve original background)”。系统会在生成 Prompt 中加入背景锁定约束词，适合局部 Inpainting 重绘模式。"
	},
	{
		question: "自定义拍摄背景支持中文输入吗？",
		answer: "支持！你在自定义背景输入框中输入的中文词汇（如“上海外滩夜景”、“复古咖啡馆落地窗”），系统会在 500ms 内自动翻译为英文 Prompt。"
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="zh">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		/* 模式选择选项卡 */
		.mode-tabs {
			display: flex;
			justify-content: center;
			gap: 0.8rem;
			margin-bottom: 1.8rem;
			flex-wrap: wrap;
		}
		.tab-btn {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			color: var(--text-muted);
			padding: 0.6em 1.2em;
			border-radius: 10px;
			font-size: 0.88rem;
			font-weight: 700;
			cursor: pointer;
			transition: all 0.2s ease;
		}
		.tab-btn.active {
			background: var(--accent);
			color: #ffffff !important;
			border-color: var(--accent);
			box-shadow: 0 4px 15px var(--accent-glow);
		}

		.form-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1.2rem;
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 16px;
			padding: 1.8rem;
			backdrop-filter: blur(12px);
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			margin-bottom: 2rem;
		}
		.form-group {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}
		.form-group.full-width {
			grid-column: 1 / -1;
		}
		label {
			font-size: 0.88rem;
			font-weight: 700;
			color: var(--text-main);
			display: flex;
			justify-content: space-between;
			align-items: center;
		}
		label .sub-tag {
			font-size: 0.75rem;
			color: var(--text-muted);
			font-weight: normal;
		}
		.translate-status {
			font-size: 0.75rem;
			color: var(--accent);
			font-weight: 600;
			margin-left: auto;
		}

		input[type="text"], select, textarea {
			width: 100%;
			padding: 0.75em 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.92rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		input[type="text"]:focus, select:focus, textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}

		.output-card {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 16px;
			padding: 1.5rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		}
		.output-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 1rem;
		}
		.output-title {
			font-size: 1.05rem;
			font-weight: 700;
			color: var(--text-main);
		}
		.btn-copy {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-size: 0.88rem;
			font-weight: 700;
			cursor: pointer;
			transition: all 0.2s ease;
		}
		.btn-copy:hover {
			background: var(--accent-hover);
			transform: translateY(-1px);
		}
		.prompt-output {
			width: 100%;
			height: 140px;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			padding: 1rem;
			color: var(--text-main);
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 0.9rem;
			line-height: 1.6;
			resize: vertical;
			box-sizing: border-box;
			outline: none;
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 工具卡片主体 -->
	<div class="tool-box">
		<!-- 核心模式选择 Tab -->
		<div class="mode-tabs">
			<button class="tab-btn active" data-mode="outfit">一、男装换装模式 (双图参考)</button>
			<button class="tab-btn" data-mode="scene">二、男装换背景模式</button>
			<button class="tab-btn" data-mode="head">三、男装换头像模式</button>
			<button class="tab-btn" data-mode="full">四、全自由定制商拍</button>
		</div>

		<div class="form-grid">
			<!-- 男模特征选择 -->
			<div class="form-group" id="modelGroup">
				<label for="modelSelect">男模特征与形象</label>
				<select id="modelSelect">
					<option value="handsome mature 30s Caucasian male model with thick beard, sharp jawline, masculine charismatic look">欧美成熟魅力男模 (络腮胡/成熟型男)</option>
					<option value="handsome young 20s Caucasian male model, blonde hair, deep blue eyes, athletic lean build">欧美年轻帅气男模 (金发/蓝眼/清爽高挑)</option>
					<option value="handsome 20s East Asian male model with short textured haircut, athletic build">20代东亚帅气男模 (短发/健壮身材/街头风)</option>
					<option value="tall attractive Asian male model in clean minimalist style">高挑东亚极简男模 (日系冷淡风)</option>
					<option value="muscular Black male model with short fade hair">肌肉型黑人男模 (美式高街/运动潮流)</option>
					<option value="custom">✨ 自定义模特描述 (Custom Model)...</option>
				</select>
			</div>

			<!-- 自定义模特输入框（默认隐藏，选中自定义时展开） -->
			<div class="form-group full-width" id="customModelGroup" style="display: none;">
				<label for="customModelInput">
					<span>自定义模特描述</span>
					<span class="sub-tag">支持中文输入，自动实时翻译</span>
					<span id="customModelStatus" class="translate-status"></span>
				</label>
				<input type="text" id="customModelInput" placeholder="例如：25岁拉丁裔男模，卷发，小麦色皮肤，阳光健美体型..." />
			</div>

			<!-- 模特姿态与拍摄角度 -->
			<div class="form-group">
				<label for="angleSelect">模特姿态/视角 (Model Angle)</label>
				<select id="angleSelect">
					<option value="">不指定 (Default / Random)</option>
					<option value="front view, standing facing directly forward towards camera, full symmetric posture">正面 (Front View)</option>
					<option value="three-quarter left side view, model turned 45 degrees to the left">左微侧 45° (Left 3/4 View)</option>
					<option value="exact left side profile view, model facing 90 degrees left, full side profile shot">左正侧 (Left Profile View)</option>
					<option value="three-quarter right side view, model turned 45 degrees to the right">右微侧 45° (Right 3/4 View)</option>
					<option value="exact right side profile view, model facing 90 degrees right, full side profile shot">右正侧 (Right Profile View)</option>
					<option value="back view, full rear view showing back details of clothing, facing away from camera">正背面 (Back View)</option>
				</select>
			</div>

			<!-- 男装品类与版型 -->
			<div class="form-group full-width" id="outfitGroup">
				<label for="outfitInput">
					<span>男装主服饰、材质与细节</span>
					<span class="sub-tag">支持中文输入，自动实时翻译</span>
					<span id="outfitStatus" class="translate-status"></span>
				</label>
				<input type="text" id="outfitInput" placeholder="例如：重磅黑色棉质连帽卫衣搭配水洗直筒牛仔裤、户外防水冲锋衣外套..." />
			</div>

			<!-- 鞋靴与穿搭配饰 -->
			<div class="form-group full-width" id="accessoryGroup">
				<label for="accessoryInput">
					<span>鞋靴与穿搭配饰</span>
					<span class="sub-tag">可选：靴子、球鞋、手表、墨镜、帽子、斜挎包等</span>
					<span id="accessoryStatus" class="translate-status"></span>
				</label>
				<input type="text" id="accessoryInput" placeholder="例如：复古黑色切尔西皮靴、白色高帮运动鞋，搭配皮质斜挎包..." />
			</div>

			<!-- 男装生活拍摄场景（包含自定义背景） -->
			<div class="form-group full-width">
				<label for="sceneSelect">拍摄与生活场景</label>
				<select id="sceneSelect">
					<option value="preserve original background environment and scene lighting exactly as is">🔒 默认原图背景</option>
					<option value="custom">✍️ 自定义背景 (Custom Environment)</option>
					<option value="in a lush green wild forest environment with sunlight filtering through pine trees">户外原始森林场景 (晨光树影/松树自然感)</option>
					<option value="on a mountain hiking trail with rocky cliffs and majestic snow peaks background">高山登山与雪山悬崖场景 (山脊视角/探险感)</option>
					<option value="in a modern sunlit minimalist coffee shop with marble table">阳光充沛的现代极简咖啡馆</option>
					<option value="walking down a European vintage street with brick architecture">欧洲复古红砖建筑街头街拍</option>
					<option value="in a luxury high-rise office with glass windows overlooking skyline">高楼大厦高管办公室/落地窗</option>
					<option value="in a clean industrial loft apartment with concrete walls">工业风 Loft 空旷公寓背景</option>
					<option value="in a professional clean commercial photo studio, plain background">商业摄影棚纯色背景</option>
				</select>
			</div>

			<!-- 自定义背景输入框（默认隐藏，选中“自定义背景”时展开） -->
			<div class="form-group full-width" id="customSceneGroup" style="display: none;">
				<label for="customSceneInput">
					<span>自定义背景描述</span>
					<span class="sub-tag">支持中文输入，自动实时翻译</span>
					<span id="customSceneStatus" class="translate-status"></span>
				</label>
				<input type="text" id="customSceneInput" placeholder="例如：上海外滩夜景霓虹灯光、雨后繁华都市街头、海边日落沙滩..." />
			</div>

			<!-- 相机设备 -->
			<div class="form-group">
				<label for="cameraSelect">相机设备 (Camera Body)</label>
				<select id="cameraSelect">
					<option value="shot on Sony Alpha A7R V">索尼 Sony A7R V (现代极锐商拍)</option>
					<option value="shot on Leica M11">徕卡 Leica M11 (经典人文色彩)</option>
					<option value="shot on Hasselblad H6D-100c">哈苏 Hasselblad H6D-100c (顶级中画幅)</option>
					<option value="shot on Canon EOS R5">佳能 Canon EOS R5 (细腻肤色与商业质感)</option>
					<option value="shot on Nikon Z9">尼康 Nikon Z9 (高对比度锐利商拍)</option>
					<option value="shot on Fujifilm GFX 100 II">富士 Fujifilm GFX 100 II (1亿像素中画幅胶片模拟)</option>
					<option value="shot on iPhone 15 Pro Max">iPhone 15 Pro Max (真实街头生活感)</option>
				</select>
			</div>

			<!-- 镜头与视角（按 85mm / 50mm / 35mm / 24mm 区分） -->
			<div class="form-group">
				<label for="lensSelect">镜头焦段与视角 (Lens & Focal Length)</label>
				<select id="lensSelect">
					<option value="85mm f/1.2 prime portrait lens, shallow depth of field, creamy bokeh blur background">85mm 焦段 (人像特写 / 奶油虚化 / 突出服装质感)</option>
					<option value="50mm f/1.4 prime lens, natural eye-level perspective, clean standard lookbook framing">50mm 焦段 (标准视角 / 眼高视角 / Lookbook首选)</option>
					<option value="35mm f/1.4 lens, street style framing with subtle environmental context">35mm 焦段 (街头人文 / 兼顾环境氛围街拍)</option>
					<option value="24mm wide angle lens, dynamic low angle perspective, striking body tension">24mm 焦段 (广角张力 / 低角度动态视觉冲击)</option>
				</select>
			</div>

			<!-- 光线风格（包含百叶窗照射光线） -->
			<div class="form-group">
				<label for="lightingSelect">光线风格 (Lighting Setup)</label>
				<select id="lightingSelect">
					<option value="overcast soft ambient light, clean natural skin tones">阴天漫射柔光 (Overcast Light / 清爽质感)</option>
					<option value="soft natural sunlight filtering through windows">自然漫射阳光</option>
					<option value="golden hour warm sunset backlighting">黄金小时逆光夕阳</option>
					<option value="clean studio softbox lighting, sharp fabric texture">柔光箱摄影棚光线</option>
					<option value="dramatic rim lighting with strong edge highlights">高光轮廓光</option>
					<option value="dual-tone neon lighting, cyan and magenta glow">双色霓虹环境光 (Cyberpunk Dual-Tone)</option>
					<option value="sunlight filtering through window shutter creating dappled shadows">百叶窗斑驳光影 </option>
				</select>
			</div>

			<!-- 画幅比例 -->
			<div class="form-group full-width">
				<label for="arSelect">画面宽高比 (--ar)</label>
				<select id="arSelect">
					<option value="--ar 3:4">--ar 3:4 (服装电商主图与详情页)</option>
					<option value="--ar 4:5">--ar 4:5 (Instagram / 小红书 / TikTok)</option>
					<option value="--ar 9:16">--ar 9:16 (手机全屏竖屏海报)</option>
					<option value="--ar 1:1">--ar 1:1 (正方形商品卡片)</option>
				</select>
			</div>
		</div>

		<!-- 实时生成预览卡片 -->
		<div class="output-card">
			<div class="output-header">
				<span class="output-title">✨ 生成的英文男装商拍 Prompt</span>
				<button class="btn-copy" id="btnCopy">📋 一键复制 Prompt</button>
			</div>
			<textarea id="promptOutput" class="prompt-output" readonly></textarea>
		</div>
	</div>

	<!-- FAQ 模块区 -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ 常见问题 (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端逻辑脚本 (添加 DOMContentLoaded 生命周期防护) -->
	<script slot="scripts">
		function initTool() {
			let currentMode = 'outfit';

			const tabBtns = document.querySelectorAll('.tab-btn');
			const outfitInput = document.getElementById('outfitInput');
			const outfitStatus = document.getElementById('outfitStatus');
			const accessoryInput = document.getElementById('accessoryInput');
			const accessoryStatus = document.getElementById('accessoryStatus');

			const sceneSelect = document.getElementById('sceneSelect');
			const customSceneGroup = document.getElementById('customSceneGroup');
			const customSceneInput = document.getElementById('customSceneInput');
			const customSceneStatus = document.getElementById('customSceneStatus');

			const modelSelect = document.getElementById('modelSelect');
			const customModelGroup = document.getElementById('customModelGroup');
			const customModelInput = document.getElementById('customModelInput');
			const customModelStatus = document.getElementById('customModelStatus');

			const angleSelect = document.getElementById('angleSelect');
			const cameraSelect = document.getElementById('cameraSelect');
			const lensSelect = document.getElementById('lensSelect');
			const lightingSelect = document.getElementById('lightingSelect');
			const arSelect = document.getElementById('arSelect');

			const promptOutput = document.getElementById('promptOutput');
			const btnCopy = document.getElementById('btnCopy');

			let translatedOutfit = 'heavyweight black cotton hoodie paired with washed straight jeans';
			let translatedAccessory = '';
			let translatedCustomScene = '';
			let translatedCustomModel = '';

			let outfitTimer = null;
			let accessoryTimer = null;
			let customSceneTimer = null;
			let customModelTimer = null;

			function containsChinese(text) {
				return /[\u4e00-\u9fa5]/.test(text);
			}

			async function translateText(text) {
				if (!text.trim()) return '';
				if (!containsChinese(text)) return text;
				try {
					const res = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=zh|en`);
					const data = await res.json();
					return data.responseData?.translatedText || text;
				} catch (e) {
					return text;
				}
			}

			function getModelValue() {
				if (modelSelect?.value === 'custom') {
					return translatedCustomModel ? translatedCustomModel : 'handsome male model';
				}
				return modelSelect?.value || 'handsome male model';
			}

			function getSceneValue() {
				if (sceneSelect?.value === 'custom') {
					return translatedCustomScene ? `in ${translatedCustomScene}` : 'in a modern urban setting';
				}
				return sceneSelect?.value || '';
			}

			function buildPrompt() {
				if (!promptOutput) return;

				const outfit = translatedOutfit || 'heavyweight black cotton hoodie';
				const accessoryStr = translatedAccessory ? `styled with ${translatedAccessory}` : '';
				const sceneVal = getSceneValue();
				const modelVal = getModelValue();

				let modePrefix = '';
				let components = [];

				if (currentMode === 'outfit') {
					modePrefix = '[Inpainting Outfit Swap / Dual-Image Reference]';
					components = [
						`Commercial menswear photography, precisely transplanting garment design from Reference Image onto Target Model`,
						`replacing outfit with ${outfit}`,
						accessoryStr,
						`worn by ${modelVal}`,
						angleSelect?.value || '',
						sceneVal,
						cameraSelect?.value || '',
						lensSelect?.value || '',
						lightingSelect?.value || '',
						'ultra-detailed fabric texture, natural drape wrinkles, 8k resolution, raw photo',
						arSelect?.value || ''
					];
				} else if (currentMode === 'scene') {
					modePrefix = '[Background Swap Focus]';
					components = [
						`Commercial menswear photography, placing model wearing ${outfit}`,
						accessoryStr,
						angleSelect?.value || '',
						`into setting: ${sceneVal}`,
						cameraSelect?.value || '',
						lensSelect?.value || '',
						lightingSelect?.value || '',
						'realistic light integration, shallow depth of field, 8k resolution, raw photo',
						arSelect?.value || ''
					];
				} else if (currentMode === 'head') {
					modePrefix = '[Model / Head Swap Focus]';
					components = [
						`Commercial menswear photography, replacing model face with ${modelVal}`,
						`wearing ${outfit}`,
						accessoryStr,
						angleSelect?.value || '',
						sceneVal,
						cameraSelect?.value || '',
						lensSelect?.value || '',
						'natural skin texture, seamless face swap, 8k resolution, raw photo',
						arSelect?.value || ''
					];
				} else {
					modePrefix = '[Full Custom Shoot]';
					components = [
						`Commercial menswear photography featuring ${modelVal}`,
						`wearing ${outfit}`,
						accessoryStr,
						angleSelect?.value || '',
						sceneVal,
						cameraSelect?.value || '',
						lensSelect?.value || '',
						lightingSelect?.value || '',
						'ultra-detailed fabric texture, 8k resolution, raw photo',
						arSelect?.value || ''
					];
				}

				promptOutput.value = `${modePrefix} ${components.filter(Boolean).join(', ')}`;
			}

			// Tab 按钮切换
			tabBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					tabBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					currentMode = btn.getAttribute('data-mode') || 'outfit';
					buildPrompt();
				});
			});

			// 模型下拉框切换监听（支持自定义模特展开）
			modelSelect?.addEventListener('change', () => {
				if (modelSelect.value === 'custom') {
					if (customModelGroup) customModelGroup.style.display = 'flex';
				} else {
					if (customModelGroup) customModelGroup.style.display = 'none';
				}
				buildPrompt();
			});

			// 背景下拉框切换监听（支持自定义背景展开）
			sceneSelect?.addEventListener('change', () => {
				if (sceneSelect.value === 'custom') {
					if (customSceneGroup) customSceneGroup.style.display = 'flex';
				} else {
					if (customSceneGroup) customSceneGroup.style.display = 'none';
				}
				buildPrompt();
			});

			// 防抖翻译：自定义模特
			customModelInput?.addEventListener('input', () => {
				clearTimeout(customModelTimer);
				const raw = customModelInput.value.trim();
				if (!raw) {
					translatedCustomModel = '';
					if (customModelStatus) customModelStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (!containsChinese(raw)) {
					translatedCustomModel = raw;
					if (customModelStatus) customModelStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (customModelStatus) customModelStatus.textContent = '翻译中...';
				customModelTimer = setTimeout(async () => {
					translatedCustomModel = await translateText(raw);
					if (customModelStatus) customModelStatus.textContent = '✓ 已转英文';
					buildPrompt();
				}, 500);
			});

			// 防抖翻译：主服装
			outfitInput?.addEventListener('input', () => {
				clearTimeout(outfitTimer);
				const raw = outfitInput.value.trim();
				if (!raw) {
					translatedOutfit = '';
					if (outfitStatus) outfitStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (!containsChinese(raw)) {
					translatedOutfit = raw;
					if (outfitStatus) outfitStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (outfitStatus) outfitStatus.textContent = '翻译中...';
				outfitTimer = setTimeout(async () => {
					translatedOutfit = await translateText(raw);
					if (outfitStatus) outfitStatus.textContent = '✓ 已转英文';
					buildPrompt();
				}, 500);
			});

			// 防抖翻译：穿搭配饰
			accessoryInput?.addEventListener('input', () => {
				clearTimeout(accessoryTimer);
				const raw = accessoryInput.value.trim();
				if (!raw) {
					translatedAccessory = '';
					if (accessoryStatus) accessoryStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (!containsChinese(raw)) {
					translatedAccessory = raw;
					if (accessoryStatus) accessoryStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (accessoryStatus) accessoryStatus.textContent = '翻译中...';
				accessoryTimer = setTimeout(async () => {
					translatedAccessory = await translateText(raw);
					if (accessoryStatus) accessoryStatus.textContent = '✓ 已转英文';
					buildPrompt();
				}, 500);
			});

			// 防抖翻译：自定义背景
			customSceneInput?.addEventListener('input', () => {
				clearTimeout(customSceneTimer);
				const raw = customSceneInput.value.trim();
				if (!raw) {
					translatedCustomScene = '';
					if (customSceneStatus) customSceneStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (!containsChinese(raw)) {
					translatedCustomScene = raw;
					if (customSceneStatus) customSceneStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (customSceneStatus) customSceneStatus.textContent = '翻译中...';
				customSceneTimer = setTimeout(async () => {
					translatedCustomScene = await translateText(raw);
					if (customSceneStatus) customSceneStatus.textContent = '✓ 已转英文';
					buildPrompt();
				}, 500);
			});

			// 下拉框改变监听
			[modelSelect, angleSelect, cameraSelect, lensSelect, lightingSelect, arSelect].forEach(el => {
				el?.addEventListener('change', buildPrompt);
			});

			buildPrompt();

			// 复制功能
			btnCopy?.addEventListener('click', () => {
				if (!promptOutput || !promptOutput.value) return;
				navigator.clipboard.writeText(promptOutput.value).then(() => {
					if (btnCopy) {
						const originalText = btnCopy.textContent;
						btnCopy.textContent = 'Copied!';
						setTimeout(() => { btnCopy.textContent = originalText; }, 2000);
					}
				});
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initTool);
		} else {
			initTool();
		}
	</script>
</ToolLayout>
