---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "大小写与变量命名格式转换工具",
	description: "免费在线英文字母大小写转换与代码变量命名格式（驼峰、蛇形、短横线、标题格式）一键转换工具。",
	icon: "🔤",
	tag: "文本工具",
	keywords: "大小写转换 驼峰命名转换 camelCase snake_case kebab-case 标题大小写 变量名转换",
	pinned: false,
	priority: 85
};

const pageTitle = `大小写与变量命名格式转换工具 — ${SITE_TITLE}`;
const pageDescription = "免费在线英文字母大小写转换与代码变量命名格式（驼峰、蛇形、短横线、标题格式）一键转换工具。";

const faqList = [
	{
		question: "这个大小写转换工具支持哪些代码变量命名格式？",
		answer: "支持主流的前后端代码命名规范，包括小驼峰（camelCase）、大驼峰（PascalCase）、蛇形命名（snake_case）、短横线/烤肉串命名（kebab-case）以及常量大写（CONSTANT_CASE）。"
	},
	{
		question: "什么是标题大小写（Title Case）？",
		answer: "Title Case 是一种英文标题排版规范，会将每个单词的首字母自动大写（如将 'hello world' 转换为 'Hello World'），非常适合撰写英文文章标题、电子邮件主题和营销文案。"
	},
	{
		question: "我的文本内容会被上传到服务器吗？",
		answer: "不会。所有的格式转换均在您的浏览器本地实时完成，文本数据绝不出设备，100% 保护隐私与代码安全。"
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<style>
			main {
				width: 850px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}

			.input-label {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-weight: 600;
				margin-bottom: 0.5em;
				color: var(--text-main);
			}
			.text-stats {
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			textarea {
				width: 100%;
				height: 180px;
				padding: 1em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 10px;
				color: var(--text-main);
				font-size: 0.95rem;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				box-sizing: border-box;
				outline: none;
				resize: vertical;
				line-height: 1.5;
				transition: border-color 0.2s;
			}
			textarea:focus {
				border-color: var(--accent);
			}

			.grid-actions {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 0.8rem;
				margin: 1.5rem 0;
			}

			.btn-action {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.7em 0.9em;
				border-radius: 8px;
				font-weight: 600;
				font-size: 0.88rem;
				cursor: pointer;
				text-align: center;
				transition: all 0.2s ease;
			}
			.btn-action:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: var(--badge-bg);
			}

			.control-bar {
				display: flex;
				gap: 0.8rem;
				justify-content: flex-end;
				margin-top: 1rem;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}

			.faq-section {
				margin-top: 3.5em;
				padding-top: 2em;
				border-top: 1px solid var(--card-border);
			}
			.faq-title {
				font-size: 1.4rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1em;
			}
			.faq-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
				gap: 1.2rem;
			}
			.faq-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 1.2em;
			}
			.faq-card h3 {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-main);
				margin: 0 0 0.5rem 0;
			}
			.faq-card p {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.6;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🔤 大小写与变量命名格式转换工具</h1>
				<p>一键转换文本字母大小写，支持多种程序员变量命名范式（Camel / Snake / Kebab）</p>
			</div>

			<div class="tool-box">
				<div class="input-label">
					<span>输入文本 / 变量名：</span>
					<span class="text-stats" id="statsText">字符数: 0 | 单词数: 0</span>
				</div>
				<textarea id="inputText" placeholder="在此粘贴或输入需要转换的文本，例如：hello_world 或 user-name..."></textarea>

				<div class="grid-actions">
					<button class="btn-action" data-type="upper">UPPERCASE (大写)</button>
					<button class="btn-action" data-type="lower">lowercase (小写)</button>
					<button class="btn-action" data-type="title">Title Case (首字母大写)</button>
					<button class="btn-action" data-type="sentence">Sentence case (句首大写)</button>
					<button class="btn-action" data-type="camel">camelCase (小驼峰)</button>
					<button class="btn-action" data-type="pascal">PascalCase (大驼峰)</button>
					<button class="btn-action" data-type="snake">snake_case (蛇形)</button>
					<button class="btn-action" data-type="kebab">kebab-case (短横线)</button>
					<button class="btn-action" data-type="constant">CONSTANT_CASE (常量)</button>
					<button class="btn-action" data-type="toggle">tOGGLE cASE (大小写反转)</button>
				</div>

				<div class="control-bar">
					<button class="btn btn-secondary" id="btnClear">清空内容</button>
					<button class="btn" id="btnCopy">复制转换结果</button>
				</div>
			</div>

			<section class="faq-section">
				<div class="faq-title">❓ 常见问题解答 (FAQ)</div>
				<div class="faq-grid">
					{faqList.map(item => (
						<div class="faq-card">
							<h3>{item.question}</h3>
							<p>{item.answer}</p>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const inputText = document.getElementById('inputText') as HTMLTextAreaElement;
			const statsText = document.getElementById('statsText');
			const btnCopy = document.getElementById('btnCopy') as HTMLButtonElement;
			const btnClear = document.getElementById('btnClear');
			const actionBtns = document.querySelectorAll('.btn-action');

			inputText?.addEventListener('input', updateStats);

			function updateStats() {
				const text = inputText.value;
				const chars = text.length;
				const words = text.trim() ? text.trim().split(/\s+/).length : 0;
				if (statsText) statsText.textContent = `字符数: ${chars} | 单词数: ${words}`;
			}

			function getWords(str: string): string[] {
				return str
					.replace(/([a-z])([A-Z])/g, '$1 $2')
					.replace(/[_-]+/g, ' ')
					.trim()
					.split(/\s+/);
			}

			actionBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					const type = (btn as HTMLElement).dataset.type;
					const val = inputText.value;
					if (!val) return;

					switch (type) {
						case 'upper':
							inputText.value = val.toUpperCase();
							break;
						case 'lower':
							inputText.value = val.toLowerCase();
							break;
						case 'title':
							inputText.value = val.toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
							break;
						case 'sentence':
							inputText.value = val.toLowerCase().replace(/(^\s*\w|[\.\!\?]\s*\w)/g, c => c.toUpperCase());
							break;
						case 'camel':
							inputText.value = getWords(val)
								.map((w, i) => i === 0 ? w.toLowerCase() : w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
								.join('');
							break;
						case 'pascal':
							inputText.value = getWords(val)
								.map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
								.join('');
							break;
						case 'snake':
							inputText.value = getWords(val).map(w => w.toLowerCase()).join('_');
							break;
						case 'kebab':
							inputText.value = getWords(val).map(w => w.toLowerCase()).join('-');
							break;
						case 'constant':
							inputText.value = getWords(val).map(w => w.toUpperCase()).join('_');
							break;
						case 'toggle':
							inputText.value = val.split('').map(c => c === c.toUpperCase() ? c.toLowerCase() : c.toUpperCase()).join('');
							break;
					}
					updateStats();
				});
			});

			btnClear?.addEventListener('click', () => {
				inputText.value = '';
				updateStats();
			});

			btnCopy?.addEventListener('click', () => {
				if (!inputText.value) return;
				navigator.clipboard.writeText(inputText.value);
				btnCopy.textContent = '已复制！';
				setTimeout(() => { btnCopy.textContent = '复制转换结果'; }, 2000);
			});
		</script>
	</body>
</html>
