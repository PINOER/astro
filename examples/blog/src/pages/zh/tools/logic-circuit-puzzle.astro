---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: '儿童编程互动游戏：电子电路与逻辑门大闯关（Logic Circuit Puzzle）',
	description: '免安装！直观体验与门(AND)、或门(OR)、非门(NOT)等数字电路逻辑门，通过拼接逻辑电路点亮终点彩灯，培养高阶条件判断与硬件编程思维。',
	icon: '⚡',
	tag: '儿童编程',
	keywords: '逻辑门 电子电路 逻辑门闯关 AND门 OR门 NOT门 数字电路 编程逻辑',
	pinned: false,
	priority: 84
};

const pageTitle = `儿童编程互动游戏：电子电路与逻辑门大闯关 — ${SITE_TITLE}`;
const pageDescription = '通过组合与门、或门、非门等逻辑组件连通电路，点亮目标彩灯，体验硬件逻辑编程的魅力！';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1120px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em 3em;
				box-sizing: border-box;
			}

			.tool-header {
				text-align: center;
				margin-bottom: 1.2em;
			}

			.tool-header h1 {
				font-size: clamp(1.3rem, 4vw, 2.1rem);
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.tool-header p {
				color: var(--text-muted);
				font-size: clamp(0.85rem, 2.2vw, 0.95rem);
			}

			.game-container {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 320px;
				gap: 1.2rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.2rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
				box-sizing: border-box;
			}

			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.8rem;
				width: 100%;
			}

			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.8rem;
				width: 100%;
				background: var(--search-bg);
				padding: 0.5em 0.8em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.88rem;
				box-sizing: border-box;
			}

			.level-select {
				max-width: 180px;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.35em 0.5em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.85rem;
				outline: none;
				cursor: pointer;
			}

			.circuit-board {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 10;
				max-height: 48vh;
				background: #090d16;
				border: 2px solid #334155;
				border-radius: 16px;
				overflow: hidden;
				display: flex;
				box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
			}

			#circuitCanvas {
				width: 100%;
				height: 100%;
				display: block;
			}

			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 0.8rem;
				min-width: 0;
				width: 100%;
			}

			.panel-section {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.7rem;
				box-sizing: border-box;
			}

			.section-title {
				font-size: 0.82rem;
				font-weight: 700;
				color: var(--text-muted);
				margin-bottom: 0.5rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.switch-group {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}

			.switch-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				background: var(--bg-card);
				padding: 0.4em 0.8em;
				border-radius: 8px;
				border: 1px solid var(--card-border);
				font-size: 0.82rem;
				font-weight: 700;
			}

			.toggle-btn {
				background: #334155;
				color: #94a3b8;
				border: none;
				padding: 0.3em 0.8em;
				border-radius: 6px;
				font-weight: 800;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.toggle-btn.on {
				background: #10b981;
				color: #fff;
				box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
			}

			.gate-palette {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.4rem;
			}

			.gate-btn {
				background: var(--bg-card);
				border: 1.5px solid var(--card-border);
				color: var(--text-main);
				padding: 0.5em 0.3em;
				border-radius: 8px;
				font-size: 0.8rem;
				font-weight: 700;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.3rem;
				transition: all 0.15s ease;
			}

			.gate-btn.selected {
				border-color: #3b82f6;
				background: rgba(59, 130, 246, 0.15);
				color: #60a5fa;
			}

			.target-card {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 0.5rem 0.8rem;
				font-size: 0.8rem;
				color: var(--text-muted);
				line-height: 1.4;
			}

			.game-message {
				min-height: 1.2em;
				padding: 0.50rem 0.8rem;
				border-radius: 10px;
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				font-size: 0.82rem;
				font-weight: 700;
				text-align: center;
				color: var(--text-muted);
			}

			.game-message.success {
				color: #10b981;
				border-color: rgba(16, 185, 129, 0.5);
			}

			@media (max-width: 900px) {
				.game-container {
					grid-template-columns: 1fr;
				}

				.editor-box {
					max-width: 520px;
					margin: 0 auto;
				}
			}

			/* 📱 手机端视口自适应压缩 */
			@media (max-width: 600px) {
				main {
					padding: 0.2em 0.5em 1em;
				}

				.tool-header p {
					display: none;
				}

				.tool-header h1 {
					font-size: 1.15rem;
					margin-bottom: 0;
				}

				.game-container {
					padding: 0.5rem;
					gap: 0.5rem;
				}

				.level-bar {
					padding: 0.35em 0.6em;
					font-size: 0.78rem;
				}

				.level-select {
					max-width: 130px;
					padding: 0.2em 0.3em;
					font-size: 0.78rem;
				}

				.circuit-board {
					max-height: 36vh !important;
				}

				.gate-palette {
					grid-template-columns: repeat(3, 1fr);
				}

				.gate-btn {
					padding: 0.4em 0.1em;
					font-size: 0.75rem;
				}

				.switch-item {
					padding: 0.3em 0.6em;
					font-size: 0.75rem;
				}

				.toggle-btn {
					padding: 0.2em 0.6em;
				}
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>⚡ 儿童编程小工具：电子电路与逻辑门大闯关</h1>
				<p>选择不同的逻辑门配置到电路节点中，调节输入开关状态，让终点的彩灯成功亮起！</p>
			</div>

			<div class="game-container">
				<div class="stage-box">
					<div class="level-bar">
						<label>
							关卡：
							<select id="levelSelect" class="level-select" aria-label="选择关卡"></select>
						</label>
						<span>💡 目标：<span id="targetStatus" style="color:#f59e0b;">点亮灯泡</span></span>
					</div>

					<div class="circuit-board">
						<canvas id="circuitCanvas" width="800" height="500"></canvas>
					</div>
				</div>

				<div class="editor-box">
					<div class="panel-section">
						<div class="section-title">🔌 输入电源开关（点击切换 0/1）</div>
						<div class="switch-group" id="switchGroup"></div>
					</div>

					<div class="panel-section">
						<div class="section-title">🧩 选择要放置的元件（点击元件槽）</div>
						<div class="gate-palette">
							<button class="gate-btn selected" data-gate="AND" type="button">AND (与门)</button>
							<button class="gate-btn" data-gate="OR" type="button">OR (或门)</button>
							<button class="gate-btn" data-gate="NOT" type="button">NOT (非门)</button>
							<button class="gate-btn" data-gate="XOR" type="button">XOR (异或)</button>
							<button class="gate-btn" data-gate="DIRECT" type="button">━ (直通线)</button>
						</div>
					</div>

					<div class="target-card" id="targetHint">关卡目标提示载入中...</div>

					<div class="game-message" id="gameMessage" aria-live="polite">准备开始</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			const LEVELS = [
				{
					id: 1,
					title: '第 1 关：与门初体验',
					switches: [{ id: 'SW1', val: 1 }, { id: 'SW2', val: 1 }],
					slots: [{ id: 'SLOT1', type: 'AND', inputs: ['SW1', 'SW2'] }],
					outputNode: 'SLOT1',
					goal: '把 SLOT1 设置为合适门电路，让两开关均为 1 时亮灯。',
					targetVal: 1
				},
				{
					id: 2,
					title: '第 2 关：反转信号（非门）',
					switches: [{ id: 'SW1', val: 1 }],
					slots: [{ id: 'SLOT1', type: 'DIRECT', inputs: ['SW1'] }],
					outputNode: 'SLOT1',
					goal: '开关 SW1 为 1 时灯灭，开关为 0 时灯亮（利用非门）。',
					targetVal: 1,
					reqSwitch: { SW1: 0 }
				},
				{
					id: 3,
					title: '第 3 关：二选一触发（或门）',
					switches: [{ id: 'SW1', val: 0 }, { id: 'SW2', val: 1 }],
					slots: [{ id: 'SLOT1', type: 'AND', inputs: ['SW1', 'SW2'] }],
					outputNode: 'SLOT1',
					goal: '任意一个开关为 1 就能点亮灯泡（需要或门 OR）。',
					targetVal: 1
				},
				{
					id: 4,
					title: '第 4 关：双重安全锁（串联逻辑）',
					switches: [{ id: 'SW1', val: 1 }, { id: 'SW2', val: 1 }, { id: 'SW3', val: 0 }],
					slots: [
						{ id: 'SLOT1', type: 'AND', inputs: ['SW1', 'SW2'] },
						{ id: 'SLOT2', type: 'AND', inputs: ['SLOT1', 'SW3'] }
					],
					outputNode: 'SLOT2',
					goal: '调节槽位，使三个开关 SW1、SW2、SW3 均为 1 时才点亮灯泡。',
					targetVal: 1,
					reqSwitch: { SW1: 1, SW2: 1, SW3: 1 }
				},
				{
					id: 5,
					title: '第 5 关：异或门（相异为真）',
					switches: [{ id: 'SW1', val: 1 }, { id: 'SW2', val: 1 }],
					slots: [{ id: 'SLOT1', type: 'AND', inputs: ['SW1', 'SW2'] }],
					outputNode: 'SLOT1',
					goal: '当两个开关状态不一致时亮灯，状态相同时灭灯（XOR 门）。',
					targetVal: 1,
					reqSwitch: { SW1: 1, SW2: 0 }
				}
			];

			const canvas = document.getElementById('circuitCanvas');
			const ctx = canvas.getContext('2d');
			const levelSelect = document.getElementById('levelSelect');
			const switchGroupEl = document.getElementById('switchGroup');
			const targetHintEl = document.getElementById('targetHint');
			const gameMessageEl = document.getElementById('gameMessage');

			let currentLevelIdx = 0;
			let selectedGateType = 'AND';
			let levelState = null;
			let activeSlotIdx = -1;

			LEVELS.forEach((lvl, idx) => {
				const opt = document.createElement('option');
				opt.value = String(idx);
				opt.textContent = lvl.title;
				levelSelect.appendChild(opt);
			});

			function initLevel(idx) {
				currentLevelIdx = idx;
				levelSelect.value = String(idx);
				const template = LEVELS[idx];

				levelState = {
					...template,
					switches: template.switches.map((s) => ({ ...s })),
					slots: template.slots.map((s) => ({ ...s }))
				};

				targetHintEl.textContent = levelState.goal;
				gameMessageEl.textContent = '配置组件并调整开关状态吧！';
				gameMessageEl.classList.remove('success');

				renderSwitchesUI();
				evaluateCircuit();
			}

			function renderSwitchesUI() {
				switchGroupEl.innerHTML = '';
				levelState.switches.forEach((sw) => {
					const item = document.createElement('div');
					item.className = 'switch-item';
					item.innerHTML = `
						<span>电源 ${sw.id}</span>
						<button class="toggle-btn ${sw.val ? 'on' : ''}" type="button">${sw.val ? '1 (HIGH)' : '0 (LOW)'}</button>
					`;
					item.querySelector('.toggle-btn').addEventListener('click', () => {
						sw.val = sw.val === 1 ? 0 : 1;
						renderSwitchesUI();
						evaluateCircuit();
					});
					switchGroupEl.appendChild(item);
				});
			}

			function evaluateCircuit() {
				const values = {};
				levelState.switches.forEach((sw) => {
					values[sw.id] = sw.val;
				});

				levelState.slots.forEach((slot) => {
					const inVals = slot.inputs.map((inId) => values[inId] || 0);
					let out = 0;

					if (slot.type === 'AND') out = inVals.every((v) => v === 1) ? 1 : 0;
					else if (slot.type === 'OR') out = inVals.some((v) => v === 1) ? 1 : 0;
					else if (slot.type === 'NOT') out = inVals[0] === 1 ? 0 : 1;
					else if (slot.type === 'XOR') out = inVals[0] !== inVals[1] ? 1 : 0;
					else if (slot.type === 'DIRECT') out = inVals[0];

					values[slot.id] = out;
				});

				const finalVal = values[levelState.outputNode];
				drawCircuit(values);

				// 检查通关条件
				let matchReq = true;
				if (levelState.reqSwitch) {
					for (const [sKey, sVal] of Object.entries(levelState.reqSwitch)) {
						const swObj = levelState.switches.find((s) => s.id === sKey);
						if (!swObj || swObj.val !== sVal) matchReq = false;
					}
				}

				if (finalVal === levelState.targetVal && matchReq) {
					gameMessageEl.textContent = '🎉 逻辑正确！点亮终点彩灯！';
					gameMessageEl.classList.add('success');
				} else {
					gameMessageEl.textContent = '💡 信号尚未满足要求，调整一下逻辑门吧';
					gameMessageEl.classList.remove('success');
				}
			}

			function drawCircuit(values) {
				ctx.fillStyle = '#090d16';
				ctx.fillRect(0, 0, canvas.width, canvas.height);

				// 网格线背景
				ctx.strokeStyle = '#1e293b';
				ctx.lineWidth = 1;
				for (let x = 0; x < canvas.width; x += 40) {
					ctx.beginPath();
					ctx.moveTo(x, 0);
					ctx.lineTo(x, canvas.height);
					ctx.stroke();
				}

				// 计算并绘制线路 & 开关
				const switchYStep = canvas.height / (levelState.switches.length + 1);
				const switchCoords = {};

				levelState.switches.forEach((sw, i) => {
					const x = 80;
					const y = switchYStep * (i + 1);
					switchCoords[sw.id] = { x, y };

					// 绘制电源开关节点
					ctx.fillStyle = sw.val ? '#10b981' : '#ef4444';
					ctx.shadowColor = ctx.fillStyle;
					ctx.shadowBlur = sw.val ? 10 : 2;
					ctx.beginPath();
					ctx.arc(x, y, 16, 0, Math.PI * 2);
					ctx.fill();

					ctx.fillStyle = '#fff';
					ctx.font = 'bold 12px sans-serif';
					ctx.textAlign = 'center';
					ctx.textBaseline = 'middle';
					ctx.fillText(sw.id, x, y);
				});

				// 绘制插槽与逻辑门元件
				const slotX = canvas.width / 2;
				const slotYStep = canvas.height / (levelState.slots.length + 1);

				levelState.slots.forEach((slot, i) => {
					const sx = slotX + (i % 2 === 0 ? -20 : 40);
					const sy = slotYStep * (i + 1);

					// 连线：输入点到槽位
					slot.inputs.forEach((inId, inIdx) => {
						const start = switchCoords[inId] || { x: slotX - 100, y: sy };
						const val = values[inId] || 0;

						ctx.strokeStyle = val ? '#10b981' : '#334155';
						ctx.lineWidth = val ? 4 : 2;
						ctx.shadowBlur = val ? 8 : 0;
						ctx.shadowColor = '#10b981';

						ctx.beginPath();
						ctx.moveTo(start.x + 16, start.y);
						ctx.bezierCurveTo(
							start.x + 80, start.y,
							sx - 80, sy + (inIdx * 20 - 10),
							sx - 35, sy + (inIdx * 20 - 10)
						);
						ctx.stroke();
					});

					// 绘制逻辑门框
					ctx.fillStyle = '#1e293b';
					ctx.strokeStyle = '#3b82f6';
					ctx.lineWidth = 2;
					ctx.shadowBlur = 0;
					ctx.beginPath();
					ctx.roundRect(sx - 35, sy - 25, 70, 50, 10);
					ctx.fill();
					ctx.stroke();

					ctx.fillStyle = '#f8fafc';
					ctx.font = 'bold 14px sans-serif';
					ctx.textAlign = 'center';
					ctx.textBaseline = 'middle';
					ctx.fillText(slot.type, sx, sy);

					switchCoords[slot.id] = { x: sx + 35, y: sy };
				});

				// 终点灯泡
				const outCoord = switchCoords[levelState.outputNode] || { x: canvas.width - 100, y: canvas.height / 2 };
				const finalVal = values[levelState.outputNode];
				const bulbX = canvas.width - 80;
				const bulbY = canvas.height / 2;

				ctx.strokeStyle = finalVal ? '#10b981' : '#334155';
				ctx.lineWidth = finalVal ? 4 : 2;
				ctx.beginPath();
				ctx.moveTo(outCoord.x, outCoord.y);
				ctx.lineTo(bulbX - 25, bulbY);
				ctx.stroke();

				// 灯泡外框
				ctx.fillStyle = finalVal ? '#f59e0b' : '#334155';
				ctx.shadowColor = '#f59e0b';
				ctx.shadowBlur = finalVal ? 25 : 0;
				ctx.beginPath();
				ctx.arc(bulbX, bulbY, 22, 0, Math.PI * 2);
				ctx.fill();

				ctx.fillStyle = '#fff';
				ctx.font = '16px sans-serif';
				ctx.fillText(finalVal ? '💡' : '🌑', bulbX, bulbY);
			}

			// 选择逻辑门
			document.querySelectorAll('.gate-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					document.querySelectorAll('.gate-btn').forEach((b) => b.classList.remove('selected'));
					btn.classList.add('selected');
					selectedGateType = btn.dataset.gate;

					// 默认将选择的门套用到当前槽位
					if (levelState && levelState.slots.length > 0) {
						levelState.slots[0].type = selectedGateType;
						evaluateCircuit();
					}
				});
			});

			levelSelect.addEventListener('change', (e) => {
				initLevel(Number.parseInt(e.target.value, 10));
			});

			// 点击 Canvas 切换插槽组件
			canvas.addEventListener('click', () => {
				if (!levelState) return;
				// 循环切换首个槽位
				const types = ['AND', 'OR', 'NOT', 'XOR', 'DIRECT'];
				const curIdx = types.indexOf(levelState.slots[0].type);
				levelState.slots[0].type = types[(curIdx + 1) % types.length];

				// 同步高亮按钮
				document.querySelectorAll('.gate-btn').forEach((b) => {
					b.classList.toggle('selected', b.dataset.gate === levelState.slots[0].type);
				});

				evaluateCircuit();
			});

			initLevel(0);
		</script>
	</body>
</html>
