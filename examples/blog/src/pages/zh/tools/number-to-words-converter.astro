---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "数字转英文大写金额与单词转换器",
	description: "免费且 100% 保护隐私的在线转换工具，快速将阿拉伯数字与金额转换为标准英文发票大写单词（Invoice Words）。",
	icon: "🔢",
	tag: "实用工具",
	keywords: "数字转英文大写 英文发票金额大写 英文数字转换 支票英文大写生成"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.option-group {
				display: flex;
				gap: 1rem;
				margin-bottom: 1.2rem;
				flex-wrap: wrap;
			}
			.radio-label {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.9rem;
				color: var(--text-main);
				cursor: pointer;
				font-weight: 600;
			}
			.field-group {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				margin-bottom: 1.2rem;
			}
			label {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--text-main);
			}
			input[type="number"] {
				width: 100%;
				padding: 0.7em 0.9em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 1.1rem;
				font-weight: 700;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			input[type="number"]:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			textarea {
				width: 100%;
				height: 120px;
				padding: 1em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 10px;
				color: var(--text-main);
				font-size: 1rem;
				font-weight: 600;
				font-family: inherit;
				box-sizing: border-box;
				outline: none;
				resize: vertical;
				line-height: 1.5;
			}
			.btn-group {
				display: flex;
				gap: 0.8rem;
				margin-top: 1.2rem;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* FAQ 与相关工具样式 */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🔢 {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="option-group">
					<label class="radio-label">
						<input type="radio" name="fmtType" value="currency" checked /> 美元发票大写格式 (Dollars & Cents)
					</label>
					<label class="radio-label">
						<input type="radio" name="fmtType" value="plain" /> 普通英文数字单词
					</label>
				</div>

				<div class="field-group">
					<label for="numInput">输入阿拉伯数字或金额：</label>
					<input type="number" id="numInput" value="1250.50" step="any" placeholder="例如输入 1250.50" />
				</div>

				<div class="field-group">
					<label for="wordsOutput">转换后的英文大写结果：</label>
					<textarea id="wordsOutput" readonly placeholder="转换后的英文单词将显示在这里..."></textarea>
				</div>

				<div class="btn-group">
					<button class="btn btn-secondary" id="btnClear">清空</button>
					<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">复制结果</button>
				</div>
			</div>

			<!-- FAQ 模块 -->
			<section class="content-section">
				<h2>常见问题解答 (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>为什么外贸发票 (Invoice) 上需要书写英文金额大写？</h3>
						<p>在国际贸易与商务发票中，使用规范英文大写单词书写总金额可以防止数字篡改、小数点看错以及财务纠纷，是国际合同与结算的标准规范。</p>
					</div>
					<div class="faq-item">
						<h3>美分 (Cents) 在发票格式中如何表示？</h3>
						<p>以 `$1,250.50` 为例，标准的商业发票大写格式为：<strong>"One Thousand Two Hundred Fifty Dollars and Fifty Cents"</strong>。</p>
					</div>
					<div class="faq-item">
						<h3>输入的数字会被保存或上传吗？</h3>
						<p><strong>绝对不会。</strong> 所有数值转换完全在您的浏览器本地实时完成，没有任何数据会发送至云端服务器。</p>
					</div>
				</div>
			</section>

			<!-- 相关工具推荐 -->
			<section class="content-section">
				<h2>你可能也会用到</h2>
				<div class="related-grid">
					<a href="/zh/tools/freelance-hourly-rate-calculator/" class="related-card">
						<span class="card-icon">💼</span>
						<div>
							<h4>自由职业者时薪计算器</h4>
							<p>基于目标年收入反推最低建议时薪与日薪。</p>
						</div>
					</a>
					<a href="/zh/tools/ecommerce-profit-margin-calculator/" class="related-card">
						<span class="card-icon">🧮</span>
						<div>
							<h4>独立站与跨境电商利润计算器</h4>
							<p>精准测算商品净利润率与保本售价。</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ 结构化数据 -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "为什么外贸发票 (Invoice) 上需要书写英文金额大写？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "使用规范英文大写单词书写总金额可以防止数字篡改、小数点看错以及财务纠纷。"
						}
					},
					{
						"@type": "Question",
						"name": "输入的数字会被保存或上传吗？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "绝对不会。所有数值转换完全在您的浏览器本地实时完成。"
						}
					}
				]
			}
		</script>

		<script>
			const numInput = document.getElementById('numInput') as HTMLInputElement;
			const wordsOutput = document.getElementById('wordsOutput') as HTMLTextAreaElement;
			const fmtRadios = document.querySelectorAll('input[name="fmtType"]');

			const units = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
			const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

			function convertChunk(num: number): string {
				let str = '';
				if (num >= 100) {
					str += units[Math.floor(num / 100)] + ' Hundred ';
					num %= 100;
				}
				if (num >= 20) {
					str += tens[Math.floor(num / 10)] + (num % 10 > 0 ? ' ' + units[num % 10] : '');
				} else if (num > 0) {
					str += units[num];
				}
				return str.trim();
			}

			function numberToWords(num: number): string {
				if (num === 0) return 'Zero';
				let integerPart = Math.floor(Math.abs(num));
				let result = '';

				const thousands = ['', 'Thousand', 'Million', 'Billion', 'Trillion'];
				let i = 0;

				while (integerPart > 0) {
					let chunk = integerPart % 1000;
					if (chunk > 0) {
						let chunkText = convertChunk(chunk);
						result = chunkText + (thousands[i] ? ' ' + thousands[i] : '') + (result ? ' ' + result : '');
					}
					integerPart = Math.floor(integerPart / 1000);
					i++;
				}

				return result.trim();
			}

			function updateConversion() {
				const val = parseFloat(numInput.value);
				if (isNaN(val)) {
					wordsOutput.value = '';
					return;
				}

				const isCurrency = (document.querySelector('input[name="fmtType"]:checked') as HTMLInputElement)?.value === 'currency';

				const absVal = Math.abs(val);
				const dollars = Math.floor(absVal);
				const cents = Math.round((absVal - dollars) * 100);

				const dollarsText = numberToWords(dollars);

				if (isCurrency) {
					let finalStr = `${dollarsText} ${dollars === 1 ? 'Dollar' : 'Dollars'}`;
					if (cents > 0) {
						const centsText = numberToWords(cents);
						finalStr += ` and ${centsText} ${cents === 1 ? 'Cent' : 'Cents'}`;
					}
					wordsOutput.value = finalStr;
				} else {
					let finalStr = dollarsText;
					if (cents > 0) {
						finalStr += ` Point ${numberToWords(cents)}`;
					}
					wordsOutput.value = finalStr;
				}
			}

			numInput?.addEventListener('input', updateConversion);
			fmtRadios.forEach(radio => radio.addEventListener('change', updateConversion));

			document.getElementById('btnClear')?.addEventListener('click', () => {
				numInput.value = '';
				wordsOutput.value = '';
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!wordsOutput.value) return;
				navigator.clipboard.writeText(wordsOutput.value);
				const btn = e.target as HTMLButtonElement;
				btn.textContent = '已复制！';
				setTimeout(() => { btn.textContent = '复制结果'; }, 2000);
			});

			updateConversion();
		</script>
	</body>
</html>
