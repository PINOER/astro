---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "独立站与跨境电商利润及加价率计算器",
	description: "精准计算扣除 1688 采购成本、头程尾程运费、广告 CPA 及平台手续费后的商品净利润、利润率与保本售价。",
	icon: "🧮",
	tag: "跨境电商",
	keywords: "独立站利润计算器 Shopify利润率计算 亚马逊保本价计算 跨境电商ROI计算器"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.calc-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
			}
			.section-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1rem;
			}
			.field-group {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				margin-bottom: 1rem;
			}
			label {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--text-main);
			}
			input[type="number"] {
				width: 100%;
				padding: 0.7em 0.9em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				color: var(--text-main);
				font-size: 0.95rem;
				box-sizing: border-box;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			input[type="number"]:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			.field-divider {
				border: none;
				border-top: 1px solid var(--card-border);
				margin: 1.2rem 0;
			}
			.field-group.highlight input {
				border-color: var(--accent);
				font-weight: 700;
				font-size: 1.05rem;
			}
			.metrics-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
				margin-bottom: 1.2rem;
			}
			.metric-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				padding: 1rem;
				border-radius: 10px;
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}
			.metric-card.primary {
				border-color: var(--accent);
				background: var(--badge-bg);
			}
			.metric-label {
				font-size: 0.78rem;
				color: var(--text-muted);
				font-weight: 600;
			}
			.metric-value {
				font-size: 1.4rem;
				font-weight: 800;
				color: var(--accent);
			}
			.breakdown-list {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				background: var(--code-bg);
				padding: 1rem;
				border-radius: 10px;
				border: 1px solid var(--card-border);
			}
			.breakdown-item {
				display: flex;
				justify-content: space-between;
				font-size: 0.88rem;
				color: var(--text-muted);
			}
			.breakdown-item strong {
				color: var(--text-main);
			}

			/* FAQ 与相关工具样式 */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.calc-grid, .metrics-grid, .related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🧮 {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="calc-grid">
					<!-- 输入列 -->
					<div class="input-section">
						<div class="section-title">成本与售价设置</div>
						
						<div class="field-group">
							<label for="cogs">商品采购成本 / COGS ($)</label>
							<input type="number" id="cogs" value="15.00" step="0.01" min="0" placeholder="如 1688 采购折算为美元" />
						</div>

						<div class="field-group">
							<label for="shipping">头程/尾程运费与包装 ($)</label>
							<input type="number" id="shipping" value="5.00" step="0.01" min="0" placeholder="单件出海物流成本" />
						</div>

						<div class="field-group">
							<label for="adSpend">预估单均广告成本 CPA / ACOS ($)</label>
							<input type="number" id="adSpend" value="8.00" step="0.01" min="0" placeholder="FB/Google 获客成本" />
						</div>

						<div class="field-group">
							<label for="feeRate">平台与支付抽成百分比 (%)</label>
							<input type="number" id="feeRate" value="2.9" step="0.1" min="0" placeholder="如 Shopify + Stripe 2.9%" />
						</div>

						<div class="field-group">
							<label for="flatFee">单笔固定交易手续费 ($)</label>
							<input type="number" id="flatFee" value="0.30" step="0.01" min="0" placeholder="如每笔 $0.30" />
						</div>

						<hr class="field-divider" />

						<div class="field-group highlight">
							<label for="sellingPrice">目标销售价格 ($)</label>
							<input type="number" id="sellingPrice" value="45.00" step="0.01" min="0" placeholder="独立站终端售价" />
						</div>
					</div>

					<!-- 输出列 -->
					<div class="output-section">
						<div class="section-title">盈利测算结果</div>

						<div class="metrics-grid">
							<div class="metric-card primary">
								<span class="metric-label">单件净利润</span>
								<span class="metric-value" id="netProfitVal">$0.00</span>
							</div>

							<div class="metric-card">
								<span class="metric-label">净利润率 (Margin)</span>
								<span class="metric-value" id="marginVal">0.00%</span>
							</div>

							<div class="metric-card">
								<span class="metric-label">成本加价率 (Markup)</span>
								<span class="metric-value" id="markupVal">0.00%</span>
							</div>

							<div class="metric-card">
								<span class="metric-label">保本销售底线价</span>
								<span class="metric-value" id="breakevenVal">$0.00</span>
							</div>
						</div>

						<div class="breakdown-list">
							<div class="breakdown-item">
								<span>单件综合成本</span>
								<strong id="totalCostVal">$0.00</strong>
							</div>
							<div class="breakdown-item">
								<span>平台与支付扣费</span>
								<strong id="totalFeesVal">$0.00</strong>
							</div>
							<div class="breakdown-item">
								<span>投入产出比 (ROI)</span>
								<strong id="roiVal">0.00%</strong>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- FAQ 模块 -->
			<section class="content-section">
				<h2>常见问题解答 (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>净利润率 (Margin) 与加价率 (Markup) 有什么区别？</h3>
						<p><strong>利润率 (Margin)</strong> 是基于【总售价】计算的占比（净利润 ÷ 售价）；而<strong>加价率 (Markup)</strong> 是基于【基础成本】计算的增值比例（净利润 ÷ 基础成本）。在制定定价策略时切勿混淆两者。</p>
					</div>
					<div class="faq-item">
						<h3>保本销售底线价是如何计算出来的？</h3>
						<p>保本价自动涵盖了商品采购成本、物流运费、广告 CPA 成本以及交易百分比手续费，确保在净利润刚好为 $0 时不亏本，为大促销打折提供安全底线。</p>
					</div>
					<div class="faq-item">
						<h3>独立站健康的利润率通常在多少？</h3>
						<p>对于 Shopify 等独立站卖家，扣除所有广告获客与支付手续费后，健康的净利润率通常建议保持在 <strong>15% ~ 30%</strong> 之间。</p>
					</div>
				</div>
			</section>

			<!-- 相关工具推荐 -->
			<section class="content-section">
				<h2>你可能也会用到</h2>
				<div class="related-grid">
					<a href="/zh/tools/stripe-paypal-fee-calculator/" class="related-card">
						<span class="card-icon">💳</span>
						<div>
							<h4>Stripe / PayPal 手续费计算器</h4>
							<p>精准计算网关手续费与实际到账金额。</p>
						</div>
					</a>
					<a href="/zh/tools/image-to-webp-converter/" class="related-card">
						<span class="card-icon">🖼️</span>
						<div>
							<h4>WebP 图像一键转换</h4>
							<p>本地无损压缩商品主图，加速独立站加载速度。</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ 结构化数据 -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "净利润率 (Margin) 与加价率 (Markup) 有什么区别？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "利润率 (Margin) 是基于总售价计算的占比；加价率 (Markup) 是基于基础成本计算的增值比例。"
						}
					},
					{
						"@type": "Question",
						"name": "保本销售底线价是如何计算出来的？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "保本价自动涵盖了商品采购成本、物流运费、广告 CPA 成本以及交易百分比手续费，确保净利润刚好为 $0 时不亏本。"
						}
					}
				]
			}
		</script>

		<script>
			const cogsIn = document.getElementById('cogs') as HTMLInputElement;
			const shippingIn = document.getElementById('shipping') as HTMLInputElement;
			const adSpendIn = document.getElementById('adSpend') as HTMLInputElement;
			const feeRateIn = document.getElementById('feeRate') as HTMLInputElement;
			const flatFeeIn = document.getElementById('flatFee') as HTMLInputElement;
			const sellingPriceIn = document.getElementById('sellingPrice') as HTMLInputElement;

			const netProfitVal = document.getElementById('netProfitVal');
			const marginVal = document.getElementById('marginVal');
			const markupVal = document.getElementById('markupVal');
			const breakevenVal = document.getElementById('breakevenVal');
			const totalCostVal = document.getElementById('totalCostVal');
			const totalFeesVal = document.getElementById('totalFeesVal');
			const roiVal = document.getElementById('roiVal');

			function calculateProfit() {
				const cogs = parseFloat(cogsIn.value) || 0;
				const shipping = parseFloat(shippingIn.value) || 0;
				const adSpend = parseFloat(adSpendIn.value) || 0;
				const feeRate = (parseFloat(feeRateIn.value) || 0) / 100;
				const flatFee = parseFloat(flatFeeIn.value) || 0;
				const price = parseFloat(sellingPriceIn.value) || 0;

				const baseCost = cogs + shipping + adSpend;
				const platformFee = (price * feeRate) + flatFee;
				const totalCost = baseCost + platformFee;
				const netProfit = price - totalCost;

				const margin = price > 0 ? (netProfit / price) * 100 : 0;
				const markup = baseCost > 0 ? (netProfit / baseCost) * 100 : 0;
				const roi = baseCost > 0 ? (netProfit / baseCost) * 100 : 0;

				const breakeven = (1 - feeRate) > 0 ? (baseCost + flatFee) / (1 - feeRate) : 0;

				if (netProfitVal) netProfitVal.textContent = `$${netProfit.toFixed(2)}`;
				if (marginVal) marginVal.textContent = `${margin.toFixed(2)}%`;
				if (markupVal) markupVal.textContent = `${markup.toFixed(2)}%`;
				if (breakevenVal) breakevenVal.textContent = `$${breakeven.toFixed(2)}`;
				if (totalCostVal) totalCostVal.textContent = `$${totalCost.toFixed(2)}`;
				if (totalFeesVal) totalFeesVal.textContent = `$${platformFee.toFixed(2)}`;
				if (roiVal) roiVal.textContent = `${roi.toFixed(2)}%`;

				if (netProfitVal) {
					netProfitVal.style.color = netProfit < 0 ? '#ef4444' : 'var(--accent, #6366f1)';
				}
			}

			[cogsIn, shippingIn, adSpendIn, feeRateIn, flatFeeIn, sellingPriceIn].forEach(input => {
				input?.addEventListener('input', calculateProfit);
			});

			calculateProfit();
		</script>
	</body>
</html>
