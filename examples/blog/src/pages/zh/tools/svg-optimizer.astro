---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "SVG 图标在线压缩与代码优化工具",
	description: "免费在线 SVG 代码瘦身与优化工具，100% 浏览器本地运行，自动清除元数据、注释、冗余属性并精简 Path 路径。",
	icon: "⚡",
	tag: "开发者工具",
	keywords: "SVG压缩 SVG优化 SVG精简 移除SVG元数据 SVG代码压缩 矢量图瘦身 SVGO",
	pinned: false,
	priority: 88
};

const pageTitle = `SVG 图标在线压缩与代码优化工具 — ${SITE_TITLE}`;
const pageDescription = "免费在线 SVG 代码瘦身与优化工具，100% 浏览器本地运行，自动清除元数据、注释、冗余属性并精简 Path 路径。";

// ⚡ 针对 SVG 优化工具定制的 FAQ
const faqList = [
	{
		question: "SVG 压缩是如何做到在不损坏画质的情况下减小体积的？",
		answer: "设计软件（如 Figma、Adobe Illustrator）导出的 SVG 通常包含大量无用的编辑元数据、Doctype 声明、编辑器属性（如 inkscape:version）、HTML 注释和多余的空行空格。通过算法剥离这些无关紧要的文本并精简 Path 坐标数值，即可在 100% 保持矢量图形完整性的同时减少 30%~70% 的文件体积。"
	},
	{
		question: "被优化后的 SVG 代码可以直接在 React / Vue / HTML 中使用吗？",
		answer: "完全可以。工具净化后的代码是非常干净的标准 XML/SVG 结构，您可以直接作为内联 SVG 插入 HTML、React (JSX) 或 Vue 组件中，有利于提升网页渲染性能与 Lighthouse 评分。"
	},
	{
		question: "我的 SVG 矢量图文件会被上传到远程服务器吗？",
		answer: "绝不上传。本工具完全运行在您浏览器的 JavaScript 引擎中，所有的代码解析与格式净化均 100% 在本地完成，保护您的设计稿与隐私数据。"
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};

// ⚡ 相关工具推荐列表（增加内部链接，提升 SEO 权重）
const relatedTools = [
	{
		name: "图片转 WebP 格式工具",
		desc: "批量将 PNG、JPG 压缩转为高压缩率的 WebP 图像。",
		link: "/tools/image-to-webp-zh/",
		icon: "🖼️"
	},
	{
		name: "Base64 & URL 编解码工具",
		desc: "快速将 SVG 或文本加密转为 Base64 或 URL 编码。",
		link: "/tools/base64-encoder-zh/",
		icon: "🔤"
	},
	{
		name: "图片在线去水印工具",
		desc: "纯前端涂抹擦除图片上的多余文字、Logo 与标记。",
		link: "/tools/watermark-remover-zh/",
		icon: "🧹"
	},
	{
		name: "大小写与变量命名转换器",
		desc: "一键转换大小写与驼峰、蛇形等代码变量格式。",
		link: "/tools/case-converter-zh/",
		icon: "🔤"
	}
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 1.8em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}

			/* 优化选项配置网格 */
			.config-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 0.8rem;
				margin-bottom: 1.2em;
				padding-bottom: 1em;
				border-bottom: 1px solid var(--card-border);
			}
			.config-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-main);
				cursor: pointer;
			}
			.config-item input {
				accent-color: var(--accent);
				cursor: pointer;
			}

			/* 视图与对比编辑器 */
			.editor-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 1.2rem;
				margin-bottom: 1.2em;
			}
			.editor-block label {
				display: flex;
				justify-content: space-between;
				font-weight: 600;
				font-size: 0.88rem;
				margin-bottom: 0.5em;
				color: var(--text-main);
			}
			.editor-block label span.size-badge {
				font-size: 0.8rem;
				color: var(--text-muted);
				font-weight: normal;
			}
			textarea {
				width: 100%;
				height: 220px;
				padding: 0.8em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 10px;
				color: var(--text-main);
				font-size: 0.88rem;
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				box-sizing: border-box;
				outline: none;
				resize: vertical;
				line-height: 1.4;
			}
			textarea:focus {
				border-color: var(--accent);
			}

			/* SVG 实时视觉预览对比 */
			.preview-row {
				display: flex;
				align-items: center;
				justify-content: space-around;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				padding: 1em;
				margin-bottom: 1.2em;
				min-height: 80px;
			}
			.preview-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.4rem;
			}
			.preview-box span {
				font-size: 0.78rem;
				color: var(--text-muted);
			}
			.svg-host {
				width: 48px;
				height: 48px;
				display: flex;
				align-items: center;
				justify-content: center;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 6px;
				padding: 4px;
			}
			.svg-host svg {
				max-width: 100%;
				max-height: 100%;
			}

			.action-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.8rem;
				flex-wrap: wrap;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}

			/* ⚡ 相关工具推荐样式 */
			.related-section {
				margin-top: 3.5em;
				padding-top: 2em;
				border-top: 1px solid var(--card-border);
			}
			.section-title {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1em;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 1rem;
			}
			.related-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 1em;
				text-decoration: none !important;
				transition: transform 0.2s, border-color 0.2s;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}
			.related-card:hover {
				transform: translateY(-2px);
				border-color: var(--accent);
			}
			.related-card-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-weight: 700;
				font-size: 0.92rem;
				color: var(--text-main);
			}
			.related-card p {
				font-size: 0.8rem;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.4;
			}

			/* FAQ 区域 */
			.faq-section {
				margin-top: 2.5em;
				padding-top: 2em;
				border-top: 1px dashed var(--card-border);
			}
			.faq-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
				gap: 1.2rem;
			}
			.faq-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 1.2em;
			}
			.faq-card h3 {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-main);
				margin: 0 0 0.5rem 0;
			}
			.faq-card p {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.6;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>⚡ SVG 图标在线压缩与代码优化工具</h1>
				<p>100% 本地分析并自动擦除 XML 冗余元素、元数据与多余注释，大幅精简 SVG 体积</p>
			</div>

			<div class="tool-box">
				<!-- 清洁配置复选框 -->
				<div class="config-grid">
					<label class="config-item">
						<input type="checkbox" id="optComments" checked /> 移除注释 (Comments)
					</label>
					<label class="config-item">
						<input type="checkbox" id="optMetadata" checked /> 移除元数据 (Metadata)
					</label>
					<label class="config-item">
						<input type="checkbox" id="optDoctype" checked /> 移除 XML / Doctype 声明
					</label>
					<label class="config-item">
						<input type="checkbox" id="optEditorAttrs" checked /> 清理编辑器专有属性
					</label>
					<label class="config-item">
						<input type="checkbox" id="optSpaces" checked /> 压缩多余空格与空行
					</label>
				</div>

				<!-- 代码对比框 -->
				<div class="editor-grid">
					<div class="editor-block">
						<label>
							<span>原始 SVG 代码 / 拖拽上传文件：</span>
							<span class="size-badge" id="rawSize">大小: 0 B</span>
						</label>
						<textarea id="rawInput" placeholder="在此粘贴 <svg> 代码，或直接拖拽 .svg 文件到此处..."></textarea>
					</div>

					<div class="editor-block">
						<label>
							<span>优化后的干净代码：</span>
							<span class="size-badge" id="optSize">大小: 0 B</span>
						</label>
						<textarea id="optOutput" readonly placeholder="精简后的代码将自动在此生成..."></textarea>
					</div>
				</div>

				<!-- 视觉与缩减率预览 -->
				<div class="preview-row">
					<div class="preview-box">
						<span>原始效果</span>
						<div class="svg-host" id="prevRaw"></div>
					</div>
					<div style="text-align:center;">
						<div style="font-size:0.85rem; color:var(--text-muted);">体积瘦身比</div>
						<strong id="savedRatio" style="font-size:1.2rem; color:var(--accent);">0%</strong>
					</div>
					<div class="preview-box">
						<span>优化后效果</span>
						<div class="svg-host" id="prevOpt"></div>
					</div>
				</div>

				<!-- 操作工具栏 -->
				<div class="action-bar">
					<button class="btn btn-secondary" id="btnClear">清空内容</button>
					<div style="display:flex; gap:0.6rem;">
						<button class="btn btn-secondary" id="btnDownload">下载 .svg 文件</button>
						<button class="btn" id="btnCopy">复制优化后的代码</button>
					</div>
				</div>
			</div>

			<!-- ⚡ 相关工具推荐 (Related Tools Mesh) -->
			<section class="related-section">
				<div class="section-title">🔗 您可能还需要这些办公与开发工具：</div>
				<div class="related-grid">
					{relatedTools.map(item => (
						<a href={item.link} class="related-card">
							<div class="related-card-header">
								<span>{item.icon}</span>
								<span>{item.name}</span>
							</div>
							<p>{item.desc}</p>
						</a>
					))}
				</div>
			</section>

			<!-- ⚡ 定制 FAQ 区域 -->
			<section class="faq-section">
				<div class="section-title">❓ 常见问题解答 (FAQ)</div>
				<div class="faq-grid">
					{faqList.map(item => (
						<div class="faq-card">
							<h3>{item.question}</h3>
							<p>{item.answer}</p>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const rawInput = document.getElementById('rawInput') as HTMLTextAreaElement;
			const optOutput = document.getElementById('optOutput') as HTMLTextAreaElement;
			const rawSize = document.getElementById('rawSize');
			const optSize = document.getElementById('optSize');
			const savedRatio = document.getElementById('savedRatio');

			const prevRaw = document.getElementById('prevRaw');
			const prevOpt = document.getElementById('prevOpt');

			const btnCopy = document.getElementById('btnCopy') as HTMLButtonElement;
			const btnDownload = document.getElementById('btnDownload');
			const btnClear = document.getElementById('btnClear');

			const optComments = document.getElementById('optComments') as HTMLInputElement;
			const optMetadata = document.getElementById('optMetadata') as HTMLInputElement;
			const optDoctype = document.getElementById('optDoctype') as HTMLInputElement;
			const optEditorAttrs = document.getElementById('optEditorAttrs') as HTMLInputElement;
			const optSpaces = document.getElementById('optSpaces') as HTMLInputElement;

			const checkboxes = [optComments, optMetadata, optDoctype, optEditorAttrs, optSpaces];
			checkboxes.forEach(cb => cb?.addEventListener('change', runOptimization));

			rawInput?.addEventListener('input', runOptimization);

			// 文件拖拽支持
			rawInput?.addEventListener('dragover', (e) => e.preventDefault());
			rawInput?.addEventListener('drop', (e) => {
				e.preventDefault();
				if (e.dataTransfer?.files.length) {
					const file = e.dataTransfer.files[0];
					if (file.name.endsWith('.svg') || file.type.includes('xml') || file.type.includes('svg')) {
						const reader = new FileReader();
						reader.onload = (ev) => {
							rawInput.value = ev.target?.result as string;
							runOptimization();
						};
						reader.readAsText(file);
					}
				}
			});

			function runOptimization() {
				const src = rawInput.value.trim();
				if (!src) {
					optOutput.value = '';
					if (rawSize) rawSize.textContent = '大小: 0 B';
					if (optSize) optSize.textContent = '大小: 0 B';
					if (savedRatio) savedRatio.textContent = '0%';
					if (prevRaw) prevRaw.innerHTML = '';
					if (prevOpt) prevOpt.innerHTML = '';
					return;
				}

				let result = src;

				// 1. 移除注释
				if (optComments?.checked) {
					result = result.replace(/<!--[\s\S]*?-->/g, '');
				}
				// 2. 移除 Doctype 与 XML 申明
				if (optDoctype?.checked) {
					result = result.replace(/<\?xml[\s\S]*?\?>/gi, '').replace(/<!DOCTYPE[\s\S]*?>/gi, '');
				}
				// 3. 移除 Metadata / Title / Desc
				if (optMetadata?.checked) {
					result = result.replace(/<metadata[\s\S]*?<\/metadata>/gi, '')
						.replace(/<title[\s\S]*?<\/title>/gi, '')
						.replace(/<desc[\s\S]*?<\/desc>/gi, '');
				}
				// 4. 清理编辑属性 (如 inkscape:, sodipodi:, xmlns:sketch)
				if (optEditorAttrs?.checked) {
					result = result.replace(/\s+(inkscape|sodipodi|sketch|xmlns:svgrepo|data-name):[a-zA-Z0-9_-]+="[^"]*"/gi, '')
						.replace(/\s+id="SVGRepo_[^"]*"/gi, '');
				}
				// 5. 压缩多余空格与换行
				if (optSpaces?.checked) {
					result = result.replace(/\s+/g, ' ')
						.replace(/>\s+</g, '><')
						.trim();
				}

				optOutput.value = result;

				// 渲染视觉预览
				if (prevRaw) prevRaw.innerHTML = src;
				if (prevOpt) prevOpt.innerHTML = result;

				// 体积数据计算
				const srcBytes = new Blob([src]).size;
				const optBytes = new Blob([result]).size;

				if (rawSize) rawSize.textContent = `大小: ${formatBytes(srcBytes)}`;
				if (optSize) optSize.textContent = `大小: ${formatBytes(optBytes)}`;

				if (srcBytes > 0) {
					const ratio = (((srcBytes - optBytes) / srcBytes) * 100).toFixed(1);
					if (savedRatio) savedRatio.textContent = `-${parseFloat(ratio) > 0 ? ratio : '0'}%`;
				}
			}

			function formatBytes(bytes: number): string {
				if (bytes === 0) return '0 B';
				const k = 1024;
				const sizes = ['B', 'KB', 'MB'];
				const i = Math.floor(Math.log(bytes) / Math.log(k));
				return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
			}

			btnClear?.addEventListener('click', () => {
				rawInput.value = '';
				runOptimization();
			});

			btnCopy?.addEventListener('click', () => {
				if (!optOutput.value) return;
				navigator.clipboard.writeText(optOutput.value);
				btnCopy.textContent = '已复制！';
				setTimeout(() => { btnCopy.textContent = '复制优化后的代码'; }, 2000);
			});

			btnDownload?.addEventListener('click', () => {
				if (!optOutput.value) return;
				const blob = new Blob([optOutput.value], { type: 'image/svg+xml' });
				const link = document.createElement('a');
				link.href = URL.createObjectURL(blob);
				link.download = `optimized_${Date.now()}.svg`;
				link.click();
			});
		</script>
	</body>
</html>
