---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "字数、字符统计与阅读时长预估工具",
	description: "免费且 100% 保护隐私的在线字数统计工具，实时计算中英文词数、字符数、段落数及朗读阅读时长。",
	icon: "📝",
	tag: "内容创作",
	keywords: "字数统计 字符统计 在线字数计算 阅读时长计算 英文词数统计"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.stats-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
				margin-bottom: 1.5rem;
			}
			.stat-card {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				padding: 1rem;
				border-radius: 12px;
				text-align: center;
			}
			.stat-card.primary {
				border-color: var(--accent);
				background: var(--badge-bg);
			}
			.stat-label {
				font-size: 0.8rem;
				color: var(--text-muted);
				font-weight: 600;
				display: block;
				margin-bottom: 0.3rem;
			}
			.stat-value {
				font-size: 1.6rem;
				font-weight: 800;
				color: var(--accent);
			}
			.time-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
				margin-bottom: 1.5rem;
				background: var(--code-bg);
				padding: 0.8rem 1.2rem;
				border-radius: 10px;
				border: 1px solid var(--card-border);
			}
			.time-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.9rem;
				color: var(--text-muted);
			}
			.time-item strong {
				color: var(--text-main);
				font-weight: 700;
			}
			textarea {
				width: 100%;
				height: 280px;
				padding: 1em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 10px;
				color: var(--text-main);
				font-size: 0.95rem;
				font-family: inherit;
				box-sizing: border-box;
				outline: none;
				resize: vertical;
				line-height: 1.6;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			textarea:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			.btn-group {
				display: flex;
				gap: 0.8rem;
				margin-top: 1.2rem;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* FAQ 与相关工具样式 */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.stats-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.time-grid, .related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>📝 {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="stats-grid">
					<div class="stat-card primary">
						<span class="stat-label">总词数 (Words)</span>
						<span class="stat-value" id="valWords">0</span>
					</div>
					<div class="stat-card">
						<span class="stat-label">总字符数 (含空格)</span>
						<span class="stat-value" id="valChars">0</span>
					</div>
					<div class="stat-card">
						<span class="stat-label">字符数 (不含空格)</span>
						<span class="stat-value" id="valCharsNoSpace">0</span>
					</div>
					<div class="stat-card">
						<span class="stat-label">段落数量</span>
						<span class="stat-value" id="valParagraphs">0</span>
					</div>
				</div>

				<div class="time-grid">
					<div class="time-item">
						<span>预估默读时间：</span>
						<strong id="valReadingTime">0 秒</strong>
					</div>
					<div class="time-item">
						<span>预估朗读/演讲时间：</span>
						<strong id="valSpeakingTime">0 秒</strong>
					</div>
				</div>

				<textarea id="textInput" placeholder="在此粘贴或输入需要统计字数的文本内容..."></textarea>

				<div class="btn-group">
					<button class="btn btn-secondary" id="btnClear">清空文本</button>
					<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">复制文本</button>
				</div>
			</div>

			<!-- FAQ 模块 -->
			<section class="content-section">
				<h2>常见问题解答 (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>阅读时间与朗读时间是如何计算的？</h3>
						<p>默读时间基于成年人平均每分钟 <strong>200 词/字</strong> 的阅读速度估算；演讲/朗读时间则基于标准的口语表达速度 <strong>130 词/字</strong> 估算。</p>
					</div>
					<div class="faq-item">
						<h3>输入的文本会被上传到云端吗？</h3>
						<p><strong>不会。</strong> 本工具的所有字数分析完全在您的浏览器本地执行，绝不会上传或保存在任何服务器上，隐私保护 100%。</p>
					</div>
					<div class="faq-item">
						<h3>中英文混排时如何精准计算词数？</h3>
						<p>工具会自动将连续的英文字母认定为一个英文单词，每一个汉字认定为一个中文词，确保中英文混排内容统计的精确度。</p>
					</div>
				</div>
			</section>

			<!-- 相关工具推荐 -->
			<section class="content-section">
				<h2>你可能也会用到</h2>
				<div class="related-grid">
					<a href="/zh/tools/base64-url-encode-decode/" class="related-card">
						<span class="card-icon">🔤</span>
						<div>
							<h4>Base64 & URL 编解码工具</h4>
							<p>安全快速地转换 Base64 字符串与 URL 参数。</p>
						</div>
					</a>
					<a href="/zh/tools/json-formatter-validator/" class="related-card">
						<span class="card-icon">🛠️</span>
						<div>
							<h4>JSON 格式化与校验工具</h4>
							<p>格式化、美化及校验 JSON 数据的本地工具。</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ 结构化数据 -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "阅读时间与朗读时间是如何计算的？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "默读时间基于成年人平均每分钟 200 词/字的阅读速度估算；演讲朗读时间则基于 130 词/字估算。"
						}
					},
					{
						"@type": "Question",
						"name": "输入的文本会被上传到云端吗？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "不会。本工具的所有字数分析完全在您的浏览器本地执行，绝不会上传或保存在任何服务器上。"
						}
					}
				]
			}
		</script>

		<script>
			const textInput = document.getElementById('textInput') as HTMLTextAreaElement;
			const valWords = document.getElementById('valWords');
			const valChars = document.getElementById('valChars');
			const valCharsNoSpace = document.getElementById('valCharsNoSpace');
			const valParagraphs = document.getElementById('valParagraphs');
			const valReadingTime = document.getElementById('valReadingTime');
			const valSpeakingTime = document.getElementById('valSpeakingTime');

			function updateCounts() {
				const text = textInput.value;
				
				const wordsArray = text.trim().match(/[\u4e00-\u9fa5]|\b[a-zA-Z0-9'-]+\b/g) || [];
				const wordCount = wordsArray.length;

				const charCount = text.length;
				const charNoSpaceCount = text.replace(/\s/g, '').length;

				const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0).length;

				const readSecs = Math.ceil((wordCount / 200) * 60);
				const speakSecs = Math.ceil((wordCount / 130) * 60);

				function formatTime(seconds: number) {
					if (seconds < 60) return `${seconds} 秒`;
					const mins = Math.floor(seconds / 60);
					const remSecs = seconds % 60;
					return `${mins} 分 ${remSecs} 秒`;
				}

				if (valWords) valWords.textContent = wordCount.toLocaleString();
				if (valChars) valChars.textContent = charCount.toLocaleString();
				if (valCharsNoSpace) valCharsNoSpace.textContent = charNoSpaceCount.toLocaleString();
				if (valParagraphs) valParagraphs.textContent = paragraphs.toLocaleString();
				if (valReadingTime) valReadingTime.textContent = formatTime(readSecs);
				if (valSpeakingTime) valSpeakingTime.textContent = formatTime(speakSecs);
			}

			textInput?.addEventListener('input', updateCounts);

			document.getElementById('btnClear')?.addEventListener('click', () => {
				textInput.value = '';
				updateCounts();
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!textInput.value) return;
				navigator.clipboard.writeText(textInput.value);
				const btn = e.target as HTMLButtonElement;
				btn.textContent = '已复制！';
				setTimeout(() => { btn.textContent = '复制文本'; }, 2000);
			});
		</script>
	</body>
</html>
