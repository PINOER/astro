---
import ToolLayout from 'src/layouts/ToolLayout.astro';

export const frontmatter = {
	title: "AI 男装下装与裤装商拍提示词生成器",
	description: "专为男装裤装电商卖家设计的 AI 商拍工具！精准控制牛仔裤、工装裤、西裤与休裤版型、水洗面料细节、鞋靴搭配、姿态控制、镜头焦段与打光，适用于 Midjourney, Flux, SDXL 与豆包。",
	icon: "👖",
	tag: "男装商拍",
	keywords: "AI 男装裤装换装 男裤电商商拍 牛仔裤提示词 工装裤商拍 模特姿态 提示词生成器 midjourney flux 豆包",
	pinned: false,
	priority: 93
};

const faqList = [
	{
		question: "如何实现保留模特和裤子不变，仅更换模特姿态与动作？",
		answer: "选择“三、换动作模式”。生成 Prompt 会自动加入模特人脸特征锁与裤装款式保持指令（Keep Model & Pants Consistent），并把核心权重放在“腿部姿态/视角”选择框上，适合批量出同款模特的不同姿态图。"
	},
	{
		question: "如何生成突出男裤版型与面料纹理的商拍图？",
		answer: "建议在镜头焦段中选择“50mm 标准人眼视角”或“85mm 腿部与裤装细节特写”，并在 Prompt 中保留重磅面料（Heavyweight Fabric）、水洗纹理（Washed Texture）与裤脚堆叠感（Break & Drape）描述。"
	},
	{
		question: "自定义裤装拍摄背景支持中文输入吗？",
		answer: "支持！你在自定义背景输入框中输入的中文描述（如“水泥工业风厂房”、“都市街头斑马线”），系统会在 500ms 内自动翻译为英文 Prompt。"
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqList.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
};
---

<ToolLayout frontmatter={frontmatter} lang="zh">
	<!-- 注入 Schema.org FAQ 结构化数据 -->
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- 工具专属自定义样式 -->
	<style slot="head">
		/* 模式选择选项卡 */
		.mode-tabs {
			display: flex;
			justify-content: center;
			gap: 0.8rem;
			margin-bottom: 1.8rem;
			flex-wrap: wrap;
		}
		.tab-btn {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			color: var(--text-muted);
			padding: 0.6em 1.2em;
			border-radius: 10px;
			font-size: 0.88rem;
			font-weight: 700;
			cursor: pointer;
			transition: all 0.2s ease;
		}
		.tab-btn.active {
			background: var(--accent);
			color: #ffffff !important;
			border-color: var(--accent);
			box-shadow: 0 4px 15px var(--accent-glow);
		}

		.form-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1.2rem;
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 16px;
			padding: 1.8rem;
			backdrop-filter: blur(12px);
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			margin-bottom: 2rem;
		}
		.form-group {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}
		.form-group.full-width {
			grid-column: 1 / -1;
		}
		label {
			font-size: 0.88rem;
			font-weight: 700;
			color: var(--text-main);
			display: flex;
			justify-content: space-between;
			align-items: center;
		}
		label .sub-tag {
			font-size: 0.75rem;
			color: var(--text-muted);
			font-weight: normal;
		}
		.translate-status {
			font-size: 0.75rem;
			color: var(--accent);
			font-weight: 600;
			margin-left: auto;
		}

		input[type="text"], select, textarea {
			width: 100%;
			padding: 0.75em 1em;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 8px;
			color: var(--text-main);
			font-size: 0.92rem;
			box-sizing: border-box;
			outline: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		input[type="text"]:focus, select:focus, textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 10px var(--accent-glow);
		}

		.output-card {
			background: var(--bg-card);
			border: 1px solid var(--card-border);
			border-radius: 16px;
			padding: 1.5rem;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		}
		.output-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 1rem;
		}
		.output-title {
			font-size: 1.05rem;
			font-weight: 700;
			color: var(--text-main);
		}
		.btn-copy {
			background: var(--accent);
			color: #ffffff !important;
			border: none;
			padding: 0.6em 1.2em;
			border-radius: 8px;
			font-size: 0.88rem;
			font-weight: 700;
			cursor: pointer;
			transition: all 0.2s ease;
		}
		.btn-copy:hover {
			background: var(--accent-hover);
			transform: translateY(-1px);
		}
		.prompt-output {
			width: 100%;
			height: 140px;
			background: var(--code-bg) !important;
			border: 1px solid var(--card-border);
			border-radius: 10px;
			padding: 1rem;
			color: var(--text-main);
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 0.9rem;
			line-height: 1.6;
			resize: vertical;
			box-sizing: border-box;
			outline: none;
		}

		/* FAQ Section Styles */
		.faq-section {
			margin-top: 2.5em;
			padding-top: 2em;
			border-top: 1px solid var(--card-border);
		}
		.faq-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 1em;
		}
		.faq-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 1.2rem;
		}
		.faq-card {
			background: var(--code-bg);
			border: 1px solid var(--card-border);
			border-radius: 12px;
			padding: 1.2em;
		}
		.faq-card h3 {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0 0 0.5rem 0;
		}
		.faq-card p {
			font-size: 0.85rem;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.6;
		}
	</style>

	<!-- 工具卡片主体 -->
	<div class="tool-box">
		<!-- 核心模式选择 Tab -->
		<div class="mode-tabs">
			<button class="tab-btn active" data-mode="outfit">一、男裤换装模式 (双图参考)</button>
			<button class="tab-btn" data-mode="scene">二、换背景模式</button>
			<button class="tab-btn" data-mode="detail">三、换动作模式</button>
			<button class="tab-btn" data-mode="full">四、自由定制</button>
		</div>

		<div class="form-grid">
			<!-- 男模身材特征 -->
			<div class="form-group" id="modelGroup">
				<label for="modelSelect">男模身材与腿型</label>
				<select id="modelSelect">
					<option value="tall attractive Asian male model with long lean legs, stylish build">高挑身材东亚男模 (长腿比例/清爽极简)</option>
					<option value="handsome 20s East Asian male model, athletic straight leg posture">20代健壮东亚男模 (直腿/运动街头风)</option>
					<option value="tall Caucasian male model with long slender legs, high fashion posture">欧美高挑长腿男模 (超模气场/腿长比例明显)</option>
					<option value="muscular Black male model with strong legs, athletic posture">肌肉型黑人男模 (美式高街/运动潮流)</option>
				</select>
			</div>

			<!-- 裤装拍摄视角与动态姿态 -->
			<div class="form-group">
				<label for="angleSelect">腿部姿态/视角 (Legs Pose & Angle)</label>
				<select id="angleSelect">
					<option value="">不指定 (Default / Random)</option>
					<option value="front view, standing facing directly forward towards camera, showing full leg drape">正面 (Front View)</option>
					<option value="three-quarter left side view, model turned 45 degrees to the left">左侧45° (Left 3/4 View)</option>
					<option value="exact left side profile view, model facing 90 degrees left, showing side leg seams and pockets">左侧 (Left Side Profile)</option>
					<option value="three-quarter right side view, model turned 45 degrees to the right">右侧45° (Right 3/4 View)</option>
					<option value="exact right side profile view, model facing 90 degrees right, showing side leg seams and pockets">右侧 (Right Side Profile)</option>
					<option value="back view, full rear shot highlighting back pockets and hip tailoring">背面 (Back View)</option>
					<option value="casual sitting posture on a stool, showing knee flexibility and ankle hem break">休闲坐姿 (Casual Sitting Pose)</option>
				</select>
			</div>

			<!-- 裤装版型、材质与细节描述 -->
			<div class="form-group full-width" id="pantsGroup">
				<label for="pantsInput">
					<span>裤装主款式、版型、面料与水洗细节</span>
					<span class="sub-tag">支持中文输入，自动实时翻译</span>
					<span id="pantsStatus" class="translate-status"></span>
				</label>
				<input type="text" id="pantsInput" placeholder="例如：重磅复古深蓝直筒水洗牛仔裤猫须做旧、深灰色羊毛宽腿西裤自然垂坠感、军绿色多口袋工装束脚裤..." />
			</div>

			<!-- 上衣搭配（衬托裤装） -->
			<div class="form-group full-width" id="topGroup">
				<label for="topInput">
					<span>搭配上衣 (衬托裤装效果)</span>
					<span class="sub-tag">支持中文输入，自动实时翻译</span>
					<span id="topStatus" class="translate-status"></span>
				</label>
				<input type="text" id="topInput" placeholder="例如：基础款纯白重磅纯棉短袖T恤塞入裤腰、黑色修身长袖打底衫..." />
			</div>

			<!-- 鞋靴组合 (裤装商拍核心) -->
			<div class="form-group full-width" id="shoesGroup">
				<label for="shoesInput">
					<span>搭配鞋靴 (裤脚与鞋衔接关键)</span>
					<span class="sub-tag">支持中文输入，自动实时翻译</span>
					<span id="shoesStatus" class="translate-status"></span>
				</label>
				<input type="text" id="shoesInput" placeholder="例如：复古黑色切尔西皮靴裤脚自然堆叠、白色低帮德训鞋、高帮运动鞋..." />
			</div>

			<!-- 男裤生活拍摄场景（包含自定义背景） -->
			<div class="form-group full-width">
				<label for="sceneSelect">拍摄与生活场景</label>
				<select id="sceneSelect">
					<option value="preserve original background environment and scene lighting exactly as is">🔒 默认原图背景</option>
					<option value="custom">✍️ 自定义背景 (Custom Environment)</option>
					<option value="walking on a modern sunlit city street with clean concrete pavement">都市阳光街头 (水泥路面/现代建筑)</option>
					<option value="in an industrial loft gallery with polished concrete floor and brick wall">工业风 Loft 展厅 (抛光水泥地面/极简线型)</option>
					<option value="walking across a sunlit crosswalk with clean urban background">阳光斑马线街拍 (动态通勤风)</option>
					<option value="in a sunlit minimalist coffee shop interior with wooden floor">日系极简咖啡馆 (木质地板/温和光影)</option>
					<option value="in a clean professional photo studio with plain neutral backdrop">商业摄影棚纯色背景 (电商主图/突出版型)</option>
				</select>
			</div>

			<!-- 自定义背景输入框（默认隐藏） -->
			<div class="form-group full-width" id="customSceneGroup" style="display: none;">
				<label for="customSceneInput">
					<span>自定义背景描述</span>
					<span class="sub-tag">支持中文输入，自动实时翻译</span>
					<span id="customSceneStatus" class="translate-status"></span>
				</label>
				<input type="text" id="customSceneInput" placeholder="例如：雨后夜幕下的霓虹街头、复古火车站台、高尔夫球场草坪..." />
			</div>

			<!-- 相机设备 -->
			<div class="form-group">
				<label for="cameraSelect">相机机身/设备</label>
				<select id="cameraSelect">
					<option value="shot on Sony Alpha A7R V">索尼 Sony A7R V (现代极锐/面料纤维可见)</option>
					<option value="shot on Leica M11">徕卡 Leica M11 (经典人文色彩与胶片感)</option>
					<option value="shot on Hasselblad H6D-100c">哈苏 Hasselblad H6D (顶级中画幅画质)</option>
					<option value="shot on iPhone 15 Pro Max, authentic mobile photography aesthetic">iPhone 15 Pro Max (小红书真实生活感)</option>
					<option value="shot on 35mm film camera">35mm 复古胶片相机 (自然复古颗粒感)</option>
				</select>
			</div>

			<!-- 镜头与焦段 -->
			<div class="form-group">
				<label for="lensSelect">镜头焦段与视角</label>
				<select id="lensSelect">
					<option value="85mm f/1.2 prime lens, creamy bokeh depth of field, sharp pant detail focus">85mm f/1.2 (经典大光圈虚化/突出裤装质感)</option>
					<option value="50mm f/1.4 prime lens, natural eye-level perspective lookbook framing">50mm f/1.4 (标准人眼视角 Lookbook 构图)</option>
					<option value="35mm lens, candid street style lower-body framing">35mm (人文街拍视角/裤装动态流动感)</option>
					<option value="24mm wide angle lens, dynamic low-angle flattering long leg perspective">24mm 广角 (低视角拉长身材腿长比例)</option>
					<option value="full-body lookbook framing, fashion editorial angle">全身姿态 Lookbook 时尚大片构图</option>
				</select>
			</div>

			<!-- 光线打光设计 -->
			<div class="form-group">
				<label for="lightingSelect">光线风格</label>
				<select id="lightingSelect">
					<option value="clean studio softbox lighting highlighting pant drape and silhouette">柔光箱摄影棚光线 (商业极简/突出裤装垂坠感)</option>
					<option value="soft natural directional sunlight creating realistic fabric texture shadow">自然漫射阳光 (真实面料纹理与光影折痕)</option>
					<option value="golden hour warm sunset backlighting with subtle lens flare">黄金小时逆光夕阳 (暖色边缘轮廓光感)</option>
					<option value="overcast soft ambient light, crisp fabric contrast">阴天漫射柔光 (清爽通透/清晰面料对比度)</option>
					<option value="dramatic rim lighting with strong edge highlights outlining pant cuts">高光轮廓光 (强烈边缘剪影/强调裤型剪裁)</option>
				</select>
			</div>

			<!-- 画幅比例 -->
			<div class="form-group full-width">
				<label for="arSelect">画面宽高比 (--ar)</label>
				<select id="arSelect">
					<option value="--ar 3:4">--ar 3:4 (服装电商主图与详情页)</option>
					<option value="--ar 4:5">--ar 4:5 (Instagram / 小红书 / TikTok)</option>
					<option value="--ar 9:16">--ar 9:16 (全屏竖屏主图)</option>
					<option value="--ar 1:1">--ar 1:1 (正方形商品卡片)</option>
				</select>
			</div>
		</div>

		<!-- 实时生成预览卡片 -->
		<div class="output-card">
			<div class="output-header">
				<span class="output-title">✨ 生成的英文男裤商拍 Prompt</span>
				<button class="btn-copy" id="btnCopy">📋 一键复制 Prompt</button>
			</div>
			<textarea id="promptOutput" class="prompt-output" readonly></textarea>
		</div>
	</div>

	<!-- FAQ 模块区 -->
	<section class="faq-section" slot="faq">
		<div class="faq-title">❓ 常见问题 (FAQ)</div>
		<div class="faq-grid">
			{faqList.map(item => (
				<div class="faq-card">
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 工具专属客户端逻辑脚本 -->
	<script slot="scripts">
		function initTool() {
			let currentMode = 'outfit';

			const tabBtns = document.querySelectorAll('.tab-btn');
			const pantsInput = document.getElementById('pantsInput');
			const pantsStatus = document.getElementById('pantsStatus');
			const topInput = document.getElementById('topInput');
			const topStatus = document.getElementById('topStatus');
			const shoesInput = document.getElementById('shoesInput');
			const shoesStatus = document.getElementById('shoesStatus');

			const sceneSelect = document.getElementById('sceneSelect');
			const customSceneGroup = document.getElementById('customSceneGroup');
			const customSceneInput = document.getElementById('customSceneInput');
			const customSceneStatus = document.getElementById('customSceneStatus');

			const modelSelect = document.getElementById('modelSelect');
			const angleSelect = document.getElementById('angleSelect');
			const cameraSelect = document.getElementById('cameraSelect');
			const lensSelect = document.getElementById('lensSelect');
			const lightingSelect = document.getElementById('lightingSelect');
			const arSelect = document.getElementById('arSelect');

			const promptOutput = document.getElementById('promptOutput');
			const btnCopy = document.getElementById('btnCopy');

			let translatedPants = 'vintage heavyweight dark blue straight-leg washed jeans with whiskering';
			let translatedTop = 'fitted plain white heavyweight cotton t-shirt tucked in';
			let translatedShoes = 'black leather Chelsea boots with natural pant hem drape';
			let translatedCustomScene = '';

			let pantsTimer = null;
			let topTimer = null;
			let shoesTimer = null;
			let customSceneTimer = null;

			function containsChinese(text) {
				return /[\u4e00-\u9fa5]/.test(text);
			}

			async function translateText(text) {
				if (!text.trim()) return '';
				if (!containsChinese(text)) return text;
				try {
					const res = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=zh|en`);
					const data = await res.json();
					return data.responseData?.translatedText || text;
				} catch (e) {
					return text;
				}
			}

			function getSceneValue() {
				if (sceneSelect?.value === 'custom') {
					return translatedCustomScene ? `in ${translatedCustomScene}` : 'in a modern urban setting';
				}
				return sceneSelect?.value || '';
			}

			function buildPrompt() {
				if (!promptOutput) return;

				const pants = translatedPants || 'heavyweight straight jeans';
				const topStr = translatedTop ? `paired with ${translatedTop}` : '';
				const shoesStr = translatedShoes ? `completed with ${translatedShoes}` : '';
				const sceneVal = getSceneValue();
				const poseVal = angleSelect?.value ? `changing pose to ${angleSelect.value}` : 'displaying dynamic posture';

				let modePrefix = '';
				let components = [];

				if (currentMode === 'outfit') {
					modePrefix = '[Inpainting Pants Swap / Dual-Image Reference]';
					components = [
						`Commercial menswear pants photography, precisely transplanting lower-body garment design from Reference Image onto Target Model`,
						`replacing trousers with ${pants}`,
						topStr,
						shoesStr,
						`worn by ${modelSelect?.value || ''}`,
						angleSelect?.value || '',
						sceneVal,
						cameraSelect?.value || '',
						lensSelect?.value || '',
						lightingSelect?.value || '',
						'ultra-detailed denim and fabric weave, realistic pant crease and drape, 8k resolution, raw photo',
						arSelect?.value || ''
					];
				} else if (currentMode === 'scene') {
					modePrefix = '[Pants Background Swap Focus]';
					components = [
						`Commercial menswear trousers photography, placing model wearing ${pants}`,
						topStr,
						shoesStr,
						angleSelect?.value || '',
						`into setting: ${sceneVal}`,
						cameraSelect?.value || '',
						lensSelect?.value || '',
						lightingSelect?.value || '',
						'realistic ground shadows, sharp fabric texture, 8k resolution, raw photo',
						arSelect?.value || ''
					];
				} else if (currentMode === 'detail') {
					// 模式三：仅改变模特动作姿态（锁定模特与裤装）
					modePrefix = '[Pose & Angle Swap Focus - Keep Model & Pants Consistent]';
					components = [
						`Commercial menswear trousers photography, strictly keeping same model (${modelSelect?.value || ''}) and exact same trousers (${pants})`,
						poseVal,
						topStr,
						shoesStr,
						sceneVal,
						cameraSelect?.value || '',
						lensSelect?.value || '',
						lightingSelect?.value || '',
						'consistent facial features, natural leg posture transition, sharp fabric weave, 8k resolution, raw photo',
						arSelect?.value || ''
					];
				} else {
					modePrefix = '[Full Custom Pants Shoot]';
					components = [
						`Commercial menswear trousers shot featuring ${modelSelect?.value || ''}`,
						`wearing ${pants}`,
						topStr,
						shoesStr,
						angleSelect?.value || '',
						sceneVal,
						cameraSelect?.value || '',
						lensSelect?.value || '',
						lightingSelect?.value || '',
						'ultra-detailed fabric texture, 8k resolution, raw photo',
						arSelect?.value || ''
					];
				}

				promptOutput.value = `${modePrefix} ${components.filter(Boolean).join(', ')}`;
			}

			// Tab 按钮切换
			tabBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					tabBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					currentMode = btn.getAttribute('data-mode') || 'outfit';
					buildPrompt();
				});
			});

			// 背景下拉框切换监听（支持自定义背景展开）
			sceneSelect?.addEventListener('change', () => {
				if (sceneSelect.value === 'custom') {
					if (customSceneGroup) customSceneGroup.style.display = 'flex';
				} else {
					if (customSceneGroup) customSceneGroup.style.display = 'none';
				}
				buildPrompt();
			});

			// 防抖翻译：裤装描述
			pantsInput?.addEventListener('input', () => {
				clearTimeout(pantsTimer);
				const raw = pantsInput.value.trim();
				if (!raw) {
					translatedPants = '';
					if (pantsStatus) pantsStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (!containsChinese(raw)) {
					translatedPants = raw;
					if (pantsStatus) pantsStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (pantsStatus) pantsStatus.textContent = '翻译中...';
				pantsTimer = setTimeout(async () => {
					translatedPants = await translateText(raw);
					if (pantsStatus) pantsStatus.textContent = '✓ 已转英文';
					buildPrompt();
				}, 500);
			});

			// 防抖翻译：上衣搭配
			topInput?.addEventListener('input', () => {
				clearTimeout(topTimer);
				const raw = topInput.value.trim();
				if (!raw) {
					translatedTop = '';
					if (topStatus) topStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (!containsChinese(raw)) {
					translatedTop = raw;
					if (topStatus) topStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (topStatus) topStatus.textContent = '翻译中...';
				topTimer = setTimeout(async () => {
					translatedTop = await translateText(raw);
					if (topStatus) topStatus.textContent = '✓ 已转英文';
					buildPrompt();
				}, 500);
			});

			// 防抖翻译：鞋靴组合
			shoesInput?.addEventListener('input', () => {
				clearTimeout(shoesTimer);
				const raw = shoesInput.value.trim();
				if (!raw) {
					translatedShoes = '';
					if (shoesStatus) shoesStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (!containsChinese(raw)) {
					translatedShoes = raw;
					if (shoesStatus) shoesStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (shoesStatus) shoesStatus.textContent = '翻译中...';
				shoesTimer = setTimeout(async () => {
					translatedShoes = await translateText(raw);
					if (shoesStatus) shoesStatus.textContent = '✓ 已转英文';
					buildPrompt();
				}, 500);
			});

			// 防抖翻译：自定义背景
			customSceneInput?.addEventListener('input', () => {
				clearTimeout(customSceneTimer);
				const raw = customSceneInput.value.trim();
				if (!raw) {
					translatedCustomScene = '';
					if (customSceneStatus) customSceneStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (!containsChinese(raw)) {
					translatedCustomScene = raw;
					if (customSceneStatus) customSceneStatus.textContent = '';
					buildPrompt();
					return;
				}
				if (customSceneStatus) customSceneStatus.textContent = '翻译中...';
				customSceneTimer = setTimeout(async () => {
					translatedCustomScene = await translateText(raw);
					if (customSceneStatus) customSceneStatus.textContent = '✓ 已转英文';
					buildPrompt();
				}, 500);
			});

			// 下拉框改变监听
			[modelSelect, angleSelect, cameraSelect, lensSelect, lightingSelect, arSelect].forEach(el => {
				el?.addEventListener('change', buildPrompt);
			});

			buildPrompt();

			// 复制功能
			btnCopy?.addEventListener('click', () => {
				if (!promptOutput || !promptOutput.value) return;
				navigator.clipboard.writeText(promptOutput.value).then(() => {
					if (btnCopy) {
						const originalText = btnCopy.textContent;
						btnCopy.textContent = 'Copied!';
						setTimeout(() => { btnCopy.textContent = originalText; }, 2000);
					}
				});
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initTool);
		} else {
			initTool();
		}
	</script>
</ToolLayout>
