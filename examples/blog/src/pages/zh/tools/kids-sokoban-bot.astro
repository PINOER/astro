---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
    title: "AI逻辑构建：智能核心大挑战",
    description: "专为训练算法思维打造的互动逻辑游戏。通过精准的矩阵引擎重构，将经典逻辑谜题化为培育计算思维的绝佳工具。",
    icon: "🧩",
    tag: "少儿编程",
    keywords: "逻辑推导 计算思维 推箱子重构 二维矩阵 AI逻辑 算法入门",
    pinned: true,
    priority: 85
};

const pageTitle = `AI逻辑构建：智能核心大挑战 — ${SITE_TITLE}`;
const pageDescription = "通过组合逻辑积木，激活数据节点。这款游戏以严格的二维矩阵引擎重构，旨在锻炼面向未来的计算思维。";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.4rem;
				font-weight: 900;
				margin-bottom: 0.3em;
				background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1rem;
				line-height: 1.6;
			}

			.game-layout {
				display: grid;
				grid-template-columns: 1fr 360px;
				gap: 1.5rem;
				background: var(--bg-card, #ffffff);
				border: 1px solid var(--card-border, #e2e8f0);
				border-radius: 24px;
				padding: 1.5rem;
				box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
			}

			@media (max-width: 900px) {
				.game-layout {
					grid-template-columns: 1fr;
					padding: 1rem;
				}
			}

			/* 🎮 游戏视窗：自适应且支持溢出滚动 */
			.game-stage {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				width: 100%;
				overflow: hidden;
			}

			.status-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				background: var(--search-bg, #f1f5f9);
				padding: 0.8rem 1.2rem;
				border-radius: 14px;
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--text-main);
			}

			.level-selector {
				background: var(--bg-card, #fff);
				border: 1px solid var(--card-border, #cbd5e1);
				color: var(--text-main);
				padding: 0.4rem 0.8rem;
				border-radius: 8px;
				font-weight: 700;
				font-family: inherit;
				outline: none;
				cursor: pointer;
			}

			.viewport {
				width: 100%;
				background: #0f172a;
				border: 4px solid #334155;
				border-radius: 16px;
				padding: 1rem;
				box-sizing: border-box;
				box-shadow: inset 0 8px 32px rgba(0,0,0,0.6);
				overflow: auto;
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 400px;
			}

			/* 🧩 矩阵网格引擎：绝对像素渲染，防止任何形变 */
			.matrix-grid {
				display: inline-grid;
				gap: 0;
				margin: auto;
			}

			.matrix-cell {
				width: 40px;
				height: 40px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.8rem;
				position: relative;
				user-select: none;
			}

			@media (max-width: 850px) {
				.matrix-cell { width: 34px; height: 34px; font-size: 1.5rem; }
			}

			/* 材质映射 */
			.cell-void { background-color: transparent; }
			
			.cell-wall {
				background-color: #1e293b;
				border: 1px solid #020617;
				box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
				border-radius: 6px;
			}
			
			.cell-floor {
				background-color: var(--tile-bg, #1e293b);
				border: 1px solid var(--tile-border, #334155);
			}

			/* 数据节点 (目标) */
			.cell-floor.target-node {
				background-color: rgba(56, 189, 248, 0.15);
				border: 2px dashed #38bdf8;
			}
			/* 节点被激活 (箱子在目标上) */
			.cell-floor.target-node.active {
				background-color: rgba(16, 185, 129, 0.3);
				border: 2px solid #10b981;
			}

			.sprite {
				position: absolute;
				transition: transform 0.12s cubic-bezier(0.4, 0, 0.2, 1);
				z-index: 10;
				filter: drop-shadow(0 4px 6px rgba(0,0,0,0.4));
			}
			.sprite-robot { z-index: 20; }

			/* 🎛️ 控制台区域 */
			.control-panel {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}

			.data-card {
				background: var(--search-bg, #f1f5f9);
				border: 1px solid var(--card-border, #cbd5e1);
				border-radius: 14px;
				padding: 1rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				font-weight: 700;
			}
			.data-row {
				display: flex;
				justify-content: space-between;
				font-size: 0.9rem;
			}

			.dpad {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.6rem;
				width: 220px;
				margin: 1rem auto;
			}

			.dpad-btn {
				background: var(--bg-card, #fff);
				border: 2px solid var(--card-border, #cbd5e1);
				color: var(--text-main);
				height: 64px;
				border-radius: 16px;
				font-size: 1.5rem;
				font-weight: 800;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 4px 0 var(--card-border, #cbd5e1);
				transition: all 0.1s ease;
				user-select: none;
				touch-action: manipulation;
			}
			.dpad-btn:active {
				transform: translateY(4px);
				box-shadow: 0 0 0 var(--card-border);
				background: #3b82f6;
				color: #fff;
				border-color: #2563eb;
			}
			.dpad-btn.hidden { visibility: hidden; }

			.btn-group {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
			}

			.action-btn {
				padding: 0.9em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.9rem;
				cursor: pointer;
				border: none;
				transition: opacity 0.2s;
			}
			.action-btn.undo { background: #f59e0b; color: #fff; }
			.action-btn.reset { background: #ef4444; color: #fff; }
			.action-btn:hover { opacity: 0.85; }
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>🧩 AI逻辑构建：智能核心大挑战</h1>
				<p>在未来的 AI 时代，强大的逻辑推导能力是核心基石。<br/>操控 AI 探路者，将散落的“逻辑积木”推入数据节点，完成底层算法的重构！</p>
			</div>

			<div class="game-layout">
				<div class="game-stage">
					<div class="status-bar">
						<div>
							系统层级: 
							<select id="levelSelect" class="level-selector">
								<option>逻辑载入中...</option>
							</select>
						</div>
						<span>节点激活率: <span id="nodeStatus" style="color: #10b981;">0/0</span></span>
					</div>

					<div class="viewport" id="viewport">
						<div class="matrix-grid" id="gridContainer">
							<!-- 二维矩阵渲染区 -->
						</div>
					</div>
				</div>

				<div class="control-panel">
					<div class="data-card">
						<div class="data-row">
							<span>⏱️ 运算步数:</span>
							<span id="stepCount" style="color:#3b82f6;">0</span>
						</div>
						<div class="data-row">
							<span>🏆 最优算法:</span>
							<span id="bestCount">--</span>
						</div>
					</div>

					<div class="dpad">
						<div class="dpad-btn hidden"></div>
						<button class="dpad-btn" id="btnUp">▲</button>
						<div class="dpad-btn hidden"></div>
						<button class="dpad-btn" id="btnLeft">◄</button>
						<button class="dpad-btn" id="btnDown">▼</button>
						<button class="dpad-btn" id="btnRight">►</button>
					</div>

					<div class="btn-group">
						<button class="action-btn undo" id="btnUndo">↩️ 回溯代码</button>
						<button class="action-btn reset" id="btnReset">🔄 重启进程</button>
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			/* 
			  ================================================
			  🧱 逻辑层：严谨的二维矩阵引擎 (The Matrix Engine)
			  ================================================
			*/
			const CORE_LEVELS = `
; 算法启蒙
  ####
###  #
# $  #
# #@.#
#    #
######

; 逻辑分支
#####
#@  #
# $$#
## .#
 #..#
 ####

; 空间推导
  ####
###  #
# .  #
# #$ #
# $ $#
#.#@.#
######

; 死锁规避
 ####
 #  ###
 #$   #
## $  #
#  # $#
#.#@.#
######

; 矩阵穿透
#####
#   #
# $ #
##$ #
# . #
#@. #
#####
`;

			class LogicEngine {
				constructor() {
					this.rawMaps = [];
					this.currentLevel = 0;
					
					this.width = 0;
					this.height = 0;
					this.baseGrid = []; // 'void', 'wall', 'floor', 'target'
					
					this.blocks = []; // [{x, y}] -> 逻辑积木
					this.bot = { x: 0, y: 0, dir: 2 }; // AI 探路者
					
					this.history = [];
					this.steps = 0;
				}

				// 稳健的区块提取器
				parseData(text) {
					const lines = text.replace(/\r/g, '').split('\n');
					const levels = [];
					let buffer = [];

					for (let line of lines) {
						if (/^[ \t\-_]*[#][#@\+\$\*\.\s\-_]*$/.test(line)) {
							buffer.push(line.replace(/[\-_]/g, ' '));
						} else if (buffer.length > 0) {
							levels.push(buffer);
							buffer = [];
						}
					}
					if (buffer.length > 0) levels.push(buffer);
					this.rawMaps = levels;
				}

				loadLevel(idx) {
					if (!this.rawMaps[idx]) return false;
					this.currentLevel = idx;
					const mapData = this.rawMaps[idx];
					
					this.height = mapData.length;
					this.width = Math.max(...mapData.map(l => l.length));
					
					this.baseGrid = Array.from({ length: this.height }, () => Array(this.width).fill('void'));
					this.blocks = [];
					this.history = [];
					this.steps = 0;

					// 1. 扫描写入矩阵
					for (let y = 0; y < this.height; y++) {
						const row = mapData[y];
						for (let x = 0; x < this.width; x++) {
							const char = row[x] || ' ';
							if (char === '#') this.baseGrid[y][x] = 'wall';
							else if (char === '.') this.baseGrid[y][x] = 'target';
							else if (char === '*') { this.baseGrid[y][x] = 'target'; this.blocks.push({x, y}); }
							else if (char === '$') { this.baseGrid[y][x] = 'floor'; this.blocks.push({x, y}); }
							else if (char === '+') { this.baseGrid[y][x] = 'target'; this.bot = {x, y, dir: 2}; }
							else if (char === '@') { this.baseGrid[y][x] = 'floor'; this.bot = {x, y, dir: 2}; }
							else if (char === ' ') this.baseGrid[y][x] = 'floor';
						}
					}

					// 2. Flood Fill 清理外围噪点区域
					const visited = Array.from({ length: this.height }, () => Array(this.width).fill(false));
					const queue = [[this.bot.x, this.bot.y]];
					visited[this.bot.y][this.bot.x] = true;

					while(queue.length > 0) {
						const [cx, cy] = queue.shift();
						const dirs = [[0,1], [0,-1], [1,0], [-1,0]];
						for (let [dx, dy] of dirs) {
							const nx = cx + dx, ny = cy + dy;
							if (nx >= 0 && nx < this.width && ny >= 0 && ny < this.height) {
								if (!visited[ny][nx] && this.baseGrid[ny][nx] !== 'wall') {
									visited[ny][nx] = true;
									queue.push([nx, ny]);
								}
							}
						}
					}

					for (let y = 0; y < this.height; y++) {
						for (let x = 0; x < this.width; x++) {
							if (this.baseGrid[y][x] !== 'wall' && !visited[y][x]) {
								this.baseGrid[y][x] = 'void';
							}
						}
					}
					return true;
				}

				getBlockAt(x, y) {
					return this.blocks.find(b => b.x === x && b.y === y);
				}

				executeMove(dir) {
					this.bot.dir = dir; // 0:Up, 1:Right, 2:Down, 3:Left
					const dx = [0, 1, 0, -1][dir];
					const dy = [-1, 0, 1, 0][dir];
					
					const nx = this.bot.x + dx;
					const ny = this.bot.y + dy;

					if (nx < 0 || nx >= this.width || ny < 0 || ny >= this.height) return false;
					if (this.baseGrid[ny][nx] === 'wall' || this.baseGrid[ny][nx] === 'void') return false;

					const block = this.getBlockAt(nx, ny);
					let pushedBlock = null;
					let oldPos = null;

					if (block) {
						const bnx = nx + dx, bny = ny + dy;
						if (bnx < 0 || bnx >= this.width || bny < 0 || bny >= this.height) return false;
						if (this.baseGrid[bny][bnx] === 'wall' || this.baseGrid[bny][bnx] === 'void') return false;
						if (this.getBlockAt(bnx, bny)) return false;

						oldPos = { x: block.x, y: block.y };
						block.x = bnx;
						block.y = bny;
						pushedBlock = block;
					}

					this.history.push({
						px: this.bot.x, py: this.bot.y, pdir: this.bot.dir,
						block: pushedBlock, oldPos: oldPos
					});

					this.bot.x = nx;
					this.bot.y = ny;
					this.steps++;
					return true;
				}

				revert() {
					if (this.history.length === 0) return false;
					const last = this.history.pop();
					this.bot.x = last.px;
					this.bot.y = last.py;
					this.bot.dir = last.pdir;
					if (last.block) {
						last.block.x = last.oldPos.x;
						last.block.y = last.oldPos.y;
					}
					this.steps--;
					return true;
				}

				checkSystemStatus() {
					let activeNodes = 0;
					let totalNodes = 0;
					for (let y = 0; y < this.height; y++) {
						for (let x = 0; x < this.width; x++) {
							if (this.baseGrid[y][x] === 'target') {
								totalNodes++;
								if (this.getBlockAt(x, y)) activeNodes++;
							}
						}
					}
					return { activeNodes, totalNodes, isComplete: (totalNodes > 0 && activeNodes === totalNodes) };
				}
			}

			/* 
			  ================================================
			  🖥️ 渲染层：数据驱动视图 (DOM Renderer)
			  ================================================
			*/
			const sys = new LogicEngine();
			const gridEl = document.getElementById('gridContainer');
			const levelSelect = document.getElementById('levelSelect');
			
			async function bootSystem() {
				sys.parseData(CORE_LEVELS);
				
				// 获取全量外部算法库
				try {
					const res = await fetch('https://raw.githubusercontent.com/sokoban-levels/sokoban-levels/master/microban.xsb');
					if (res.ok) {
						const text = await res.text();
						sys.parseData(text);
					}
				} catch (e) {
					console.log("外部数据源断开，使用本地核心引擎池");
				}

				levelSelect.innerHTML = '';
				sys.rawMaps.forEach((_, i) => {
					const opt = document.createElement('option');
					opt.value = i;
					
					let difficulty = '🟢基础逻辑';
					if (i > 15) difficulty = '🟡算法进阶';
					if (i > 50) difficulty = '🔴底层重构';
					if (i > 100) difficulty = '🔥终极计算';
					
					opt.textContent = `层级 ${i + 1} - ${difficulty}`;
					levelSelect.appendChild(opt);
				});

				renderLevel(0);
			}

			function renderLevel(idx) {
				sys.loadLevel(idx);
				levelSelect.value = idx;
				paint();
			}

			function paint() {
				gridEl.innerHTML = '';
				gridEl.style.gridTemplateColumns = `repeat(${sys.width}, 1fr)`;
				gridEl.style.gridTemplateRows = `repeat(${sys.height}, 1fr)`;

				for (let y = 0; y < sys.height; y++) {
					for (let x = 0; x < sys.width; x++) {
						const cellType = sys.baseGrid[y][x];
						const cell = document.createElement('div');
						cell.className = `matrix-cell cell-${cellType}`;

						// 棋盘格运算区渲染
						if (cellType === 'floor' || cellType === 'target') {
							if ((x + y) % 2 === 1) {
								cell.style.setProperty('--tile-bg', '#1e293b');
								cell.style.setProperty('--tile-border', '#334155');
							} else {
								cell.style.setProperty('--tile-bg', '#0f172a');
								cell.style.setProperty('--tile-border', '#1e293b');
							}
						}

						if (cellType === 'wall') {
							cell.textContent = '🧱';
						} else if (cellType === 'target') {
							cell.classList.add('target-node');
							if (!sys.getBlockAt(x, y)) {
								const indicator = document.createElement('span');
								indicator.textContent = '⚡';
								indicator.className = 'sprite';
								indicator.style.opacity = '0.5';
								cell.appendChild(indicator);
							}
						}

						// 渲染逻辑积木 (Box)
						const block = sys.getBlockAt(x, y);
						if (block) {
							const bEl = document.createElement('span');
							// 结合教育玩具与数据概念
							bEl.textContent = '🧩'; 
							bEl.className = 'sprite';
							if (cellType === 'target') cell.classList.add('active');
							cell.appendChild(bEl);
						}

						// 渲染 AI 探路者 (Player)
						if (sys.bot.x === x && sys.bot.y === y) {
							const botEl = document.createElement('span');
							botEl.textContent = '🤖';
							botEl.className = 'sprite sprite-robot';
							const angles = [0, 90, 180, -90];
							botEl.style.transform = `rotate(${angles[sys.bot.dir]}deg) scale(1.1)`;
							cell.appendChild(botEl);
						}

						gridEl.appendChild(cell);
					}
				}

				// 更新仪表盘
				const status = sys.checkSystemStatus();
				document.getElementById('nodeStatus').textContent = `${status.activeNodes}/${status.totalNodes}`;
				document.getElementById('stepCount').textContent = sys.steps;

				const bestKey = `ai_logic_best_${sys.currentLevel}`;
				const best = localStorage.getItem(bestKey);
				document.getElementById('bestCount').textContent = best ? best : '--';

				// 结算判定
				if (status.isComplete) {
					if (!best || sys.steps < parseInt(best)) {
						localStorage.setItem(bestKey, sys.steps);
					}
					setTimeout(() => {
						if (sys.currentLevel < sys.rawMaps.length - 1) {
							alert(`🎉 逻辑重构完成！运算消耗: ${sys.steps} 步。系统将自动切入下一层级。`);
							renderLevel(sys.currentLevel + 1);
						} else {
							alert('🏆 恭喜！你已通关所有矩阵算法，展现了卓越的计算思维！');
						}
					}, 200);
				}
			}

			// 指令绑定
			function inputCommand(dir) {
				if (sys.executeMove(dir)) paint();
			}

			window.addEventListener('keydown', (e) => {
				if (['ArrowUp', 'w', 'W'].includes(e.key)) { e.preventDefault(); inputCommand(0); }
				if (['ArrowRight', 'd', 'D'].includes(e.key)) { e.preventDefault(); inputCommand(1); }
				if (['ArrowDown', 's', 'S'].includes(e.key)) { e.preventDefault(); inputCommand(2); }
				if (['ArrowLeft', 'a', 'A'].includes(e.key)) { e.preventDefault(); inputCommand(3); }
				if (['z', 'Z'].includes(e.key)) { e.preventDefault(); if (sys.revert()) paint(); }
			});

			document.getElementById('btnUp').addEventListener('click', () => inputCommand(0));
			document.getElementById('btnRight').addEventListener('click', () => inputCommand(1));
			document.getElementById('btnDown').addEventListener('click', () => inputCommand(2));
			document.getElementById('btnLeft').addEventListener('click', () => inputCommand(3));

			document.getElementById('btnUndo').addEventListener('click', () => { if(sys.revert()) paint(); });
			document.getElementById('btnReset').addEventListener('click', () => renderLevel(sys.currentLevel));
			levelSelect.addEventListener('change', (e) => renderLevel(parseInt(e.target.value)));

			bootSystem();
		</script>
	</body>
</html>
