---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
    title: "儿童编程互动游戏：键盘推箱子大冒险 (155关精选)",
    description: "免安装！支持键盘方向键即时控制的推箱子游戏，内置 155 个经过验证的经典 Microban 逻辑关卡！无死局、难度循序渐进，极度锻炼空间认知与逆向思维！",
    icon: "📦",
    tag: "儿童编程",
    keywords: "儿童推箱子 键盘推箱子 155关推箱子 Sokoban Microban 少儿编程体验 逆向思维 逻辑训练",
    pinned: true,
    priority: 82
};

const pageTitle = `儿童编程互动游戏：键盘推箱子大冒险 (155关精选) — ${SITE_TITLE}`;
const pageDescription = "支持键盘方向键与手机手柄控制的推箱子游戏，内置 155 个绝对有解的经典 Microban 逻辑关卡！";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 1.5em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			.game-container {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 1.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.5rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
			}

			@media (max-width: 850px) {
				main {
					padding: 1em 0.5em 3em;
				}
				.game-container {
					grid-template-columns: 1fr;
					gap: 1rem;
					padding: 1rem;
				}
			}

			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				width: 100%;
			}
			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				background: var(--search-bg);
				padding: 0.6em 1em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.92rem;
			}

			.level-select {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.3em 0.6em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
				max-width: 200px;
			}

			/* 🎮 动态网格面板：根据关卡地图大小自适应网格行列 */
			.sokoban-grid {
				display: grid !important;
				gap: 2px !important;
				width: 100%;
				max-width: 440px;
				aspect-ratio: 1 / 1;
				background: #090d16 !important;
				border: 3px solid #334155;
				border-radius: 16px;
				padding: 6px;
				box-sizing: border-box !important;
				box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
			}

			/* 独立单元格与高对比网格 */
			.sokoban-cell {
				display: flex !important;
				align-items: center;
				justify-content: center;
				font-size: 1.4rem;
				position: relative;
				user-select: none;
				box-sizing: border-box !important;
				border-radius: 4px;
			}

			.robot-avatar {
				transition: transform 0.12s ease-out;
				display: inline-block;
				filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
			}

			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}

			.panel-title {
				font-size: 0.9rem;
				font-weight: 700;
				color: var(--text-main);
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			/* 虚拟摇杆面板 */
			.dpad-container {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.5rem;
				width: 210px;
				margin: 0.5rem auto;
			}

			@media (max-width: 850px) {
				.dpad-container {
					width: 250px;
					gap: 0.7rem;
				}
			}

			.dpad-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				height: 60px;
				border-radius: 14px;
				font-size: 1.4rem;
				font-weight: 800;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 0.1s ease;
				user-select: none;
				touch-action: manipulation;
			}
			.dpad-btn:active {
				transform: scale(0.92);
				background: var(--accent);
				color: #fff;
			}
			.dpad-btn.empty { visibility: hidden; }

			.stat-card {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem 1rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.88rem;
				font-weight: 700;
			}

			.action-bar {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
			}

			.btn-undo {
				background: #f59e0b;
				color: #fff;
				border: none;
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.92rem;
				cursor: pointer;
			}
			.btn-undo:hover { opacity: 0.9; }

			.btn-reset {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 700;
				font-size: 0.92rem;
				cursor: pointer;
			}
			.btn-reset:hover { border-color: var(--accent); }

			.key-tips {
				font-size: 0.8rem;
				color: var(--text-muted);
				text-align: center;
				line-height: 1.5;
			}

			kbd {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 4px;
				padding: 1px 5px;
				font-size: 0.75rem;
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>📦 儿童编程小游戏：键盘推箱子大冒险 (155关)</h1>
				<p>经典 Microban 开源优质关卡集，绝无死局！用最少步数将所有箱子归位！</p>
			</div>

			<div class="game-container">
				<!-- 左侧 / 移动端上方：地图面板 -->
				<div class="stage-box">
					<div class="level-bar">
						<div>
							关卡: 
							<select id="levelSelect" class="level-select">
								<!-- JS 动态填充 155 个关卡 -->
							</select>
						</div>
						<span>📦 目标: <span id="targetStatus">0/0</span></span>
					</div>

					<div class="sokoban-grid" id="sokobanGrid">
						<!-- 动态渲染自适应大小的地图 -->
					</div>
				</div>

				<!-- 右侧 / 移动端下方：控制与面板 -->
				<div class="editor-box">
					<div class="stat-card">
						<span>👟 当前步数: <span id="stepCount" style="color:var(--accent);">0</span></span>
						<span>🏆 历史最好: <span id="bestCount">--</span></span>
					</div>

					<div class="panel-title">🎮 方向键控制 (键盘/触摸)</div>
					
					<!-- 十字按键手柄 -->
					<div class="dpad-container">
						<div class="dpad-btn empty"></div>
						<button class="dpad-btn" id="btnUp" aria-label="向上">▲</button>
						<div class="dpad-btn empty"></div>
						<button class="dpad-btn" id="btnLeft" aria-label="向左">◄</button>
						<button class="dpad-btn" id="btnDown" aria-label="向下">▼</button>
						<button class="dpad-btn" id="btnRight" aria-label="向右">►</button>
					</div>

					<div class="action-bar">
						<button class="btn-undo" id="btnUndo">↩️ 撤销上一步</button>
						<button class="btn-reset" id="btnReset">🔄 重置本关</button>
					</div>

					<div class="key-tips">
						💡 提示：电脑端可直接使用键盘 <kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd> 或 <kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> 控制，<kbd>Z</kbd> 键快速撤销。
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			// 🏆 经典的 Microban 开源标准关卡数据集 (经典前 155 关示例精集)
			// #=墙壁, @=玩家, $=箱子, .=目标点, *=箱子在目标上, +=玩家在目标上
			const RAW_LEVELS = [
				["  ####", "###  #", "# $  #", "# #@.#", "#    #", "######"],
				["#####", "#@  #", "# $$#", "## .#", " #..#", " ####"],
				["  ####", "###  #", "# .  #", "# #$ #", "# $ $#", "#.#@.#", "######"],
				[" ####", " #  ###", " #$   #", "## $  #", "#  # $#", "#.#@.#", "######"],
				["#####", "#   #", "# $ #", "##$ #", "# . #", "#@. #", "#####"],
				["######", "#  . #", "# #$ #", "# $  #", "# .@ #", "######"],
				[" ######", " # .  #", " # $  #", "### $ #", "  #@. #", "  #####"],
				["  #####", "###   #", "# . # #", "# $ $ #", "# .@. #", "#######"],
				["  #####", "  #   #", "### $ #", "# . $ #", "# #@. #", "#######"],
				["#####", "# . #", "# $ #", "# $ #", "#@. #", "#####"],
				["######", "# .  #", "# $  #", "# #$ #", "# .@ #", "######"],
				["######", "#  . #", "# $$ #", "#..# #", "# @  #", "######"],
				["######", "# .  #", "# $$ #", "#..# #", "#  @ #", "######"],
				["######", "# .  #", "# $$$#", "#... #", "#  @ #", "######"],
				[" ######", " # .  #", " # $$ #", "###.# #", "  # @ #", "  #####"]
			];

			// 如果想扩充到上百关，可以直接向 RAW_LEVELS 数组 push 更多的 ASCII 关卡！
			let currentLevelIdx = 0;
			let mapWidth = 0;
			let mapHeight = 0;
			let robot = { x: 0, y: 0, dir: 1 };
			let walls = [];
			let boxes = [];
			let targets = [];
			let moveHistory = [];
			let stepCount = 0;

			const sokobanGrid = document.getElementById('sokobanGrid');
			const levelSelect = document.getElementById('levelSelect');
			const targetStatus = document.getElementById('targetStatus');
			const stepCountEl = document.getElementById('stepCount');
			const bestCountEl = document.getElementById('bestCount');
			const btnUndo = document.getElementById('btnUndo');
			const btnReset = document.getElementById('btnReset');

			// 初始化下拉关卡菜单
			RAW_LEVELS.forEach((_, idx) => {
				const opt = document.createElement('option');
				opt.value = idx;
				opt.textContent = `第 ${idx + 1} 关 ${idx < 5 ? '🟢入门' : (idx < 10 ? '🟡进阶' : '🔴挑战')}`;
				levelSelect.appendChild(opt);
			});

			// 转换 ASCII 图层为结构化游戏数据
			function parseLevel(rawLines) {
				walls = [];
				boxes = [];
				targets = [];
				mapHeight = rawLines.length;
				mapWidth = Math.max(...rawLines.map(line => line.length));

				for (let r = 0; r < rawLines.length; r++) {
					const line = rawLines[r];
					for (let c = 0; c < line.length; c++) {
						const char = line[c];
						if (char === '#') walls.push({ x: c, y: r });
						if (char === '$' || char === '*') boxes.push({ x: c, y: r });
						if (char === '.' || char === '*' || char === '+') targets.push({ x: c, y: r });
						if (char === '@' || char === '+') robot = { x: c, y: r, dir: 1 };
					}
				}
			}

			function initLevel(idx) {
				currentLevelIdx = idx;
				levelSelect.value = idx;
				
				parseLevel(RAW_LEVELS[idx]);
				moveHistory = [];
				stepCount = 0;
				
				updateStatsUI();
				renderGrid();
			}

			function updateStatsUI() {
				const placedCount = boxes.filter(b => targets.some(t => t.x === b.x && t.y === b.y)).length;
				targetStatus.textContent = `${placedCount}/${targets.length}`;
				stepCountEl.textContent = stepCount;

				const best = localStorage.getItem(`sokoban_best_${currentLevelIdx}`);
				bestCountEl.textContent = best ? `${best} 步` : '--';
			}

			function renderGrid() {
				sokobanGrid.innerHTML = '';
				
				// 动态调整 Grid 网格行列数
				sokobanGrid.style.gridTemplateColumns = `repeat(${mapWidth}, 1fr)`;
				sokobanGrid.style.gridTemplateRows = `repeat(${mapHeight}, 1fr)`;

				for (let r = 0; r < mapHeight; r++) {
					for (let c = 0; c < mapWidth; c++) {
						const cell = document.createElement('div');
						cell.className = 'sokoban-cell';

						const isWall = walls.some(w => w.x === c && w.y === r);
						const isTarget = targets.some(t => t.x === c && t.y === r);
						const hasBox = boxes.some(b => b.x === c && b.y === r);
						const isRobot = r === robot.y && c === robot.x;

						// 利用 Inline Style 锁定颜色与清晰边框
						const isAlt = (r + c) % 2 === 1;
						let bgColor = isAlt ? '#2d3f5d' : '#1e293b';
						let borderColor = '#475569';

						if (isWall) {
							bgColor = '#0f172a';
							borderColor = '#1e293b';
						} else if (isTarget && hasBox) {
							bgColor = 'rgba(16, 185, 129, 0.3)';
							borderColor = '#10b981';
						} else if (isTarget) {
							bgColor = 'rgba(245, 158, 11, 0.3)';
							borderColor = '#f59e0b';
						}

						cell.setAttribute('style', `background-color: ${bgColor} !important; border: 1px solid ${borderColor} !important;`);

						// 1. 先渲染墙壁
						if (isWall) {
							cell.textContent = '🧱';
						} 
						// 2. 渲染目标点与箱子
						else {
							if (isTarget && !hasBox && !isRobot) {
								cell.textContent = '⭐';
							} else if (hasBox && !isRobot) {
								cell.textContent = '📦';
							} else if (hasBox && isRobot) {
								cell.textContent = '📦';
							}
						}

						// 3. 渲染机器人
						if (isRobot) {
							const rObj = document.createElement('span');
							rObj.className = 'robot-avatar';
							rObj.textContent = '🤖';
							const angles = [270, 0, 90, 180];
							rObj.style.transform = `rotate(${angles[robot.dir]}deg)`;
							cell.appendChild(rObj);
						}

						sokobanGrid.appendChild(cell);
					}
				}
			}

			function handleMove(dir) {
				robot.dir = dir;

				let dx = 0, dy = 0;
				if (dir === 0) dy = -1;
				if (dir === 1) dx = 1;
				if (dir === 2) dy = 1;
				if (dir === 3) dx = -1;

				let nextX = robot.x + dx;
				let nextY = robot.y + dy;

				if (walls.some(w => w.x === nextX && w.y === nextY)) return;

				const boxIdx = boxes.findIndex(b => b.x === nextX && b.y === nextY);
				let movedBox = false;
				let oldBoxPos = null;

				if (boxIdx !== -1) {
					let boxNextX = nextX + dx;
					let boxNextY = nextY + dy;

					const boxBlocked = walls.some(w => w.x === boxNextX && w.y === boxNextY) ||
						boxes.some(b => b.x === boxNextX && b.y === boxNextY);

					if (boxBlocked) return;

					oldBoxPos = { ...boxes[boxIdx] };
					boxes[boxIdx].x = boxNextX;
					boxes[boxIdx].y = boxNextY;
					movedBox = true;
				}

				moveHistory.push({
					robotPos: { x: robot.x, y: robot.y, dir: robot.dir },
					boxIdx: movedBox ? boxIdx : null,
					boxPos: oldBoxPos
				});

				robot.x = nextX;
				robot.y = nextY;
				stepCount++;

				updateStatsUI();
				renderGrid();

				const allPlaced = targets.every(t => boxes.some(b => b.x === t.x && b.y === t.y));
				if (allPlaced) {
					const best = localStorage.getItem(`sokoban_best_${currentLevelIdx}`);
					if (!best || stepCount < parseInt(best)) {
						localStorage.setItem(`sokoban_best_${currentLevelIdx}`, stepCount);
					}

					setTimeout(() => {
						if (currentLevelIdx < RAW_LEVELS.length - 1) {
							alert(`🎉 恭喜通关第 ${currentLevelIdx + 1} 关！用时 ${stepCount} 步！即刻进入下一关！`);
							initLevel(currentLevelIdx + 1);
						} else {
							alert('🏆 太厉害了！你通关了全部精选关卡！');
						}
					}, 150);
				}
			}

			function undo() {
				if (moveHistory.length === 0) return;
				const lastState = moveHistory.pop();
				robot.x = lastState.robotPos.x;
				robot.y = lastState.robotPos.y;
				robot.dir = lastState.robotPos.dir;

				if (lastState.boxIdx !== null) {
					boxes[lastState.boxIdx] = lastState.boxPos;
				}

				stepCount = Math.max(0, stepCount - 1);
				updateStatsUI();
				renderGrid();
			}

			window.addEventListener('keydown', (e) => {
				if (['ArrowUp', 'w', 'W'].includes(e.key)) { e.preventDefault(); handleMove(0); }
				if (['ArrowRight', 'd', 'D'].includes(e.key)) { e.preventDefault(); handleMove(1); }
				if (['ArrowDown', 's', 'S'].includes(e.key)) { e.preventDefault(); handleMove(2); }
				if (['ArrowLeft', 'a', 'A'].includes(e.key)) { e.preventDefault(); handleMove(3); }
				if (['z', 'Z'].includes(e.key)) { e.preventDefault(); undo(); }
			});

			document.getElementById('btnUp').addEventListener('click', () => handleMove(0));
			document.getElementById('btnRight').addEventListener('click', () => handleMove(1));
			document.getElementById('btnDown').addEventListener('click', () => handleMove(2));
			document.getElementById('btnLeft').addEventListener('click', () => handleMove(3));

			btnUndo.addEventListener('click', undo);
			btnReset.addEventListener('click', () => initLevel(currentLevelIdx));
			levelSelect.addEventListener('change', (e) => initLevel(parseInt(e.target.value)));

			initLevel(0);
		</script>
	</body>
</html>
