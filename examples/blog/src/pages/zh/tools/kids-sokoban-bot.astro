---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: '儿童编程互动游戏：键盘推箱子大冒险（98关）',
	description: '免安装！支持键盘方向键和触摸按键控制的经典推箱子游戏，内置98个经过求解器验证、由浅入深的关卡，锻炼空间认知、逆向思维与死锁预判能力。',
	icon: '📦',
	tag: '儿童编程',
	keywords: '儿童推箱子 键盘推箱子 98关推箱子 少儿编程体验 逆向思维 逻辑训练 Sokoban',
	pinned: false,
	priority: 82
};

const pageTitle = `儿童编程互动游戏：键盘推箱子大冒险（98关）— ${SITE_TITLE}`;
const pageDescription = '支持键盘方向键和触摸按键即时控制，内置98个经过可解性验证并按真实难度排序的推箱子关卡。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			/*
			 * Legacy-compatible layout:
			 * - No CSS Grid, flex gap, clamp(), min(), aspect-ratio or backdrop-filter.
			 * - Theme variables have hard-coded fallbacks for IE11.
			 */
			main {
				width: 1120px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2.5em 1em 4em;
				box-sizing: border-box;
			}

			.tool-header {
				text-align: center;
				margin-bottom: 1.5em;
			}

			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin: 0 0 0.3em;
				color: #2563eb;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.tool-header p {
				color: #64748b;
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			.game-container {
				display: table;
				width: 100%;
				table-layout: fixed;
				background: #ffffff;
				background: var(--bg-card);
				border: 1px solid #d7deea;
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.5rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				box-sizing: border-box;
			}

			.stage-box,
			.editor-box {
				display: table-cell;
				vertical-align: top;
				box-sizing: border-box;
			}

			.stage-box {
				padding-right: 1.5rem;
				width: auto;
			}

			.editor-box {
				width: 340px;
			}

			.level-bar {
				width: 100%;
				overflow: hidden;
				background: #f3f6fa;
				background: var(--search-bg);
				padding: 0.6em 1em;
				border-radius: 12px;
				border: 1px solid #d7deea;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.92rem;
				box-sizing: border-box;
				margin-bottom: 1rem;
			}

			.level-bar label { float: left; }
			.level-target { float: right; line-height: 2.1em; }

			.level-select {
				max-width: 200px;
				background: #ffffff;
				background: var(--bg-card);
				border: 1px solid #d7deea;
				border: 1px solid var(--card-border);
				color: #1f2937;
				color: var(--text-main);
				padding: 0.4em 0.65em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
			}

			.board-scroll {
				width: 100%;
				overflow: auto;
				text-align: center;
				padding: 2px;
				box-sizing: border-box;
			}

			.sokoban-grid {
				display: table;
				border-collapse: separate;
				border-spacing: 1px;
				margin: 0 auto;
				background: #090d16;
				border: 3px solid #334155;
				border-radius: 16px;
				padding: 8px;
				box-sizing: border-box;
				box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
			}

			.sokoban-grid tbody,
			.sokoban-grid tr { border: 0; padding: 0; margin: 0; }

			.sokoban-cell {
				padding: 0;
				border-radius: 3px;
				text-align: center;
				vertical-align: middle;
				line-height: 1;
				position: relative;
				user-select: none;
				-ms-user-select: none;
				-webkit-user-select: none;
				overflow: hidden;
			}

			.sokoban-cell.tile-even {
				background-color: #1a2332;
				border: 1px solid #253346;
			}

			.sokoban-cell.tile-odd {
				background-color: #243044;
				border: 1px solid #2e3e57;
			}

			.sokoban-cell.void {
				visibility: hidden;
				border-color: transparent;
				background: transparent;
			}

			.sokoban-cell.wall {
				background: #0f172a !important;
				border: 1px solid #334155 !important;
				box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.6);
			}

			.sokoban-cell.target-cell {
				background-color: rgba(245, 158, 11, 0.22) !important;
				border: 1px dashed #f59e0b !important;
			}

			.sokoban-cell.target-placed {
				background-color: rgba(16, 185, 129, 0.35) !important;
				border: 1px solid #10b981 !important;
			}

			.robot-avatar,
			.box-avatar,
			.target-avatar,
			.wall-avatar {
				display: inline-block;
				text-shadow: 0 2px 3px rgba(0, 0, 0, 0.45);
			}

			.robot-avatar {
				transition: transform 0.12s ease-out;
				-ms-transition: -ms-transform 0.12s ease-out;
			}

			.panel-title {
				font-size: 0.85rem;
				font-weight: 700;
				color: #1f2937;
				color: var(--text-main);
				margin: 0 0 0.6rem;
			}

			.stat-card {
				overflow: hidden;
				background: #f3f6fa;
				background: var(--search-bg);
				border: 1px solid #d7deea;
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.6rem 0.9rem;
				font-size: 0.85rem;
				font-weight: 700;
				box-sizing: border-box;
				margin-bottom: 0.8rem;
			}

			.stat-card .stat-left { float: left; }
			.stat-card .stat-right { float: right; }

			.dpad-container {
				width: 220px;
				margin: 0.2rem auto 0.8rem;
				text-align: center;
			}

			.dpad-row { height: 60px; white-space: nowrap; }

			.dpad-btn,
			.dpad-spacer {
				display: inline-block;
				vertical-align: top;
				width: 60px;
				height: 54px;
				margin: 3px;
				box-sizing: border-box;
			}

			.dpad-btn {
				background: #f3f6fa;
				background: var(--search-bg);
				border: 1px solid #d7deea;
				border: 1px solid var(--card-border);
				color: #1f2937;
				color: var(--text-main);
				border-radius: 12px;
				font-size: 1.4rem;
				font-weight: 800;
				cursor: pointer;
				line-height: 50px;
				padding: 0;
				-webkit-tap-highlight-color: transparent;
			}

			.dpad-btn:active {
				-ms-transform: scale(0.92);
				-webkit-transform: scale(0.92);
				transform: scale(0.92);
				background: #2563eb;
				background: var(--accent);
				color: #fff;
			}

			.action-bar {
				font-size: 0;
				white-space: nowrap;
				margin-bottom: 0.8rem;
			}

			.btn-undo,
			.btn-reset {
				display: inline-block;
				width: 48%;
				padding: 0.65em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.88rem;
				cursor: pointer;
				box-sizing: border-box;
				vertical-align: top;
			}

			.btn-undo { margin-right: 4%; background: #f59e0b; color: #fff; border: none; }
			.btn-reset {
				background: #f3f6fa;
				background: var(--search-bg);
				border: 1px solid #d7deea;
				border: 1px solid var(--card-border);
				color: #1f2937;
				color: var(--text-main);
			}

			button[disabled] { cursor: not-allowed; opacity: 0.55; }

			.game-message {
				min-height: 1.2em;
				padding: 0.5rem 0.8rem;
				border-radius: 10px;
				background: #f3f6fa;
				background: var(--search-bg);
				border: 1px solid #d7deea;
				border: 1px solid var(--card-border);
				font-size: 0.82rem;
				font-weight: 700;
				text-align: center;
				color: #64748b;
				color: var(--text-muted);
				margin-bottom: 0.8rem;
			}

			.game-message.success {
				color: #059669;
				border-color: #6ee7b7;
			}

			.key-tips {
				font-size: 0.78rem;
				color: #64748b;
				color: var(--text-muted);
				text-align: center;
				line-height: 1.5;
			}

			kbd {
				background: #f3f6fa;
				background: var(--search-bg);
				border: 1px solid #d7deea;
				border: 1px solid var(--card-border);
				border-radius: 4px;
				padding: 1px 5px;
				font-size: 0.72rem;
			}

			.legacy-note {
				margin-top: 0.8rem;
				font-size: 0.72rem;
				text-align: center;
				color: #64748b;
			}

			@media (max-width: 900px) {
				.game-container { display: block; }
				.stage-box,
				.editor-box { display: block; width: 100%; }
				.stage-box { padding-right: 0; margin-bottom: 1rem; }
				.editor-box { max-width: 520px; margin: 0 auto; }
			}

			@media (max-width: 600px) {
				main { width: 100%; max-width: 100%; padding: 0.2em 0.5em 1em; }
				.tool-header { margin-bottom: 0.3em; }
				.tool-header h1 { font-size: 1.15rem; margin-bottom: 0; }
				.tool-header p { display: none; }
				.game-container { padding: 0.5rem; border-radius: 14px; }
				.level-bar { padding: 0.35em 0.6em; font-size: 0.78rem; margin-bottom: 0.4rem; }
				.level-select { max-width: 125px; padding: 0.2em 0.3em; font-size: 0.78rem; }
				.level-target { line-height: 1.8em; }
				.sokoban-grid { padding: 4px; border-width: 2px; border-radius: 10px; }
				.stat-card { padding: 0.35rem 0.6rem; font-size: 0.78rem; }
				.panel-title { display: none; }
				.dpad-container { width: 170px; margin-bottom: 0.4rem; }
				.dpad-row { height: 46px; }
				.dpad-btn,
				.dpad-spacer { width: 48px; height: 42px; margin: 2px; }
				.dpad-btn { line-height: 38px; font-size: 1.1rem; border-radius: 8px; }
				.btn-undo,
				.btn-reset { padding: 0.45em; font-size: 0.8rem; border-radius: 8px; }
				.game-message { padding: 0.35rem 0.5rem; font-size: 0.78rem; }
				.key-tips { display: none; }
				.legacy-note { margin-top: 0.35rem; }
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>📦 儿童编程小游戏：键盘推箱子大冒险（98关）</h1>
				<p>使用方向键推动箱子，把所有箱子送到目标位置。注意：箱子只能推，不能拉！</p>
			</div>

			<div class="game-container">
				<div class="stage-box">
					<div class="level-bar">
						<label>
							关卡：
							<select id="levelSelect" class="level-select" aria-label="选择推箱子关卡"></select>
						</label>
						<span class="level-target">📦 目标：<span id="targetStatus">0/0</span></span>
					</div>

					<div class="board-scroll" id="boardScroll">
						<table class="sokoban-grid" id="sokobanGrid" role="application" aria-label="推箱子游戏地图">
							<tbody></tbody>
						</table>
					</div>
				</div>

				<div class="editor-box">
					<div class="stat-card">
						<span class="stat-left">👟 当前步数：<span id="stepCount" style="color:#2563eb;">0</span></span>
						<span class="stat-right">🏆 最佳：<span id="bestCount">--</span></span>
					</div>

					<div class="panel-title">🎮 方向键控制（键盘 / 触摸）</div>

					<div class="dpad-container" aria-label="方向控制">
						<div class="dpad-row"><span class="dpad-spacer"></span><button class="dpad-btn" id="btnUp" type="button" aria-label="向上">▲</button><span class="dpad-spacer"></span></div>
						<div class="dpad-row"><button class="dpad-btn" id="btnLeft" type="button" aria-label="向左">◄</button><button class="dpad-btn" id="btnDown" type="button" aria-label="向下">▼</button><button class="dpad-btn" id="btnRight" type="button" aria-label="向右">►</button></div>
					</div>

					<div class="action-bar">
						<button class="btn-undo" id="btnUndo" type="button">↩️ 撤销</button><button class="btn-reset" id="btnReset" type="button">🔄 重置</button>
					</div>

					<div class="game-message" id="gameMessage" aria-live="polite">准备开始</div>

					<div class="key-tips">
						电脑端可使用 <kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd> 或
						<kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd>；按 <kbd>Z</kbd> 撤销，按 <kbd>R</kbd> 重置。
					</div>
					<div class="legacy-note">兼容模式：不依赖 CSS Grid、ES6 集合或现代数组 API。</div>
				</div>
			</div>
			<noscript><p style="text-align:center;color:#b91c1c;">此游戏需要启用 JavaScript。</p></noscript>
		</main>

		<Footer lang="zh" />

