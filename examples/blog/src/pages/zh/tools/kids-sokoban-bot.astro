			const CELL = Object.freeze({
				VOID: 'void',
				FLOOR: 'floor',
				WALL: 'wall'
			});

			const keyOf = (x, y) => `${x},${y}`;

			function parseLevelPack(rawText) {
				const sourceLines = rawText.replace(/\r/g, '').split('\n');
				const sections = [];
				let current = null;

				const finishCurrent = () => {
					if (!current) return;

					while (current.lines.length && current.lines[0].trim() === '') {
						current.lines.shift();
					}
					while (current.lines.length && current.lines[current.lines.length - 1].trim() === '') {
						current.lines.pop();
					}

					if (current.lines.length) sections.push(current);
				};

				for (const sourceLine of sourceLines) {
					const marker = sourceLine.match(/^;\s*(\d+)\s*$/);
					if (marker) {
						finishCurrent();
						current = { sourceId: Number(marker[1]), lines: [] };
						continue;
					}

					if (current) {
						current.lines.push(sourceLine.replace(/\s+$/, ''));
					}
				}
				finishCurrent();

				return sections.map(parseLevelSection);
			}

			function parseLevelSection(section, index) {
				const height = section.lines.length;
				const width = Math.max(...section.lines.map((line) => line.length));
				const rawGrid = section.lines.map((line) => line.padEnd(width, ' ').split(''));

				const walls = new Set();
				const targets = new Set();
				const boxes = [];
				let robot = null;

				for (let y = 0; y < height; y++) {
					for (let x = 0; x < width; x++) {
						const symbol = rawGrid[y][x];
						const key = keyOf(x, y);

						if (symbol === '#') walls.add(key);
						if (symbol === '.' || symbol === '*' || symbol === '+') targets.add(key);
						if (symbol === '$' || symbol === '*') boxes.push({ x, y });
						if (symbol === '@' || symbol === '+') robot = { x, y, dir: 1 };
					}
				}

				if (!robot) {
					throw new Error(`关卡 ${section.sourceId} 缺少玩家符号 @ 或 +`);
				}
				if (boxes.length !== targets.size) {
					throw new Error(
						`关卡 ${section.sourceId} 的箱子数量（${boxes.length}）与目标数量（${targets.size}）不一致`
					);
				}

				const outsideSpaces = findOutsideSpaces(rawGrid, width, height);
				const cells = Array.from({ length: height }, (_, y) =>
					Array.from({ length: width }, (_, x) => {
						const key = keyOf(x, y);
						if (walls.has(key)) return CELL.WALL;
						if (outsideSpaces.has(key)) return CELL.VOID;
						return CELL.FLOOR;
					})
				);

				return {
					index,
					sourceId: section.sourceId,
					title: `第 ${index + 1} 关`,
					width,
					height,
					cells,
					walls,
					targets,
					initialRobot: robot,
					initialBoxes: boxes
				};
			}

			function findOutsideSpaces(rawGrid, width, height) {
				const outside = new Set();
				const queue = [];
				let head = 0;

				const addSpace = (x, y) => {
					if (x < 0 || y < 0 || x >= width || y >= height) return;
					if (rawGrid[y][x] !== ' ') return;

					const key = keyOf(x, y);
					if (outside.has(key)) return;

					outside.add(key);
					queue.push({ x, y });
				};

				for (let x = 0; x < width; x++) {
					addSpace(x, 0);
					addSpace(x, height - 1);
				}
				for (let y = 0; y < height; y++) {
					addSpace(0, y);
					addSpace(width - 1, y);
				}

				while (head < queue.length) {
					const { x, y } = queue[head++];
					addSpace(x + 1, y);
					addSpace(x - 1, y);
					addSpace(x, y + 1);
					addSpace(x, y - 1);
				}

				return outside;
			}

			function cloneBoxes(sourceBoxes) {
				return sourceBoxes.map((box) => ({ ...box }));
			}

			const LEVELS = parseLevelPack(RAW_LEVELS);
			let currentLevelIdx = 0;
			let robot = { x: 0, y: 0, dir: 1 };
			let boxes = [];
			let moveHistory = [];
			let stepCount = 0;
			let levelCompleted = false;
			let completionTimer = null;

			const sokobanGrid = document.getElementById('sokobanGrid');
			const levelSelect = document.getElementById('levelSelect');
			const targetStatus = document.getElementById('targetStatus');
			const stepCountEl = document.getElementById('stepCount');
			const bestCountEl = document.getElementById('bestCount');
			const gameMessage = document.getElementById('gameMessage');
			const btnUndo = document.getElementById('btnUndo');
			const btnReset = document.getElementById('btnReset');

			function getDifficultyLabel(index) {
				if (index < 15) return '🌱 教学';
				if (index < 35) return '🟢 入门';
				if (index < 65) return '🟡 进阶';
				if (index < 85) return '🟠 困难';
				return '🔴 大师';
			}

			LEVELS.forEach((level, index) => {
				const option = document.createElement('option');
				option.value = String(index);
				option.textContent = `第 ${index + 1} 关 · ${getDifficultyLabel(index)}`;
				option.title = `已通过求解器验证 · ${getDifficultyLabel(index)}`;
				levelSelect.appendChild(option);
			});

			function readBest(levelIndex) {
				try {
					const value = localStorage.getItem(`sokoban_v3_best_${levelIndex}`);
					if (value === null) return null;
					const parsed = Number.parseInt(value, 10);
					return Number.isFinite(parsed) ? parsed : null;
				} catch {
					return null;
				}
			}

			function saveBest(levelIndex, steps) {
				try {
					localStorage.setItem(`sokoban_v3_best_${levelIndex}`, String(steps));
				} catch {
					// 本地存储不可用时，游戏仍可正常运行。
				}
			}

			function setMessage(text, type = '') {
				gameMessage.textContent = text;
				gameMessage.classList.toggle('success', type === 'success');
			}

			function initLevel(index) {
				if (!Number.isInteger(index) || index < 0 || index >= LEVELS.length) return;

				if (completionTimer !== null) {
					clearTimeout(completionTimer);
					completionTimer = null;
				}

				currentLevelIdx = index;
				levelSelect.value = String(index);
				const level = LEVELS[index];

				robot = { ...level.initialRobot };
				boxes = cloneBoxes(level.initialBoxes);
				moveHistory = [];
				stepCount = 0;
				levelCompleted = false;

				setMessage(index < 15 ? `教学阶段 · 第 ${index + 1} 关` : `第 ${index + 1} 关开始`);
				updateStatsUI();
				renderGrid();
			}

			function updateStatsUI() {
				const level = LEVELS[currentLevelIdx];
				const placedCount = boxes.filter((box) => level.targets.has(keyOf(box.x, box.y))).length;
				const best = readBest(currentLevelIdx);

				targetStatus.textContent = `${placedCount}/${level.targets.size}`;
				stepCountEl.textContent = String(stepCount);
				bestCountEl.textContent = best === null ? '--' : `${best} 步`;
				btnUndo.disabled = moveHistory.length === 0 || levelCompleted;
			}

			function renderGrid() {
				const level = LEVELS[currentLevelIdx];
				const boxMap = new Map(boxes.map((box, index) => [keyOf(box.x, box.y), index]));

				sokobanGrid.innerHTML = '';
				sokobanGrid.style.setProperty('--cols', String(level.width));
				sokobanGrid.style.setProperty('--rows', String(level.height));
				sokobanGrid.style.setProperty(
					'--board-max-width',
					`${Math.min(760, Math.max(260, level.width * 52 + 20))}px`
				);

				const fragment = document.createDocumentFragment();

				for (let y = 0; y < level.height; y++) {
					for (let x = 0; x < level.width; x++) {
						const cell = document.createElement('div');
						const key = keyOf(x, y);
						const cellType = level.cells[y][x];
						const isTarget = level.targets.has(key);
						const hasBox = boxMap.has(key);
						const isRobot = robot.x === x && robot.y === y;

						cell.className = 'sokoban-cell';

						// 🏁 为交错深浅网格设置基础渲染类
						const isEven = (x + y) % 2 === 0;
						cell.classList.add(isEven ? 'tile-even' : 'tile-odd');

						if (cellType === CELL.VOID) {
							cell.classList.add('void');
							fragment.appendChild(cell);
							continue;
						}

						if (cellType === CELL.WALL) {
							cell.classList.add('wall');
							const wallAvatar = document.createElement('span');
							wallAvatar.className = 'wall-avatar';
							wallAvatar.textContent = '🧱';
							cell.appendChild(wallAvatar);
							fragment.appendChild(cell);
							continue;
						}

						if (isTarget && hasBox) {
							cell.classList.add('target-placed');
						} else if (isTarget) {
							cell.classList.add('target-cell');
						}

						if (hasBox) {
							const boxAvatar = document.createElement('span');
							boxAvatar.className = 'box-avatar';
							boxAvatar.textContent = '📦';
							cell.appendChild(boxAvatar);
						} else if (isTarget && !isRobot) {
							const targetAvatar = document.createElement('span');
							targetAvatar.className = 'target-avatar';
							targetAvatar.textContent = '⭐';
							cell.appendChild(targetAvatar);
						}

						if (isRobot) {
							const robotAvatar = document.createElement('span');
							robotAvatar.className = 'robot-avatar';
							robotAvatar.textContent = '🤖';
							const angles = [270, 0, 90, 180];
							robotAvatar.style.transform = `rotate(${angles[robot.dir]}deg)`;
							cell.appendChild(robotAvatar);
						}

						fragment.appendChild(cell);
					}
				}

				sokobanGrid.appendChild(fragment);
			}

			function isBlocked(level, x, y) {
				if (x < 0 || y < 0 || x >= level.width || y >= level.height) return true;
				return level.cells[y][x] !== CELL.FLOOR;
			}

			function handleMove(dir) {
				if (levelCompleted) return;

				const level = LEVELS[currentLevelIdx];
				const previousRobot = { ...robot };
				const vectors = [
					{ dx: 0, dy: -1 },
					{ dx: 1, dy: 0 },
					{ dx: 0, dy: 1 },
					{ dx: -1, dy: 0 }
				];
				const { dx, dy } = vectors[dir];
				const nextX = robot.x + dx;
				const nextY = robot.y + dy;

				robot.dir = dir;

				if (isBlocked(level, nextX, nextY)) {
					renderGrid();
					return;
				}

				const boxIndex = boxes.findIndex((box) => box.x === nextX && box.y === nextY);
				let previousBox = null;

				if (boxIndex !== -1) {
					const boxNextX = nextX + dx;
					const boxNextY = nextY + dy;
					const anotherBoxBlocks = boxes.some(
						(box, index) => index !== boxIndex && box.x === boxNextX && box.y === boxNextY
					);

					if (isBlocked(level, boxNextX, boxNextY) || anotherBoxBlocks) {
						renderGrid();
						return;
					}

					previousBox = { ...boxes[boxIndex] };
					boxes[boxIndex] = { x: boxNextX, y: boxNextY };
				}

				moveHistory.push({
					robot: previousRobot,
					boxIndex: boxIndex === -1 ? null : boxIndex,
					box: previousBox
				});

				robot.x = nextX;
				robot.y = nextY;
				stepCount++;

				updateStatsUI();
				renderGrid();
				checkCompletion();
			}

			function checkCompletion() {
				const level = LEVELS[currentLevelIdx];
				const allPlaced = boxes.every((box) => level.targets.has(keyOf(box.x, box.y)));
				if (!allPlaced || levelCompleted) return;

				levelCompleted = true;
				const completedLevelIndex = currentLevelIdx;
				const completedSteps = stepCount;
				const oldBest = readBest(completedLevelIndex);

				if (oldBest === null || completedSteps < oldBest) {
					saveBest(completedLevelIndex, completedSteps);
				}

				updateStatsUI();
				setMessage(`🎉 第 ${completedLevelIndex + 1} 关完成，共 ${completedSteps} 步！`, 'success');

				completionTimer = window.setTimeout(() => {
					completionTimer = null;
					if (completedLevelIndex < LEVELS.length - 1) {
						initLevel(completedLevelIndex + 1);
					} else {
						setMessage(`🏆 恭喜完成全部 ${LEVELS.length} 关！`, 'success');
					}
				}, 900);
			}

			function undo() {
				if (levelCompleted || moveHistory.length === 0) return;

				const lastMove = moveHistory.pop();
				robot = { ...lastMove.robot };

				if (lastMove.boxIndex !== null && lastMove.box) {
					boxes[lastMove.boxIndex] = { ...lastMove.box };
				}

				stepCount = Math.max(0, stepCount - 1);
				setMessage('已撤销上一步');
				updateStatsUI();
				renderGrid();
			}

			window.addEventListener('keydown', (event) => {
				if (event.target instanceof HTMLInputElement ||
					event.target instanceof HTMLTextAreaElement ||
					event.target instanceof HTMLSelectElement) {
					return;
				}

				const directionMap = {
					ArrowUp: 0,
					w: 0,
					W: 0,
					ArrowRight: 1,
					d: 1,
					D: 1,
					ArrowDown: 2,
					s: 2,
					S: 2,
					ArrowLeft: 3,
					a: 3,
					A: 3
				};

				if (Object.prototype.hasOwnProperty.call(directionMap, event.key)) {
					event.preventDefault();
					handleMove(directionMap[event.key]);
					return;
				}

				if (event.key === 'z' || event.key === 'Z') {
					event.preventDefault();
					undo();
					return;
				}

				if (event.key === 'r' || event.key === 'R') {
					event.preventDefault();
					initLevel(currentLevelIdx);
				}
			});

			document.getElementById('btnUp').addEventListener('click', () => handleMove(0));
			document.getElementById('btnRight').addEventListener('click', () => handleMove(1));
			document.getElementById('btnDown').addEventListener('click', () => handleMove(2));
			document.getElementById('btnLeft').addEventListener('click', () => handleMove(3));
			btnUndo.addEventListener('click', undo);
			btnReset.addEventListener('click', () => initLevel(currentLevelIdx));
			levelSelect.addEventListener('change', (event) => {
				initLevel(Number.parseInt(event.target.value, 10));
			});

			initLevel(0);
		</script>
	</body>
