---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: '儿童编程互动游戏：键盘推箱子大冒险（98关）',
	description: '免安装！支持键盘方向键和触摸按键控制的经典推箱子游戏，内置98个经过求解器验证、由浅入深的关卡，锻炼空间认知、逆向思维与死锁预判能力。',
	icon: '📦',
	tag: '儿童编程',
	keywords: '儿童推箱子 键盘推箱子 98关推箱子 少儿编程体验 逆向思维 逻辑训练 Sokoban',
	pinned: false,
	priority: 82
};

const pageTitle = `儿童编程互动游戏：键盘推箱子大冒险（98关）— ${SITE_TITLE}`;
const pageDescription = '支持键盘方向键和触摸按键即时控制，内置98个经过可解性验证并按真实难度排序的推箱子关卡。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1120px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
				box-sizing: border-box;
			}

			.tool-header {
				text-align: center;
				margin-bottom: 1.5em;
			}

			.tool-header h1 {
				font-size: clamp(1.4rem, 4.5vw, 2.2rem);
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.tool-header p {
				color: var(--text-muted);
				font-size: clamp(0.85rem, 2.5vw, 0.95rem);
			}

			.game-container {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 340px;
				gap: 1.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.5rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
				box-sizing: border-box;
			}

			.stage-box {
				display: flex;
				min-width: 0;
				width: 100%;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
			}

			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.8rem;
				width: 100%;
				background: var(--search-bg);
				padding: 0.6em 1em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.92rem;
				box-sizing: border-box;
			}

			.level-select {
				max-width: 200px;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.4em 0.65em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
			}

			.board-scroll {
				display: flex;
				justify-content: center;
				align-items: center;
				width: 100%;
				overflow: auto;
				padding: 2px;
				box-sizing: border-box;
			}

			.sokoban-grid {
				display: grid;
				grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
				grid-template-rows: repeat(var(--rows), minmax(0, 1fr));
				gap: 1px;
				width: min(100%, var(--board-max-width));
				min-width: min(100%, 240px);
				aspect-ratio: var(--cols) / var(--rows);
				background: #090d16;
				border: 3px solid #334155;
				border-radius: 16px;
				padding: 8px;
				box-sizing: border-box;
				box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
				touch-action: manipulation;
			}

			.sokoban-cell {
				min-width: 0;
				min-height: 0;
				border-radius: 3px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: clamp(0.7rem, 3vw, 1.5rem);
				line-height: 1;
				position: relative;
				user-select: none;
				overflow: hidden;
			}

			.sokoban-cell.tile-even {
				background-color: #1a2332;
				border: 1px solid #253346;
			}

			.sokoban-cell.tile-odd {
				background-color: #243044;
				border: 1px solid #2e3e57;
			}

			.sokoban-cell.void {
				visibility: hidden;
				pointer-events: none;
			}

			.sokoban-cell.wall {
				background: #0f172a !important;
				border: 1px solid #334155 !important;
				box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.6);
			}

			.sokoban-cell.target-cell {
				background-color: rgba(245, 158, 11, 0.22) !important;
				border: 1.5px dashed #f59e0b !important;
			}

			.sokoban-cell.target-placed {
				background-color: rgba(16, 185, 129, 0.35) !important;
				border: 1.5px solid #10b981 !important;
			}

			.robot-avatar,
			.box-avatar,
			.target-avatar,
			.wall-avatar {
				display: inline-block;
				filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.45));
			}

			.robot-avatar {
				transition: transform 0.12s ease-out;
			}

			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 0.8rem;
				min-width: 0;
				width: 100%;
			}

			.panel-title {
				font-size: 0.85rem;
				font-weight: 700;
				color: var(--text-main);
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			.dpad-container {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.5rem;
				width: 100%;
				max-width: 220px;
				margin: 0.2rem auto;
				touch-action: manipulation;
			}

			.dpad-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				height: 54px;
				border-radius: 12px;
				font-size: 1.4rem;
				font-weight: 800;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: transform 0.1s ease, background 0.1s ease;
				user-select: none;
				-webkit-user-select: none;
				-webkit-touch-callout: none;
				touch-action: manipulation;
			}

			.dpad-btn:active {
				transform: scale(0.92);
				background: var(--accent);
				color: #fff;
			}

			.dpad-btn.empty {
				visibility: hidden;
			}

			.stat-card {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.6rem 0.9rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.8rem;
				font-size: 0.85rem;
				font-weight: 700;
				box-sizing: border-box;
			}

			.action-bar {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
			}

			.btn-undo,
			.btn-reset {
				padding: 0.65em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.88rem;
				cursor: pointer;
				-webkit-tap-highlight-color: transparent;
			}

			.btn-undo {
				background: #f59e0b;
				color: #fff;
				border: none;
			}

			.btn-reset {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}

			.game-message {
				min-height: 1.2em;
				padding: 0.5rem 0.8rem;
				border-radius: 10px;
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				font-size: 0.82rem;
				font-weight: 700;
				text-align: center;
				color: var(--text-muted);
			}

			.game-message.success {
				color: #10b981;
				border-color: rgba(16, 185, 129, 0.5);
			}

			.key-tips {
				font-size: 0.78rem;
				color: var(--text-muted);
				text-align: center;
				line-height: 1.5;
			}

			kbd {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 4px;
				padding: 1px 5px;
				font-size: 0.72rem;
			}

			@media (max-width: 900px) {
				.game-container {
					grid-template-columns: 1fr;
				}

				.editor-box {
					max-width: 520px;
					width: 100%;
					margin: 0 auto;
				}
			}

			/* 📱 手机端适配：全面缩减垂直占用，确保一屏展示 */
			@media (max-width: 600px) {
				main {
					width: 100%;
					max-width: 100%;
					padding: 0.2em 0.5em 1em;
				}

				.tool-header {
					margin-bottom: 0.3em;
				}

				.tool-header h1 {
					font-size: 1.15rem;
					margin-bottom: 0;
				}

				.tool-header p {
					display: none;
				}

				.game-container {
					padding: 0.5rem;
					border-radius: 14px;
					gap: 0.5rem;
				}

				.stage-box {
					gap: 0.3rem;
				}

				.level-bar {
					flex-direction: row;
					justify-content: space-between;
					align-items: center;
					gap: 0.4rem;
					padding: 0.35em 0.6em;
					font-size: 0.78rem;
				}

				.level-select {
					max-width: 125px;
					padding: 0.2em 0.3em;
					font-size: 0.78rem;
				}

				/* 🎯 地图最高限制为视口的 38vh，宽度自动等比缩小 */
				.sokoban-grid {
					max-height: 38vh !important;
					width: auto !important;
					gap: 1px;
					padding: 4px;
					border-width: 2px;
					border-radius: 10px;
				}

				.stat-card {
					padding: 0.35rem 0.6rem;
					font-size: 0.78rem;
				}

				.panel-title {
					display: none; /* 移动端隐藏面板小标题，省出高度 */
				}

				.dpad-container {
					max-width: 165px;
					margin: 0 auto;
					gap: 0.35rem;
				}

				.dpad-btn {
					height: 42px;
					font-size: 1.1rem;
					border-radius: 8px;
				}

				.btn-undo,
				.btn-reset {
					padding: 0.45em;
					font-size: 0.8rem;
					border-radius: 8px;
				}

				.game-message {
					padding: 0.35rem 0.5rem;
					font-size: 0.78rem;
				}

				.key-tips {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>📦 儿童编程小游戏：键盘推箱子大冒险（98关）</h1>
				<p>使用方向键推动箱子，把所有箱子送到目标位置。注意：箱子只能推，不能拉！</p>
			</div>

			<div class="game-container">
				<div class="stage-box">
					<div class="level-bar">
						<label>
							关卡：
							<select id="levelSelect" class="level-select" aria-label="选择推箱子关卡"></select>
						</label>
						<span>📦 目标：<span id="targetStatus">0/0</span></span>
					</div>

					<div class="board-scroll">
						<div
							class="sokoban-grid"
							id="sokobanGrid"
							role="application"
							aria-label="推箱子游戏地图"
						></div>
					</div>
				</div>

				<div class="editor-box">
					<div class="stat-card">
						<span>👟 当前步数：<span id="stepCount" style="color:var(--accent);">0</span></span>
						<span>🏆 最佳：<span id="bestCount">--</span></span>
					</div>

					<div class="panel-title">🎮 方向键控制（键盘 / 触摸）</div>

					<div class="dpad-container" aria-label="方向控制">
						<div class="dpad-btn empty" aria-hidden="true"></div>
						<button class="dpad-btn" id="btnUp" type="button" aria-label="向上">▲</button>
						<div class="dpad-btn empty" aria-hidden="true"></div>
						<button class="dpad-btn" id="btnLeft" type="button" aria-label="向左">◄</button>
						<button class="dpad-btn" id="btnDown" type="button" aria-label="向下">▼</button>
						<button class="dpad-btn" id="btnRight" type="button" aria-label="向右">►</button>
					</div>

					<div class="action-bar">
						<button class="btn-undo" id="btnUndo" type="button">↩️ 撤销</button>
						<button class="btn-reset" id="btnReset" type="button">🔄 重置</button>
					</div>

					<div class="game-message" id="gameMessage" aria-live="polite">准备开始</div>

					<div class="key-tips">
						电脑端可使用 <kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd> 或
						<kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd>；按 <kbd>Z</kbd> 撤销，按 <kbd>R</kbd> 重置。
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

