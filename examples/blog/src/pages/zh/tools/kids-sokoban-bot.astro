			let parsedLevels = [];
			let currentLevelIdx = 0;
			let mapWidth = 0;
			let mapHeight = 0;
			let robot = { x: 0, y: 0, dir: 1 };
			let walls = [];
			let boxes = [];
			let targets = [];
			let moveHistory = [];
			let stepCount = 0;

			const sokobanGrid = document.getElementById('sokobanGrid');
			const levelSelect = document.getElementById('levelSelect');
			const targetStatus = document.getElementById('targetStatus');
			const stepCountEl = document.getElementById('stepCount');
			const bestCountEl = document.getElementById('bestCount');
			const btnUndo = document.getElementById('btnUndo');
			const btnReset = document.getElementById('btnReset');

			// 🧠 强壮的本地区块解析器：彻底清理无用字符，精准还原每一块地图
			function parseSokobanXsb(text) {
				const cleanText = text.replace(/\u00a0/g, ' ').replace(/\r/g, '');
				const lines = cleanText.split('\n');
				const levels = [];
				let currentLevel = [];

				for (let line of lines) {
					const trimmed = line.trim();
					
					if (trimmed.length === 0) {
						if (currentLevel.length > 0) {
							if (currentLevel.some(l => l.includes('#'))) levels.push(currentLevel);
							currentLevel = [];
						}
						continue;
					}

					if (/^[#@\+\$\*\.\s\-_]+$/.test(line)) {
						currentLevel.push(line);
					} else {
						if (currentLevel.length > 0) {
							if (currentLevel.some(l => l.includes('#'))) levels.push(currentLevel);
							currentLevel = [];
						}
					}
				}
				
				if (currentLevel.length > 0 && currentLevel.some(l => l.includes('#'))) {
					levels.push(currentLevel);
				}
				
				return levels;
			}

			// 直接在本地初始化解析
			function initGame() {
				parsedLevels = parseSokobanXsb(MICROBAN_155_LEVELS);
				
				levelSelect.innerHTML = '';
				parsedLevels.forEach((_, idx) => {
					const opt = document.createElement('option');
					opt.value = idx;
					// 自动判断难度（前期简单，后期逐渐变态）
					let diff = '🟢入门';
					if (idx >= 30) diff = '🟡进阶';
					if (idx >= 80) diff = '🔴挑战';
					if (idx >= 120) diff = '🔥深渊';
					opt.textContent = `第 ${idx + 1} 关 ${diff}`;
					levelSelect.appendChild(opt);
				});

				if (parsedLevels.length > 0) {
					initLevel(0);
				} else {
					sokobanGrid.innerHTML = '<div style="color:white; padding: 2rem;">请将 155 关代码粘贴到 js 的 MICROBAN_155_LEVELS 变量中！</div>';
				}
			}

			function loadLevelData(rawLines) {
				walls = [];
				boxes = [];
				targets = [];
				mapHeight = rawLines.length;
				mapWidth = Math.max(...rawLines.map(line => line.length));

				for (let r = 0; r < rawLines.length; r++) {
					const line = rawLines[r];
					for (let c = 0; c < line.length; c++) {
						const char = line[c];
						if (char === '#') walls.push({ x: c, y: r });
						if (char === '$' || char === '*') boxes.push({ x: c, y: r });
						if (char === '.' || char === '*' || char === '+') targets.push({ x: c, y: r });
						if (char === '@' || char === '+') robot = { x: c, y: r, dir: 1 };
					}
				}
			}

			function initLevel(idx) {
				if (!parsedLevels[idx]) return;
				currentLevelIdx = idx;
				levelSelect.value = idx;
				
				loadLevelData(parsedLevels[idx]);
				moveHistory = [];
				stepCount = 0;
				
				updateStatsUI();
				renderGrid();
			}

			function updateStatsUI() {
				const placedCount = boxes.filter(b => targets.some(t => t.x === b.x && t.y === b.y)).length;
				targetStatus.textContent = `${placedCount}/${targets.length}`;
				stepCountEl.textContent = stepCount;

				const best = localStorage.getItem(`sokoban_best_${currentLevelIdx}`);
				bestCountEl.textContent = best ? `${best} 步` : '--';
			}

			function renderGrid() {
				sokobanGrid.innerHTML = '';
				
				sokobanGrid.style.gridTemplateColumns = `repeat(${mapWidth}, 34px)`;
				sokobanGrid.style.gridTemplateRows = `repeat(${mapHeight}, 34px)`;

				if (window.innerWidth <= 850) {
					sokobanGrid.style.gridTemplateColumns = `repeat(${mapWidth}, 30px)`;
					sokobanGrid.style.gridTemplateRows = `repeat(${mapHeight}, 30px)`;
				}

				for (let r = 0; r < mapHeight; r++) {
					for (let c = 0; c < mapWidth; c++) {
						const cell = document.createElement('div');
						cell.className = 'sokoban-cell';

						const isWall = walls.some(w => w.x === c && w.y === r);
						const isTarget = targets.some(t => t.x === c && t.y === r);
						const hasBox = boxes.some(b => b.x === c && b.y === r);
						const isRobot = r === robot.y && c === robot.x;

						const isAlt = (r + c) % 2 === 1;
						if (isAlt) {
							cell.classList.add('alt-tile');
						} else {
							cell.classList.add('main-tile');
						}

						if (isWall) {
							cell.style.backgroundColor = '#0f172a';
							cell.style.borderColor = '#0f172a';
							cell.textContent = '🧱';
						} else if (isTarget && hasBox) {
							cell.style.backgroundColor = 'rgba(16, 185, 129, 0.4)';
							cell.style.borderColor = '#10b981';
						} else if (isTarget) {
							cell.style.backgroundColor = 'rgba(245, 158, 11, 0.3)';
							cell.style.borderColor = '#f59e0b';
						}

						if (!isWall) {
							if (isTarget && !hasBox && !isRobot) {
								cell.textContent = '⭐';
							} else if (hasBox && !isRobot) {
								cell.textContent = '📦';
							} else if (hasBox && isRobot) {
								cell.textContent = '📦';
							}
						}

						if (isRobot) {
							const rObj = document.createElement('span');
							rObj.className = 'robot-avatar';
							rObj.textContent = '🤖';
							const angles = [270, 0, 90, 180];
							rObj.style.transform = `rotate(${angles[robot.dir]}deg)`;
							cell.appendChild(rObj);
						}

						sokobanGrid.appendChild(cell);
					}
				}
			}

			function handleMove(dir) {
				robot.dir = dir;

				let dx = 0, dy = 0;
				if (dir === 0) dy = -1;
				if (dir === 1) dx = 1;
				if (dir === 2) dy = 1;
				if (dir === 3) dx = -1;

				let nextX = robot.x + dx;
				let nextY = robot.y + dy;

				if (walls.some(w => w.x === nextX && w.y === nextY)) return;

				const boxIdx = boxes.findIndex(b => b.x === nextX && b.y === nextY);
				let movedBox = false;
				let oldBoxPos = null;

				if (boxIdx !== -1) {
					let boxNextX = nextX + dx;
					let boxNextY = nextY + dy;

					const boxBlocked = walls.some(w => w.x === boxNextX && w.y === boxNextY) ||
						boxes.some(b => b.x === boxNextX && b.y === boxNextY);

					if (boxBlocked) return;

					oldBoxPos = { ...boxes[boxIdx] };
					boxes[boxIdx].x = boxNextX;
					boxes[boxIdx].y = boxNextY;
					movedBox = true;
				}

				moveHistory.push({
					robotPos: { x: robot.x, y: robot.y, dir: robot.dir },
					boxIdx: movedBox ? boxIdx : null,
					boxPos: oldBoxPos
				});

				robot.x = nextX;
				robot.y = nextY;
				stepCount++;

				updateStatsUI();
				renderGrid();

				const allPlaced = targets.every(t => boxes.some(b => b.x === t.x && b.y === t.y));
				if (allPlaced) {
					const best = localStorage.getItem(`sokoban_best_${currentLevelIdx}`);
					if (!best || stepCount < parseInt(best)) {
						localStorage.setItem(`sokoban_best_${currentLevelIdx}`, stepCount);
					}

					setTimeout(() => {
						if (currentLevelIdx < parsedLevels.length - 1) {
							alert(`🎉 恭喜通关第 ${currentLevelIdx + 1} 关！用时 ${stepCount} 步！即刻进入下一关！`);
							initLevel(currentLevelIdx + 1);
						} else {
							alert('🏆 太牛了！你凭借出色的逻辑能力通关了全部 155 个关卡！');
						}
					}, 150);
				}
			}

			function undo() {
				if (moveHistory.length === 0) return;
				const lastState = moveHistory.pop();
				robot.x = lastState.robotPos.x;
				robot.y = lastState.robotPos.y;
				robot.dir = lastState.robotPos.dir;

				if (lastState.boxIdx !== null) {
					boxes[lastState.boxIdx] = lastState.boxPos;
				}

				stepCount = Math.max(0, stepCount - 1);
				updateStatsUI();
				renderGrid();
			}

			window.addEventListener('keydown', (e) => {
				if (['ArrowUp', 'w', 'W'].includes(e.key)) { e.preventDefault(); handleMove(0); }
				if (['ArrowRight', 'd', 'D'].includes(e.key)) { e.preventDefault(); handleMove(1); }
				if (['ArrowDown', 's', 'S'].includes(e.key)) { e.preventDefault(); handleMove(2); }
				if (['ArrowLeft', 'a', 'A'].includes(e.key)) { e.preventDefault(); handleMove(3); }
				if (['z', 'Z'].includes(e.key)) { e.preventDefault(); undo(); }
			});

			document.getElementById('btnUp').addEventListener('click', () => handleMove(0));
			document.getElementById('btnRight').addEventListener('click', () => handleMove(1));
			document.getElementById('btnDown').addEventListener('click', () => handleMove(2));
			document.getElementById('btnLeft').addEventListener('click', () => handleMove(3));

			btnUndo.addEventListener('click', undo);
			btnReset.addEventListener('click', () => initLevel(currentLevelIdx));
			levelSelect.addEventListener('change', (e) => initLevel(parseInt(e.target.value)));

			window.addEventListener('resize', () => {
				renderGrid();
			});

			// 直接初始化本地游戏
			initGame();
		</script>
	</body>
</html>
