---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
    title: "儿童编程互动游戏：键盘推箱子大冒险 (内置 155 关)",
    description: "免安装！纯离线内置 155 个经典开源 Microban 逻辑关卡！无死局、全量显示，锻炼空间认知与逆向思维！",
    icon: "📦",
    tag: "儿童编程",
    keywords: "儿童推箱子 键盘推箱子 Sokoban Microban 少儿编程体验 逆向思维 逻辑训练",
    pinned: true,
    priority: 82
};

const pageTitle = `儿童编程互动游戏：键盘推箱子大冒险 (内置 155 关) — ${SITE_TITLE}`;
const pageDescription = "支持键盘方向键与手机手柄控制的推箱子游戏，纯离线内置 155 个绝对有解的经典逻辑关卡！";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 1.5em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			.game-container {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 1.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.5rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
			}

			@media (max-width: 850px) {
				main {
					padding: 1em 0.5em 3em;
				}
				.game-container {
					grid-template-columns: 1fr;
					gap: 1rem;
					padding: 1rem;
				}
			}

			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				width: 100%;
				overflow: hidden; 
			}
			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				background: var(--search-bg);
				padding: 0.6em 1em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.92rem;
			}

			.level-select {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.3em 0.6em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
				max-width: 200px;
			}

			/* 🎮 网格：自适应宽度、支持滚动，保证巨大关卡完美展示 */
			.sokoban-grid {
				display: grid !important;
				gap: 0px !important;
				width: fit-content; 
				max-width: 100%; 
				overflow: auto;  
				margin: 0 auto;
				background: #090d16 !important;
				border: 4px solid #334155;
				border-radius: 12px;
				padding: 8px;
				box-sizing: border-box !important;
				box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
			}

			/* 绝对尺寸的独立单元格，防拉伸变形 */
			.sokoban-cell {
				display: flex !important;
				align-items: center;
				justify-content: center;
				font-size: 1.6rem;
				position: relative;
				user-select: none;
				box-sizing: border-box !important;
				width: 34px;  
				height: 34px; 
			}

			@media (max-width: 850px) {
				.sokoban-cell {
					width: 30px;
					height: 30px;
					font-size: 1.3rem;
				}
			}

			/* 深浅交错渲染 */
			.sokoban-cell.alt-tile {
				background-color: #2b3a52 !important;
				border: 1px solid #3a4b66 !important;
			}
			.sokoban-cell.main-tile {
				background-color: #1a2436 !important;
				border: 1px solid #2a384e !important;
			}

			.robot-avatar {
				transition: transform 0.1s ease-out;
				display: inline-block;
				filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
			}

			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}

			.panel-title {
				font-size: 0.9rem;
				font-weight: 700;
				color: var(--text-main);
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			.dpad-container {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.5rem;
				width: 210px;
				margin: 0.5rem auto;
			}

			@media (max-width: 850px) {
				.dpad-container {
					width: 250px;
					gap: 0.7rem;
				}
			}

			.dpad-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				height: 60px;
				border-radius: 14px;
				font-size: 1.4rem;
				font-weight: 800;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 0.1s ease;
				user-select: none;
				touch-action: manipulation;
			}
			.dpad-btn:active {
				transform: scale(0.92);
				background: var(--accent);
				color: #fff;
			}
			.dpad-btn.empty { visibility: hidden; }

			.stat-card {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem 1rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.88rem;
				font-weight: 700;
			}

			.action-bar {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
			}

			.btn-undo {
				background: #f59e0b;
				color: #fff;
				border: none;
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.92rem;
				cursor: pointer;
			}
			.btn-undo:hover { opacity: 0.9; }

			.btn-reset {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 700;
				font-size: 0.92rem;
				cursor: pointer;
			}
			.btn-reset:hover { border-color: var(--accent); }

			.key-tips {
				font-size: 0.8rem;
				color: var(--text-muted);
				text-align: center;
				line-height: 1.5;
			}
			kbd {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 4px;
				padding: 1px 5px;
				font-size: 0.75rem;
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>📦 儿童编程小游戏：键盘推箱子大冒险</h1>
				<p>100% 纯本地离线运行！完美解析内置的 Microban 完整关卡库，绝无死局！</p>
			</div>

			<div class="game-container">
				<!-- 左侧：地图面板 -->
				<div class="stage-box">
					<div class="level-bar">
						<div>
							关卡: 
							<select id="levelSelect" class="level-select">
								<!-- JS 动态渲染 -->
							</select>
						</div>
						<span>📦 目标: <span id="targetStatus">0/0</span></span>
					</div>

					<div class="sokoban-grid" id="sokobanGrid">
						<!-- 动态渲染固定尺寸的单元格 -->
					</div>
				</div>

				<!-- 右侧：控制与面板 -->
				<div class="editor-box">
					<div class="stat-card">
						<span>👟 当前步数: <span id="stepCount" style="color:var(--accent);">0</span></span>
						<span>🏆 历史最好: <span id="bestCount">--</span></span>
					</div>

					<div class="panel-title">🎮 方向键控制 (键盘/触摸)</div>
					
					<div class="dpad-container">
						<div class="dpad-btn empty"></div>
						<button class="dpad-btn" id="btnUp" aria-label="向上">▲</button>
						<div class="dpad-btn empty"></div>
						<button class="dpad-btn" id="btnLeft" aria-label="向左">◄</button>
						<button class="dpad-btn" id="btnDown" aria-label="向下">▼</button>
						<button class="dpad-btn" id="btnRight" aria-label="向右">►</button>
					</div>

					<div class="action-bar">
						<button class="btn-undo" id="btnUndo">↩️ 撤销上一步</button>
						<button class="btn-reset" id="btnReset">🔄 重置本关</button>
					</div>

					<div class="key-tips">
						💡 提示：电脑端可直接使用键盘 <kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd> 或 <kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> 控制，<kbd>Z</kbd> 键快速撤销。
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			// 👇 请将从网页复制的 155 关文本，完完整整地粘贴在下面的两个反引号之间！
