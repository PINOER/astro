---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
    title: "儿童编程互动游戏：键盘推箱子大冒险 (全新重构版)",
    description: "免安装！基于严格二维矩阵引擎重构的推箱子游戏，支持智能区块解析与 Flood-fill 内部空间检测，100% 杜绝错位死局！",
    icon: "📦",
    tag: "儿童编程",
    keywords: "儿童推箱子 键盘推箱子 Sokoban 矩阵逻辑 空间渲染 少儿编程 逆向思维",
    pinned: true,
    priority: 82
};

const pageTitle = `儿童编程互动游戏：键盘推箱子大冒险 (全新重构版) — ${SITE_TITLE}`;
const pageDescription = "基于严格二维矩阵引擎重构的推箱子游戏，杜绝任何地图解析错误，完美呈现逻辑关卡！";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 1.5em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			.game-container {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 1.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.5rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
			}

			@media (max-width: 850px) {
				.game-container {
					grid-template-columns: 1fr;
					gap: 1rem;
					padding: 1rem;
				}
			}

			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				width: 100%;
				overflow: hidden; 
			}
			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				background: var(--search-bg);
				padding: 0.6em 1em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.92rem;
			}

			.level-select {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.3em 0.6em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
				max-width: 200px;
			}

			/* 🎮 游戏视口区域 */
			.viewport {
				width: 100%;
				max-width: 100%;
				overflow: auto; /* 允许滚动 */
				background: #090d16;
				border: 4px solid #334155;
				border-radius: 12px;
				padding: 12px;
				box-sizing: border-box;
				box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 300px;
			}

			/* 严格的二维网格 */
			.sokoban-grid {
				display: grid;
				gap: 0;
				margin: auto;
			}

			/* 基础单元格：统一尺寸，拒绝变形 */
			.cell {
				width: 36px;
				height: 36px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.6rem;
				position: relative;
				user-select: none;
				box-sizing: border-box;
			}

			@media (max-width: 850px) {
				.cell {
					width: 30px;
					height: 30px;
					font-size: 1.3rem;
				}
			}

			/* 🎨 场景材质渲染 */
			.cell.void {
				background-color: transparent; /* 墙外的区域不可见 */
			}
			.cell.wall {
				background-color: #1e293b;
				border: 1px solid #0f172a;
				border-radius: 4px;
				box-shadow: inset 0 0 8px rgba(0,0,0,0.5);
			}
			/* 内部地板深浅交错 (利用 CSS 变量动态赋值) */
			.cell.floor {
				background-color: var(--tile-bg, #1a2436);
				border: 1px solid var(--tile-border, #2a384e);
			}
			.cell.floor.target {
				background-color: rgba(245, 158, 11, 0.2);
				border: 2px dashed #f59e0b;
				border-radius: 4px;
			}
			.cell.floor.target.filled {
				background-color: rgba(16, 185, 129, 0.3);
				border: 2px solid #10b981;
			}

			.sprite {
				position: absolute;
				transition: transform 0.1s ease-out;
				filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
				z-index: 2;
			}
			.sprite.robot {
				z-index: 3;
			}

			/* 控制面板 */
			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}

			.panel-title {
				font-size: 0.9rem;
				font-weight: 700;
				color: var(--text-main);
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			.dpad-container {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.5rem;
				width: 210px;
				margin: 0.5rem auto;
			}

			@media (max-width: 850px) {
				.dpad-container { width: 250px; gap: 0.7rem; }
			}

			.dpad-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				height: 60px;
				border-radius: 14px;
				font-size: 1.4rem;
				font-weight: 800;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				user-select: none;
				touch-action: manipulation;
			}
			.dpad-btn:active {
				transform: scale(0.92);
				background: var(--accent);
				color: #fff;
			}
			.dpad-btn.empty { visibility: hidden; }

			.stat-card {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem 1rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.88rem;
				font-weight: 700;
			}

			.action-bar {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
			}

			.btn-action {
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.92rem;
				cursor: pointer;
				border: none;
				color: #fff;
			}
			.btn-action.undo { background: #f59e0b; }
			.btn-action.reset { background: var(--search-bg); color: var(--text-main); border: 1px solid var(--card-border); }
			.btn-action:hover { opacity: 0.9; }

			.key-tips {
				font-size: 0.8rem;
				color: var(--text-muted);
				text-align: center;
				line-height: 1.5;
			}
			kbd {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 4px;
				padding: 1px 5px;
				font-size: 0.75rem;
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>📦 儿童编程小游戏：键盘推箱子大冒险</h1>
				<p>搭载全新重构的二维矩阵引擎，完美解析 155 关开源地图，100% 杜绝错位死局！</p>
			</div>

			<div class="game-container">
				<!-- 左侧地图面板 -->
				<div class="stage-box">
					<div class="level-bar">
						<div>
							关卡: 
							<select id="levelSelect" class="level-select">
								<option>系统初始化中...</option>
							</select>
						</div>
						<span>📦 目标: <span id="targetStatus">0/0</span></span>
					</div>

					<div class="viewport" id="viewport">
						<div class="sokoban-grid" id="gridContainer">
							<!-- 引擎动态渲染二维矩阵 -->
						</div>
					</div>
				</div>

				<!-- 右侧控制面板 -->
				<div class="editor-box">
					<div class="stat-card">
						<span>👟 当前步数: <span id="stepCount" style="color:var(--accent);">0</span></span>
						<span>🏆 历史最好: <span id="bestCount">--</span></span>
					</div>

					<div class="panel-title">🎮 方向键控制 (键盘/触摸)</div>
					
					<div class="dpad-container">
						<div class="dpad-btn empty"></div>
						<button class="dpad-btn" id="btnUp" aria-label="向上">▲</button>
						<div class="dpad-btn empty"></div>
						<button class="dpad-btn" id="btnLeft" aria-label="向左">◄</button>
						<button class="dpad-btn" id="btnDown" aria-label="向下">▼</button>
						<button class="dpad-btn" id="btnRight" aria-label="向右">►</button>
					</div>

					<div class="action-bar">
						<button class="btn-action undo" id="btnUndo">↩️ 撤销上一步</button>
						<button class="btn-action reset" id="btnReset">🔄 重置本关</button>
					</div>

					<div class="key-tips">
						💡 提示：电脑端可直接使用键盘 <kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd> 或 <kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> 控制，<kbd>Z</kbd> 键快速撤销。
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

