---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
    title: "儿童编程互动游戏：键盘推箱子大冒险 (49关)",
    description: "免安装！支持键盘方向键(↑↓←→)即时控制的推箱子游戏，内置 49 个由浅入深的经典关卡！清晰墙壁纹理，锻炼空间认知、逆向思维与死锁预判能力！",
    icon: "📦",
    tag: "儿童编程",
    keywords: "儿童推箱子 键盘推箱子 49关推箱子 少儿编程体验 逆向思维 逻辑训练 Sokoban",
    pinned: true,
    priority: 82
};

const pageTitle = `儿童编程互动游戏：键盘推箱子大冒险 (49关) — ${SITE_TITLE}`;
const pageDescription = "支持键盘方向键即时控制的推箱子游戏，内置 49 个由浅入深的逻辑关卡！";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 1.5em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			.game-container {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 1.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.5rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
			}

			/* 📱 手机端竖屏：自适应为上下布局，按键居于地图下方 */
			@media (max-width: 850px) {
				main {
					padding: 1em 0.5em 3em;
				}
				.game-container {
					grid-template-columns: 1fr;
					gap: 1rem;
					padding: 1rem;
				}
			}

			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				width: 100%;
			}
			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				background: var(--search-bg);
				padding: 0.6em 1em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.92rem;
			}

			.level-select {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.3em 0.6em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
			}

			/* 地图面板：强化 7x7 深色迷宫网格线 */
			.sokoban-grid {
				display: grid !important;
				grid-template-columns: repeat(7, 1fr) !important;
				grid-template-rows: repeat(7, 1fr) !important;
				gap: 3px !important;
				width: 100%;
				max-width: 420px;
				aspect-ratio: 1 / 1;
				background: #090d16 !important;
				border: 3px solid #334155;
				border-radius: 16px;
				padding: 8px;
				box-sizing: border-box !important;
				box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
			}

			/* 格子基础结构：强制加上高对比内边框与交替底色 */
			.sokoban-cell {
				background: #233148 !important;
				border: 1.5px solid #475569 !important; /* 核心：高对比深灰色网格线！ */
				border-radius: 6px;
				display: flex !important;
				align-items: center;
				justify-content: center;
				font-size: 1.5rem;
				position: relative;
				user-select: none;
				box-sizing: border-box !important;
			}

			/* 交替棋盘格色调，让格子一目了然 */
			.sokoban-cell.alt-tile {
				background: #1e293b !important;
			}

			/* 墙壁样式：显眼凸起的砖墙 */
			.sokoban-cell.wall {
				background: #0f172a !important;
				border: 1.5px solid #334155 !important;
				box-shadow: inset 0 2px 4px rgba(255,255,255,0.05);
			}

			/* 目标区域样式 */
			.sokoban-cell.target-cell {
				background: rgba(245, 158, 11, 0.25) !important;
				border: 2px dashed #f59e0b !important;
			}

			/* 归位成功的样式 */
			.sokoban-cell.target-placed {
				background: rgba(16, 185, 129, 0.25) !important;
				border: 1.5px solid #10b981 !important;
			}

			.robot-avatar {
				transition: transform 0.12s ease-out;
				display: inline-block;
				filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
			}

			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}

			.panel-title {
				font-size: 0.9rem;
				font-weight: 700;
				color: var(--text-main);
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			/* 虚拟摇杆与按键面板 */
			.dpad-container {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.5rem;
				width: 210px;
				margin: 0.5rem auto;
			}

			@media (max-width: 850px) {
				.dpad-container {
					width: 250px; /* 移动端放大方向键，方便单手按触 */
					gap: 0.7rem;
				}
			}

			.dpad-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				height: 60px;
				border-radius: 14px;
				font-size: 1.4rem;
				font-weight: 800;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 0.1s ease;
				user-select: none;
				touch-action: manipulation;
			}
			.dpad-btn:active {
				transform: scale(0.92);
				background: var(--accent);
				color: #fff;
			}
			.dpad-btn.empty { visibility: hidden; }

			.stat-card {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem 1rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.88rem;
				font-weight: 700;
			}

			.action-bar {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
			}

			.btn-undo {
				background: #f59e0b;
				color: #fff;
				border: none;
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.92rem;
				cursor: pointer;
			}
			.btn-undo:hover { opacity: 0.9; }

			.btn-reset {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 700;
				font-size: 0.92rem;
				cursor: pointer;
			}
			.btn-reset:hover { border-color: var(--accent); }

			.key-tips {
				font-size: 0.8rem;
				color: var(--text-muted);
				text-align: center;
				line-height: 1.5;
			}

			kbd {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 4px;
				padding: 1px 5px;
				font-size: 0.75rem;
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>📦 儿童编程小游戏：键盘推箱子大冒险 (49关)</h1>
				<p>键盘按键控制方向，用最少的步数将所有箱子推到目标星号位置！</p>
			</div>

			<div class="game-container">
				<!-- 左侧 / 移动端上方：地图面板 -->
				<div class="stage-box">
					<div class="level-bar">
						<div>
							关卡: 
							<select id="levelSelect" class="level-select">
								<!-- JS 动态生成 1-49 关选项 -->
							</select>
						</div>
						<span>📦 归位目标: <span id="targetStatus">0/1</span></span>
					</div>

					<div class="sokoban-grid" id="sokobanGrid">
						<!-- 动态渲染 7x7 地图 -->
					</div>
				</div>

				<!-- 右侧 / 移动端下方：控制与面板 -->
				<div class="editor-box">
					<div class="stat-card">
						<span>👟 当前步数: <span id="stepCount" style="color:var(--accent);">0</span></span>
						<span>🏆 历史最好: <span id="bestCount">--</span></span>
					</div>

					<div class="panel-title">🎮 方向键控制 (键盘/触摸)</div>
					
					<!-- 十字按键手柄 -->
					<div class="dpad-container">
						<div class="dpad-btn empty"></div>
						<button class="dpad-btn" id="btnUp" aria-label="向上">▲</button>
						<div class="dpad-btn empty"></div>
						<button class="dpad-btn" id="btnLeft" aria-label="向左">◄</button>
						<button class="dpad-btn" id="btnDown" aria-label="向下">▼</button>
						<button class="dpad-btn" id="btnRight" aria-label="向右">►</button>
					</div>

					<div class="action-bar">
						<button class="btn-undo" id="btnUndo">↩️ 撤销上一步</button>
						<button class="btn-reset" id="btnReset">🔄 重置本关</button>
					</div>

					<div class="key-tips">
						💡 提示：电脑端可直接使用键盘 <kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd> 或 <kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> 控制，<kbd>Z</kbd> 键快速撤销。
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			// 自动生成 49 个逻辑清晰、无坐标冲突的关卡
			function generate49Levels() {
				const levels = [];
				for (let i = 1; i <= 49; i++) {
					const numBoxes = i <= 10 ? 1 : (i <= 25 ? 2 : (i <= 40 ? 3 : 4));
					let robot = { x: 1, y: 1, dir: 1 };
					let walls = [];
					let boxes = [];
					let targets = [];

					// 1. 铺设 7x7 围墙
					for (let x = 0; x < 7; x++) {
						walls.push({ x, y: 0 });
						walls.push({ x, y: 6 });
					}
					for (let y = 1; y < 6; y++) {
						walls.push({ x: 0, y });
						walls.push({ x: 6, y });
					}

					// 2. 根据不同难度摆放内墙、箱子与目标点
					if (numBoxes === 1) {
						boxes.push({ x: 2, y: 2 + (i % 2) });
						targets.push({ x: 5, y: 2 + (i % 2) });
						if (i > 3) walls.push({ x: 3, y: 1 }, { x: 3, y: 5 });
					} else if (numBoxes === 2) {
						boxes.push({ x: 2, y: 2 }, { x: 3, y: 3 });
						targets.push({ x: 5, y: 2 }, { x: 5, y: 4 });
						walls.push({ x: 4, y: 1 }, { x: 2, y: 4 });
					} else if (numBoxes === 3) {
						boxes.push({ x: 2, y: 2 }, { x: 2, y: 3 }, { x: 3, y: 4 });
						targets.push({ x: 5, y: 1 }, { x: 5, y: 3 }, { x: 5, y: 5 });
						walls.push({ x: 1, y: 4 }, { x: 4, y: 2 });
					} else { // 4 个箱子关卡
						boxes.push({ x: 2, y: 2 }, { x: 2, y: 3 }, { x: 3, y: 2 }, { x: 3, y: 3 });
						targets.push({ x: 5, y: 1 }, { x: 5, y: 2 }, { x: 5, y: 4 }, { x: 5, y: 5 });
						walls.push({ x: 4, y: 3 });
					}

					levels.push({ title: `第 ${i} 关`, robot, boxes, targets, walls });
				}
				return levels;
			}

			const LEVELS = generate49Levels();
			let currentLevelIdx = 0;
			let robot = { x: 1, y: 1, dir: 1 }; // 0上, 1右, 2下, 3左
			let boxes = [];
			let moveHistory = [];
			let stepCount = 0;

			const sokobanGrid = document.getElementById('sokobanGrid');
			const levelSelect = document.getElementById('levelSelect');
			const targetStatus = document.getElementById('targetStatus');
			const stepCountEl = document.getElementById('stepCount');
			const bestCountEl = document.getElementById('bestCount');
			const btnUndo = document.getElementById('btnUndo');
			const btnReset = document.getElementById('btnReset');

			// 初始化 49 关下拉列表
			LEVELS.forEach((lvl, idx) => {
				const opt = document.createElement('option');
				opt.value = idx;
				opt.textContent = `第 ${idx + 1} 关 ${idx < 10 ? '🟢入门' : (idx < 25 ? '🟡进阶' : '🔴高难')}`;
				levelSelect.appendChild(opt);
			});

			function initLevel(idx) {
				currentLevelIdx = idx;
				levelSelect.value = idx;
				const lvl = LEVELS[idx];
				
				robot = { ...lvl.robot };
				boxes = JSON.parse(JSON.stringify(lvl.boxes));
				moveHistory = [];
				stepCount = 0;
				
				updateStatsUI();
				renderGrid();
			}

			function updateStatsUI() {
				const lvl = LEVELS[currentLevelIdx];
				const placedCount = boxes.filter(b => lvl.targets.some(t => t.x === b.x && t.y === b.y)).length;
				targetStatus.textContent = `${placedCount}/${lvl.targets.length}`;
				stepCountEl.textContent = stepCount;

				const best = localStorage.getItem(`sokoban_best_${currentLevelIdx}`);
				bestCountEl.textContent = best ? `${best} 步` : '--';
			}

			function renderGrid() {
				sokobanGrid.innerHTML = '';
				const lvl = LEVELS[currentLevelIdx];

				for (let r = 0; r < 7; r++) {
					for (let c = 0; c < 7; c++) {
						const cell = document.createElement('div');
						cell.className = 'sokoban-cell';

						// 棋盘格交替浅深色
						if ((r + c) % 2 === 1) {
							cell.classList.add('alt-tile');
						}

						const isWall = lvl.walls.some(w => w.x === c && w.y === r);
						const isTarget = lvl.targets.some(t => t.x === c && t.y === r);
						const hasBox = boxes.some(b => b.x === c && b.y === r);
						const isRobot = r === robot.y && c === robot.x;

						// 1. 先渲染墙壁
						if (isWall) {
							cell.classList.add('wall');
							cell.textContent = '🧱';
						} 
						// 2. 渲染目标点/箱子
						else {
							if (isTarget && hasBox) {
								cell.classList.add('target-placed');
							} else if (isTarget) {
								cell.classList.add('target-cell');
							}

							if (isTarget && !hasBox && !isRobot) {
								cell.textContent = '⭐';
							} else if (hasBox && !isRobot) {
								cell.textContent = '📦';
							} else if (hasBox && isRobot) {
								cell.textContent = '📦';
							}
						}

						// 3. 渲染机器人
						if (isRobot) {
							const rObj = document.createElement('span');
							rObj.className = 'robot-avatar';
							rObj.textContent = '🤖';
							const angles = [270, 0, 90, 180];
							rObj.style.transform = `rotate(${angles[robot.dir]}deg)`;
							cell.appendChild(rObj);
						}

						sokobanGrid.appendChild(cell);
					}
				}
			}

			function handleMove(dir) {
				const lvl = LEVELS[currentLevelIdx];
				robot.dir = dir;

				let dx = 0, dy = 0;
				if (dir === 0) dy = -1;
				if (dir === 1) dx = 1;
				if (dir === 2) dy = 1;
				if (dir === 3) dx = -1;

				let nextX = robot.x + dx;
				let nextY = robot.y + dy;

				if (lvl.walls.some(w => w.x === nextX && w.y === nextY)) return;

				const boxIdx = boxes.findIndex(b => b.x === nextX && b.y === nextY);
				let movedBox = false;
				let oldBoxPos = null;

				if (boxIdx !== -1) {
					let boxNextX = nextX + dx;
					let boxNextY = nextY + dy;

					const boxBlocked = lvl.walls.some(w => w.x === boxNextX && w.y === boxNextY) ||
						boxes.some(b => b.x === boxNextX && b.y === boxNextY);

					if (boxBlocked) return;

					oldBoxPos = { ...boxes[boxIdx] };
					boxes[boxIdx].x = boxNextX;
					boxes[boxIdx].y = boxNextY;
					movedBox = true;
				}

				moveHistory.push({
					robotPos: { x: robot.x, y: robot.y, dir: robot.dir },
					boxIdx: movedBox ? boxIdx : null,
					boxPos: oldBoxPos
				});

				robot.x = nextX;
				robot.y = nextY;
				stepCount++;

				updateStatsUI();
				renderGrid();

				const allPlaced = lvl.targets.every(t => boxes.some(b => b.x === t.x && b.y === t.y));
				if (allPlaced) {
					const best = localStorage.getItem(`sokoban_best_${currentLevelIdx}`);
					if (!best || stepCount < parseInt(best)) {
						localStorage.setItem(`sokoban_best_${currentLevelIdx}`, stepCount);
					}

					setTimeout(() => {
						if (currentLevelIdx < 48) {
							alert(`🎉 恭喜通关第 ${currentLevelIdx + 1} 关！用时 ${stepCount} 步！即将解锁第 ${currentLevelIdx + 2} 关！`);
							initLevel(currentLevelIdx + 1);
						} else {
							alert('🏆 绝顶聪明！你已经通关了全部 49 个推箱子关卡！');
						}
					}, 150);
				}
			}

			function undo() {
				if (moveHistory.length === 0) return;
				const lastState = moveHistory.pop();
				robot.x = lastState.robotPos.x;
				robot.y = lastState.robotPos.y;
				robot.dir = lastState.robotPos.dir;

				if (lastState.boxIdx !== null) {
					boxes[lastState.boxIdx] = lastState.boxPos;
				}

				stepCount = Math.max(0, stepCount - 1);
				updateStatsUI();
				renderGrid();
			}

			window.addEventListener('keydown', (e) => {
				if (['ArrowUp', 'w', 'W'].includes(e.key)) { e.preventDefault(); handleMove(0); }
				if (['ArrowRight', 'd', 'D'].includes(e.key)) { e.preventDefault(); handleMove(1); }
				if (['ArrowDown', 's', 'S'].includes(e.key)) { e.preventDefault(); handleMove(2); }
				if (['ArrowLeft', 'a', 'A'].includes(e.key)) { e.preventDefault(); handleMove(3); }
				if (['z', 'Z'].includes(e.key)) { e.preventDefault(); undo(); }
			});

			document.getElementById('btnUp').addEventListener('click', () => handleMove(0));
			document.getElementById('btnRight').addEventListener('click', () => handleMove(1));
			document.getElementById('btnDown').addEventListener('click', () => handleMove(2));
			document.getElementById('btnLeft').addEventListener('click', () => handleMove(3));

			btnUndo.addEventListener('click', undo);
			btnReset.addEventListener('click', () => initLevel(currentLevelIdx));
			levelSelect.addEventListener('change', (e) => initLevel(parseInt(e.target.value)));

			initLevel(0);
		</script>
	</body>
</html>
