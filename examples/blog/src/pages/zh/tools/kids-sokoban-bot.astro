		</script>

		<script is:inline>
			(function () {
				'use strict';

				var CELL = {
					VOID: 'void',
					FLOOR: 'floor',
					WALL: 'wall'
				};

				function addEvent(element, eventName, handler) {
					if (!element) return;
					if (element.addEventListener) {
						element.addEventListener(eventName, handler, false);
					} else if (element.attachEvent) {
						element.attachEvent('on' + eventName, handler);
					}
				}

				function getEvent(event) {
					return event || window.event;
				}

				function preventDefault(event) {
					if (event.preventDefault) event.preventDefault();
					else event.returnValue = false;
				}

				function setText(element, value) {
					if (!element) return;
					if (typeof element.textContent !== 'undefined') element.textContent = value;
					else element.innerText = value;
				}

				function trimText(value) {
					return String(value).replace(/^\s+|\s+$/g, '');
				}

				function rightTrim(value) {
					return String(value).replace(/\s+$/g, '');
				}

				function keyOf(x, y) {
					return 'k' + x + '_' + y;
				}

				function dictHas(dict, key) {
					return Object.prototype.hasOwnProperty.call(dict, key);
				}

				function getRawLevelText() {
					var node = document.getElementById('rawLevels');
					if (!node) return '';
					if (typeof node.text === 'string') return node.text;
					if (typeof node.textContent === 'string') return node.textContent;
					return node.innerHTML || '';
				}

				function parseLevelPack(rawText) {
					var sourceLines = rawText.replace(/\r/g, '').split('\n');
					var sections = [];
					var current = null;
					var i;

					function finishCurrent() {
						if (!current) return;
						while (current.lines.length && trimText(current.lines[0]) === '') current.lines.shift();
						while (current.lines.length && trimText(current.lines[current.lines.length - 1]) === '') current.lines.pop();
						if (current.lines.length) sections.push(current);
					}

					for (i = 0; i < sourceLines.length; i++) {
						var sourceLine = sourceLines[i];
						var marker = sourceLine.match(/^;\s*(\d+)\s*$/);
						if (marker) {
							finishCurrent();
							current = { sourceId: parseInt(marker[1], 10), lines: [] };
						} else if (current) {
							current.lines.push(rightTrim(sourceLine));
						}
					}
					finishCurrent();

					var levels = [];
					for (i = 0; i < sections.length; i++) levels.push(parseLevelSection(sections[i], i));
					return levels;
				}

				function parseLevelSection(section, index) {
					var height = section.lines.length;
					var width = 0;
					var rawGrid = [];
					var walls = {};
					var targets = {};
					var targetCount = 0;
					var boxes = [];
					var robot = null;
					var x, y;

					for (y = 0; y < height; y++) {
						if (section.lines[y].length > width) width = section.lines[y].length;
					}

					for (y = 0; y < height; y++) {
						var row = section.lines[y];
						while (row.length < width) row += ' ';
						rawGrid.push(row.split(''));
					}

					for (y = 0; y < height; y++) {
						for (x = 0; x < width; x++) {
							var symbol = rawGrid[y][x];
							var key = keyOf(x, y);
							if (symbol === '#') walls[key] = true;
							if (symbol === '.' || symbol === '*' || symbol === '+') {
								if (!dictHas(targets, key)) targetCount++;
								targets[key] = true;
							}
							if (symbol === '$' || symbol === '*') boxes.push({ x: x, y: y });
							if (symbol === '@' || symbol === '+') robot = { x: x, y: y, dir: 1 };
						}
					}

					if (!robot) throw new Error('关卡 ' + section.sourceId + ' 缺少玩家符号 @ 或 +');
					if (boxes.length !== targetCount) {
						throw new Error('关卡 ' + section.sourceId + ' 的箱子数量（' + boxes.length + '）与目标数量（' + targetCount + '）不一致');
					}

					var outsideSpaces = findOutsideSpaces(rawGrid, width, height);
					var cells = [];
					for (y = 0; y < height; y++) {
						var cellRow = [];
						for (x = 0; x < width; x++) {
							var cellKey = keyOf(x, y);
							if (dictHas(walls, cellKey)) cellRow.push(CELL.WALL);
							else if (dictHas(outsideSpaces, cellKey)) cellRow.push(CELL.VOID);
							else cellRow.push(CELL.FLOOR);
						}
						cells.push(cellRow);
					}

					return {
						index: index,
						sourceId: section.sourceId,
						title: '第 ' + (index + 1) + ' 关',
						width: width,
						height: height,
						cells: cells,
						walls: walls,
						targets: targets,
						targetCount: targetCount,
						initialRobot: robot,
						initialBoxes: boxes
					};
				}

				function findOutsideSpaces(rawGrid, width, height) {
					var outside = {};
					var queue = [];
					var head = 0;

					function addSpace(x, y) {
						if (x < 0 || y < 0 || x >= width || y >= height) return;
						if (rawGrid[y][x] !== ' ') return;
						var key = keyOf(x, y);
						if (dictHas(outside, key)) return;
						outside[key] = true;
						queue.push({ x: x, y: y });
					}

					var x, y;
					for (x = 0; x < width; x++) {
						addSpace(x, 0);
						addSpace(x, height - 1);
					}
					for (y = 0; y < height; y++) {
						addSpace(0, y);
						addSpace(width - 1, y);
					}

					while (head < queue.length) {
						var point = queue[head++];
						addSpace(point.x + 1, point.y);
						addSpace(point.x - 1, point.y);
						addSpace(point.x, point.y + 1);
						addSpace(point.x, point.y - 1);
					}
					return outside;
				}

				function cloneRobot(source) {
					return { x: source.x, y: source.y, dir: source.dir };
				}

				function cloneBoxes(sourceBoxes) {
					var result = [];
					var i;
					for (i = 0; i < sourceBoxes.length; i++) {
						result.push({ x: sourceBoxes[i].x, y: sourceBoxes[i].y });
					}
					return result;
				}

				var LEVELS = parseLevelPack(getRawLevelText());
				var currentLevelIdx = 0;
				var robot = { x: 0, y: 0, dir: 1 };
				var boxes = [];
				var moveHistory = [];
				var stepCount = 0;
				var levelCompleted = false;
				var completionTimer = null;
				var resizeTimer = null;

				var sokobanGrid = document.getElementById('sokobanGrid');
				var boardScroll = document.getElementById('boardScroll');
				var levelSelect = document.getElementById('levelSelect');
				var targetStatus = document.getElementById('targetStatus');
				var stepCountEl = document.getElementById('stepCount');
				var bestCountEl = document.getElementById('bestCount');
				var gameMessage = document.getElementById('gameMessage');
				var btnUndo = document.getElementById('btnUndo');
				var btnReset = document.getElementById('btnReset');

				function getDifficultyLabel(index) {
					if (index < 15) return '🌱 教学';
					if (index < 35) return '🟢 入门';
					if (index < 65) return '🟡 进阶';
					if (index < 85) return '🟠 困难';
					return '🔴 大师';
				}

				function populateLevelSelect() {
					var i;
					for (i = 0; i < LEVELS.length; i++) {
						var option = document.createElement('option');
						option.value = String(i);
						setText(option, '第 ' + (i + 1) + ' 关 · ' + getDifficultyLabel(i));
						option.title = '已通过求解器验证 · ' + getDifficultyLabel(i);
						levelSelect.appendChild(option);
					}
				}

				function readBest(levelIndex) {
					try {
						var value = window.localStorage ? window.localStorage.getItem('sokoban_v3_best_' + levelIndex) : null;
						if (value === null || typeof value === 'undefined') return null;
						var parsed = parseInt(value, 10);
						return isFinite(parsed) ? parsed : null;
					} catch (error) {
						return null;
					}
				}

				function saveBest(levelIndex, steps) {
					try {
						if (window.localStorage) window.localStorage.setItem('sokoban_v3_best_' + levelIndex, String(steps));
					} catch (error) {
						/* Storage failure must not stop the game. */
					}
				}

				function setMessage(text, type) {
					setText(gameMessage, text);
					gameMessage.className = type === 'success' ? 'game-message success' : 'game-message';
				}

				function isInteger(value) {
					return typeof value === 'number' && isFinite(value) && Math.floor(value) === value;
				}

				function initLevel(index) {
					if (!isInteger(index) || index < 0 || index >= LEVELS.length) return;
					if (completionTimer !== null) {
						window.clearTimeout(completionTimer);
						completionTimer = null;
					}

					currentLevelIdx = index;
					levelSelect.value = String(index);
					var level = LEVELS[index];
					robot = cloneRobot(level.initialRobot);
					boxes = cloneBoxes(level.initialBoxes);
					moveHistory = [];
					stepCount = 0;
					levelCompleted = false;

					setMessage(index < 15 ? '教学阶段 · 第 ' + (index + 1) + ' 关' : '第 ' + (index + 1) + ' 关开始', '');
					updateStatsUI();
					renderGrid();
				}

				function updateStatsUI() {
					var level = LEVELS[currentLevelIdx];
					var placedCount = 0;
					var i;
					for (i = 0; i < boxes.length; i++) {
						if (dictHas(level.targets, keyOf(boxes[i].x, boxes[i].y))) placedCount++;
					}
					var best = readBest(currentLevelIdx);
					setText(targetStatus, placedCount + '/' + level.targetCount);
					setText(stepCountEl, String(stepCount));
					setText(bestCountEl, best === null ? '--' : best + ' 步');
					btnUndo.disabled = moveHistory.length === 0 || levelCompleted;
				}

				function calculateCellSize(level) {
					var availableWidth = boardScroll && boardScroll.clientWidth ? boardScroll.clientWidth - 28 : 720;
					var viewportHeight = document.documentElement && document.documentElement.clientHeight ? document.documentElement.clientHeight : 700;
					var maxBoardHeight = viewportHeight < 700 ? Math.floor(viewportHeight * 0.42) : 620;
					var byWidth = Math.floor(availableWidth / level.width) - 3;
					var byHeight = Math.floor(maxBoardHeight / level.height) - 3;
					var size = Math.min(52, byWidth, byHeight);
					if (size < 18) size = 18;
					return size;
				}

				function renderGrid() {
					var level = LEVELS[currentLevelIdx];
					var boxMap = {};
					var i, x, y;
					for (i = 0; i < boxes.length; i++) boxMap[keyOf(boxes[i].x, boxes[i].y)] = i;

					while (sokobanGrid.firstChild) sokobanGrid.removeChild(sokobanGrid.firstChild);
					var tbody = document.createElement('tbody');
					var cellSize = calculateCellSize(level);

					for (y = 0; y < level.height; y++) {
						var row = document.createElement('tr');
						for (x = 0; x < level.width; x++) {
							var cell = document.createElement('td');
							var key = keyOf(x, y);
							var cellType = level.cells[y][x];
							var isTarget = dictHas(level.targets, key);
							var hasBox = dictHas(boxMap, key);
							var isRobot = robot.x === x && robot.y === y;
							var className = 'sokoban-cell ' + (((x + y) % 2 === 0) ? 'tile-even' : 'tile-odd');

							cell.style.width = cellSize + 'px';
							cell.style.height = cellSize + 'px';
							cell.style.fontSize = Math.max(11, Math.floor(cellSize * 0.48)) + 'px';

							if (cellType === CELL.VOID) {
								cell.className = className + ' void';
								row.appendChild(cell);
								continue;
							}

							if (cellType === CELL.WALL) {
								cell.className = className + ' wall';
								var wallAvatar = document.createElement('span');
								wallAvatar.className = 'wall-avatar';
								setText(wallAvatar, '🧱');
								cell.appendChild(wallAvatar);
								row.appendChild(cell);
								continue;
							}

							if (isTarget && hasBox) className += ' target-placed';
							else if (isTarget) className += ' target-cell';
							cell.className = className;

							if (hasBox) {
								var boxAvatar = document.createElement('span');
								boxAvatar.className = 'box-avatar';
								setText(boxAvatar, '📦');
								cell.appendChild(boxAvatar);
							} else if (isTarget && !isRobot) {
								var targetAvatar = document.createElement('span');
								targetAvatar.className = 'target-avatar';
								setText(targetAvatar, '⭐');
								cell.appendChild(targetAvatar);
							}

							if (isRobot) {
								var robotAvatar = document.createElement('span');
								var angles = [270, 0, 90, 180];
								robotAvatar.className = 'robot-avatar';
								setText(robotAvatar, '🤖');
								robotAvatar.style.transform = 'rotate(' + angles[robot.dir] + 'deg)';
								robotAvatar.style.msTransform = 'rotate(' + angles[robot.dir] + 'deg)';
								robotAvatar.style.webkitTransform = 'rotate(' + angles[robot.dir] + 'deg)';
								cell.appendChild(robotAvatar);
							}
							row.appendChild(cell);
						}
						tbody.appendChild(row);
					}
					sokobanGrid.appendChild(tbody);
				}

				function isBlocked(level, x, y) {
					if (x < 0 || y < 0 || x >= level.width || y >= level.height) return true;
					return level.cells[y][x] !== CELL.FLOOR;
				}

				function findBoxIndex(x, y) {
					var i;
					for (i = 0; i < boxes.length; i++) {
						if (boxes[i].x === x && boxes[i].y === y) return i;
					}
					return -1;
				}

				function handleMove(dir) {
					if (levelCompleted) return;
					var level = LEVELS[currentLevelIdx];
					var previousRobot = cloneRobot(robot);
					var vectors = [
						{ dx: 0, dy: -1 },
						{ dx: 1, dy: 0 },
						{ dx: 0, dy: 1 },
						{ dx: -1, dy: 0 }
					];
					var dx = vectors[dir].dx;
					var dy = vectors[dir].dy;
					var nextX = robot.x + dx;
					var nextY = robot.y + dy;
					var boxIndex;
					var previousBox = null;

					robot.dir = dir;
					if (isBlocked(level, nextX, nextY)) {
						renderGrid();
						return;
					}

					boxIndex = findBoxIndex(nextX, nextY);
					if (boxIndex !== -1) {
						var boxNextX = nextX + dx;
						var boxNextY = nextY + dy;
						var anotherBoxIndex = findBoxIndex(boxNextX, boxNextY);
						if (isBlocked(level, boxNextX, boxNextY) || anotherBoxIndex !== -1) {
							renderGrid();
							return;
						}
						previousBox = { x: boxes[boxIndex].x, y: boxes[boxIndex].y };
						boxes[boxIndex] = { x: boxNextX, y: boxNextY };
					}

					moveHistory.push({
						robot: previousRobot,
						boxIndex: boxIndex === -1 ? null : boxIndex,
						box: previousBox
					});
					robot.x = nextX;
					robot.y = nextY;
					stepCount++;
					updateStatsUI();
					renderGrid();
					checkCompletion();
				}

				function checkCompletion() {
					var level = LEVELS[currentLevelIdx];
					var allPlaced = true;
					var i;
					for (i = 0; i < boxes.length; i++) {
						if (!dictHas(level.targets, keyOf(boxes[i].x, boxes[i].y))) {
							allPlaced = false;
							break;
						}
					}
					if (!allPlaced || levelCompleted) return;

					levelCompleted = true;
					var completedLevelIndex = currentLevelIdx;
					var completedSteps = stepCount;
					var oldBest = readBest(completedLevelIndex);
					if (oldBest === null || completedSteps < oldBest) saveBest(completedLevelIndex, completedSteps);
					updateStatsUI();
					setMessage('🎉 第 ' + (completedLevelIndex + 1) + ' 关完成，共 ' + completedSteps + ' 步！', 'success');

					completionTimer = window.setTimeout(function () {
						completionTimer = null;
						if (completedLevelIndex < LEVELS.length - 1) initLevel(completedLevelIndex + 1);
						else setMessage('🏆 恭喜完成全部 ' + LEVELS.length + ' 关！', 'success');
					}, 900);
				}

				function undo() {
					if (levelCompleted || moveHistory.length === 0) return;
					var lastMove = moveHistory.pop();
					robot = cloneRobot(lastMove.robot);
					if (lastMove.boxIndex !== null && lastMove.box) {
						boxes[lastMove.boxIndex] = { x: lastMove.box.x, y: lastMove.box.y };
					}
					stepCount = Math.max(0, stepCount - 1);
					setMessage('已撤销上一步', '');
					updateStatsUI();
					renderGrid();
				}

				function getDirectionFromKeyboard(event) {
					var key = event.key;
					var code = event.which || event.keyCode || 0;
					if (key === 'ArrowUp' || key === 'w' || key === 'W' || code === 38 || code === 87) return 0;
					if (key === 'ArrowRight' || key === 'd' || key === 'D' || code === 39 || code === 68) return 1;
					if (key === 'ArrowDown' || key === 's' || key === 'S' || code === 40 || code === 83) return 2;
					if (key === 'ArrowLeft' || key === 'a' || key === 'A' || code === 37 || code === 65) return 3;
					return -1;
				}

				function handleKeyDown(rawEvent) {
					var event = getEvent(rawEvent);
					var target = event.target || event.srcElement;
					var tagName = target && target.tagName ? String(target.tagName).toUpperCase() : '';
					if (tagName === 'INPUT' || tagName === 'TEXTAREA' || tagName === 'SELECT') return;

					var direction = getDirectionFromKeyboard(event);
					var code = event.which || event.keyCode || 0;
					var key = event.key;
					if (direction !== -1) {
						preventDefault(event);
						handleMove(direction);
						return;
					}
					if (key === 'z' || key === 'Z' || code === 90) {
						preventDefault(event);
						undo();
						return;
					}
					if (key === 'r' || key === 'R' || code === 82) {
						preventDefault(event);
						initLevel(currentLevelIdx);
					}
				}

				populateLevelSelect();
				addEvent(window, 'keydown', handleKeyDown);
				addEvent(document.getElementById('btnUp'), 'click', function () { handleMove(0); });
				addEvent(document.getElementById('btnRight'), 'click', function () { handleMove(1); });
				addEvent(document.getElementById('btnDown'), 'click', function () { handleMove(2); });
				addEvent(document.getElementById('btnLeft'), 'click', function () { handleMove(3); });
				addEvent(btnUndo, 'click', undo);
				addEvent(btnReset, 'click', function () { initLevel(currentLevelIdx); });
				addEvent(levelSelect, 'change', function (rawEvent) {
					var event = getEvent(rawEvent);
					var target = event.target || event.srcElement;
					initLevel(parseInt(target.value, 10));
				});
				addEvent(window, 'resize', function () {
					if (resizeTimer !== null) window.clearTimeout(resizeTimer);
					resizeTimer = window.setTimeout(function () {
						resizeTimer = null;
						renderGrid();
					}, 100);
				});

				initLevel(0);
			}());
		</script>
	</body>
</html>
