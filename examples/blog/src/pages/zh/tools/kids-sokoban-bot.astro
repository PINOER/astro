			function parseXSB(text) {
				const lines = text.replace(/\r/g, '').split('\n');
				const levels = [];
				let currentMap = [];

				for (let line of lines) {
					// 判定有效行：包含 #，且只包含合法符号
					if (/^[ \t\-_]*[#][#@\+\$\*\.\s\-_]*$/.test(line)) {
						currentMap.push(line.replace(/[\-_]/g, ' '));
					} else {
						if (currentMap.length > 0) {
							levels.push(currentMap);
							currentMap = [];
						}
					}
				}
				if (currentMap.length > 0) levels.push(currentMap);
				return levels;
			}

			/* =========================================================
			   核心引擎 2: 矩阵化状态管理 (Matrix State Management)
			   - 将文本转化为严格的 2D Array。
			   - 使用 Flood-Fill 算法区分“墙外黑洞”与“墙内地板”。
			========================================================= */
			class SokobanEngine {
				constructor() {
					this.levels = [];
					this.levelIdx = 0;
					
					this.width = 0;
					this.height = 0;
					
					// 静态层：'void' (外部), 'wall' (墙壁), 'floor' (空地), 'target' (目标点)
					this.staticGrid = []; 
					
					// 动态层
					this.boxes = []; // [{x, y}]
					this.player = { x: 0, y: 0, dir: 2 };
					this.history = [];
					this.steps = 0;
				}

				loadRawLevels(rawArray) {
					this.levels = rawArray;
				}

				initLevel(idx) {
					if (!this.levels[idx]) return;
					this.levelIdx = idx;
					const rawMap = this.levels[idx];
					
					this.height = rawMap.length;
					this.width = Math.max(...rawMap.map(l => l.length));
					
					this.staticGrid = Array.from({ length: this.height }, () => Array(this.width).fill('void'));
					this.boxes = [];
					this.history = [];
					this.steps = 0;

					// 1. 初步解析元素
					for (let y = 0; y < this.height; y++) {
						const row = rawMap[y];
						for (let x = 0; x < this.width; x++) {
							const char = row[x] || ' ';
							if (char === '#') this.staticGrid[y][x] = 'wall';
							else if (char === '.') this.staticGrid[y][x] = 'target';
							else if (char === '*') { this.staticGrid[y][x] = 'target'; this.boxes.push({x, y}); }
							else if (char === '$') { this.staticGrid[y][x] = 'floor'; this.boxes.push({x, y}); }
							else if (char === '+') { this.staticGrid[y][x] = 'target'; this.player = {x, y, dir: 2}; }
							else if (char === '@') { this.staticGrid[y][x] = 'floor'; this.player = {x, y, dir: 2}; }
							else if (char === ' ') this.staticGrid[y][x] = 'floor';
						}
					}

					// 2. Flood Fill 优化视觉：把墙外的 floor 标记回 void
					// 找到任何一个必定在墙内的点 (玩家位置) 进行连通性填充
					const visited = Array.from({ length: this.height }, () => Array(this.width).fill(false));
					const queue = [[this.player.x, this.player.y]];
					visited[this.player.y][this.player.x] = true;

					while(queue.length > 0) {
						const [cx, cy] = queue.shift();
						const dirs = [[0,1], [0,-1], [1,0], [-1,0]];
						for (let [dx, dy] of dirs) {
							const nx = cx + dx;
							const ny = cy + dy;
							if (nx >= 0 && nx < this.width && ny >= 0 && ny < this.height) {
								if (!visited[ny][nx] && this.staticGrid[ny][nx] !== 'wall') {
									visited[ny][nx] = true;
									queue.push([nx, ny]);
								}
							}
						}
					}

					// 清理未被访问到的非墙区域 (认定为墙外)
					for (let y = 0; y < this.height; y++) {
						for (let x = 0; x < this.width; x++) {
							if (this.staticGrid[y][x] !== 'wall' && !visited[y][x]) {
								this.staticGrid[y][x] = 'void';
							}
						}
					}
				}

				getBoxAt(x, y) {
					return this.boxes.find(b => b.x === x && b.y === y);
				}

				move(dir) {
					// dir: 0:Up, 1:Right, 2:Down, 3:Left
					this.player.dir = dir;
					const dx = [0, 1, 0, -1][dir];
					const dy = [-1, 0, 1, 0][dir];
					
					const nx = this.player.x + dx;
					const ny = this.player.y + dy;

					// 越界或撞墙
					if (nx < 0 || nx >= this.width || ny < 0 || ny >= this.height) return false;
					if (this.staticGrid[ny][nx] === 'wall' || this.staticGrid[ny][nx] === 'void') return false;

					const box = this.getBoxAt(nx, ny);
					let pushedBox = null;
					let oldBoxPos = null;

					if (box) {
						const bnx = nx + dx;
						const bny = ny + dy;
						// 箱子受阻
						if (bnx < 0 || bnx >= this.width || bny < 0 || bny >= this.height) return false;
						if (this.staticGrid[bny][bnx] === 'wall' || this.staticGrid[bny][bnx] === 'void') return false;
						if (this.getBoxAt(bnx, bny)) return false;

						oldBoxPos = { x: box.x, y: box.y };
						box.x = bnx;
						box.y = bny;
						pushedBox = box;
					}

					this.history.push({
						px: this.player.x, py: this.player.y, pdir: this.player.dir,
						box: pushedBox, oldBoxPos: oldBoxPos
					});

					this.player.x = nx;
					this.player.y = ny;
					this.steps++;
					return true;
				}

				undo() {
					if (this.history.length === 0) return false;
					const last = this.history.pop();
					this.player.x = last.px;
					this.player.y = last.py;
					this.player.dir = last.pdir;
					if (last.box) {
						last.box.x = last.oldBoxPos.x;
						last.box.y = last.oldBoxPos.y;
					}
					this.steps--;
					return true;
				}

				isWin() {
					let placed = 0;
					let total = 0;
					for (let y = 0; y < this.height; y++) {
						for (let x = 0; x < this.width; x++) {
							if (this.staticGrid[y][x] === 'target') {
								total++;
								if (this.getBoxAt(x, y)) placed++;
							}
						}
					}
					return { placed, total, win: (total > 0 && placed === total) };
				}
			}

			/* =========================================================
			   核心引擎 3: 视图渲染器 (DOM Renderer)
			   - 绝对像素匹配，彻底消除 CSS Grid 变形。
			========================================================= */
			const engine = new SokobanEngine();
			const gridContainer = document.getElementById('gridContainer');
			const levelSelect = document.getElementById('levelSelect');
			const targetStatus = document.getElementById('targetStatus');
			const stepCountEl = document.getElementById('stepCount');
			const bestCountEl = document.getElementById('bestCount');

			async function initApp() {
				let levelsData = parseXSB(INTERNAL_LEVELS);
				
				// 尝试静默拉取完整库
				try {
					const res = await fetch('https://raw.githubusercontent.com/sokoban-levels/sokoban-levels/master/microban.xsb');
					if (res.ok) {
						const text = await res.text();
						const fetched = parseXSB(text);
						if (fetched.length > 0) levelsData = fetched;
					}
				} catch (e) {
					console.log("使用本地内置关卡库");
				}

				engine.loadRawLevels(levelsData);
				
				levelSelect.innerHTML = '';
				engine.levels.forEach((_, i) => {
					const opt = document.createElement('option');
					opt.value = i;
					opt.textContent = `第 ${i + 1} 关`;
					levelSelect.appendChild(opt);
				});

				startGame(0);
			}

			function startGame(idx) {
				engine.initLevel(idx);
				levelSelect.value = idx;
				updateUI();
			}

			function updateUI() {
				// 1. 渲染矩阵
				gridContainer.innerHTML = '';
				gridContainer.style.gridTemplateColumns = `repeat(${engine.width}, 1fr)`;
				gridContainer.style.gridTemplateRows = `repeat(${engine.height}, 1fr)`;

				for (let y = 0; y < engine.height; y++) {
					for (let x = 0; x < engine.width; x++) {
						const cellType = engine.staticGrid[y][x];
						const cellEl = document.createElement('div');
						cellEl.className = `cell ${cellType}`;

						// 生成深浅交错的地板视觉
						if (cellType === 'floor' || cellType === 'target') {
							const isAlt = (x + y) % 2 === 1;
							if (isAlt) {
								cellEl.style.setProperty('--tile-bg', '#2b3a52');
								cellEl.style.setProperty('--tile-border', '#3a4b66');
							}
						}

						// 绘制墙壁
						if (cellType === 'wall') cellEl.textContent = '🧱';
						// 绘制目标点 (未填充)
						else if (cellType === 'target' && !engine.getBoxAt(x, y)) {
							const star = document.createElement('span');
							star.textContent = '⭐';
							star.className = 'sprite';
							cellEl.appendChild(star);
						}

						// 绘制箱子
						const box = engine.getBoxAt(x, y);
						if (box) {
							const boxEl = document.createElement('span');
							boxEl.textContent = '📦';
							boxEl.className = 'sprite box';
							if (cellType === 'target') cellEl.classList.add('filled');
							cellEl.appendChild(boxEl);
						}

						// 绘制玩家
						if (engine.player.x === x && engine.player.y === y) {
							const bot = document.createElement('span');
							bot.textContent = '🤖';
							bot.className = 'sprite robot';
							const angles = [0, 90, 180, -90]; // Up, Right, Down, Left
							bot.style.transform = `rotate(${angles[engine.player.dir]}deg)`;
							cellEl.appendChild(bot);
						}

						gridContainer.appendChild(cellEl);
					}
				}

				// 2. 状态更新
				const status = engine.isWin();
				targetStatus.textContent = `${status.placed}/${status.total}`;
				stepCountEl.textContent = engine.steps;

				const best = localStorage.getItem(`sokoban_best_v2_${engine.levelIdx}`);
				bestCountEl.textContent = best ? `${best} 步` : '--';

				// 3. 胜利判定
				if (status.win) {
					if (!best || engine.steps < parseInt(best)) {
						localStorage.setItem(`sokoban_best_v2_${engine.levelIdx}`, engine.steps);
					}
					setTimeout(() => {
						if (engine.levelIdx < engine.levels.length - 1) {
							alert(`🎉 恭喜！用时 ${engine.steps} 步通过第 ${engine.levelIdx + 1} 关！`);
							startGame(engine.levelIdx + 1);
						} else {
							alert('🏆 太牛了！全部关卡已被攻克！');
						}
					}, 200);
				}
			}

			// 控制绑定
			function doMove(dir) {
				if (engine.move(dir)) updateUI();
			}

			window.addEventListener('keydown', (e) => {
				if (['ArrowUp', 'w', 'W'].includes(e.key)) { e.preventDefault(); doMove(0); }
				if (['ArrowRight', 'd', 'D'].includes(e.key)) { e.preventDefault(); doMove(1); }
				if (['ArrowDown', 's', 'S'].includes(e.key)) { e.preventDefault(); doMove(2); }
				if (['ArrowLeft', 'a', 'A'].includes(e.key)) { e.preventDefault(); doMove(3); }
				if (['z', 'Z'].includes(e.key)) { e.preventDefault(); if (engine.undo()) updateUI(); }
			});

			document.getElementById('btnUp').addEventListener('click', () => doMove(0));
			document.getElementById('btnRight').addEventListener('click', () => doMove(1));
			document.getElementById('btnDown').addEventListener('click', () => doMove(2));
			document.getElementById('btnLeft').addEventListener('click', () => doMove(3));

			document.getElementById('btnUndo').addEventListener('click', () => { if(engine.undo()) updateUI(); });
			document.getElementById('btnReset').addEventListener('click', () => startGame(engine.levelIdx));
			levelSelect.addEventListener('change', (e) => startGame(parseInt(e.target.value)));

			// 启动引擎
			initApp();
		</script>
	</body>
</html>
