---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
    title: "儿童编程互动游戏：智能机器人迷宫大逃脱 (100关算法保证有解)",
    description: "免安装！专为儿童设计的逻辑避障编程游戏。采用递归回溯迷宫算法生成 100 个完美无死局关卡！通过组合积木指令指挥机器人自主避障！",
    icon: "🧱",
    tag: "儿童编程",
    keywords: "儿童编程游戏 迷宫算法 条件判断 100关迷宫 DFS迷宫 if-else 少儿编程 Scratch逻辑 STEM",
    pinned: true,
    priority: 85
};

const pageTitle = `儿童编程互动游戏：智能机器人迷宫大逃脱 (100关保证有解) — ${SITE_TITLE}`;
const pageDescription = "免安装！专为儿童设计的逻辑避障编程游戏，算法保障 100 个由浅入深且绝对有解的迷宫关卡。";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 1.5em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			/* 游戏容器 */
			.game-container {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 1.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.5rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
			}

			@media (max-width: 850px) {
				.game-container {
					grid-template-columns: 1fr;
					padding: 1rem;
				}
			}

			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				width: 100%;
			}
			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				background: var(--search-bg);
				padding: 0.6em 1em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.92rem;
			}

			.level-select {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.3em 0.6em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
			}

			/* 🏁 迷宫地图外框 */
			.maze-grid {
				display: grid !important;
				grid-template-columns: repeat(6, 1fr) !important;
				grid-template-rows: repeat(6, 1fr) !important;
				gap: 3px !important;
				width: 100%;
				max-width: 380px;
				aspect-ratio: 1 / 1;
				background: #090d16 !important;
				border: 3px solid #3b82f6;
				border-radius: 16px;
				padding: 6px;
				box-sizing: border-box !important;
				box-shadow: 0 8px 24px rgba(0,0,0,0.5);
			}

			/* 🏁 基础格子：深色底 + 极清灰蓝边框 */
			.maze-cell {
				background-color: #1e293b !important;
				border: 1.5px solid #475569 !important; /* 强制绘制清晰边框 */
				border-radius: 4px;
				display: flex !important;
				align-items: center;
				justify-content: center;
				font-size: 1.6rem;
				position: relative;
				user-select: none;
				box-sizing: border-box !important;
			}

			/* 🏁 交替棋盘格色 */
			.maze-cell.alt-cell {
				background-color: #2d3f5d !important;
				border-color: #64748b !important;
			}

			/* 🏁 墙壁样式 */
			.maze-cell.wall-cell {
				background-color: #0f172a !important;
				border-color: #1e293b !important;
				box-shadow: inset 0 2px 4px rgba(255,255,255,0.05);
			}

			/* 🏁 终点目标样式 */
			.maze-cell.target-cell {
				background-color: rgba(245, 158, 11, 0.3) !important;
				border: 2px dashed #f59e0b !important;
			}

			.robot-icon {
				transition: transform 0.2s ease-out;
				display: inline-block;
				filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
			}

			/* 右侧编辑器 */
			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 0.9rem;
			}

			.panel-title {
				font-size: 0.9rem;
				font-weight: 700;
				color: var(--text-main);
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			.block-palette {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.5rem;
			}

			.block-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.5em 0.6em;
				border-radius: 10px;
				font-size: 0.82rem;
				font-weight: 700;
				cursor: pointer;
				display: flex;
				align-items: center;
				gap: 0.3rem;
				transition: all 0.2s ease;
			}
			.block-btn:hover {
				transform: translateY(-2px);
				border-color: var(--accent);
			}

			.block-btn.blue { border-left: 4px solid #3b82f6; }
			.block-btn.amber { border-left: 4px solid #f59e0b; }
			.block-btn.purple { border-left: 4px solid #8b5cf6; }
			.block-btn.emerald { border-left: 4px solid #10b981; }

			.code-workspace {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem;
				min-height: 180px;
				max-height: 220px;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}

			.code-item {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 0.4em 0.7em;
				font-size: 0.82rem;
				font-weight: 600;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.code-item .remove-btn {
				color: #ef4444;
				cursor: pointer;
				font-weight: bold;
			}

			.action-bar {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
			}

			.btn-run {
				background: #3b82f6;
				color: #fff;
				border: none;
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.92rem;
				cursor: pointer;
			}
			.btn-run:hover { opacity: 0.9; transform: scale(1.02); }

			.btn-reset {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 700;
				font-size: 0.92rem;
				cursor: pointer;
			}
			.btn-reset:hover { border-color: var(--accent); }

			.empty-hint {
				color: var(--text-muted);
				font-size: 0.8rem;
				text-align: center;
				margin: auto;
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>🧱 儿童编程小游戏：智能机器人迷宫大逃脱 (100关)</h1>
				<p>组合“检测传感器”与“方向转弯”算法，帮助探险机器人冲出迷宫陷阱！</p>
			</div>

			<div class="game-container">
				<!-- 左侧：迷宫地图 -->
				<div class="stage-box">
					<div class="level-bar">
						<div>
							关卡: 
							<select id="levelSelect" class="level-select">
								<!-- JS 动态生成 100 关 -->
							</select>
						</div>
						<span>电池状态: ⚡ 100%</span>
					</div>

					<div class="maze-grid" id="mazeGrid">
						<!-- 动态生成 6x6 迷宫 -->
					</div>
				</div>

				<!-- 右侧：代码积木区 -->
				<div class="editor-box">
					<div class="panel-title">🧩 1. 点击添加避障逻辑</div>
					<div class="block-palette">
						<button class="block-btn blue" data-action="MOVE">🤖 前进 1 格</button>
						<button class="block-btn amber" data-action="TURN_RIGHT">↻ 右转 90°</button>
						<button class="block-btn amber" data-action="TURN_LEFT">↺ 左转 90°</button>
						<button class="block-btn purple" data-action="IF_WALL_RIGHT">⚠️ 若前方有墙则右转</button>
						<button class="block-btn emerald" data-action="REPEAT_3">🔁 重复前进 3 次</button>
					</div>

					<div class="panel-title">📜 2. 探险逻辑代码</div>
					<div class="code-workspace" id="codeWorkspace">
						<div class="empty-hint" id="emptyHint">点击上方积木组装避障代码...</div>
					</div>

					<div class="action-bar">
						<button class="btn-run" id="btnRun">▶ 启动机器人</button>
						<button class="btn-reset" id="btnReset">🔄 复位重置</button>
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			// 🧠 利用 DFS 深度优先算法生成绝对有解的 6x6 迷宫
			function generateValidMaze(levelNum) {
				const size = 6;
				// 伪随机种子（确保相同的关卡序号永远生成相同的独一无二迷宫）
				let seed = levelNum * 9301 + 49297;
				function random() {
					seed = (seed * 9301 + 49297) % 233280;
					return seed / 233280;
				}

				// 1. 初始化全为墙
				let maze = Array(size).fill(null).map(() => Array(size).fill(true));
				
				// 2. 递归雕刻通路
				function carve(x, y) {
					maze[y][x] = false;
					const dirs = [
						{dx: 0, dy: -1}, {dx: 1, dy: 0},
						{dx: 0, dy: 1}, {dx: -1, dy: 0}
					].sort(() => random() - 0.5);

					for (let d of dirs) {
						let nx = x + d.dx, ny = y + d.dy;
						if (nx >= 0 && nx < size && ny >= 0 && ny < size && maze[ny][nx]) {
							// 检查邻居数量，确保通畅
							let neighbors = 0;
							for (let check of [{dx:0,dy:-1},{dx:1,dy:0},{dx:0,dy:1},{dx:-1,dy:0}]) {
								let cx = nx + check.dx, cy = ny + check.dy;
								if (cx >= 0 && cx < size && cy >= 0 && cy < size && !maze[cy][cx]) neighbors++;
							}
							if (neighbors <= 1 || random() > 0.4) {
								carve(nx, ny);
							}
						}
					}
				}

				carve(0, 0);
				maze[0][0] = false; // 起点 (0,0)
				maze[5][5] = false; // 终点 (5,5)

				// 提取墙壁坐标列表
				let walls = [];
				for (let r = 0; r < size; r++) {
					for (let c = 0; c < size; c++) {
						if (maze[r][c] && !(c === 0 && r === 0) && !(c === 5 && r === 5)) {
							walls.push({ x: c, y: r });
						}
					}
				}

				return {
					title: `第 ${levelNum} 关 ${levelNum <= 30 ? '🟢入门' : (levelNum <= 70 ? '🟡进阶' : '🔴高难')}`,
					start: { x: 0, y: 0, dir: 1 },
					target: { x: 5, y: 5 },
					walls
				};
			}

			// 自动生成 100 关有解迷宫
			const TOTAL_LEVELS = 100;
			const LEVELS = [];
			for (let i = 1; i <= TOTAL_LEVELS; i++) {
				LEVELS.push(generateValidMaze(i));
			}

			let currentLevelIdx = 0;
			let robot = { x: 0, y: 0, dir: 1 };
			let instructions = [];
			let isRunning = false;

			const mazeGrid = document.getElementById('mazeGrid');
			const codeWorkspace = document.getElementById('codeWorkspace');
			const emptyHint = document.getElementById('emptyHint');
			const levelSelect = document.getElementById('levelSelect');
			const btnRun = document.getElementById('btnRun');
			const btnReset = document.getElementById('btnReset');

			// 初始化 100 关下拉列表
			LEVELS.forEach((lvl, idx) => {
				const opt = document.createElement('option');
				opt.value = idx;
				opt.textContent = lvl.title;
				levelSelect.appendChild(opt);
			});

			function initMaze(idx) {
				currentLevelIdx = idx;
				levelSelect.value = idx;
				const lvl = LEVELS[idx];
				robot = { ...lvl.start };
				instructions = [];
				renderWorkspace();
				renderGrid();
			}

			function renderGrid() {
				mazeGrid.innerHTML = '';
				const lvl = LEVELS[currentLevelIdx];

				for (let r = 0; r < 6; r++) {
					for (let c = 0; c < 6; c++) {
						const cell = document.createElement('div');
						cell.className = 'maze-cell';

						// 挂载棋盘深浅格子类名
						if ((r + c) % 2 === 1) {
							cell.classList.add('alt-cell');
						}

						const isWall = lvl.walls.some(w => w.x === c && w.y === r);
						const isTarget = c === lvl.target.x && r === lvl.target.y;
						const isRobot = r === robot.y && c === robot.x;

						// 1. 渲染墙壁
						if (isWall) {
							cell.classList.add('wall-cell');
							cell.textContent = '🧱';
						} 
						// 2. 渲染终点
						else if (isTarget) {
							cell.classList.add('target-cell');
							if (!isRobot) {
								cell.textContent = '🏆';
							}
						}

						// 3. 渲染机器人
						if (isRobot) {
							const rObj = document.createElement('span');
							rObj.className = 'robot-icon';
							rObj.textContent = '🤖';
							const angles = [270, 0, 90, 180];
							rObj.style.transform = `rotate(${angles[robot.dir]}deg)`;
							cell.appendChild(rObj);
						}

						mazeGrid.appendChild(cell);
					}
				}
			}

			document.querySelectorAll('.block-palette .block-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					if (isRunning) return;
					const action = btn.dataset.action;
					const label = btn.textContent;
					instructions.push({ action, label });
					renderWorkspace();
				});
			});

			function renderWorkspace() {
				if (instructions.length === 0) {
					emptyHint.style.display = 'block';
					codeWorkspace.innerHTML = '';
					codeWorkspace.appendChild(emptyHint);
					return;
				}
				emptyHint.style.display = 'none';
				codeWorkspace.innerHTML = '';

				instructions.forEach((item, idx) => {
					const el = document.createElement('div');
					el.className = 'code-item';
					el.innerHTML = `
						<span>${idx + 1}. ${item.label}</span>
						<span class="remove-btn" onclick="removeInstruction(${idx})">✕</span>
					`;
					codeWorkspace.appendChild(el);
				});
			}

			window.removeInstruction = function(idx) {
				if (isRunning) return;
				instructions.splice(idx, 1);
				renderWorkspace();
			};

			btnRun.addEventListener('click', async () => {
				if (isRunning || instructions.length === 0) return;
				isRunning = true;
				btnRun.disabled = true;

				const lvl = LEVELS[currentLevelIdx];

				// 展开重复指令
				let expandedQueue = [];
				for (let item of instructions) {
					if (item.action === 'REPEAT_3') {
						expandedQueue.push({ action: 'MOVE' }, { action: 'MOVE' }, { action: 'MOVE' });
					} else {
						expandedQueue.push(item);
					}
				}

				for (let item of expandedQueue) {
					await new Promise(r => setTimeout(r, 450));

					if (item.action === 'IF_WALL_RIGHT') {
						let nextX = robot.x;
						let nextY = robot.y;
						if (robot.dir === 0) nextY--;
						if (robot.dir === 1) nextX++;
						if (robot.dir === 2) nextY++;
						if (robot.dir === 3) nextX--;

						const hitWall = nextX < 0 || nextX >= 6 || nextY < 0 || nextY >= 6 || lvl.walls.some(w => w.x === nextX && w.y === nextY);
						if (hitWall) {
							robot.dir = (robot.dir + 1) % 4;
						}
					} else if (item.action === 'MOVE') {
						let nextX = robot.x;
						let nextY = robot.y;
						if (robot.dir === 0) nextY--;
						if (robot.dir === 1) nextX++;
						if (robot.dir === 2) nextY++;
						if (robot.dir === 3) nextX--;

						if (nextX < 0 || nextX >= 6 || nextY < 0 || nextY >= 6 || lvl.walls.some(w => w.x === nextX && w.y === nextY)) {
							alert('💥 嘭！机器人撞到墙壁了！重试一下吧！');
							break;
						}
						robot.x = nextX;
						robot.y = nextY;
					} else if (item.action === 'TURN_RIGHT') {
						robot.dir = (robot.dir + 1) % 4;
					} else if (item.action === 'TURN_LEFT') {
						robot.dir = (robot.dir + 3) % 4;
					}

					renderGrid();

					if (robot.x === lvl.target.x && robot.y === lvl.target.y) {
						setTimeout(() => {
							if (currentLevelIdx < TOTAL_LEVELS - 1) {
								alert(`🎉 恭喜通关第 ${currentLevelIdx + 1} 关！机器人成功逃脱！即将解锁第 ${currentLevelIdx + 2} 关！`);
								initMaze(currentLevelIdx + 1);
							} else {
								alert('🏆 太厉害了！你成功帮助机器人通关了全部 100 个迷宫！');
							}
						}, 200);
						break;
					}
				}

				isRunning = false;
				btnRun.disabled = false;
			});

			btnReset.addEventListener('click', () => {
				if (isRunning) return;
				initMaze(currentLevelIdx);
			});

			levelSelect.addEventListener('change', (e) => {
				if (isRunning) return;
				initMaze(parseInt(e.target.value));
			});

			initMaze(0);
		</script>
	</body>
</html>
