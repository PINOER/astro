---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: '儿童编程互动游戏：智能机器人迷宫大逃脱（100关）',
	description: '免安装的儿童逻辑编程游戏。100个确定性迷宫关卡均经过BFS可达性验证，通过前进、转向和条件判断积木指挥机器人到达终点。',
	icon: '🤖',
	tag: '儿童编程',
	keywords: '儿童编程游戏 机器人迷宫 逻辑训练 条件判断 BFS迷宫 少儿编程 Scratch逻辑 STEM',
	pinned: true,
	priority: 85
};

const pageTitle = `儿童编程互动游戏：智能机器人迷宫大逃脱（100关）— ${SITE_TITLE}`;
const pageDescription = '组合前进、转向和条件判断积木，挑战100个经过可达性验证、难度逐步提升的机器人迷宫关卡。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}

			.tool-header {
				text-align: center;
				margin-bottom: 1.5em;
			}

			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.tool-header p {
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			.game-container {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 1.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.5rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
			}

			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				width: 100%;
				min-width: 0;
			}

			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.8rem;
				width: 100%;
				background: var(--search-bg);
				padding: 0.6em 1em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.88rem;
				box-sizing: border-box;
			}

			.level-meta {
				display: flex;
				gap: 0.8rem;
				flex-wrap: wrap;
				justify-content: flex-end;
				color: var(--text-muted);
			}

			.level-select {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.35em 0.6em;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
			}

			/* 🏁 网格容器：极度明确的强约束 CSS Grid */
			.maze-grid {
				display: grid !important;
				grid-template-columns: repeat(6, 1fr) !important;
				grid-template-rows: repeat(6, 1fr) !important;
				gap: 2px !important;
				width: min(100%, 420px) !important;
				aspect-ratio: 1 / 1 !important;
				background: #090d16 !important;
				border: 4px solid #3b82f6 !important;
				border-radius: 16px !important;
				padding: 8px !important;
				box-sizing: border-box !important;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5) !important;
				overflow: hidden !important;
			}

			.maze-cell {
				display: flex !important;
				align-items: center !important;
				justify-content: center !important;
				font-size: clamp(1.2rem, 4.5vw, 1.85rem) !important;
				position: relative !important;
				user-select: none !important;
				box-sizing: border-box !important;
				border-radius: 4px !important;
			}

			.robot-icon {
				transition: transform 0.18s ease-out;
				display: inline-block;
				filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.6));
			}

			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 0.9rem;
				min-width: 0;
			}

			.panel-title {
				font-size: 0.9rem;
				font-weight: 700;
				color: var(--text-main);
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			.block-palette {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.5rem;
			}

			.block-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.55em 0.6em;
				border-radius: 10px;
				font-size: 0.8rem;
				font-weight: 700;
				cursor: pointer;
				display: flex;
				align-items: center;
				gap: 0.3rem;
				transition: transform 0.2s ease, border-color 0.2s ease;
				text-align: left;
			}

			.block-btn:hover:not(:disabled) {
				transform: translateY(-2px);
				border-color: var(--accent);
			}

			.block-btn.blue { border-left: 4px solid #3b82f6; }
			.block-btn.amber { border-left: 4px solid #f59e0b; }
			.block-btn.purple { border-left: 4px solid #8b5cf6; }
			.block-btn.emerald { border-left: 4px solid #10b981; }

			.code-workspace {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem;
				min-height: 180px;
				max-height: 235px;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}

			.code-item {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 0.4em 0.55em 0.4em 0.7em;
				font-size: 0.82rem;
				font-weight: 600;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.5rem;
			}

			.remove-btn {
				border: none;
				background: transparent;
				color: #ef4444;
				cursor: pointer;
				font-weight: 900;
				font-size: 1rem;
				line-height: 1;
				padding: 0.25rem;
			}

			.action-bar {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
			}

			.btn-run,
			.btn-reset {
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.92rem;
				cursor: pointer;
			}

			.btn-run {
				background: #3b82f6;
				color: #fff;
				border: none;
			}

			.btn-run:hover:not(:disabled) {
				opacity: 0.9;
				transform: scale(1.02);
			}

			.btn-reset {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}

			.btn-reset:hover:not(:disabled) {
				border-color: var(--accent);
			}

			button:disabled,
			select:disabled {
				cursor: not-allowed;
				opacity: 0.55;
			}

			.empty-hint {
				color: var(--text-muted);
				font-size: 0.8rem;
				text-align: center;
				margin: auto;
			}

			.code-tip {
				font-size: 0.78rem;
				line-height: 1.55;
				color: var(--text-muted);
				text-align: center;
			}

			@media (max-width: 850px) {
				.game-container {
					grid-template-columns: 1fr;
					padding: 1rem;
				}

				.level-bar {
					align-items: flex-start;
					flex-direction: column;
				}

				.level-meta {
					justify-content: flex-start;
				}
			}

			@media (max-width: 460px) {
				main {
					max-width: calc(100% - 1em);
					padding-left: 0.5em;
					padding-right: 0.5em;
				}

				.tool-header h1 {
					font-size: 1.65rem;
				}

				.block-palette {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>🤖 儿童编程小游戏：智能机器人迷宫大逃脱（100关）</h1>
				<p>组合前进、转向与条件判断积木，编写程序帮助机器人安全抵达终点。</p>
			</div>

			<div class="game-container">
				<div class="stage-box">
					<div class="level-bar">
						<label>
							关卡：
							<select id="levelSelect" class="level-select" aria-label="选择迷宫关卡"></select>
						</label>
						<div class="level-meta">
							<span id="routeStatus">最短路线：--</span>
							<span id="bestStatus">最佳积木：--</span>
						</div>
					</div>

					<div class="maze-grid" id="mazeGrid" aria-label="6乘6机器人迷宫"></div>
				</div>

				<div class="editor-box">
					<div class="panel-title">🧩 1. 点击添加编程积木</div>
					<div class="block-palette">
						<button type="button" class="block-btn blue" data-action="MOVE">🤖 前进 1 格</button>
						<button type="button" class="block-btn amber" data-action="TURN_RIGHT">↻ 右转 90°</button>
						<button type="button" class="block-btn amber" data-action="TURN_LEFT">↺ 左转 90°</button>
						<button type="button" class="block-btn purple" data-action="IF_WALL_RIGHT">⚠️ 前方有墙则右转</button>
						<button type="button" class="block-btn emerald" data-action="REPEAT_3">⏩ 连续前进 3 格</button>
					</div>

					<div class="panel-title">📜 2. 探险逻辑代码</div>
					<div class="code-workspace" id="codeWorkspace" aria-live="polite">
						<div class="empty-hint" id="emptyHint">点击上方积木组装机器人程序……</div>
					</div>

					<div class="action-bar">
						<button type="button" class="btn-run" id="btnRun">▶ 从起点运行</button>
						<button type="button" class="btn-reset" id="btnReset">🗑️ 清空并复位</button>
					</div>

					<div class="code-tip">
						每次运行都会从起点开始。程序最多可放置60个积木，撞墙后可修改代码再次尝试。
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			const GRID_SIZE = 6;
			const TOTAL_LEVELS = 100;
			const MAX_INSTRUCTIONS = 60;
			const STEP_DELAY = 360;
			const DIRECTIONS = [
				{ dx: 0, dy: -1 },
				{ dx: 1, dy: 0 },
				{ dx: 0, dy: 1 },
				{ dx: -1, dy: 0 }
			];

			function createRandom(seed) {
				let state = seed >>> 0;
				return function random() {
					state = (state + 0x6D2B79F5) >>> 0;
					let value = state;
					value = Math.imul(value ^ (value >>> 15), value | 1);
					value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
					return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
				};
			}

			function shuffle(values, random) {
				const result = [...values];
				for (let index = result.length - 1; index > 0; index--) {
					const swapIndex = Math.floor(random() * (index + 1));
					[result[index], result[swapIndex]] = [result[swapIndex], result[index]];
				}
				return result;
			}

			function positionKey(x, y) {
				return `${x},${y}`;
			}

			function getDifficultyConfig(levelNum) {
				if (levelNum <= 30) {
					return {
						label: '🟢 入门',
						minWalls: 5,
						maxWalls: 8,
						minPathLength: 10,
						minTurns: 1
					};
				}

				if (levelNum <= 70) {
					return {
						label: '🟡 进阶',
						minWalls: 8,
						maxWalls: 12,
						minPathLength: 12,
						minTurns: 3
					};
				}

				return {
					label: '🔴 高难',
					minWalls: 11,
					maxWalls: 15,
					minPathLength: 14,
					minTurns: 4
				};
			}

			function findShortestPath(walls) {
				const wallSet = new Set(walls.map((wall) => positionKey(wall.x, wall.y)));
				const targetX = GRID_SIZE - 1;
				const targetY = GRID_SIZE - 1;
				const queue = [{ x: 0, y: 0, path: [] }];
				const visited = new Set([positionKey(0, 0)]);
				let queueIndex = 0;

				while (queueIndex < queue.length) {
					const current = queue[queueIndex++];

					if (current.x === targetX && current.y === targetY) {
						return current.path;
					}

					for (let direction = 0; direction < DIRECTIONS.length; direction++) {
						const nextX = current.x + DIRECTIONS[direction].dx;
						const nextY = current.y + DIRECTIONS[direction].dy;
						const key = positionKey(nextX, nextY);

						if (
							nextX < 0 || nextX >= GRID_SIZE ||
							nextY < 0 || nextY >= GRID_SIZE ||
							wallSet.has(key) ||
							visited.has(key)
						) {
							continue;
						}

						visited.add(key);
						queue.push({
							x: nextX,
							y: nextY,
							path: [...current.path, direction]
						});
					}
				}

				return null;
			}

			function countTurns(path) {
				let turns = 0;
				for (let index = 1; index < path.length; index++) {
					if (path[index] !== path[index - 1]) turns++;
				}
				return turns;
			}

			function generateValidMaze(levelNum, usedSignatures) {
				const config = getDifficultyConfig(levelNum);
				const availableCells = [];

				for (let y = 0; y < GRID_SIZE; y++) {
					for (let x = 0; x < GRID_SIZE; x++) {
						const isStart = x === 0 && y === 0;
						const isTarget = x === GRID_SIZE - 1 && y === GRID_SIZE - 1;
						if (!isStart && !isTarget) availableCells.push({ x, y });
					}
				}

				for (let attempt = 0; attempt < 5000; attempt++) {
					const random = createRandom(levelNum * 1000003 + attempt * 9176 + 12345);
					const wallRange = config.maxWalls - config.minWalls + 1;
					const wallCount = config.minWalls + Math.floor(random() * wallRange);
					const walls = shuffle(availableCells, random).slice(0, wallCount);
					const signature = walls
						.map((wall) => positionKey(wall.x, wall.y))
						.sort()
						.join('|');

					if (usedSignatures.has(signature)) continue;

					const shortestPath = findShortestPath(walls);
					if (!shortestPath) continue;
					if (shortestPath.length < config.minPathLength) continue;
					if (countTurns(shortestPath) < config.minTurns) continue;

					usedSignatures.add(signature);
					return {
						title: `第 ${levelNum} 关 ${config.label}`,
						start: { x: 0, y: 0, dir: 1 },
						target: { x: GRID_SIZE - 1, y: GRID_SIZE - 1 },
						walls,
						wallSet: new Set(walls.map((wall) => positionKey(wall.x, wall.y))),
						shortestPathLength: shortestPath.length,
						turnCount: countTurns(shortestPath)
					};
				}

				throw new Error(`无法生成第 ${levelNum} 关迷宫`);
			}

			const usedSignatures = new Set();
			const LEVELS = Array.from(
				{ length: TOTAL_LEVELS },
				(_, index) => generateValidMaze(index + 1, usedSignatures)
			);

			let currentLevelIdx = 0;
			let robot = { x: 0, y: 0, dir: 1 };
			let instructions = [];
			let isRunning = false;

			const mazeGrid = document.getElementById('mazeGrid');
			const codeWorkspace = document.getElementById('codeWorkspace');
			const emptyHint = document.getElementById('emptyHint');
			const levelSelect = document.getElementById('levelSelect');
			const routeStatus = document.getElementById('routeStatus');
			const bestStatus = document.getElementById('bestStatus');
			const btnRun = document.getElementById('btnRun');
			const btnReset = document.getElementById('btnReset');
			const blockButtons = [...document.querySelectorAll('.block-btn')];

			function readBest(levelIdx) {
				try {
					const value = localStorage.getItem(`robot_maze_best_v2_${levelIdx}`);
					if (value === null) return null;
					const parsed = Number.parseInt(value, 10);
					return Number.isFinite(parsed) ? parsed : null;
				} catch {
					return null;
				}
			}

			function saveBest(levelIdx, count) {
				try {
					localStorage.setItem(`robot_maze_best_v2_${levelIdx}`, String(count));
				} catch {
					// 本地存储不可用时，不影响游戏继续运行。
				}
			}

			function updateLevelStatus() {
				const level = LEVELS[currentLevelIdx];
				const best = readBest(currentLevelIdx);
				routeStatus.textContent = `最短路线：${level.shortestPathLength} 格`;
				bestStatus.textContent = best === null ? '最佳积木：--' : `最佳积木：${best} 个`;
			}

			function setControlsDisabled(disabled) {
				btnRun.disabled = disabled;
				btnReset.disabled = disabled;
				levelSelect.disabled = disabled;
				blockButtons.forEach((button) => {
					button.disabled = disabled;
				});
				codeWorkspace.querySelectorAll('.remove-btn').forEach((button) => {
					button.disabled = disabled;
				});
			}

			LEVELS.forEach((level, index) => {
				const option = document.createElement('option');
				option.value = String(index);
				option.textContent = level.title;
				levelSelect.appendChild(option);
			});

			function initMaze(index, clearProgram = true) {
				const safeIndex = Math.max(0, Math.min(index, TOTAL_LEVELS - 1));
				currentLevelIdx = safeIndex;
				levelSelect.value = String(safeIndex);
				robot = { ...LEVELS[safeIndex].start };

				if (clearProgram) {
					instructions = [];
					renderWorkspace();
				}

				updateLevelStatus();
				renderGrid();
			}

			/* 🏁 【终极解决方案】：使用最高强度的 Dynamic Inline Style 动态渲染地砖！ */
			function renderGrid() {
				mazeGrid.replaceChildren();
				const level = LEVELS[currentLevelIdx];

				for (let row = 0; row < GRID_SIZE; row++) {
					for (let column = 0; column < GRID_SIZE; column++) {
						const cell = document.createElement('div');
						cell.className = 'maze-cell';
						
						// 1. 奇偶交错底色 (浅亮蓝灰 vs 深暗蓝灰)
						const isEven = (row + column) % 2 === 0;
						if (isEven) {
							cell.style.backgroundColor = '#1d2a3e';
							cell.style.border = '1px solid #283954';
						} else {
							cell.style.backgroundColor = '#384b6c';
							cell.style.border = '1px solid #4a6188';
						}

						const key = positionKey(column, row);
						const isWall = level.wallSet.has(key);
						const isTarget = column === level.target.x && row === level.target.y;
						const isRobot = column === robot.x && row === robot.y;

						// 2. 墙壁与目标的高优先覆盖色
						if (isWall) {
							cell.style.backgroundColor = '#0c121e';
							cell.style.border = '1px solid #1a273b';
							cell.style.boxShadow = 'inset 0 0 8px rgba(0,0,0,0.8)';
							cell.textContent = '🧱';
						} else if (isTarget) {
							cell.style.backgroundColor = 'rgba(245, 158, 11, 0.35)';
							cell.style.border = '2px dashed #f59e0b';
							if (!isRobot) cell.textContent = '🏆';
						}

						// 3. 渲染机器人
						if (isRobot) {
							const robotIcon = document.createElement('span');
							robotIcon.className = 'robot-icon';
							robotIcon.textContent = '🤖';
							const angles = [270, 0, 90, 180];
							robotIcon.style.transform = `rotate(${angles[robot.dir]}deg)`;
							cell.appendChild(robotIcon);
						}

						mazeGrid.appendChild(cell);
					}
				}
			}

			function renderWorkspace() {
				codeWorkspace.replaceChildren();

				if (instructions.length === 0) {
					emptyHint.style.display = 'block';
					codeWorkspace.appendChild(emptyHint);
					return;
				}

				emptyHint.style.display = 'none';

				instructions.forEach((instruction, index) => {
					const item = document.createElement('div');
					item.className = 'code-item';

					const label = document.createElement('span');
					label.textContent = `${index + 1}. ${instruction.label}`;

					const removeButton = document.createElement('button');
					removeButton.type = 'button';
					removeButton.className = 'remove-btn';
					removeButton.dataset.index = String(index);
					removeButton.setAttribute('aria-label', `删除第 ${index + 1} 个积木`);
					removeButton.textContent = '✕';
					removeButton.disabled = isRunning;

					item.append(label, removeButton);
					codeWorkspace.appendChild(item);
				});
			}

			function getNextPosition(direction) {
				return {
					x: robot.x + DIRECTIONS[direction].dx,
					y: robot.y + DIRECTIONS[direction].dy
				};
			}

			function isBlocked(level, x, y) {
				return (
					x < 0 || x >= GRID_SIZE ||
					y < 0 || y >= GRID_SIZE ||
					level.wallSet.has(positionKey(x, y))
				);
			}

			function expandInstructions(program) {
				const queue = [];
				for (const instruction of program) {
					if (instruction.action === 'REPEAT_3') {
						queue.push(
							{ action: 'MOVE' },
							{ action: 'MOVE' },
							{ action: 'MOVE' }
						);
					} else {
						queue.push({ action: instruction.action });
					}
				}
				return queue;
			}

			function sleep(milliseconds) {
				return new Promise((resolve) => window.setTimeout(resolve, milliseconds));
			}

			blockButtons.forEach((button) => {
				button.addEventListener('click', () => {
					if (isRunning) return;

					if (instructions.length >= MAX_INSTRUCTIONS) {
						alert(`最多可以添加 ${MAX_INSTRUCTIONS} 个积木。`);
						return;
					}

					const action = button.dataset.action;
					if (!action) return;

					instructions.push({
						action,
						label: button.textContent.trim()
					});
					renderWorkspace();
				});
			});

			codeWorkspace.addEventListener('click', (event) => {
				if (isRunning) return;
				const button = event.target.closest('.remove-btn');
				if (!button) return;

				const index = Number.parseInt(button.dataset.index ?? '', 10);
				if (!Number.isInteger(index) || index < 0 || index >= instructions.length) return;

				instructions.splice(index, 1);
				renderWorkspace();
			});

			btnRun.addEventListener('click', async () => {
				if (isRunning || instructions.length === 0) return;

				const runLevelIdx = currentLevelIdx;
				const level = LEVELS[runLevelIdx];
				const programLength = instructions.length;
				const executionQueue = expandInstructions(instructions);
				let reachedTarget = false;
				let crashed = false;

				robot = { ...level.start };
				renderGrid();
				isRunning = true;
				setControlsDisabled(true);

				try {
					for (const instruction of executionQueue) {
						await sleep(STEP_DELAY);

						if (currentLevelIdx !== runLevelIdx) break;

						if (instruction.action === 'IF_WALL_RIGHT') {
							const next = getNextPosition(robot.dir);
							if (isBlocked(level, next.x, next.y)) {
								robot.dir = (robot.dir + 1) % 4;
							}
						} else if (instruction.action === 'MOVE') {
							const next = getNextPosition(robot.dir);
							if (isBlocked(level, next.x, next.y)) {
								crashed = true;
								break;
							}
							robot.x = next.x;
							robot.y = next.y;
						} else if (instruction.action === 'TURN_RIGHT') {
							robot.dir = (robot.dir + 1) % 4;
						} else if (instruction.action === 'TURN_LEFT') {
							robot.dir = (robot.dir + 3) % 4;
						}

						renderGrid();

						if (robot.x === level.target.x && robot.y === level.target.y) {
							reachedTarget = true;
							break;
						}
					}
				} finally {
					isRunning = false;
					setControlsDisabled(false);
				}

				if (reachedTarget) {
					const previousBest = readBest(runLevelIdx);
					if (previousBest === null || programLength < previousBest) {
						saveBest(runLevelIdx, programLength);
					}
					updateLevelStatus();

					if (runLevelIdx < TOTAL_LEVELS - 1) {
						alert(`🎉 恭喜通关第 ${runLevelIdx + 1} 关！即将进入第 ${runLevelIdx + 2} 关。`);
						initMaze(runLevelIdx + 1, true);
					} else {
						alert('🏆 太厉害了！你已经通关全部100个机器人迷宫！');
					}
				} else if (crashed) {
					alert('💥 机器人撞墙了！修改积木顺序后再试一次。');
				} else {
					alert('🤔 程序执行完了，但机器人还没有到达终点。继续完善代码吧！');
				}
			});

			btnReset.addEventListener('click', () => {
				if (isRunning) return;
				initMaze(currentLevelIdx, true);
			});

			levelSelect.addEventListener('change', (event) => {
				if (isRunning) {
					levelSelect.value = String(currentLevelIdx);
					return;
				}

				const index = Number.parseInt(event.target.value, 10);
				if (!Number.isInteger(index)) return;
				initMaze(index, true);
			});

			initMaze(0, true);
		</script>
	</body>
</html>
