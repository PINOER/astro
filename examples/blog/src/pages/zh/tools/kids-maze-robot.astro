const messageBox = document.getElementById('messageBox');
const editorSize = document.getElementById('editorSize');
const editorToolbar = document.getElementById('editorToolbar');
const editorGrid = document.getElementById('editorGrid');
const editorMessage = document.getElementById('editorMessage');
const shareCode = document.getElementById('shareCode');
const btnEditorValidate = document.getElementById('btnEditorValidate');
const btnEditorPlay = document.getElementById('btnEditorPlay');
const btnEditorClear = document.getElementById('btnEditorClear');
const btnEditorExport = document.getElementById('btnEditorExport');
const btnEditorImport = document.getElementById('btnEditorImport');

function getLevelRecord(index) {
	return progress.levels[String(index)] ?? null;
}

function totalStars() {
	return Object.values(progress.levels).reduce((sum, record) => sum + (Number(record?.stars) || 0), 0);
}

function chapterStars(chapter) {
	let stars = 0;
	for (let number = chapter.range[0]; number <= chapter.range[1]; number++) stars += Number(getLevelRecord(number - 1)?.stars) || 0;
	return stars;
}

function chapterCompleted(chapter) {
	let completed = 0;
	for (let number = chapter.range[0]; number <= chapter.range[1]; number++) {
		if ((Number(getLevelRecord(number - 1)?.stars) || 0) > 0) completed++;
	}
	return completed;
}

function setMessage(text, type = '') {
	messageBox.className = `message-box${type ? ` ${type}` : ''}`;
	messageBox.textContent = text;
}

function setEditorMessage(text, type = '') {
	editorMessage.className = `editor-message${type ? ` ${type}` : ''}`;
	editorMessage.textContent = text;
}

function renderProgress() {
	const unlockedCount = Math.min(TOTAL_LEVELS, progress.unlockedLevel + 1);
	const stars = totalStars();
	progressSummary.textContent = `已解锁 ${unlockedCount}/${TOTAL_LEVELS} · 星星 ${stars}/${TOTAL_LEVELS * 3}`;
	progressFill.style.width = `${Math.max(unlockedCount / TOTAL_LEVELS * 100, 1.5)}%`;
	chapterTabs.replaceChildren();
	for (const chapter of CHAPTERS) {
		const firstIndex = chapter.range[0] - 1;
		const unlocked = progress.unlockedLevel >= firstIndex;
		const button = document.createElement('button');
		button.type = 'button';
		button.className = `chapter-btn${currentChapterId === chapter.id ? ' active' : ''}`;
		button.dataset.chapter = String(chapter.id);
		button.disabled = !unlocked || isRunning;
		button.innerHTML = `<span class="chapter-name">${chapter.icon} ${chapter.shortName}</span><span class="chapter-stat">${chapterCompleted(chapter)}/15关 · ${chapterStars(chapter)}/45⭐</span>`;
		chapterTabs.appendChild(button);
	}

	levelPicker.replaceChildren();
	const chapter = CHAPTERS[currentChapterId - 1];
	for (let number = chapter.range[0]; number <= chapter.range[1]; number++) {
		const index = number - 1;
		const unlocked = index <= progress.unlockedLevel;
		const record = getLevelRecord(index);
		const button = document.createElement('button');
		button.type = 'button';
		button.className = `level-btn${index === currentLevelIdx ? ' active' : ''}${unlocked ? '' : ' locked'}`;
		button.dataset.level = String(index);
		button.disabled = !unlocked || isRunning;
		button.textContent = unlocked ? String(number) : '🔒';
		if (record?.stars) {
			const starsEl = document.createElement('span');
			starsEl.className = 'level-stars';
			starsEl.textContent = '★'.repeat(record.stars);
			button.appendChild(starsEl);
		}
		levelPicker.appendChild(button);
	}
}

function recordForActiveLevel() {
	if (currentMode === 'main') return getLevelRecord(currentLevelIdx);
	if (currentMode === 'daily') return progress.daily[localDateKey()] ?? null;
	return null;
}

function modeName() {
	if (currentMode === 'daily') return '📅 每日挑战';
	if (currentMode === 'custom') return '🛠️ 自建地图测试';
	return activeLevel.chapter.name;
}

function renderLevelHeader() {
	const record = recordForActiveLevel();
	levelHeading.textContent = currentMode === 'main' ? `${activeLevel.title} · ${activeLevel.chapter.shortName}` : activeLevel.title;
	difficultyStatus.textContent = `难度：${'★'.repeat(activeLevel.difficulty)}${'☆'.repeat(5 - activeLevel.difficulty)}`;
	budgetStatus.textContent = `推荐积木：≤ ${activeLevel.blockBudget}`;
	bestStatus.textContent = record?.bestBlocks ? `最佳：${record.bestBlocks}块 / ${record.bestSteps}步` : '最佳：--';
	missionTitle.textContent = `任务：${activeLevel.featureText}`;
	missionDescription.textContent = `${activeLevel.chapter.mission} 当前机关：${activeLevel.featureText}。`;
	paletteNote.textContent = activeLevel.chapter.note;
}

function inventoryText() {
	const parts = [];
	if (activeLevel.key) parts.push(runtimeState.hasKey ? '🔑 已获得' : '🔑 未获得');
	if (activeLevel.switch) parts.push(runtimeState.switchOn ? '🟢 机关已开启' : '🔘 机关未开启');
	if (activeLevel.batteries.length) {
		let count = 0;
		for (let index = 0; index < activeLevel.batteries.length; index++) if (runtimeState.batteryMask & (1 << index)) count++;
		parts.push(`🔋 ${count}/${activeLevel.batteries.length}`);
	}
	return parts.length ? parts.join(' · ') : '🎒 无任务物品';
}

function cellBaseStyle(cell, row, column) {
	const even = (row + column) % 2 === 0;
	cell.style.backgroundColor = even ? '#1d2a3e' : '#344866';
	cell.style.border = even ? '1px solid #283954' : '1px solid #4a6188';
}

function renderGrid() {
	mazeGrid.replaceChildren();
	mazeGrid.style.gridTemplateColumns = `repeat(${activeLevel.size}, 1fr)`;
	mazeGrid.style.gridTemplateRows = `repeat(${activeLevel.size}, 1fr)`;
	mazeGrid.style.maxWidth = activeLevel.size <= 5 ? '390px' : activeLevel.size <= 7 ? '460px' : '520px';

	for (let row = 0; row < activeLevel.size; row++) {
		for (let column = 0; column < activeLevel.size; column++) {
			const cell = document.createElement('div');
			cell.className = 'maze-cell';
			cellBaseStyle(cell, row, column);
			const key = positionKey(column, row);
			const isRobot = runtimeState.x === column && runtimeState.y === row;
			const batteryIndex = activeLevel.batteries.findIndex((battery) => battery.x === column && battery.y === row);
			const portal = activeLevel.portals.find((item) => item.x === column && item.y === row);

			if (activeLevel.wallSet.has(key)) {
				cell.classList.add('wall-cell');
				cell.textContent = '🧱';
			} else {
				if (activeLevel.iceSet.has(key)) {
					cell.classList.add('ice-cell');
					cell.textContent = '🧊';
				}
				if (activeLevel.gateSet.has(key)) {
					cell.classList.add(runtimeState.switchOn ? 'open-gate-cell' : 'gate-cell');
					cell.textContent = runtimeState.switchOn ? '🔓' : '🚧';
				} else if (activeLevel.door && activeLevel.door.x === column && activeLevel.door.y === row) {
					cell.classList.add(runtimeState.hasKey ? 'open-gate-cell' : 'door-cell');
					cell.textContent = runtimeState.hasKey ? '🔓' : '🚪';
				} else if (activeLevel.key && activeLevel.key.x === column && activeLevel.key.y === row && !runtimeState.hasKey) {
					cell.textContent = '🔑';
				} else if (activeLevel.switch && activeLevel.switch.x === column && activeLevel.switch.y === row) {
					cell.textContent = runtimeState.switchOn ? '🟢' : '🔘';
				} else if (batteryIndex >= 0 && !(runtimeState.batteryMask & (1 << batteryIndex))) {
					cell.textContent = '🔋';
				} else if (portal) {
					cell.classList.add('portal-cell');
					cell.innerHTML = `<span class="portal-symbol">🌀</span><small>${portal.label}</small>`;
				} else if (column === activeLevel.target.x && row === activeLevel.target.y) {
					cell.classList.add('target-cell');
					cell.textContent = '🏆';
				}
			}

			if (isRobot) {
				const robotIcon = document.createElement('span');
				robotIcon.className = 'robot-icon';
				robotIcon.textContent = '🤖';
				const angles = [270, 0, 90, 180];
				robotIcon.style.transform = `rotate(${angles[runtimeState.dir]}deg)`;
				cell.appendChild(robotIcon);
			}
			mazeGrid.appendChild(cell);
		}
	}
	inventoryStatus.textContent = inventoryText();
}

function availableBlocksForLevel() {
	if (currentMode === 'daily' || currentMode === 'custom') return BLOCK_DEFINITIONS;
	return BLOCK_DEFINITIONS.filter((block) => block.unlockLevel <= activeLevel.number);
}

function renderBlockPalette() {
	blockPalette.replaceChildren();
	for (const block of availableBlocksForLevel()) {
		const button = document.createElement('button');
		button.type = 'button';
		button.className = `block-btn ${block.group}`;
		button.dataset.action = block.action;
		button.dataset.group = block.group;
		button.textContent = block.label;
		button.disabled = isRunning;
		blockPalette.appendChild(button);
	}
}

function renderWorkspace() {
	codeWorkspace.replaceChildren();
	if (instructions.length === 0) {
		emptyHint.style.display = 'block';
		codeWorkspace.appendChild(emptyHint);
	} else {
		emptyHint.style.display = 'none';
		instructions.forEach((instruction, index) => {
			const item = document.createElement('div');
			item.className = 'code-item';
			const label = document.createElement('span');
			label.textContent = `${index + 1}. ${instruction.label}`;
			const controls = document.createElement('span');
			controls.className = 'code-controls code-actions';
			for (const [command, symbol, title] of [['up', '↑', '上移'], ['down', '↓', '下移'], ['remove', '✕', '删除']]) {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = `icon-btn${command === 'remove' ? ' remove' : ''}`;
				button.dataset.command = command;
				button.dataset.index = String(index);
				button.textContent = symbol;
				button.title = title;
				button.disabled = isRunning || (command === 'up' && index === 0) || (command === 'down' && index === instructions.length - 1);
				controls.appendChild(button);
			}
			item.append(label, controls);
			codeWorkspace.appendChild(item);
		});
	}
	blockCounter.textContent = `${instructions.length} / ${activeLevel.blockBudget}`;
	blockCounter.className = `budget-number ${instructions.length <= activeLevel.blockBudget ? 'good' : instructions.length <= activeLevel.blockBudget + 4 ? 'warn' : 'over'}`;
}

function updateAttemptUI() {
	attemptStatus.textContent = `尝试 ${attemptCount} 次 · 提示 ${hintsUsed} 次`;
}

function resetRuntime() {
	runtimeState = createInitialState(activeLevel);
	renderGrid();
}

function initActiveLevel(level, clearProgram = true) {
	activeLevel = level;
	if (clearProgram) instructions = [];
	attemptCount = 0;
	sessionCrashCount = 0;
	hintsUsed = 0;
	resetRuntime();
	renderLevelHeader();
	renderBlockPalette();
	renderWorkspace();
	updateAttemptUI();
	btnBackEditor.hidden = currentMode !== 'custom';
	setMessage(currentMode === 'daily' ? '今日迷宫固定不变。完成后可以继续优化积木数量。' : currentMode === 'custom' ? '这是你的自建地图。运行前先观察所有机关的位置。' : '先观察机器人的朝向和机关，再从第一条积木开始编写程序。');
}

function showMode(mode) {
	currentMode = mode;
	modeButtons.forEach((button) => button.classList.toggle('active', button.dataset.mode === (mode === 'custom' ? 'editor' : mode)));
	progressShell.hidden = mode !== 'main';
	editorContainer.hidden = mode !== 'editor';
	gameContainer.hidden = mode === 'editor';
	btnResetProgress.hidden = mode !== 'main';

	if (mode === 'main') {
		modeSummary.textContent = '60关主线 · 四章递进学习';
		activeLevel = LEVELS[currentLevelIdx];
		currentChapterId = activeLevel.chapter.id;
		renderProgress();
		initActiveLevel(activeLevel, true);
	} else if (mode === 'daily') {
		const dateKey = localDateKey();
		if (!dailyLevelCache || dailyLevelDate !== dateKey) {
			dailyLevelDate = dateKey;
			dailyLevelCache = generateDailyLevel(dateKey);
		}
		modeSummary.textContent = `${dateKey} · 每天一张固定综合地图`;
		initActiveLevel(dailyLevelCache, true);
	} else if (mode === 'editor') {
		modeSummary.textContent = '设计、验证、分享并测试自己的迷宫';
		editorSize.value = String(editorMap.size);
		renderEditorToolbar();
		renderEditorGrid();
		setEditorMessage('选择工具后点击格子放置元素。完成后先验证，再进入测试。');
	} else if (mode === 'custom' && customLevel) {
		modeSummary.textContent = '自建地图测试模式';
		initActiveLevel(customLevel, true);
	}
}

function saveLevelResult(index, stars, blockCount, executionSteps) {
	const previous = getLevelRecord(index);
	progress.levels[String(index)] = {
		stars: Math.max(stars, Number(previous?.stars) || 0),
		bestBlocks: previous?.bestBlocks ? Math.min(previous.bestBlocks, blockCount) : blockCount,
		bestSteps: previous?.bestSteps ? Math.min(previous.bestSteps, executionSteps) : executionSteps
	};
	if (index < TOTAL_LEVELS - 1) progress.unlockedLevel = Math.max(progress.unlockedLevel, index + 1);
	progress.lastLevel = index;
	saveProgress();
}

function saveDailyResult(stars, blockCount, executionSteps) {
	const key = localDateKey();
	const previous = progress.daily[key];
	progress.daily[key] = {
		stars: Math.max(stars, Number(previous?.stars) || 0),
		bestBlocks: previous?.bestBlocks ? Math.min(previous.bestBlocks, blockCount) : blockCount,
		bestSteps: previous?.bestSteps ? Math.min(previous.bestSteps, executionSteps) : executionSteps
	};
	saveProgress();
}

function skillRequirementsMet(level, program) {
	const skills = programSkills(program.map((item) => item.action ?? item));
	return (!level.requiredSkills.condition || skills.condition) && (!level.requiredSkills.loop || skills.loop);
}

function calculateStars(level, program, executionSteps) {
	const blockCount = program.length;
	const skillMet = skillRequirementsMet(level, program);
	let stars = 1;
	if (blockCount <= level.blockBudget && skillMet) stars = 2;
	if (blockCount <= level.blockBudget && skillMet && executionSteps <= level.parSteps + 2 && hintsUsed === 0 && sessionCrashCount === 0) stars = 3;
	return { stars, skillMet };
}

function setRunningState(running) {
	isRunning = running;
	btnRun.textContent = running ? '⏹ 停止运行' : '▶ 从起点运行';
	btnReset.disabled = running;
	btnHint.disabled = running;
	speedSelect.disabled = running;
	modeButtons.forEach((button) => { button.disabled = running; });
	blockPalette.querySelectorAll('button').forEach((button) => { button.disabled = running; });
	renderWorkspace();
	if (currentMode === 'main') renderProgress();
}

function sleep(milliseconds) {
	return new Promise((resolve) => window.setTimeout(resolve, milliseconds));
}

async function animateMovement(movement, delay, runStats) {
	for (const state of movement.trail) {
		if (runCancelled) return false;
		runtimeState = cloneState(state);
		renderGrid();
		await sleep(Math.max(70, Math.floor(delay / Math.max(1, movement.trail.length))));
	}
	runStats.executionSteps += Math.max(1, movement.traveled);
	return true;
}

async function executeInstruction(instruction, level, delay, runStats) {
	const action = instruction.action;
	if (action === 'MOVE') {
		const movement = simulateMoveState(level, runtimeState);
		if (!movement) return 'crash';
		if (!(await animateMovement(movement, delay, runStats))) return 'cancelled';
		return isSuccessState(level, runtimeState) ? 'success' : 'continue';
	}
	if (action === 'TURN_RIGHT' || action === 'TURN_LEFT' || action === 'TURN_AROUND') {
		if (action === 'TURN_RIGHT') runtimeState.dir = (runtimeState.dir + 1) % 4;
		else if (action === 'TURN_LEFT') runtimeState.dir = (runtimeState.dir + 3) % 4;
		else runtimeState.dir = (runtimeState.dir + 2) % 4;
		runStats.executionSteps++;
		renderGrid();
		await sleep(delay);
		return 'continue';
	}
	if (action === 'IF_WALL_RIGHT' || action === 'IF_WALL_LEFT') {
		const nextX = runtimeState.x + DIRECTIONS[runtimeState.dir].dx;
		const nextY = runtimeState.y + DIRECTIONS[runtimeState.dir].dy;
		if (isBlockedForState(level, runtimeState, nextX, nextY)) {
			runtimeState.dir = action === 'IF_WALL_RIGHT' ? (runtimeState.dir + 1) % 4 : (runtimeState.dir + 3) % 4;
		}
		runStats.executionSteps++;
		renderGrid();
		await sleep(delay);
		return 'continue';
	}
	if (action.startsWith('REPEAT_MOVE_')) {
		const count = Number.parseInt(action.split('_').pop(), 10);
		for (let step = 0; step < count; step++) {
			if (runCancelled) return 'cancelled';
			const movement = simulateMoveState(level, runtimeState);
			if (!movement) return 'crash';
			if (!(await animateMovement(movement, delay, runStats))) return 'cancelled';
			if (isSuccessState(level, runtimeState)) return 'success';
		}
		return 'continue';
	}
	if (action === 'MOVE_UNTIL_BLOCKED') {
		let safety = level.size * level.size;
		while (safety-- > 0) {
			if (runCancelled) return 'cancelled';
			const movement = simulateMoveState(level, runtimeState);
			if (!movement) break;
			if (!(await animateMovement(movement, delay, runStats))) return 'cancelled';
			if (isSuccessState(level, runtimeState)) return 'success';
		}
		return 'continue';
	}
	return 'continue';
}

function suggestedProgramText(level, limit = null) {
	const actions = limit === null ? level.suggestedProgram : level.suggestedProgram.slice(0, limit);
	return actions.map((action, index) => `${index + 1}. ${actionLabel(action)}`).join(' → ');
}

function showNextHint() {
	hintsUsed++;
	updateAttemptUI();
	if (hintsUsed === 1) {
		setMessage(`提示1：本关包含“${activeLevel.featureText}”。先找出必须最先触发或收集的机关。`, 'hint');
	} else if (hintsUsed === 2) {
		setMessage(`提示2：参考程序的前三个积木是：${suggestedProgramText(activeLevel, 3)}`, 'hint');
	} else {
		setMessage(`完整参考程序：${suggestedProgramText(activeLevel)}。使用完整提示仍可通关，但本次无法获得3星。`, 'hint');
	}
}

function renderEditorToolbar() {
	editorToolbar.replaceChildren();
	for (const tool of EDITOR_TOOLS) {
		const button = document.createElement('button');
		button.type = 'button';
		button.className = `editor-tool${editorTool === tool.id ? ' active' : ''}`;
		button.dataset.tool = tool.id;
		button.textContent = tool.label;
		editorToolbar.appendChild(button);
	}
}

function pointExists(list, x, y) {
	return list.some((point) => point.x === x && point.y === y);
}

function removePoint(list, x, y) {
	return list.filter((point) => point.x !== x || point.y !== y);
}

function clearEditorCell(x, y) {
	editorMap.walls = removePoint(editorMap.walls, x, y);
	editorMap.ice = removePoint(editorMap.ice, x, y);
	editorMap.batteries = removePoint(editorMap.batteries, x, y);
	editorMap.gates = removePoint(editorMap.gates, x, y);
	if (samePosition(editorMap.key, { x, y })) editorMap.key = null;
	if (samePosition(editorMap.door, { x, y })) editorMap.door = null;
	if (samePosition(editorMap.switch, { x, y })) editorMap.switch = null;
	if (samePosition(editorMap.portals[0], { x, y })) editorMap.portals[0] = null;
	if (samePosition(editorMap.portals[1], { x, y })) editorMap.portals[1] = null;
}

function paintEditorCell(x, y) {
	const point = { x, y };
	if (editorTool === 'FLOOR') {
		clearEditorCell(x, y);
	} else if (editorTool === 'START') {
		clearEditorCell(x, y);
		editorMap.start = { x, y, dir: editorMap.start?.dir ?? 1 };
	} else if (editorTool === 'TARGET') {
		clearEditorCell(x, y);
		editorMap.target = point;
	} else if (editorTool === 'ICE') {
		if (pointExists(editorMap.walls, x, y)) return setEditorMessage('冰面不能放在墙壁上。', 'error');
		editorMap.ice = pointExists(editorMap.ice, x, y) ? removePoint(editorMap.ice, x, y) : [...editorMap.ice, point];
	} else if (editorTool === 'BATTERY') {
		if (editorMap.batteries.length >= 3 && !pointExists(editorMap.batteries, x, y)) return setEditorMessage('自建地图最多放置3枚电池。', 'error');
		clearEditorCell(x, y);
		editorMap.batteries = [...editorMap.batteries, point];
	} else {
		if (samePosition(editorMap.start, point) || samePosition(editorMap.target, point)) return setEditorMessage('请先把起点或终点移动到其他格子。', 'error');
		clearEditorCell(x, y);
		if (editorTool === 'WALL') editorMap.walls.push(point);
		else if (editorTool === 'KEY') editorMap.key = point;
		else if (editorTool === 'DOOR') editorMap.door = point;
		else if (editorTool === 'SWITCH') editorMap.switch = point;
		else if (editorTool === 'GATE') editorMap.gates = [...editorMap.gates, point].slice(-3);
		else if (editorTool === 'PORTAL_A') editorMap.portals[0] = { ...point, label: 'A' };
		else if (editorTool === 'PORTAL_B') editorMap.portals[1] = { ...point, label: 'B' };
	}
	saveEditorDraft();
	renderEditorGrid();
	setEditorMessage('地图已更新。点击“验证地图”检查是否可完成。');
}

function renderEditorGrid() {
	editorGrid.replaceChildren();
	editorGrid.style.gridTemplateColumns = `repeat(${editorMap.size}, 1fr)`;
	editorGrid.style.gridTemplateRows = `repeat(${editorMap.size}, 1fr)`;
	for (let row = 0; row < editorMap.size; row++) {
		for (let column = 0; column < editorMap.size; column++) {
			const cell = document.createElement('button');
			cell.type = 'button';
			cell.className = 'maze-cell editor-cell';
			cell.dataset.x = String(column);
			cell.dataset.y = String(row);
			cellBaseStyle(cell, row, column);
			const point = { x: column, y: row };
			if (pointExists(editorMap.walls, column, row)) cell.textContent = '🧱';
			else if (samePosition(editorMap.start, point)) cell.textContent = '🤖';
			else if (samePosition(editorMap.target, point)) cell.textContent = '🏆';
			else if (samePosition(editorMap.key, point)) cell.textContent = '🔑';
			else if (samePosition(editorMap.door, point)) cell.textContent = '🚪';
			else if (samePosition(editorMap.switch, point)) cell.textContent = '🔘';
			else if (pointExists(editorMap.gates, column, row)) cell.textContent = '🚧';
			else if (pointExists(editorMap.batteries, column, row)) cell.textContent = '🔋';
			else if (samePosition(editorMap.portals[0], point)) cell.innerHTML = '<span>🌀</span><small>A</small>';
			else if (samePosition(editorMap.portals[1], point)) cell.innerHTML = '<span>🌀</span><small>B</small>';
			else if (pointExists(editorMap.ice, column, row)) cell.textContent = '🧊';
			editorGrid.appendChild(cell);
		}
	}
}

modeButtons.forEach((button) => {
	button.addEventListener('click', () => {
		if (isRunning) return;
		showMode(button.dataset.mode);
	});
});

chapterTabs.addEventListener('click', (event) => {
	const button = event.target.closest('.chapter-btn');
	if (!button || button.disabled || isRunning) return;
	const chapterId = Number.parseInt(button.dataset.chapter ?? '', 10);
	if (!Number.isInteger(chapterId)) return;
	currentChapterId = chapterId;
	renderProgress();
});

levelPicker.addEventListener('click', (event) => {
	const button = event.target.closest('.level-btn');
	if (!button || button.disabled || isRunning) return;
	const index = Number.parseInt(button.dataset.level ?? '', 10);
	if (!Number.isInteger(index)) return;
	currentLevelIdx = index;
	progress.lastLevel = index;
	saveProgress();
	currentChapterId = LEVELS[index].chapter.id;
	activeLevel = LEVELS[index];
	renderProgress();
	initActiveLevel(activeLevel, true);
});

blockPalette.addEventListener('click', (event) => {
	const button = event.target.closest('.block-btn');
	if (!button || button.disabled || isRunning) return;
	if (instructions.length >= MAX_INSTRUCTIONS) return setMessage(`最多可以添加 ${MAX_INSTRUCTIONS} 个积木。请删除或压缩重复指令。`, 'error');
	const action = button.dataset.action;
	if (!action) return;
	instructions.push({ action, label: button.textContent.trim() });
	renderWorkspace();
});

codeWorkspace.addEventListener('click', (event) => {
	if (isRunning) return;
	const button = event.target.closest('.icon-btn');
	if (!button) return;
	const index = Number.parseInt(button.dataset.index ?? '', 10);
	if (!Number.isInteger(index) || index < 0 || index >= instructions.length) return;
	const command = button.dataset.command;
	if (command === 'remove') instructions.splice(index, 1);
	else if (command === 'up' && index > 0) [instructions[index - 1], instructions[index]] = [instructions[index], instructions[index - 1]];
	else if (command === 'down' && index < instructions.length - 1) [instructions[index], instructions[index + 1]] = [instructions[index + 1], instructions[index]];
	renderWorkspace();
});

btnRun.addEventListener('click', async () => {
	if (isRunning) {
		runCancelled = true;
		return;
	}
	if (instructions.length === 0) return setMessage('请先添加至少一个编程积木。', 'error');
	const level = activeLevel;
	const program = instructions.map((instruction) => ({ ...instruction }));
	const delay = Number.parseInt(speedSelect.value, 10) || 360;
	const runStats = { executionSteps: 0 };
	let outcome = 'incomplete';
	attemptCount++;
	updateAttemptUI();
	runCancelled = false;
	resetRuntime();
	setRunningState(true);
	setMessage('机器人正在从起点执行程序……');
	try {
		await sleep(Math.min(delay, 220));
		for (const instruction of program) {
			if (runCancelled || activeLevel !== level) {
				outcome = 'cancelled';
				break;
			}
			outcome = await executeInstruction(instruction, level, delay, runStats);
			if (outcome !== 'continue') break;
		}
		if (outcome === 'continue') outcome = isSuccessState(level, runtimeState) ? 'success' : 'incomplete';
	} finally {
		setRunningState(false);
	}

	if (outcome === 'success') {
		const rating = calculateStars(level, program, runStats.executionSteps);
		if (currentMode === 'main') {
			saveLevelResult(currentLevelIdx, rating.stars, program.length, runStats.executionSteps);
			renderProgress();
		} else if (currentMode === 'daily') {
			saveDailyResult(rating.stars, program.length, runStats.executionSteps);
		}
		renderLevelHeader();
		setMessage(`🎉 通关成功！获得 ${'⭐'.repeat(rating.stars)}。使用 ${program.length} 个积木，执行 ${runStats.executionSteps} 步。${!rating.skillMet ? ' 若使用本关推荐的判断或循环积木，可以获得更高评价。' : rating.stars < 3 ? ' 继续优化程序可以挑战3星。' : ' 完美算法！'}`, 'success');
	} else if (outcome === 'crash') {
		sessionCrashCount++;
		setMessage('💥 机器人撞到了墙壁、未开启的门或机关门。调整程序后再试一次。', 'error');
	} else if (outcome === 'cancelled') {
		setMessage('运行已停止。你可以修改程序后重新运行。');
	} else if (runtimeState.x === level.target.x && runtimeState.y === level.target.y && !requirementsMetState(level, runtimeState)) {
		setMessage('🔐 已到达终点，但钥匙、开关或电池任务尚未完成。', 'error');
	} else {
		setMessage('🤔 程序执行结束，但机器人还没有完成任务。继续调整代码。');
	}
});

btnReset.addEventListener('click', () => {
	if (isRunning) return;
	instructions = [];
	attemptCount = 0;
	sessionCrashCount = 0;
	hintsUsed = 0;
	resetRuntime();
	renderWorkspace();
	updateAttemptUI();
	setMessage('已清空程序并把机器人放回起点。');
});

btnHint.addEventListener('click', () => {
	if (!isRunning) showNextHint();
});

btnBackEditor.addEventListener('click', () => {
	if (!isRunning) showMode('editor');
});

btnResetProgress.addEventListener('click', () => {
	if (isRunning) return;
	if (!window.confirm('确定要清除全部主线、每日挑战和最佳成绩吗？此操作无法撤销。')) return;
	progress = defaultProgress();
	saveProgress();
	currentLevelIdx = 0;
	currentChapterId = 1;
	showMode('main');
});

editorToolbar.addEventListener('click', (event) => {
	const button = event.target.closest('.editor-tool');
	if (!button) return;
	editorTool = button.dataset.tool;
	renderEditorToolbar();
});

editorGrid.addEventListener('click', (event) => {
	const cell = event.target.closest('.editor-cell');
	if (!cell) return;
	const x = Number.parseInt(cell.dataset.x, 10);
	const y = Number.parseInt(cell.dataset.y, 10);
	if (Number.isInteger(x) && Number.isInteger(y)) paintEditorCell(x, y);
});

editorSize.addEventListener('change', () => {
	const size = Number.parseInt(editorSize.value, 10);
	if (![5, 7, 9].includes(size)) return;
	if (!window.confirm('改变地图尺寸会清空当前自建地图，是否继续？')) {
		editorSize.value = String(editorMap.size);
		return;
	}
	editorMap = createEditorMap(size);
	saveEditorDraft();
	renderEditorGrid();
	setEditorMessage(`已创建 ${size}×${size} 空白地图。`);
});

btnEditorValidate.addEventListener('click', () => {
	const result = validateCustomMap(editorMap);
	if (!result.valid) setEditorMessage(`验证失败：${result.errors.join('；')}`, 'error');
	else setEditorMessage(`✅ 地图可完成。参考程序约 ${result.level.suggestedProgram.length} 个积木，机关：${result.level.featureText}。`, 'success');
});

btnEditorPlay.addEventListener('click', () => {
	const result = validateCustomMap(editorMap);
	if (!result.valid) return setEditorMessage(`无法测试：${result.errors.join('；')}`, 'error');
	customLevel = result.level;
	showMode('custom');
});

btnEditorClear.addEventListener('click', () => {
	if (!window.confirm('确定清空当前自建地图吗？')) return;
	editorMap = createEditorMap(editorMap.size);
	saveEditorDraft();
	renderEditorGrid();
	shareCode.value = '';
	setEditorMessage('自建地图已清空。');
});

btnEditorExport.addEventListener('click', async () => {
	const result = validateCustomMap(editorMap);
	if (!result.valid) return setEditorMessage(`导出前请先修复：${result.errors.join('；')}`, 'error');
	const code = encodeMapShareCode(editorMap);
	shareCode.value = code;
	try {
		await navigator.clipboard.writeText(code);
		setEditorMessage('✅ 分享码已生成并复制到剪贴板。', 'success');
	} catch {
		setEditorMessage('✅ 分享码已生成，请手动复制文本框内容。', 'success');
	}
});

btnEditorImport.addEventListener('click', () => {
	try {
		editorMap = decodeMapShareCode(shareCode.value);
		editorSize.value = String(editorMap.size);
		saveEditorDraft();
		renderEditorGrid();
		const result = validateCustomMap(editorMap);
		setEditorMessage(result.valid ? '✅ 分享地图已导入，并通过可解性验证。' : `地图已导入，但需要调整：${result.errors.join('；')}`, result.valid ? 'success' : 'error');
	} catch (error) {
		setEditorMessage(`导入失败：${error instanceof Error ? error.message : '分享码无法解析'}`, 'error');
	}
});

showMode('main');

		</script>
	</body>
</html>
