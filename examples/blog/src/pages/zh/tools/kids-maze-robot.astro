---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: '儿童编程互动游戏：智能机器人迷宫大逃脱 V2（60关＋每日挑战＋自建地图）',
	description: '免安装儿童编程游戏。挑战60关主线、钥匙门禁、开关机关、冰面、传送门、每日挑战和可分享的自建地图。',
	icon: '🤖',
	tag: '儿童编程',
	keywords: '儿童编程游戏 机器人迷宫 自建地图 每日挑战 冰面 传送门 条件判断 循环指令 少儿编程 STEM',
	pinned: true,
	priority: 85
};

const pageTitle = `儿童编程互动游戏：智能机器人迷宫大逃脱 V2 — ${SITE_TITLE}`;
const pageDescription = '挑战60关机器人编程迷宫，并体验钥匙门禁、开关、冰面、传送门、每日挑战和自建地图分享。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1120px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}

			.tool-header {
				text-align: center;
				margin-bottom: 1.25rem;
			}

			.tool-header h1 {
				font-size: clamp(1.8rem, 4vw, 2.35rem);
				font-weight: 850;
				margin: 0 0 0.35em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.tool-header p {
				color: var(--text-muted);
				font-size: 0.96rem;
				margin: 0;
			}

			.progress-shell {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 18px;
				padding: 1rem;
				margin-bottom: 1rem;
				box-shadow: 0 7px 24px rgba(0, 0, 0, 0.08);
			}

			.progress-top {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 0.8rem;
			}

			.progress-title {
				font-weight: 800;
				color: var(--text-main);
			}

			.progress-summary {
				font-size: 0.86rem;
				font-weight: 750;
				color: var(--text-muted);
			}

			.progress-track {
				height: 9px;
				border-radius: 99px;
				background: var(--search-bg);
				overflow: hidden;
				margin-bottom: 1rem;
			}

			.progress-fill {
				height: 100%;
				width: 0;
				border-radius: inherit;
				background: linear-gradient(90deg, #3b82f6, #8b5cf6, #10b981);
				transition: width 0.3s ease;
			}

			.chapter-tabs {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 0.65rem;
			}

			.chapter-btn {
				border: 1px solid var(--card-border);
				background: var(--search-bg);
				color: var(--text-main);
				border-radius: 12px;
				padding: 0.75rem;
				cursor: pointer;
				text-align: left;
				transition: transform 0.18s ease, border-color 0.18s ease;
			}

			.chapter-btn:hover:not(:disabled) {
				transform: translateY(-2px);
				border-color: var(--accent);
			}

			.chapter-btn.active {
				border-color: #3b82f6;
				box-shadow: inset 0 0 0 1px #3b82f6;
			}

			.chapter-btn:disabled {
				cursor: not-allowed;
				opacity: 0.48;
			}

			.chapter-name {
				display: block;
				font-size: 0.84rem;
				font-weight: 850;
				margin-bottom: 0.25rem;
			}

			.chapter-stat {
				display: block;
				font-size: 0.74rem;
				color: var(--text-muted);
			}

			.level-picker {
				display: grid;
				grid-template-columns: repeat(15, minmax(0, 1fr));
				gap: 0.35rem;
				margin-top: 0.8rem;
			}

			.level-btn {
				aspect-ratio: 1 / 1;
				min-width: 0;
				border: 1px solid var(--card-border);
				border-radius: 8px;
				background: var(--search-bg);
				color: var(--text-main);
				font-size: 0.73rem;
				font-weight: 800;
				cursor: pointer;
				position: relative;
			}

			.level-btn.active {
				background: #2563eb;
				border-color: #2563eb;
				color: #fff;
			}

			.level-btn.locked {
				opacity: 0.45;
				cursor: not-allowed;
			}

			.level-stars {
				position: absolute;
				left: 50%;
				bottom: -0.18rem;
				transform: translateX(-50%);
				font-size: 0.46rem;
				white-space: nowrap;
				color: #f59e0b;
			}

			.game-container {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 370px;
				gap: 1.25rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.25rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
			}

			.stage-box,
			.editor-box {
				min-width: 0;
			}

			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.85rem;
			}

			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.75rem;
				width: 100%;
				background: var(--search-bg);
				padding: 0.7rem 0.85rem;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				box-sizing: border-box;
			}

			.level-heading {
				font-size: 0.9rem;
				font-weight: 850;
				color: var(--text-main);
			}

			.level-meta {
				display: flex;
				gap: 0.65rem;
				flex-wrap: wrap;
				justify-content: flex-end;
				font-size: 0.76rem;
				font-weight: 750;
				color: var(--text-muted);
			}

			.maze-grid {
				display: grid;
				gap: 2px;
				width: min(100%, 500px);
				aspect-ratio: 1 / 1;
				background: #090d16;
				border: 4px solid #3b82f6;
				border-radius: 16px;
				padding: 8px;
				box-sizing: border-box;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
				overflow: hidden;
			}

			.maze-cell {
				display: flex;
				align-items: center;
				justify-content: center;
				position: relative;
				user-select: none;
				box-sizing: border-box;
				border-radius: 4px;
				font-size: clamp(0.82rem, 4vw, 1.7rem);
				line-height: 1;
			}

			.robot-icon {
				transition: transform 0.16s ease-out;
				display: inline-block;
				filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.65));
				z-index: 3;
			}

			.tile-badge {
				position: absolute;
				right: 2px;
				bottom: 1px;
				font-size: 0.55em;
				font-weight: 900;
				color: #fff;
				text-shadow: 0 1px 2px #000;
			}

			.mission-card {
				width: 100%;
				box-sizing: border-box;
				border: 1px solid var(--card-border);
				background: var(--search-bg);
				border-radius: 12px;
				padding: 0.75rem 0.85rem;
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 0.5rem 1rem;
				font-size: 0.79rem;
			}

			.mission-title {
				font-weight: 850;
				color: var(--text-main);
			}

			.inventory {
				font-weight: 800;
				color: var(--text-muted);
				text-align: right;
			}

			.mission-description {
				grid-column: 1 / -1;
				color: var(--text-muted);
				line-height: 1.5;
			}

			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}

			.panel-title {
				font-size: 0.88rem;
				font-weight: 800;
				color: var(--text-main);
			}

			.block-palette {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.45rem;
			}

			.block-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.56rem 0.6rem;
				border-radius: 10px;
				font-size: 0.76rem;
				font-weight: 750;
				cursor: pointer;
				display: flex;
				align-items: center;
				gap: 0.3rem;
				transition: transform 0.18s ease, border-color 0.18s ease;
				text-align: left;
			}

			.block-btn:hover:not(:disabled) {
				transform: translateY(-2px);
				border-color: var(--accent);
			}

			.block-btn[data-group="move"] { border-left: 4px solid #3b82f6; }
			.block-btn[data-group="turn"] { border-left: 4px solid #f59e0b; }
			.block-btn[data-group="condition"] { border-left: 4px solid #8b5cf6; }
			.block-btn[data-group="loop"] { border-left: 4px solid #10b981; }

			.palette-note {
				font-size: 0.72rem;
				color: var(--text-muted);
				line-height: 1.45;
			}

			.code-workspace {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.7rem;
				min-height: 190px;
				max-height: 255px;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}

			.code-item {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 0.42rem 0.5rem 0.42rem 0.65rem;
				font-size: 0.79rem;
				font-weight: 650;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.45rem;
			}

			.code-label {
				min-width: 0;
				overflow-wrap: anywhere;
			}

			.code-actions {
				display: flex;
				gap: 0.15rem;
				flex: 0 0 auto;
			}

			.icon-btn {
				border: none;
				background: transparent;
				color: var(--text-muted);
				cursor: pointer;
				font-size: 0.86rem;
				font-weight: 900;
				line-height: 1;
				padding: 0.22rem;
			}

			.icon-btn.remove {
				color: #ef4444;
			}

			.empty-hint {
				color: var(--text-muted);
				font-size: 0.78rem;
				text-align: center;
				margin: auto;
				line-height: 1.55;
			}

			.budget-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				font-size: 0.76rem;
				font-weight: 750;
				color: var(--text-muted);
			}

			.budget-number.good { color: #10b981; }
			.budget-number.warn { color: #f59e0b; }
			.budget-number.over { color: #ef4444; }

			.action-bar {
				display: grid;
				grid-template-columns: 1.3fr 1fr 1fr;
				gap: 0.5rem;
			}

			.btn {
				padding: 0.72rem 0.55rem;
				border-radius: 11px;
				font-weight: 800;
				font-size: 0.82rem;
				cursor: pointer;
				border: 1px solid var(--card-border);
			}

			.btn-run {
				background: #2563eb;
				border-color: #2563eb;
				color: #fff;
			}

			.btn-secondary {
				background: var(--search-bg);
				color: var(--text-main);
			}

			.btn-hint {
				background: #7c3aed;
				border-color: #7c3aed;
				color: #fff;
			}

			button:disabled,
			select:disabled {
				cursor: not-allowed;
				opacity: 0.5;
			}

			.utility-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.7rem;
				font-size: 0.75rem;
				color: var(--text-muted);
			}

			.speed-select {
				background: var(--search-bg);
				color: var(--text-main);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 0.25rem 0.4rem;
			}

			.message-box {
				border-radius: 12px;
				border: 1px solid var(--card-border);
				background: var(--search-bg);
				padding: 0.75rem;
				font-size: 0.79rem;
				line-height: 1.55;
				color: var(--text-muted);
				min-height: 2.7rem;
			}

			.message-box.success {
				border-color: #10b981;
				background: rgba(16, 185, 129, 0.1);
				color: var(--text-main);
			}

			.message-box.error {
				border-color: #ef4444;
				background: rgba(239, 68, 68, 0.08);
				color: var(--text-main);
			}

			.message-box.hint {
				border-color: #8b5cf6;
				background: rgba(139, 92, 246, 0.09);
				color: var(--text-main);
			}

			.footer-tools {
				display: flex;
				justify-content: center;
				margin-top: 0.85rem;
			}

			.reset-progress {
				border: none;
				background: transparent;
				color: var(--text-muted);
				font-size: 0.72rem;
				text-decoration: underline;
				cursor: pointer;
			}

			@media (max-width: 920px) {
				.game-container {
					grid-template-columns: 1fr;
				}

				.chapter-tabs {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}

				.level-picker {
					grid-template-columns: repeat(8, minmax(0, 1fr));
				}
			}

			@media (max-width: 520px) {
				main {
					max-width: calc(100% - 1em);
					padding-left: 0.5em;
					padding-right: 0.5em;
				}

				.progress-top,
				.level-bar,
				.utility-row {
					align-items: flex-start;
					flex-direction: column;
				}

				.level-meta {
					justify-content: flex-start;
				}

				.level-picker {
					grid-template-columns: repeat(5, minmax(0, 1fr));
				}

				.block-palette {
					grid-template-columns: 1fr;
				}

				.action-bar {
					grid-template-columns: 1fr 1fr;
				}

				.btn-run {
					grid-column: 1 / -1;
				}
			}

			[hidden] { display: none !important; }

			.mode-shell {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 0.75rem;
				margin-bottom: 1rem;
				box-shadow: 0 6px 22px rgba(0, 0, 0, 0.07);
			}

			.mode-tabs {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.mode-btn {
				border: 1px solid var(--card-border);
				background: var(--search-bg);
				color: var(--text-main);
				border-radius: 10px;
				padding: 0.58rem 0.82rem;
				font-weight: 800;
				font-size: 0.8rem;
				cursor: pointer;
			}

			.mode-btn.active {
				background: #2563eb;
				border-color: #2563eb;
				color: #fff;
			}

			.mode-summary {
				font-size: 0.76rem;
				font-weight: 700;
				color: var(--text-muted);
				text-align: right;
			}

			.wall-cell {
				background: #0b1120 !important;
				border-color: #1e293b !important;
				box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.8);
			}

			.ice-cell {
				background: linear-gradient(135deg, rgba(125, 211, 252, 0.72), rgba(224, 242, 254, 0.38)) !important;
				border-color: #7dd3fc !important;
			}

			.target-cell {
				background: rgba(245, 158, 11, 0.28) !important;
				border: 2px dashed #f59e0b !important;
			}

			.door-cell,
			.gate-cell {
				background: rgba(239, 68, 68, 0.18) !important;
				border-color: #ef4444 !important;
			}

			.open-gate-cell {
				background: rgba(16, 185, 129, 0.18) !important;
				border-color: #10b981 !important;
			}

			.portal-cell {
				background: radial-gradient(circle, rgba(139, 92, 246, 0.58), rgba(49, 46, 129, 0.35)) !important;
				border-color: #a78bfa !important;
				flex-direction: column;
			}

			.portal-cell small,
			.editor-cell small {
				position: absolute;
				right: 2px;
				bottom: 1px;
				font-size: 0.5em;
				font-weight: 900;
				color: #fff;
				text-shadow: 0 1px 2px #000;
			}

			.portal-symbol { line-height: 1; }
			.block-btn.move { border-left: 4px solid #3b82f6; }
			.block-btn.turn { border-left: 4px solid #f59e0b; }
			.block-btn.condition { border-left: 4px solid #8b5cf6; }
			.block-btn.loop { border-left: 4px solid #10b981; }
			.code-controls { display: flex; gap: 0.15rem; }
			.back-editor {
				border: none;
				background: transparent;
				color: #2563eb;
				font-weight: 800;
				cursor: pointer;
			}

			.map-editor-shell {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 370px;
				gap: 1.25rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.25rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
			}

			.editor-canvas-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.8rem;
				min-width: 0;
			}

			.editor-topbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.8rem;
				width: 100%;
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.7rem 0.85rem;
				box-sizing: border-box;
				font-size: 0.8rem;
				font-weight: 800;
			}

			.editor-grid {
				width: min(100%, 520px);
				max-width: 520px;
			}

			.editor-cell {
				padding: 0;
				cursor: crosshair;
				font-family: inherit;
			}

			.editor-cell:hover {
				outline: 2px solid #60a5fa;
				outline-offset: -2px;
				z-index: 2;
			}

			.editor-side {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				min-width: 0;
			}

			.editor-toolbar {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.42rem;
			}

			.editor-tool {
				border: 1px solid var(--card-border);
				background: var(--search-bg);
				color: var(--text-main);
				border-radius: 9px;
				padding: 0.52rem;
				font-size: 0.75rem;
				font-weight: 750;
				cursor: pointer;
				text-align: left;
			}

			.editor-tool.active {
				border-color: #2563eb;
				box-shadow: inset 0 0 0 1px #2563eb;
				background: rgba(37, 99, 235, 0.1);
			}

			.editor-actions {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.5rem;
			}

			.editor-message {
				border: 1px solid var(--card-border);
				background: var(--search-bg);
				border-radius: 11px;
				padding: 0.7rem;
				font-size: 0.76rem;
				line-height: 1.5;
				color: var(--text-muted);
				min-height: 2.5rem;
			}

			.editor-message.success {
				border-color: #10b981;
				background: rgba(16, 185, 129, 0.09);
				color: var(--text-main);
			}

			.editor-message.error {
				border-color: #ef4444;
				background: rgba(239, 68, 68, 0.08);
				color: var(--text-main);
			}

			.share-code {
				width: 100%;
				min-height: 88px;
				resize: vertical;
				box-sizing: border-box;
				border: 1px solid var(--card-border);
				background: var(--code-bg);
				color: var(--text-main);
				border-radius: 10px;
				padding: 0.65rem;
				font-size: 0.7rem;
				line-height: 1.4;
			}

			.editor-help {
				font-size: 0.72rem;
				line-height: 1.55;
				color: var(--text-muted);
			}

			@media (max-width: 920px) {
				.map-editor-shell { grid-template-columns: 1fr; }
				.mode-shell { align-items: flex-start; flex-direction: column; }
				.mode-summary { text-align: left; }
			}

			@media (max-width: 520px) {
