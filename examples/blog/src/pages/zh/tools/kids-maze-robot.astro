	{ action: 'REPEAT_MOVE_4', label: '🔁 重复前进 4 次', group: 'loop', unlockLevel: 41 },
	{ action: 'MOVE_UNTIL_BLOCKED', label: '⏩ 前进直到受阻', group: 'loop', unlockLevel: 46 }
];

const EDITOR_TOOLS = [
	{ id: 'FLOOR', label: '⬜ 清除' },
	{ id: 'WALL', label: '🧱 墙壁' },
	{ id: 'START', label: '🤖 起点' },
	{ id: 'TARGET', label: '🏆 终点' },
	{ id: 'KEY', label: '🔑 钥匙' },
	{ id: 'DOOR', label: '🚪 门' },
	{ id: 'SWITCH', label: '🔘 开关' },
	{ id: 'GATE', label: '🚧 机关门' },
	{ id: 'ICE', label: '🧊 冰面' },
	{ id: 'PORTAL_A', label: '🌀 传送A' },
	{ id: 'PORTAL_B', label: '🌀 传送B' },
	{ id: 'BATTERY', label: '🔋 电池' }
];

function createRandom(seed) {
	let state = seed >>> 0;
	return function random() {
		state = (state + 0x6D2B79F5) >>> 0;
		let value = state;
		value = Math.imul(value ^ (value >>> 15), value | 1);
		value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
		return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
	};
}

function hashString(value) {
	let hash = 2166136261;
	for (let index = 0; index < value.length; index++) {
		hash ^= value.charCodeAt(index);
		hash = Math.imul(hash, 16777619);
	}
	return hash >>> 0;
}

function shuffle(values, random) {
	const result = [...values];
	for (let index = result.length - 1; index > 0; index--) {
		const swapIndex = Math.floor(random() * (index + 1));
		[result[index], result[swapIndex]] = [result[swapIndex], result[index]];
	}
	return result;
}

function positionKey(x, y) {
	return `${x},${y}`;
}

function samePosition(a, b) {
	return Boolean(a && b && a.x === b.x && a.y === b.y);
}

function getChapterByLevel(levelNum) {
	return CHAPTERS[Math.min(CHAPTERS.length - 1, Math.floor((levelNum - 1) / LEVELS_PER_CHAPTER))];
}

function reconstructPath(parent, targetKey) {
	const directions = [];
	let currentKey = targetKey;
	while (parent.has(currentKey)) {
		const node = parent.get(currentKey);
		directions.push(node.direction);
		currentKey = node.previous;
	}
	return directions.reverse();
}

function findShortestPath(size, walls, start, target) {
	const wallSet = walls instanceof Set ? walls : new Set(walls.map((wall) => positionKey(wall.x, wall.y)));
	const startKey = positionKey(start.x, start.y);
	const targetKey = positionKey(target.x, target.y);
	const queue = [{ x: start.x, y: start.y }];
	const visited = new Set([startKey]);
	const parent = new Map();
	let queueIndex = 0;

	while (queueIndex < queue.length) {
		const current = queue[queueIndex++];
		const currentKey = positionKey(current.x, current.y);
		if (currentKey === targetKey) return reconstructPath(parent, targetKey);

		for (let direction = 0; direction < DIRECTIONS.length; direction++) {
			const nextX = current.x + DIRECTIONS[direction].dx;
			const nextY = current.y + DIRECTIONS[direction].dy;
			const nextKey = positionKey(nextX, nextY);
			if (
				nextX < 0 || nextX >= size || nextY < 0 || nextY >= size ||
				wallSet.has(nextKey) || visited.has(nextKey)
			) continue;
			visited.add(nextKey);
			parent.set(nextKey, { previous: currentKey, direction });
			queue.push({ x: nextX, y: nextY });
		}
	}
	return null;
}

function countTurns(path) {
	let turns = 0;
	for (let index = 1; index < path.length; index++) {
		if (path[index] !== path[index - 1]) turns++;
	}
	return turns;
}

function pathPositions(start, directions) {
	const positions = [{ x: start.x, y: start.y }];
	let x = start.x;
	let y = start.y;
	for (const direction of directions) {
		x += DIRECTIONS[direction].dx;
		y += DIRECTIONS[direction].dy;
		positions.push({ x, y });
	}
	return positions;
}

function generateOpenMaze(levelNum, chapter, salt, usedSignatures) {
	const size = chapter.size;
	const start = { x: 0, y: 0, dir: 1 };
	const target = { x: size - 1, y: size - 1 };
	const localLevel = Math.max(1, levelNum - chapter.range[0] + 1);
	const isChapterOne = chapter.id === 1;
	const minWalls = isChapterOne ? Math.min(1 + Math.floor(localLevel / 3), 5) : 7 + Math.floor(localLevel / 4);
	const maxWalls = isChapterOne ? minWalls + 2 : minWalls + 4;
	const minPath = (size - 1) * 2 + (isChapterOne ? Math.floor(localLevel / 6) * 2 : 2 + Math.floor(localLevel / 5) * 2);
	const minTurns = isChapterOne ? 1 + Math.floor(localLevel / 6) : 3 + Math.floor(localLevel / 5);
	const availableCells = [];

	for (let y = 0; y < size; y++) {
		for (let x = 0; x < size; x++) {
			if ((x === start.x && y === start.y) || (x === target.x && y === target.y)) continue;
			availableCells.push({ x, y });
		}
	}

	for (let attempt = 0; attempt < 5000; attempt++) {
		const random = createRandom(levelNum * 500009 + salt * 104729 + attempt * 8191 + 777);
		const count = minWalls + Math.floor(random() * (maxWalls - minWalls + 1));
		const walls = shuffle(availableCells, random).slice(0, count);
		const signature = `${size}:` + walls.map((wall) => positionKey(wall.x, wall.y)).sort().join('|');
		if (usedSignatures?.has(signature)) continue;
		const path = findShortestPath(size, walls, start, target);
		if (!path || path.length < minPath || countTurns(path) < minTurns) continue;
		return { size, start, target, walls, path, signature };
	}
	return null;
}

function generatePerfectMaze(levelNum, chapter, salt, usedSignatures) {
	const size = chapter.size;
	const start = { x: 1, y: 1, dir: 1 };
	const target = { x: size - 2, y: size - 2 };
	const localLevel = Math.max(1, levelNum - chapter.range[0] + 1);
	const minPath = chapter.id === 3 ? 16 + Math.floor(localLevel / 5) * 2 : 18 + Math.floor(localLevel / 5) * 2;
	const minTurns = chapter.id === 3 ? 4 + Math.floor(localLevel / 6) : 5 + Math.floor(localLevel / 6);

	for (let attempt = 0; attempt < 3500; attempt++) {
		const random = createRandom(levelNum * 1000003 + salt * 130363 + attempt * 3571 + 2027);
		const open = new Set([positionKey(start.x, start.y)]);
		const visited = new Set([positionKey(start.x, start.y)]);
		const stack = [{ x: start.x, y: start.y }];

		while (stack.length > 0) {
			const current = stack[stack.length - 1];
			const candidates = shuffle([
				{ dx: 0, dy: -2 }, { dx: 2, dy: 0 },
				{ dx: 0, dy: 2 }, { dx: -2, dy: 0 }
			], random).filter((direction) => {
				const nx = current.x + direction.dx;
				const ny = current.y + direction.dy;
				return nx > 0 && nx < size - 1 && ny > 0 && ny < size - 1 && !visited.has(positionKey(nx, ny));
			});

			if (candidates.length === 0) {
				stack.pop();
				continue;
			}

			const chosen = candidates[0];
			const nx = current.x + chosen.dx;
			const ny = current.y + chosen.dy;
			open.add(positionKey(current.x + chosen.dx / 2, current.y + chosen.dy / 2));
			open.add(positionKey(nx, ny));
			visited.add(positionKey(nx, ny));
			stack.push({ x: nx, y: ny });
		}

		const walls = [];
		for (let y = 0; y < size; y++) {
			for (let x = 0; x < size; x++) {
				if (!open.has(positionKey(x, y))) walls.push({ x, y });
			}
		}
		const signature = `${size}:` + walls.map((wall) => positionKey(wall.x, wall.y)).join('|');
		if (usedSignatures?.has(signature)) continue;
		const path = findShortestPath(size, walls, start, target);
		if (!path || path.length < minPath || countTurns(path) < minTurns) continue;
		return { size, start, target, walls, path, signature };
	}
	return null;
}

function getFeatureProfile(levelNum, daily = false) {
	if (daily) {
		return { keyDoor: true, switchGate: true, ice: true, portal: true, batteries: 3 };
	}
	if (levelNum <= 20) return { keyDoor: false, switchGate: false, ice: false, portal: false, batteries: 0 };
	if (levelNum <= 25) return { keyDoor: false, switchGate: true, ice: false, portal: false, batteries: 0 };
	if (levelNum <= 30) return { keyDoor: true, switchGate: false, ice: false, portal: false, batteries: 0 };
	if (levelNum <= 35) return { keyDoor: false, switchGate: false, ice: true, portal: false, batteries: 0 };
	if (levelNum <= 40) return { keyDoor: false, switchGate: false, ice: false, portal: true, batteries: 0 };
	if (levelNum <= 45) return { keyDoor: false, switchGate: false, ice: true, portal: true, batteries: 0 };
	if (levelNum <= 50) return { keyDoor: true, switchGate: false, ice: false, portal: false, batteries: 1 + Math.floor((levelNum - 46) / 2) };
	if (levelNum <= 55) return { keyDoor: false, switchGate: true, ice: true, portal: false, batteries: 2 };
	return { keyDoor: true, switchGate: true, ice: true, portal: true, batteries: 3 };
}

function createLevelShell(number, chapter, base, title = null) {
	return {
		number,
		title: title ?? `第 ${number} 关`,
		chapter,
		size: base.size,
		start: { ...base.start },
		target: { ...base.target },
		walls: base.walls.map((wall) => ({ ...wall })),
		wallSet: new Set(base.walls.map((wall) => positionKey(wall.x, wall.y))),
		path: [...base.path],
		key: null,
		door: null,
		switch: null,
		gates: [],
		batteries: [],
		ice: [],
		iceSet: new Set(),
		portals: [],
		portalMap: new Map(),
		profile: null,
		requiredSkills: { condition: false, loop: false },
		isDaily: false,
		isCustom: false
	};
}

function pickPathIndex(positions, startIndex, endIndex, preferredIndex, reserved) {
	const start = Math.max(1, startIndex);
	const end = Math.min(positions.length - 2, endIndex);
	if (start > end) return -1;
	const candidates = [];
	for (let index = start; index <= end; index++) candidates.push(index);
	candidates.sort((a, b) => Math.abs(a - preferredIndex) - Math.abs(b - preferredIndex));
	return candidates.find((index) => !reserved.has(positionKey(positions[index].x, positions[index].y))) ?? -1;
}

function choosePortalPair(level, reserved) {
	const positions = pathPositions(level.start, level.path);
	const pathLength = level.path.length;
	const candidates = [];
	for (let entryIndex = 2; entryIndex < pathLength - 5; entryIndex++) {
		const incomingDirection = level.path[entryIndex - 1];
		for (let exitIndex = entryIndex + 3; exitIndex < pathLength - 1; exitIndex++) {
			const outgoingDirection = level.path[exitIndex];
			if (incomingDirection !== outgoingDirection) continue;
			const entry = positions[entryIndex];
			const exit = positions[exitIndex];
			if (reserved.has(positionKey(entry.x, entry.y)) || reserved.has(positionKey(exit.x, exit.y))) continue;
			const desiredEntry = pathLength * 0.28;
			const desiredExit = pathLength * 0.55;
			const score = Math.abs(entryIndex - desiredEntry) + Math.abs(exitIndex - desiredExit);
			candidates.push({ entryIndex, exitIndex, entry, exit, score });
		}
	}
	candidates.sort((a, b) => a.score - b.score);
	return candidates[0] ?? null;
}

function chooseIceCells(level, reserved, minimumIndex = 1) {
	const positions = pathPositions(level.start, level.path);
	const runs = [];
	let runStart = 0;
	while (runStart < level.path.length) {
		const direction = level.path[runStart];
		let runEnd = runStart + 1;
		while (runEnd < level.path.length && level.path[runEnd] === direction) runEnd++;
		const length = runEnd - runStart;
		if (length >= 3 && runStart >= minimumIndex) runs.push({ start: runStart, length });
		runStart = runEnd;
	}
	runs.sort((a, b) => b.length - a.length || a.start - b.start);
	for (const run of runs) {
		const cells = [];
		const iceLength = Math.min(3, run.length - 1);
		for (let offset = 1; offset <= iceLength; offset++) {
			const point = positions[run.start + offset];
			if (reserved.has(positionKey(point.x, point.y))) {
				cells.length = 0;
				break;
			}
			cells.push({ ...point });
		}
		if (cells.length >= 2) return cells;
	}
	return null;
}

function decorateLevel(level, profile) {
	level.profile = { ...profile };
	const positions = pathPositions(level.start, level.path);
	const reserved = new Set([
		positionKey(level.start.x, level.start.y),
		positionKey(level.target.x, level.target.y)
	]);
	let portalPair = null;
	if (profile.portal) {
		portalPair = choosePortalPair(level, reserved);
		if (!portalPair) return false;
		level.portals = [
			{ ...portalPair.entry, label: 'A' },
			{ ...portalPair.exit, label: 'B' }
		];
		reserved.add(positionKey(portalPair.entry.x, portalPair.entry.y));
		reserved.add(positionKey(portalPair.exit.x, portalPair.exit.y));
	}

	const earlyEnd = portalPair ? portalPair.entryIndex - 1 : Math.floor((positions.length - 1) * 0.42);
	const lateStart = portalPair ? portalPair.exitIndex + 1 : Math.floor((positions.length - 1) * 0.52);

	if (profile.keyDoor) {
		const keyIndex = pickPathIndex(positions, 1, Math.max(1, earlyEnd), Math.floor(earlyEnd * 0.55), reserved);
		const doorIndex = pickPathIndex(positions, lateStart, positions.length - 2, Math.floor((lateStart + positions.length - 2) / 2), reserved);
		if (keyIndex < 0 || doorIndex < 0 || keyIndex >= doorIndex) return false;
		level.key = { ...positions[keyIndex] };
		level.door = { ...positions[doorIndex] };
		reserved.add(positionKey(level.key.x, level.key.y));
		reserved.add(positionKey(level.door.x, level.door.y));
	}

	if (profile.switchGate) {
		const switchIndex = pickPathIndex(positions, 1, Math.max(1, earlyEnd), Math.floor(earlyEnd * 0.78), reserved);
		const gateIndex = pickPathIndex(positions, lateStart, positions.length - 2, Math.floor((lateStart * 2 + positions.length - 2) / 3), reserved);
		if (switchIndex < 0 || gateIndex < 0 || switchIndex >= gateIndex) return false;
		level.switch = { ...positions[switchIndex] };
		level.gates = [{ ...positions[gateIndex] }];
		reserved.add(positionKey(level.switch.x, level.switch.y));
		reserved.add(positionKey(level.gates[0].x, level.gates[0].y));
	}

	if (profile.batteries > 0) {
		for (let index = 0; index < profile.batteries; index++) {
			const ratio = (index + 1) / (profile.batteries + 1);
			const preferred = Math.floor(lateStart + (positions.length - 2 - lateStart) * ratio);
			const batteryIndex = pickPathIndex(positions, lateStart, positions.length - 2, preferred, reserved);
			if (batteryIndex < 0) return false;
			const battery = { ...positions[batteryIndex] };
			level.batteries.push(battery);
			reserved.add(positionKey(battery.x, battery.y));
		}
	}

	if (profile.ice) {
		const minimumIndex = portalPair ? Math.min(level.path.length - 3, portalPair.exitIndex + 1) : 1;
		let cells = chooseIceCells(level, reserved, minimumIndex);
		if (!cells) cells = chooseIceCells(level, reserved, 1);
		if (!cells) return false;
		level.ice = cells;
		for (const cell of cells) reserved.add(positionKey(cell.x, cell.y));
	}

	finalizeFeatureSets(level);
	return true;
}

function finalizeFeatureSets(level) {
	level.wallSet = new Set((level.walls ?? []).map((wall) => positionKey(wall.x, wall.y)));
	level.iceSet = new Set((level.ice ?? []).map((cell) => positionKey(cell.x, cell.y)));
	level.gateSet = new Set((level.gates ?? []).map((gate) => positionKey(gate.x, gate.y)));
	level.portalMap = new Map();
	if (level.portals?.length === 2) {
		const [first, second] = level.portals;
		level.portalMap.set(positionKey(first.x, first.y), { x: second.x, y: second.y, label: second.label });
		level.portalMap.set(positionKey(second.x, second.y), { x: first.x, y: first.y, label: first.label });
	}
}

function createInitialState(level) {
	return {
		x: level.start.x,
		y: level.start.y,
		dir: level.start.dir ?? 1,
		hasKey: false,
		switchOn: false,
		batteryMask: 0
	};
}

function cloneState(state) {
	return { ...state };
}

function batteryFullMask(level) {
	return level.batteries.length === 0 ? 0 : (1 << level.batteries.length) - 1;
}

function requirementsMetState(level, state) {
	if (level.key && !state.hasKey) return false;
	if (level.switch && !state.switchOn) return false;
	return state.batteryMask === batteryFullMask(level);
}

function isSuccessState(level, state) {
	return state.x === level.target.x && state.y === level.target.y && requirementsMetState(level, state);
}

function isBlockedForState(level, state, x, y) {
	if (x < 0 || x >= level.size || y < 0 || y >= level.size) return true;
	const key = positionKey(x, y);
	if (level.wallSet.has(key)) return true;
	if (level.door && samePosition(level.door, { x, y }) && !state.hasKey) return true;
	if (level.gateSet.has(key) && !state.switchOn) return true;
	return false;
}

function collectCellEffects(level, state) {
	if (level.key && state.x === level.key.x && state.y === level.key.y) state.hasKey = true;
	if (level.switch && state.x === level.switch.x && state.y === level.switch.y) state.switchOn = true;
	level.batteries.forEach((battery, index) => {
		if (state.x === battery.x && state.y === battery.y) state.batteryMask |= (1 << index);
	});
}

function simulateMoveState(level, originalState) {
	const state = cloneState(originalState);
	const trail = [];
	const moveOneTile = () => {
		const nextX = state.x + DIRECTIONS[state.dir].dx;
		const nextY = state.y + DIRECTIONS[state.dir].dy;
		if (isBlockedForState(level, state, nextX, nextY)) return { blocked: true, portal: false };
		state.x = nextX;
		state.y = nextY;
		collectCellEffects(level, state);
		trail.push(cloneState(state));
		const portalDestination = level.portalMap.get(positionKey(state.x, state.y));
		if (portalDestination) {
			state.x = portalDestination.x;
			state.y = portalDestination.y;
			collectCellEffects(level, state);
			trail.push(cloneState(state));
			return { blocked: false, portal: true };
		}
		return { blocked: false, portal: false };
	};

	const first = moveOneTile();
	if (first.blocked) return null;
	if (!first.portal) {
		let safety = level.size * level.size;
		while (level.iceSet.has(positionKey(state.x, state.y)) && safety-- > 0) {
			const nextX = state.x + DIRECTIONS[state.dir].dx;
			const nextY = state.y + DIRECTIONS[state.dir].dy;
			if (isBlockedForState(level, state, nextX, nextY)) break;
			const next = moveOneTile();
			if (next.portal) break;
			if (!level.iceSet.has(positionKey(state.x, state.y))) break;
		}
	}
	return { state, trail, traveled: trail.filter((item, index) => index === 0 || item.x !== trail[index - 1].x || item.y !== trail[index - 1].y).length };
}

function stateKey(state) {
	return `${state.x},${state.y},${state.dir},${state.hasKey ? 1 : 0},${state.switchOn ? 1 : 0},${state.batteryMask}`;
}

function solveLevel(level, maxStates = 180000) {
	const start = createInitialState(level);
	const startKey = stateKey(start);
	const queue = [start];
	const visited = new Set([startKey]);
	const parent = new Map();
	let queueIndex = 0;

	while (queueIndex < queue.length && visited.size <= maxStates) {
		const current = queue[queueIndex++];
		const currentKey = stateKey(current);
		if (isSuccessState(level, current)) {
			const actions = [];
			let key = currentKey;
			while (parent.has(key)) {
				const node = parent.get(key);
				actions.push(node.action);
				key = node.previous;
			}
			return actions.reverse();
		}

		const candidates = [
			{ action: 'TURN_LEFT', state: { ...current, dir: (current.dir + 3) % 4 } },
			{ action: 'TURN_RIGHT', state: { ...current, dir: (current.dir + 1) % 4 } }
		];
		const movement = simulateMoveState(level, current);
		if (movement) candidates.unshift({ action: 'MOVE', state: movement.state });

		for (const candidate of candidates) {
			const key = stateKey(candidate.state);
			if (visited.has(key)) continue;
			visited.add(key);
			parent.set(key, { previous: currentKey, action: candidate.action });
			queue.push(candidate.state);
		}
	}
	return null;
}

function actionLabel(action) {
	return BLOCK_DEFINITIONS.find((block) => block.action === action)?.label ?? action;
}

function canUseLoops(level) {
	return level.isDaily || level.isCustom || level.chapter.id >= 3;
}

function canUseConditions(level) {
	return level.isDaily || level.isCustom || level.chapter.id >= 2;
}

function buildSuggestedProgram(level, primitiveActions) {
	const tokens = [];
	let state = createInitialState(level);
	for (const action of primitiveActions) {
		if (action === 'MOVE') {
			tokens.push('MOVE');
			const movement = simulateMoveState(level, state);
			if (movement) state = movement.state;
			continue;
		}
		if (action === 'TURN_LEFT' || action === 'TURN_RIGHT') {
			const nextX = state.x + DIRECTIONS[state.dir].dx;
			const nextY = state.y + DIRECTIONS[state.dir].dy;
			const blocked = isBlockedForState(level, state, nextX, nextY);
			if (blocked && canUseConditions(level)) {
				tokens.push(action === 'TURN_LEFT' ? 'IF_WALL_LEFT' : 'IF_WALL_RIGHT');
			} else {
				tokens.push(action);
			}
			state.dir = action === 'TURN_LEFT' ? (state.dir + 3) % 4 : (state.dir + 1) % 4;
		}
	}

	if (!canUseLoops(level)) return tokens;
	const compressed = [];
	for (let index = 0; index < tokens.length;) {
		if (tokens[index] !== 'MOVE') {
			compressed.push(tokens[index++]);
			continue;
		}
		let end = index;
		while (end < tokens.length && tokens[end] === 'MOVE') end++;
		let count = end - index;
		while (count >= 4) {
			compressed.push('REPEAT_MOVE_4');
			count -= 4;
		}
		if (count === 3) compressed.push('REPEAT_MOVE_3');
		else if (count === 2) compressed.push('REPEAT_MOVE_2');
		else if (count === 1) compressed.push('MOVE');
		index = end;
	}
	return compressed;
}

function programSkills(program) {
	const actions = new Set(program);
	return {
		condition: actions.has('IF_WALL_LEFT') || actions.has('IF_WALL_RIGHT'),
		loop: [...actions].some((action) => action.startsWith('REPEAT_MOVE_')) || actions.has('MOVE_UNTIL_BLOCKED')
	};
}

function simulateProgram(level, program) {
	let state = createInitialState(level);
	let executionSteps = 0;
	for (const action of program) {
		if (action === 'TURN_LEFT' || action === 'TURN_RIGHT' || action === 'TURN_AROUND') {
			if (action === 'TURN_LEFT') state.dir = (state.dir + 3) % 4;
			else if (action === 'TURN_RIGHT') state.dir = (state.dir + 1) % 4;
			else state.dir = (state.dir + 2) % 4;
			executionSteps++;
			continue;
		}
		if (action === 'IF_WALL_LEFT' || action === 'IF_WALL_RIGHT') {
			const nextX = state.x + DIRECTIONS[state.dir].dx;
			const nextY = state.y + DIRECTIONS[state.dir].dy;
			if (isBlockedForState(level, state, nextX, nextY)) {
				state.dir = action === 'IF_WALL_LEFT' ? (state.dir + 3) % 4 : (state.dir + 1) % 4;
			}
			executionSteps++;
			continue;
		}
		const moveCount = action.startsWith('REPEAT_MOVE_') ? Number.parseInt(action.split('_').pop(), 10) : 1;
		if (action === 'MOVE_UNTIL_BLOCKED') {
			let safety = level.size * level.size;
			while (safety-- > 0) {
				const movement = simulateMoveState(level, state);
				if (!movement) break;
				state = movement.state;
				executionSteps += Math.max(1, movement.traveled);
				if (isSuccessState(level, state)) break;
			}
			continue;
		}
		for (let count = 0; count < moveCount; count++) {
			const movement = simulateMoveState(level, state);
			if (!movement) return { success: false, state, executionSteps, crashed: true };
			state = movement.state;
			executionSteps += Math.max(1, movement.traveled);
			if (isSuccessState(level, state)) break;
		}
	}
	return { success: isSuccessState(level, state), state, executionSteps, crashed: false };
}

function levelFeatureText(level) {
	const features = [];
	if (level.key) features.push('钥匙与门');
	if (level.switch) features.push('开关机关');
	if (level.ice.length) features.push('冰面滑行');
	if (level.portals.length) features.push('传送门');
	if (level.batteries.length) features.push(`${level.batteries.length}枚电池`);
	return features.length ? features.join('、') : '基础迷宫';
}

function finalizeGeneratedLevel(level, usedSignatures, signature) {
	finalizeFeatureSets(level);
	const primitive = solveLevel(level);
	if (!primitive) return false;
	const suggestedProgram = buildSuggestedProgram(level, primitive);
	const reference = simulateProgram(level, suggestedProgram);
	if (!reference.success || suggestedProgram.length > MAX_INSTRUCTIONS) return false;
	const skills = programSkills(suggestedProgram);
	level.suggestedProgram = suggestedProgram;
	level.blockBudget = Math.max(3, suggestedProgram.length + (level.chapter.id === 1 ? 2 : 1));
	level.parSteps = reference.executionSteps;
	level.requiredSkills = {
		condition: (level.chapter.id === 2 || level.chapter.id === 4 || level.isDaily) && skills.condition,
		loop: (level.chapter.id === 3 || level.chapter.id === 4 || level.isDaily) && skills.loop
	};
	const featureWeight = [level.key, level.switch, level.ice.length > 0, level.portals.length > 0, level.batteries.length > 0].filter(Boolean).length;
	level.difficulty = Math.min(5, Math.max(1, level.chapter.id + Math.floor(featureWeight / 2)));
	level.featureText = levelFeatureText(level);
	if (signature && usedSignatures) usedSignatures.add(signature);
	return true;
}

function generateLevel(levelNum, usedSignatures) {
	const chapter = getChapterByLevel(levelNum);
	const profile = getFeatureProfile(levelNum, false);
	for (let salt = 0; salt < 120; salt++) {
		const base = chapter.id <= 2
			? generateOpenMaze(levelNum, chapter, salt, usedSignatures)
			: generatePerfectMaze(levelNum, chapter, salt, usedSignatures);
		if (!base) continue;
		const level = createLevelShell(levelNum, chapter, base);
		if (!decorateLevel(level, profile)) continue;
		if (finalizeGeneratedLevel(level, usedSignatures, base.signature)) return level;
	}
	throw new Error(`无法稳定生成第 ${levelNum} 关`);
}

function localDateKey(date = new Date()) {
	const year = date.getFullYear();
	const month = String(date.getMonth() + 1).padStart(2, '0');
	const day = String(date.getDate()).padStart(2, '0');
	return `${year}-${month}-${day}`;
}

function generateDailyLevel(dateKey) {
	const seed = hashString(`robot-daily-${dateKey}`);
	const chapter = { ...CHAPTERS[3], name: '每日挑战', shortName: '每日挑战', id: 4, size: 9 };
	const profile = getFeatureProfile(60, true);
	for (let salt = 0; salt < 160; salt++) {
		const base = generatePerfectMaze(60, chapter, salt + (seed % 100003), null);
		if (!base) continue;
		const level = createLevelShell(0, chapter, base, `${dateKey} 每日挑战`);
		level.isDaily = true;
		if (!decorateLevel(level, profile)) continue;
		if (finalizeGeneratedLevel(level, null, null)) {
			level.difficulty = 5;
			return level;
		}
	}
	throw new Error('无法生成今日挑战');
}

const usedSignatures = new Set();
const LEVELS = Array.from({ length: TOTAL_LEVELS }, (_, index) => generateLevel(index + 1, usedSignatures));
let dailyLevelCache = null;
let dailyLevelDate = '';

function defaultProgress() {
	return {
		unlockedLevel: 0,
		levels: {},
		lastLevel: 0,
		daily: {}
	};
}

function loadProgress() {
	try {
		const raw = localStorage.getItem(STORAGE_KEY) ?? localStorage.getItem(LEGACY_STORAGE_KEY);
		if (!raw) return defaultProgress();
		const parsed = JSON.parse(raw);
		return {
			unlockedLevel: Math.max(0, Math.min(TOTAL_LEVELS - 1, Number(parsed.unlockedLevel) || 0)),
			levels: parsed.levels && typeof parsed.levels === 'object' ? parsed.levels : {},
			lastLevel: Math.max(0, Math.min(TOTAL_LEVELS - 1, Number(parsed.lastLevel) || 0)),
			daily: parsed.daily && typeof parsed.daily === 'object' ? parsed.daily : {}
		};
	} catch {
		return defaultProgress();
	}
}

function saveProgress() {
	try {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
	} catch {
		// 本地存储不可用时不阻止游戏运行。
	}
}

function createEditorMap(size = 7) {
	return {
		version: 2,
		size,
		start: { x: 0, y: 0, dir: 1 },
		target: { x: size - 1, y: size - 1 },
		walls: [],
		key: null,
		door: null,
		switch: null,
		gates: [],
		ice: [],
		portals: [null, null],
		batteries: []
	};
}

function sanitizeEditorMap(raw) {
	if (!raw || typeof raw !== 'object') throw new Error('地图数据格式不正确');
	const size = [5, 7, 9].includes(Number(raw.size)) ? Number(raw.size) : 7;
	const map = createEditorMap(size);
	const validPoint = (point) => point && Number.isInteger(point.x) && Number.isInteger(point.y) && point.x >= 0 && point.x < size && point.y >= 0 && point.y < size;
	const points = (values, limit = size * size) => Array.isArray(values) ? values.filter(validPoint).slice(0, limit).map((point) => ({ x: point.x, y: point.y })) : [];
	map.start = validPoint(raw.start) ? { x: raw.start.x, y: raw.start.y, dir: Number.isInteger(raw.start.dir) ? ((raw.start.dir % 4) + 4) % 4 : 1 } : map.start;
	map.target = validPoint(raw.target) ? { x: raw.target.x, y: raw.target.y } : map.target;
	map.walls = points(raw.walls);
	map.key = validPoint(raw.key) ? { x: raw.key.x, y: raw.key.y } : null;
	map.door = validPoint(raw.door) ? { x: raw.door.x, y: raw.door.y } : null;
	map.switch = validPoint(raw.switch) ? { x: raw.switch.x, y: raw.switch.y } : null;
	map.gates = points(raw.gates, 3);
	map.ice = points(raw.ice);
	map.batteries = points(raw.batteries, 3);
	if (Array.isArray(raw.portals)) {
		map.portals = [validPoint(raw.portals[0]) ? { ...raw.portals[0], label: 'A' } : null, validPoint(raw.portals[1]) ? { ...raw.portals[1], label: 'B' } : null];
	}
	return map;
}

function loadEditorDraft() {
	try {
		const raw = localStorage.getItem(EDITOR_DRAFT_KEY);
		return raw ? sanitizeEditorMap(JSON.parse(raw)) : createEditorMap(7);
	} catch {
		return createEditorMap(7);
	}
}

function saveEditorDraft() {
	try {
		localStorage.setItem(EDITOR_DRAFT_KEY, JSON.stringify(editorMap));
	} catch {
		// 忽略草稿保存失败。
	}
}

function editorMapToLevel(map) {
	const chapter = { ...CHAPTERS[3], name: '自建地图', shortName: '自建地图', id: 4, size: map.size };
	const path = findShortestPath(map.size, map.walls, map.start, map.target) ?? [];
	const base = { size: map.size, start: map.start, target: map.target, walls: map.walls, path };
	const level = createLevelShell(0, chapter, base, '自建地图测试');
	level.isCustom = true;
	level.key = map.key ? { ...map.key } : null;
	level.door = map.door ? { ...map.door } : null;
	level.switch = map.switch ? { ...map.switch } : null;
	level.gates = map.gates.map((gate) => ({ ...gate }));
	level.ice = map.ice.map((cell) => ({ ...cell }));
	level.batteries = map.batteries.map((battery) => ({ ...battery }));
	level.portals = map.portals.filter(Boolean).map((portal, index) => ({ x: portal.x, y: portal.y, label: index === 0 ? 'A' : 'B' }));
	finalizeFeatureSets(level);
	return level;
}

function validateCustomMap(map) {
	const errors = [];
	if (!map.start || !map.target) errors.push('必须设置起点和终点');
	if (samePosition(map.start, map.target)) errors.push('起点和终点不能重合');
	if (Boolean(map.key) !== Boolean(map.door)) errors.push('钥匙与门必须成对出现');
	if (Boolean(map.switch) !== (map.gates.length > 0)) errors.push('开关与机关门必须成对出现');
	if (Boolean(map.portals[0]) !== Boolean(map.portals[1])) errors.push('传送门A与B必须成对出现');

	const occupied = new Map();
	const register = (point, label, allowIce = false) => {
		if (!point) return;
		const key = positionKey(point.x, point.y);
		const existing = occupied.get(key);
		if (existing && !(allowIce && existing === '冰面')) errors.push(`${label}与${existing}发生重叠`);
		else if (!allowIce) occupied.set(key, label);
	};
	map.walls.forEach((point) => register(point, '墙壁'));
	register(map.start, '起点');
	register(map.target, '终点');
	register(map.key, '钥匙');
	register(map.door, '门');
	register(map.switch, '开关');
	map.gates.forEach((point) => register(point, '机关门'));
	map.batteries.forEach((point) => register(point, '电池'));
	map.portals.forEach((point) => register(point, '传送门'));
	map.ice.forEach((point) => {
		const key = positionKey(point.x, point.y);
		if (map.walls.some((wall) => samePosition(wall, point))) errors.push('冰面不能放在墙壁上');
		else if (!occupied.has(key)) occupied.set(key, '冰面');
	});
	if (errors.length) return { valid: false, errors };

	const level = editorMapToLevel(map);
	const primitive = solveLevel(level);
	if (!primitive) return { valid: false, errors: ['该地图目前没有可完成的路线，请调整墙壁或机关位置'] };
	const suggestedProgram = buildSuggestedProgram(level, primitive);
	const result = simulateProgram(level, suggestedProgram);
	if (!result.success) return { valid: false, errors: ['地图可达性验证失败，请简化机关组合'] };
	level.suggestedProgram = suggestedProgram;
	level.blockBudget = Math.max(3, suggestedProgram.length + 2);
	level.parSteps = result.executionSteps;
	level.requiredSkills = { condition: false, loop: false };
	level.difficulty = Math.min(5, 1 + Math.floor((map.walls.length + map.ice.length + map.batteries.length * 2 + map.gates.length * 2 + level.portals.length * 2) / 8));
	level.featureText = levelFeatureText(level);
	return { valid: true, level, primitive };
}

function bytesToBase64(bytes) {
	let binary = '';
	for (const byte of bytes) binary += String.fromCharCode(byte);
	return btoa(binary);
}

function base64ToBytes(value) {
	const binary = atob(value);
	return Uint8Array.from(binary, (character) => character.charCodeAt(0));
}

function encodeMapShareCode(map) {
	const json = JSON.stringify(map);
	return `RM2.${bytesToBase64(new TextEncoder().encode(json)).replaceAll('+', '-').replaceAll('/', '_').replaceAll('=', '')}`;
}

function decodeMapShareCode(code) {
	const trimmed = code.trim();
	if (!trimmed.startsWith('RM2.')) throw new Error('分享码不是RM2格式');
	let data = trimmed.slice(4).replaceAll('-', '+').replaceAll('_', '/');
	while (data.length % 4) data += '=';
	const json = new TextDecoder().decode(base64ToBytes(data));
	return sanitizeEditorMap(JSON.parse(json));
}

let progress = loadProgress();
let currentLevelIdx = Math.min(progress.lastLevel, progress.unlockedLevel);
let currentChapterId = LEVELS[currentLevelIdx].chapter.id;
let currentMode = 'main';
let activeLevel = LEVELS[currentLevelIdx];
let runtimeState = createInitialState(activeLevel);
let instructions = [];
let isRunning = false;
let runCancelled = false;
let attemptCount = 0;
let sessionCrashCount = 0;
let hintsUsed = 0;
let editorMap = loadEditorDraft();
let editorTool = 'WALL';
let customLevel = null;

const modeButtons = [...document.querySelectorAll('.mode-btn')];
const modeSummary = document.getElementById('modeSummary');
const progressShell = document.getElementById('progressShell');
const gameContainer = document.getElementById('gameContainer');
const editorContainer = document.getElementById('editorContainer');
const chapterTabs = document.getElementById('chapterTabs');
const levelPicker = document.getElementById('levelPicker');
const progressSummary = document.getElementById('progressSummary');
const progressFill = document.getElementById('progressFill');
const levelHeading = document.getElementById('levelHeading');
const difficultyStatus = document.getElementById('difficultyStatus');
const budgetStatus = document.getElementById('budgetStatus');
const bestStatus = document.getElementById('bestStatus');
const mazeGrid = document.getElementById('mazeGrid');
const missionTitle = document.getElementById('missionTitle');
const missionDescription = document.getElementById('missionDescription');
const inventoryStatus = document.getElementById('inventoryStatus');
const blockPalette = document.getElementById('blockPalette');
const paletteNote = document.getElementById('paletteNote');
const blockCounter = document.getElementById('blockCounter');
const codeWorkspace = document.getElementById('codeWorkspace');
const emptyHint = document.getElementById('emptyHint');
const btnRun = document.getElementById('btnRun');
const btnReset = document.getElementById('btnReset');
const btnHint = document.getElementById('btnHint');
const btnBackEditor = document.getElementById('btnBackEditor');
const btnResetProgress = document.getElementById('btnResetProgress');
