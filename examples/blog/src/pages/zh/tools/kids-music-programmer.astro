---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
    title: "儿童编程互动游戏：魔法音乐演奏家",
    description: "免安装！专为儿童设计的音乐算法编程游戏。通过组合音符积木、节奏音长与循环指令，用代码编排《小星星》与自创旋律，轻松建立编程与音乐双重思维！",
    icon: "🎵",
    tag: "儿童编程",
    keywords: "儿童编程游戏 音乐编程 声音算法 少儿编程体验 Web Audio 积木编程 STEM",
    pinned: true,
    priority: 86
};

const pageTitle = `儿童编程互动游戏：魔法音乐演奏家 — ${SITE_TITLE}`;
const pageDescription = "免安装！专为儿童设计的音乐算法编程游戏，用积木编排音乐旋律，感受代码的节奏之美。";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em 4em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 1.5em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 0.95rem;
			}

			/* 游戏主容器 */
			.game-container {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 1.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 1.5rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
				backdrop-filter: blur(12px);
			}

			@media (max-width: 850px) {
				.game-container {
					grid-template-columns: 1fr;
				}
			}

			/* 左侧：琴键与舞台区 */
			.stage-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1.2rem;
			}
			.level-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				background: var(--search-bg);
				padding: 0.6em 1em;
				border-radius: 12px;
				border: 1px solid var(--card-border);
				font-weight: 700;
				font-size: 0.92rem;
			}

			/* 琴键可视化显示 */
			.piano-keyboard {
				display: flex;
				justify-content: center;
				gap: 6px;
				width: 100%;
				max-width: 420px;
				height: 180px;
				background: #111827;
				border: 2px solid var(--card-border);
				border-radius: 16px;
				padding: 12px;
				box-sizing: border-box;
			}

			.key-item {
				flex: 1;
				background: #f9fafb;
				border-radius: 8px 8px 12px 12px;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				align-items: center;
				padding-bottom: 0.8rem;
				font-weight: 800;
				font-size: 0.9rem;
				color: #1f2937;
				cursor: pointer;
				transition: all 0.15s ease;
				box-shadow: inset 0 -4px 0 #d1d5db;
			}
			.key-item:hover {
				background: #f3f4f6;
			}
			.key-item.playing {
				background: #6366f1 !important;
				color: #ffffff;
				box-shadow: inset 0 -2px 0 #4338ca;
				transform: translateY(3px);
			}

			/* 右侧：代码面板 */
			.editor-box {
				display: flex;
				flex-direction: column;
				gap: 0.9rem;
			}

			.panel-title {
				font-size: 0.9rem;
				font-weight: 700;
				color: var(--text-main);
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			/* 音符积木选择网格 */
			.note-palette {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.4rem;
			}

			.note-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.5em 0.2em;
				border-radius: 8px;
				font-size: 0.82rem;
				font-weight: 800;
				cursor: pointer;
				text-align: center;
				transition: all 0.2s ease;
			}
			.note-btn:hover {
				border-color: var(--accent);
				transform: translateY(-2px);
			}

			.control-palette {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.5rem;
			}

			.ctrl-btn {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.5em 0.7em;
				border-radius: 10px;
				font-size: 0.82rem;
				font-weight: 700;
				cursor: pointer;
				display: flex;
				align-items: center;
				gap: 0.3rem;
			}
			.ctrl-btn:hover { border-color: var(--accent); }
			.ctrl-btn.purple { border-left: 4px solid #8b5cf6; }
			.ctrl-btn.amber { border-left: 4px solid #f59e0b; }

			/* 代码堆叠列表 */
			.code-workspace {
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 0.8rem;
				min-height: 180px;
				max-height: 220px;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}

			.code-item {
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 0.4em 0.7em;
				font-size: 0.82rem;
				font-weight: 600;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.code-item .remove-btn {
				color: #ef4444;
				cursor: pointer;
				font-weight: bold;
			}

			.action-bar {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8rem;
			}

			.btn-run {
				background: #6366f1;
				color: #fff;
				border: none;
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 800;
				font-size: 0.92rem;
				cursor: pointer;
				transition: all 0.2s;
			}
			.btn-run:hover { opacity: 0.9; transform: scale(1.02); }

			.btn-reset {
				background: var(--search-bg);
				border: 1px solid var(--card-border);
				color: var(--text-main);
				padding: 0.8em;
				border-radius: 12px;
				font-weight: 700;
				font-size: 0.92rem;
				cursor: pointer;
			}
			.btn-reset:hover { border-color: var(--accent); }

			.empty-hint {
				color: var(--text-muted);
				font-size: 0.8rem;
				text-align: center;
				margin: auto;
			}
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<div class="tool-header">
				<h1>🎵 儿童编程小游戏：魔法音乐演奏家</h1>
				<p>点击音符积木组合音乐代码，探索节奏与循环算法的华丽交响乐！</p>
			</div>

			<div class="game-container">
				<!-- 左侧：钢琴和律动可视化区 -->
				<div class="stage-box">
					<div class="level-bar">
						<span id="levelTitle">关卡 1: 奏响《小星星》前奏</span>
						<span>🎼 对应乐谱: <small id="targetSongHint">Do Do Sol Sol La La Sol</small></span>
					</div>

					<!-- 可视化琴键 -->
					<div class="piano-keyboard" id="keyboard">
						<div class="key-item" data-note="C4"><span>Do</span><small>1</small></div>
						<div class="key-item" data-note="D4"><span>Re</span><small>2</small></div>
						<div class="key-item" data-note="E4"><span>Mi</span><small>3</small></div>
						<div class="key-item" data-note="F4"><span>Fa</span><small>4</small></div>
						<div class="key-item" data-note="G4"><span>Sol</span><small>5</small></div>
						<div class="key-item" data-note="A4"><span>La</span><small>6</small></div>
						<div class="key-item" data-note="B4"><span>Si</span><small>7</small></div>
					</div>
				</div>

				<!-- 右侧：积木算法区 -->
				<div class="editor-box">
					<div class="panel-title">🎹 1. 点击添加音符</div>
					<div class="note-palette">
						<button class="note-btn" data-note="C4" data-name="Do (1)">Do 1</button>
						<button class="note-btn" data-note="D4" data-name="Re (2)">Re 2</button>
						<button class="note-btn" data-note="E4" data-name="Mi (3)">Mi 3</button>
						<button class="note-btn" data-note="F4" data-name="Fa (4)">Fa 4</button>
						<button class="note-btn" data-note="G4" data-name="Sol (5)">Sol 5</button>
						<button class="note-btn" data-note="A4" data-name="La (6)">La 6</button>
						<button class="note-btn" data-note="B4" data-name="Si (7)">Si 7</button>
						<button class="note-btn" data-note="C5" data-name="High Do">高Do</button>
					</div>

					<div class="panel-title">⚡ 2. 节奏与循环指令</div>
					<div class="control-palette">
						<button class="ctrl-btn purple" data-action="REPEAT_2">🔁 重复上音 2 次</button>
						<button class="ctrl-btn amber" data-action="PAUSE">⏸️ 停顿 0.5 秒</button>
					</div>

					<div class="panel-title">📜 3. 乐曲代码序列</div>
					<div class="code-workspace" id="codeWorkspace">
						<div class="empty-hint" id="emptyHint">点击音符积木开始编排乐曲...</div>
					</div>

					<div class="action-bar">
						<button class="btn-run" id="btnRun">▶ 演奏代码</button>
						<button class="btn-reset" id="btnReset">🧹 清空乐谱</button>
					</div>
				</div>
			</div>
		</main>

		<Footer lang="zh" />

		<script is:inline>
			// 频率映射表
			const FREQUENCIES = {
				'C4': 261.63, 'D4': 293.66, 'E4': 329.63, 'F4': 349.23,
				'G4': 392.00, 'A4': 440.00, 'B4': 493.88, 'C5': 523.25
			};

			const LEVELS = [
				{
					title: "关卡 1: 奏响《小星星》前奏",
					targetNotes: ['C4', 'C4', 'G4', 'G4', 'A4', 'A4', 'G4'],
					hint: "Do Do Sol Sol La La Sol"
				},
				{
					title: "关卡 2: 《两只老虎》循环节",
					targetNotes: ['C4', 'D4', 'E4', 'C4', 'C4', 'D4', 'E4', 'C4'],
					hint: "Do Re Mi Do | Do Re Mi Do"
				}
			];

			let currentLevelIdx = 0;
			let instructions = [];
			let isPlaying = false;
			let audioCtx = null;

			const codeWorkspace = document.getElementById('codeWorkspace');
			const emptyHint = document.getElementById('emptyHint');
			const levelTitle = document.getElementById('levelTitle');
			const targetSongHint = document.getElementById('targetSongHint');
			const btnRun = document.getElementById('btnRun');
			const btnReset = document.getElementById('btnReset');

			// 初始化 Web Audio API
			function playSound(noteStr, duration = 0.4) {
				if (!audioCtx) {
					audioCtx = new (window.AudioContext || window.webkitAudioContext)();
				}
				const freq = FREQUENCIES[noteStr];
				if (!freq) return;

				const osc = audioCtx.createOscillator();
				const gain = audioCtx.createGain();

				osc.type = 'triangle'; // 类似正弦与木琴的声音
				osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

				gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
				gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);

				osc.connect(gain);
				gain.connect(audioCtx.destination);

				osc.start();
				osc.stop(audioCtx.currentTime + duration);

				// 高亮键盘UI
				const keyEl = document.querySelector(`.key-item[data-note="${noteStr}"]`);
				if (keyEl) {
					keyEl.classList.add('playing');
					setTimeout(() => keyEl.classList.remove('playing'), duration * 800);
				}
			}

			function initLevel(idx) {
				const lvl = LEVELS[idx];
				levelTitle.textContent = lvl.title;
				targetSongHint.textContent = lvl.hint;
			}

			// 音符点击添加
			document.querySelectorAll('.note-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					if (isPlaying) return;
					const note = btn.dataset.note;
					const name = btn.dataset.name;
					instructions.push({ type: 'NOTE', note, label: `🎵 音符: ${name}` });
					playSound(note, 0.2); // 点击预览声音
					renderWorkspace();
				});
			});

			// 控制积木添加
			document.querySelectorAll('.ctrl-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					if (isPlaying) return;
					const action = btn.dataset.action;
					const label = btn.textContent;
					instructions.push({ type: 'CTRL', action, label });
					renderWorkspace();
				});
			});

			function renderWorkspace() {
				if (instructions.length === 0) {
					emptyHint.style.display = 'block';
					codeWorkspace.innerHTML = '';
					codeWorkspace.appendChild(emptyHint);
					return;
				}
				emptyHint.style.display = 'none';
				codeWorkspace.innerHTML = '';

				instructions.forEach((item, idx) => {
					const el = document.createElement('div');
					el.className = 'code-item';
					el.innerHTML = `
						<span>${idx + 1}. ${item.label}</span>
						<span class="remove-btn" onclick="removeInstruction(${idx})">✕</span>
					`;
					codeWorkspace.appendChild(el);
				});
			}

			window.removeInstruction = function(idx) {
				if (isPlaying) return;
				instructions.splice(idx, 1);
				renderWorkspace();
			};

			// 执行乐曲演奏
			btnRun.addEventListener('click', async () => {
				if (isPlaying || instructions.length === 0) return;
				isPlaying = true;
				btnRun.disabled = true;

				// 展开循环指令
				let expandedNotes = [];
				for (let i = 0; i < instructions.length; i++) {
					const item = instructions[i];
					if (item.type === 'NOTE') {
						expandedNotes.push(item.note);
					} else if (item.action === 'REPEAT_2' && i > 0 && instructions[i - 1].type === 'NOTE') {
						expandedNotes.push(instructions[i - 1].note);
					} else if (item.action === 'PAUSE') {
						expandedNotes.push('PAUSE');
					}
				}

				// 逐个演奏音符
				for (let note of expandedNotes) {
					if (note === 'PAUSE') {
						await new Promise(r => setTimeout(r, 500));
					} else {
						playSound(note, 0.4);
						await new Promise(r => setTimeout(r, 450));
					}
				}

				// 通关判别
				const lvl = LEVELS[currentLevelIdx];
				const isMatch = JSON.stringify(expandedNotes) === JSON.stringify(lvl.targetNotes);

				if (isMatch) {
					setTimeout(() => {
						alert('🎉 太美妙了！你用代码弹出了完美的乐曲！解锁下一关！');
						currentLevelIdx = (currentLevelIdx + 1) % LEVELS.length;
						instructions = [];
						renderWorkspace();
						initLevel(currentLevelIdx);
					}, 300);
				}

				isPlaying = false;
				btnRun.disabled = false;
			});

			btnReset.addEventListener('click', () => {
				if (isPlaying) return;
				instructions = [];
				renderWorkspace();
			});

			initLevel(0);
		</script>
	</body>
</html>
