---
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import { SITE_TITLE } from 'src/consts';

export const frontmatter = {
	title: "JSON 格式化、美化与语法校验工具",
	description: "免费且 100% 保护隐私的 JSON 在线工具，支持实时 JSON 格式美化、体积压缩及语法错误排查。",
	icon: "🛠️",
	tag: "开发者工具",
	keywords: "JSON格式化 JSON美化 JSON校验 JSON压缩 JSON在线解析"
};

const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.tool-header h1 {
				font-size: 2.2rem;
				font-weight: 800;
				margin-bottom: 0.3em;
				background: var(--hero-title-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.tool-header p {
				color: var(--text-muted);
				font-size: 1.05rem;
			}
			.tool-box {
				background: var(--bg-card);
				backdrop-filter: blur(12px);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.status-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.6em 1em;
				border-radius: 8px;
				font-size: 0.88rem;
				font-weight: 600;
				margin-bottom: 1em;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				color: var(--text-muted);
			}
			.status-bar.success {
				border-color: #10b981;
				color: #10b981;
				background: rgba(16, 185, 129, 0.08);
			}
			.status-bar.error {
				border-color: #ef4444;
				color: #ef4444;
				background: rgba(239, 68, 68, 0.08);
			}
			.editor-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.2rem;
			}
			.editor-container {
				display: flex;
				flex-direction: column;
				gap: 0.5em;
			}
			label {
				font-weight: 600;
				color: var(--text-main);
				font-size: 0.9rem;
			}
			textarea {
				width: 100%;
				height: 380px;
				padding: 1em;
				background: var(--code-bg) !important;
				border: 1px solid var(--card-border);
				border-radius: 10px;
				color: var(--text-main);
				font-size: 0.9rem;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
				box-sizing: border-box;
				outline: none;
				resize: vertical;
				line-height: 1.5;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			textarea:focus {
				border-color: var(--accent);
				box-shadow: 0 0 10px var(--accent-glow);
			}
			.btn-group {
				display: flex;
				gap: 0.8rem;
				margin: 1.2rem 0 0;
				flex-wrap: wrap;
			}
			.btn {
				background: var(--accent);
				color: #ffffff !important;
				border: none;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
			}
			.btn:hover { background: var(--accent-hover); }
			.btn-secondary {
				background: var(--gray-light);
				border: 1px solid var(--card-border);
				color: var(--text-main);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* FAQ 与相关工具样式 */
			.content-section {
				margin-top: 2.5rem;
				background: var(--bg-card);
				border: 1px solid var(--card-border);
				border-radius: 16px;
				padding: 2em;
			}
			.content-section h2 {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 1.2rem;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
			}
			.faq-item h3 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-main);
				margin-bottom: 0.3rem;
			}
			.faq-item p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.related-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.related-card {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.9rem;
				background: var(--code-bg);
				border: 1px solid var(--card-border);
				border-radius: 10px;
				text-decoration: none !important;
				transition: border-color 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
			}
			.card-icon {
				font-size: 1.6rem;
			}
			.related-card h4 {
				margin: 0 0 0.2rem 0;
				color: var(--text-main);
				font-size: 0.92rem;
				font-weight: 700;
			}
			.related-card p {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			@media (max-width: 768px) {
				.editor-grid, .related-grid {
					grid-template-columns: 1fr;
				}
				textarea {
					height: 240px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<h1>🛠️ {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<div class="tool-box">
				<div class="status-bar" id="statusBar">
					<span>状态：准备接收 JSON 文本</span>
					<span id="charCount">0 字符</span>
				</div>

				<div class="editor-grid">
					<div class="editor-container">
						<label for="jsonInput">输入原始 JSON：</label>
						<textarea id="jsonInput" placeholder="在此粘贴或输入需要处理的 JSON 数据..."></textarea>
					</div>
					<div class="editor-container">
						<label for="jsonOutput">格式化 / 压缩输出：</label>
						<textarea id="jsonOutput" readonly placeholder="处理后的结果将显示在这里..."></textarea>
					</div>
				</div>

				<div class="btn-group">
					<button class="btn" id="btnBeautify">格式化美化 (2空格缩进)</button>
					<button class="btn" id="btnMinify">极简压缩 (去除换行空格)</button>
					<button class="btn btn-secondary" id="btnClear">清空内容</button>
					<button class="btn btn-secondary" id="btnCopy" style="margin-left: auto;">复制结果</button>
				</div>
			</div>

			<!-- FAQ 模块 -->
			<section class="content-section">
				<h2>常见问题解答 (FAQ)</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>我的 JSON 数据会被上传到服务器吗？</h3>
						<p><strong>绝对不会。</strong> 本工具采用 100% 浏览器客户端本地解析技术，您的 API 密钥、数据库响应体或敏感商业 JSON 绝不会离开您的电脑。</p>
					</div>
					<div class="faq-item">
						<h3>常见的 JSON 语法错误有哪些？</h3>
						<p>最常见的错误包括：对象或数组末尾多写了逗号（Trailing Comma）、Key 或字符串使用了单引号而不是双引号、包含了未转义的特殊字符等。</p>
					</div>
					<div class="faq-item">
						<h3>格式化美化与极简压缩有什么区别？</h3>
						<p><strong>格式化美化</strong>通过自动增加缩进和换行，使数据结构更易人类肉眼阅读；<strong>极简压缩</strong>则抹去所有无用的空格与换行，从而缩小传输体积。</p>
					</div>
				</div>
			</section>

			<!-- 相关工具推荐 -->
			<section class="content-section">
				<h2>你可能也会用到</h2>
				<div class="related-grid">
					<a href="/zh/tools/base64-url-encode-decode/" class="related-card">
						<span class="card-icon">🔤</span>
						<div>
							<h4>Base64 & URL 编解码工具</h4>
							<p>安全快速地转换 Base64 字符串与 URL 参数。</p>
						</div>
					</a>
					<a href="/zh/tools/ecommerce-profit-margin-calculator/" class="related-card">
						<span class="card-icon">🧮</span>
						<div>
							<h4>独立站与跨境电商利润计算器</h4>
							<p>精准测算商品净利润率与保本售价。</p>
						</div>
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Schema.org FAQ 结构化数据 -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "我的 JSON 数据会被上传到服务器吗？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "绝对不会。本工具采用 100% 浏览器客户端本地解析技术，您的数据绝不会离开电脑。"
						}
					},
					{
						"@type": "Question",
						"name": "格式化美化与极简压缩有什么区别？",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "格式化美化增加缩进和换行方便阅读，极简压缩抹去无用空格缩减传输体积。"
						}
					}
				]
			}
		</script>

		<script>
			const jsonInput = document.getElementById('jsonInput') as HTMLTextAreaElement;
			const jsonOutput = document.getElementById('jsonOutput') as HTMLTextAreaElement;
			const statusBar = document.getElementById('statusBar');
			const charCount = document.getElementById('charCount');

			function updateStatus(isSuccess: boolean, message: string) {
				if (!statusBar) return;
				statusBar.className = `status-bar ${isSuccess ? 'success' : 'error'}`;
				const statusText = statusBar.querySelector('span');
				if (statusText) statusText.textContent = message;
			}

			function processJson(indent: number | null) {
				const val = jsonInput.value.trim();
				if (!val) {
					jsonOutput.value = '';
					updateStatus(true, '状态：准备接收 JSON 文本');
					if (charCount) charCount.textContent = '0 字符';
					return;
				}

				try {
					const parsed = JSON.parse(val);
					jsonOutput.value = indent !== null ? JSON.stringify(parsed, null, indent) : JSON.stringify(parsed);
					updateStatus(true, '状态：JSON 语法校验正确！');
					if (charCount) charCount.textContent = `${jsonOutput.value.length} 字符`;
				} catch (e: any) {
					jsonOutput.value = '';
					updateStatus(false, `语法错误：${e.message}`);
					if (charCount) charCount.textContent = '解析失败';
				}
			}

			document.getElementById('btnBeautify')?.addEventListener('click', () => processJson(2));
			document.getElementById('btnMinify')?.addEventListener('click', () => processJson(null));

			document.getElementById('btnClear')?.addEventListener('click', () => {
				jsonInput.value = '';
				jsonOutput.value = '';
				updateStatus(true, '状态：准备接收 JSON 文本');
				if (charCount) charCount.textContent = '0 字符';
			});

			document.getElementById('btnCopy')?.addEventListener('click', (e) => {
				if (!jsonOutput.value) return;
				navigator.clipboard.writeText(jsonOutput.value);
				const btn = e.target as HTMLButtonElement;
				btn.textContent = '已复制！';
				setTimeout(() => { btn.textContent = '复制结果'; }, 2000);
			});

			jsonInput?.addEventListener('input', () => {
				if (jsonInput.value.trim() === '') {
					jsonOutput.value = '';
					updateStatus(true, '状态：准备接收 JSON 文本');
					if (charCount) charCount.textContent = '0 字符';
				}
			});
		</script>
	</body>
</html>
