---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const pageTitle = `隐私政策 — ${SITE_TITLE}`;
const pageDescription = "HelpMini 隐私政策。100% 本地纯前端处理，数据绝不上传服务器。";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: 800px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 5em;
				color: var(--text-muted);
				line-height: 1.7;
			}
			h1, h2 { color: var(--text-main); }
			h1 { font-size: 2.2rem; margin-bottom: 0.2em; }
			h2 { font-size: 1.3rem; margin-top: 1.8em; }
		</style>
	</head>
	<body>
		<Header lang="zh" />
		<main>
			<h1>隐私政策</h1>
			<p><em>最近更新日期：2026 年 8 月</em></p>

			<h2>1. 数据零上传声明</h2>
			<p>在 HelpMini，保护您的隐私是我们的首要原则。全站所有工具均采用 100% 纯前端浏览器本地算法。您处理的图片、发票数据、代码及文本数据均完全在您的本地设备上计算，<strong>绝不上传至任何远程服务器</strong>。</p>

			<h2>2. 我们不收集的信息</h2>
			<p>我们不收集个人身份信息、账号密码或任何支付信息。使用我们的工具无需注册或登录。</p>

			<h2>3. Cookie 与本地存储</h2>
			<p>我们仅利用浏览器的 LocalStorage 来保存您的网页主题喜好（深色/浅色模式）及语言偏好设置。</p>

			<h2>4. 联系我们</h2>
			<p>如果您对本隐私政策有任何疑问，请通过 <a href="/zh/feedback/" style="color:var(--accent);">发送反馈</a> 页面联系我们。</p>
		</main>
		<Footer lang="zh" />
	</body>
</html>
