// 5. 初始化加载文章内容（确保精准读取并填充 content 正文）
async function loadArticleData() {
  await initToolsDropdown();
  document.getElementById('artLang').value = urlLang;

  if (articleId) {
    try {
      const res = await fetch(`/api/admin/articles?lang=${urlLang}`);
      const json = await res.json();
      if (json.success && Array.isArray(json.data)) {
        // 匹配解码后的 articleId 或 slug
        const decodedId = decodeURIComponent(articleId);
        const art = json.data.find(a => a.id === decodedId || a.id === articleId || a.slug === articleId);
        
        if (art) {
          document.getElementById('artSlug').value = art.slug || '';
          document.getElementById('artTitle').value = art.title || '';
          document.getElementById('artRelatedTool').value = art.relatedTool || '';
          
          // ⚡ 优先回填返回的真正正文内容，若没有正文才显示模版
          if (art.content && art.content.trim() !== '') {
            mdInput.value = art.content;
          } else {
            mdInput.value = `# ${art.title}\n\n${art.description || ''}`;
          }
          
          updatePreview();
        }
      }
    } catch (e) {
      console.error('读取文章正文异常:', e);
    }
  }
}
