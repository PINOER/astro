---
// src/pages/admin/articles/edit.astro
import AdminLayout from 'src/layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Markdown / MDX 在线编辑器">
  <!-- 引入 Marked.js 与 DOMPurify 用于双栏实时安全渲染 -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <style>
    .editor-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      background: var(--admin-card);
      padding: 1rem 1.5rem;
      border-radius: 12px;
      border: 1px solid var(--admin-border);
    }

    .editor-form-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      background: var(--admin-card);
      padding: 1.2rem;
      border-radius: 12px;
      border: 1px solid var(--admin-border);
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--admin-muted);
      margin-bottom: 0.4rem;
    }

    .form-control {
      width: 100%;
      background: #0b0f17;
      border: 1px solid var(--admin-border);
      color: #fff;
      padding: 0.5rem;
      border-radius: 6px;
      font-size: 0.88rem;
      box-sizing: border-box;
    }
    .form-control:focus { border-color: var(--admin-accent); outline: none; }

    /* 双栏编辑器结构 */
    .editor-workspace {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      height: calc(100vh - 360px);
      min-height: 500px;
    }

    .editor-pane {
      background: #0b0f17;
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }

    .pane-header {
      background: var(--admin-card);
      padding: 0.6rem 1rem;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--admin-muted);
      border-bottom: 1px solid var(--admin-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    textarea.markdown-input {
      width: 100%;
      height: 100%;
      background: transparent;
      border: none;
      color: #f1f5f9;
      padding: 1rem;
      font-family: 'Fira Code', Consolas, Monaco, monospace;
      font-size: 0.9rem;
      line-height: 1.6;
      resize: none;
      outline: none;
      box-sizing: border-box;
    }

    .preview-pane {
      padding: 1rem;
      overflow-y: auto;
      color: #e2e8f0;
      font-size: 0.95rem;
      line-height: 1.7;
    }

    /* 拖拽上传覆盖层 */
    .drag-overlay {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(99, 102, 241, 0.85);
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1.2rem;
      backdrop-filter: blur(4px);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .drag-active .drag-overlay {
      opacity: 1;
    }

    .btn-save {
      background: var(--admin-accent);
      color: #fff;
      border: none;
      padding: 0.6rem 1.4rem;
      border-radius: 8px;
      font-weight: 800;
      cursor: pointer;
    }
  </style>

  <div class="editor-header">
    <div>
      <h3 style="margin:0 0 0.2rem 0; color:#fff;">✍️ Markdown / MDX 实时编辑器</h3>
      <p style="margin:0; color:var(--admin-muted); font-size:0.82rem;">支持拖拽图片自动转 WebP 格式，并挂载双向交互工具卡片</p>
    </div>
    <div style="display:flex; gap:0.8rem;">
      <a href="/admin/articles" class="form-control" style="text-decoration:none; text-align:center;">返回列表</a>
      <button class="btn-save" id="btnSaveArticle">💾 保存文章</button>
    </div>
  </div>

  <div class="editor-form-grid">
    <div class="form-group">
      <label>语言 (Language)</label>
      <select id="artLang" class="form-control">
        <option value="zh">🇨🇳 中文 (zh)</option>
        <option value="en">🇺🇸 English (en)</option>
        <option value="ja">🇯🇵 日本語 (ja)</option>
        <option value="ko">🇰🇷 한국어 (ko)</option>
        <option value="de">🇩🇪 Deutsch (de)</option>
      </select>
    </div>

    <div class="form-group">
      <label>URL Slug *</label>
      <input type="text" id="artSlug" class="form-control" placeholder="e.g. how-to-use-seo-tool" />
    </div>

    <div class="form-group">
      <label>文章标题 (Title) *</label>
      <input type="text" id="artTitle" class="form-control" placeholder="输入文章标题..." />
    </div>

    <div class="form-group">
      <label>关联交互工具 (Widget/Tool Link) 🛠️</label>
      <select id="artRelatedTool" class="form-control">
        <option value="">-- 无关联工具 --</option>
      </select>
    </div>
  </div>

  <div class="editor-workspace">
    <!-- 左侧编辑器（支持拖拽图片） -->
    <div class="editor-pane" id="dropZone">
      <div class="pane-header">
        <span>MARKDOWN 源码</span>
        <span style="font-size:0.75rem; color:#818cf8;">💡 拖拽/粘贴图片可自动转 WebP 上传</span>
      </div>
      <textarea id="mdInput" class="markdown-input" placeholder="在此输入 Markdown / MDX 内容..."></textarea>
      
      <div class="drag-overlay">
        <span>📥 释放图片以自动转换 WebP 并插入文章</span>
      </div>
    </div>

    <!-- 右侧实时渲染 -->
    <div class="editor-pane">
      <div class="pane-header">
        <span>实时效果预览</span>
        <span id="wordCount" style="font-size:0.75rem;">0 字</span>
      </div>
      <div id="htmlPreview" class="preview-pane"></div>
    </div>
  </div>

  <script is:inline>
    const urlParams = new URLSearchParams(window.location.search);
    const articleId = urlParams.get('id');
    const urlLang = urlParams.get('lang') || 'zh';

    const mdInput = document.getElementById('mdInput');
    const htmlPreview = document.getElementById('htmlPreview');
    const dropZone = document.getElementById('dropZone');

    // 1. 初始化关联工具下拉列表
    async function initToolsDropdown() {
      try {
        const res = await fetch(`/api/admin/config?type=tools_v2_${urlLang}`);
        const json = await res.json();
        const toolSelect = document.getElementById('artRelatedTool');

        if (json.success && Array.isArray(json.data)) {
          json.data.forEach(t => {
            const opt = document.createElement('option');
            opt.value = t.slug;
            opt.textContent = `${t.icon || '🛠️'} ${t.name} (${t.slug})`;
            toolSelect.appendChild(opt);
          });
        }
      } catch (e) {}
    }

    // 2. 双栏实时渲染与字数统计
    function updatePreview() {
      const text = mdInput.value || '';
      if (window.marked) {
        htmlPreview.innerHTML = window.marked.parse(text);
      } else {
        htmlPreview.textContent = text;
      }
      document.getElementById('wordCount').textContent = `${text.length} 字`;
    }

    mdInput.addEventListener('input', updatePreview);

    // 3. 图片转 WebP 并自动插入文本
    async function processAndUploadImage(file) {
      if (!file.type.startsWith('image/')) return;

      const placeholder = `\n![上传中...](Uploading...)\n`;
      const cursorPos = mdInput.selectionStart;
      mdInput.value = mdInput.value.slice(0, cursorPos) + placeholder + mdInput.value.slice(cursorPos);
      updatePreview();

      // 使用 Canvas 将图片转 WebP 格式 Blob
      const img = new Image();
      img.src = URL.createObjectURL(file);
      await img.decode();

      const canvas = document.createElement('canvas');
      canvas.width = img.width;
      canvas.height = img.height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0);

      canvas.toBlob(async (blob) => {
        const formData = new FormData();
        formData.append('file', blob, `${Date.now()}.webp`);

        try {
          // 上传文件接口
          const res = await fetch('/api/admin/media/upload', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();

          if (data.success && data.url) {
            const imgMarkdown = `\n![${file.name}](${data.url})\n`;
            mdInput.value = mdInput.value.replace(placeholder, imgMarkdown);
            updatePreview();
          } else {
            alert('图片上传失败');
          }
        } catch (e) {
          alert('上传请求异常');
        }
      }, 'image/webp', 0.85);
    }

    // 4. 拖拽与剪贴板监听
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-active'); });
    dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('drag-active'); });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-active');
      if (e.dataTransfer.files.length > 0) processAndUploadImage(e.dataTransfer.files[0]);
    });

    mdInput.addEventListener('paste', (e) => {
      const items = (e.clipboardData || e.originalEvent.clipboardData).items;
      for (const item of items) {
        if (item.kind === 'file') processAndUploadImage(item.getAsFile());
      }
    });

    // 5. 初始化加载文章内容（若为编辑模式）
    async function loadArticleData() {
      await initToolsDropdown();
      document.getElementById('artLang').value = urlLang;

      if (articleId) {
        try {
          const res = await fetch(`/api/admin/articles?lang=${urlLang}`);
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            const art = json.data.find(a => a.id === articleId);
            if (art) {
              document.getElementById('artSlug').value = art.slug || '';
              document.getElementById('artTitle').value = art.title || '';
              document.getElementById('artRelatedTool').value = art.relatedTool || '';
              mdInput.value = art.content || `# ${art.title}\n\n${art.description || ''}`;
              updatePreview();
            }
          }
        } catch (e) {}
      }
    }

    // 6. 保存保存提交
    document.getElementById('btnSaveArticle')?.addEventListener('click', async () => {
      const lang = document.getElementById('artLang').value;
      const slug = document.getElementById('artSlug').value.trim();
      const title = document.getElementById('artTitle').value.trim();
      const relatedTool = document.getElementById('artRelatedTool').value;
      const content = mdInput.value;

      if (!slug || !title) {
        alert('请填写文章 Slug 与标题！');
        return;
      }

      try {
        const res = await fetch('/api/admin/articles/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: articleId || `${lang}/${slug}`, lang, slug, title, relatedTool, content })
        });
        const data = await res.json();
        if (data.success) {
          alert('🎉 文章编辑成功并更新部署！');
          window.location.href = '/admin/articles';
        } else {
          alert('保存失败: ' + (data.message || '未知错误'));
        }
      } catch (e) {
        alert('网络请求异常');
      }
    });

    loadArticleData();
  </script>
</AdminLayout>
