---
// src/pages/admin/articles/edit.astro
import AdminLayout from 'src/layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Markdown / MDX 在线编辑器">
  <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <style>
    .editor-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      background: var(--admin-card);
      padding: 1rem 1.5rem;
      border-radius: 12px;
      border: 1px solid var(--admin-border);
    }

    .editor-form-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      background: var(--admin-card);
      padding: 1.2rem;
      border-radius: 12px;
      border: 1px solid var(--admin-border);
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--admin-muted);
      margin-bottom: 0.4rem;
    }

    .form-control {
      width: 100%;
      background: #0b0f17;
      border: 1px solid var(--admin-border);
      color: #fff;
      padding: 0.5rem;
      border-radius: 6px;
      font-size: 0.88rem;
      box-sizing: border-box;
    }
    .form-control:focus { border-color: var(--admin-accent); outline: none; }

    .hero-image-uploader {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .hero-preview-box {
      margin-top: 0.4rem;
      max-height: 60px;
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid var(--admin-border);
      display: none;
    }

    .hero-preview-box img {
      width: 100%;
      height: 60px;
      object-fit: cover;
    }

    .btn-upload-hero {
      background: rgba(99, 102, 241, 0.2);
      border: 1px solid rgba(99, 102, 241, 0.4);
      color: #818cf8;
      padding: 0.5rem 0.8rem;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }

    .editor-workspace {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      height: calc(100vh - 420px);
      min-height: 480px;
    }

    .editor-pane {
      background: #0b0f17;
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }

    .pane-header {
      background: var(--admin-card);
      padding: 0.6rem 1rem;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--admin-muted);
      border-bottom: 1px solid var(--admin-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    textarea.markdown-input {
      width: 100%;
      height: 100%;
      background: transparent;
      border: none;
      color: #f1f5f9;
      padding: 1rem;
      font-family: 'Fira Code', Consolas, Monaco, monospace;
      font-size: 0.9rem;
      line-height: 1.6;
      resize: none;
      outline: none;
      box-sizing: border-box;
    }

    .preview-pane {
      padding: 1rem;
      overflow-y: auto;
      color: #e2e8f0;
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .drag-overlay {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(99, 102, 241, 0.85);
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1.2rem;
      backdrop-filter: blur(4px);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .drag-active .drag-overlay {
      opacity: 1;
    }

    .btn-save {
      background: var(--admin-accent);
      color: #fff;
      border: none;
      padding: 0.6rem 1.4rem;
      border-radius: 8px;
      font-weight: 800;
      cursor: pointer;
    }
    .btn-save:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  </style>

  <div class="editor-header">
    <div>
      <h3 style="margin:0 0 0.2rem 0; color:#fff;">✍️ Markdown / MDX 实时编辑器</h3>
      <p style="margin:0; color:var(--admin-muted); font-size:0.82rem;">支持拖拽图片自动转 WebP 格式，并挂载双向交互工具卡片</p>
    </div>
    <div style="display:flex; gap:0.8rem;">
      <a href="/admin/articles" class="form-control" style="text-decoration:none; text-align:center;">返回列表</a>
      <button class="btn-save" id="btnSaveArticle">💾 保存文章</button>
    </div>
  </div>

  <div class="editor-form-grid">
    <div class="form-group">
      <label>语言 (Language)</label>
      <select id="artLang" class="form-control">
        <option value="zh">🇨🇳 中文 (zh)</option>
        <option value="en">🇺🇸 English (en)</option>
        <option value="ja">🇯🇵 日本語 (ja)</option>
        <option value="ko">🇰🇷 한국어 (ko)</option>
        <option value="de">🇩🇪 Deutsch (de)</option>
      </select>
    </div>

    <div class="form-group">
      <label>URL Slug *</label>
      <input type="text" id="artSlug" class="form-control" placeholder="e.g. how-to-use-seo-tool" />
    </div>

    <div class="form-group">
      <label>文章标题 (Title) *</label>
      <input type="text" id="artTitle" class="form-control" placeholder="输入文章标题..." />
    </div>

    <div class="form-group">
      <label>封面图 (Hero Image) 🖼️</label>
      <div class="hero-image-uploader">
        <input type="text" id="artHeroImage" class="form-control" placeholder="粘贴 URL 或选择上传..." />
        <label for="heroFileInput" class="btn-upload-hero">上传</label>
        <input type="file" id="heroFileInput" accept="image/*" style="display:none;" />
      </div>
      <div class="hero-preview-box" id="heroPreviewBox">
        <img id="heroPreviewImg" src="" alt="Hero Image Preview" />
      </div>
    </div>

    <div class="form-group" style="grid-column: span 4;">
      <label>关联交互工具 (Widget/Tool Link) 🛠️</label>
      <select id="artRelatedTool" class="form-control">
        <option value="">-- 无关联工具 --</option>
      </select>
    </div>
  </div>

  <div class="editor-workspace">
    <div class="editor-pane" id="dropZone">
      <div class="pane-header">
        <span>MARKDOWN 源码</span>
        <span style="font-size:0.75rem; color:#818cf8;">💡 拖拽/粘贴图片可自动转 WebP 上传</span>
      </div>
      <textarea id="mdInput" class="markdown-input" placeholder="在此输入 Markdown / MDX 内容..."></textarea>
      
      <div class="drag-overlay">
        <span>📥 释放图片以自动转换 WebP 并插入文章</span>
      </div>
    </div>

    <div class="editor-pane">
      <div class="pane-header">
        <span>实时效果预览</span>
        <span id="wordCount" style="font-size:0.75rem;">0 字</span>
      </div>
      <div id="htmlPreview" class="preview-pane"></div>
    </div>
  </div>

  <script is:inline>
    const urlParams = new URLSearchParams(window.location.search);
    const articleId = urlParams.get('id');
    const urlLang = urlParams.get('lang') || 'zh';

    const mdInput = document.getElementById('mdInput');
    const htmlPreview = document.getElementById('htmlPreview');
    const dropZone = document.getElementById('dropZone');

    const artHeroImage = document.getElementById('artHeroImage');
    const heroFileInput = document.getElementById('heroFileInput');
    const heroPreviewBox = document.getElementById('heroPreviewBox');
    const heroPreviewImg = document.getElementById('heroPreviewImg');

    function updateHeroPreview() {
      const url = artHeroImage.value.trim();
      if (url) {
        heroPreviewImg.src = url;
        heroPreviewBox.style.display = 'block';
      } else {
        heroPreviewBox.style.display = 'none';
      }
    }

    artHeroImage.addEventListener('input', updateHeroPreview);

    // 封面图独立上传并转 WebP Base64
    heroFileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file || !file.type.startsWith('image/')) return;

      try {
        const webpBase64 = await fileToWebPBase64(file);
        artHeroImage.value = webpBase64;
        updateHeroPreview();
      } catch (err) {
        alert('封面图处理失败: ' + err.message);
      }
    });

    async function initToolsDropdown() {
      try {
        const res = await fetch(`/api/admin/config?type=tools_v2_${urlLang}`);
        const json = await res.json();
        const toolSelect = document.getElementById('artRelatedTool');

        if (json.success && Array.isArray(json.data)) {
          json.data.forEach(t => {
            const opt = document.createElement('option');
            opt.value = t.slug;
            opt.textContent = `${t.icon || '🛠️'} ${t.name} (${t.slug})`;
            toolSelect.appendChild(opt);
          });
        }
      } catch (e) {}
    }

    function updatePreview() {
      const text = mdInput.value || '';
      if (window.marked) {
        htmlPreview.innerHTML = window.marked.parse(text);
      } else {
        htmlPreview.textContent = text;
      }
      document.getElementById('wordCount').textContent = `${text.length} 字`;
    }

    mdInput.addEventListener('input', updatePreview);

    // 通用图片转 WebP Base64 逻辑
    async function fileToWebPBase64(file, maxDimension = 1600) {
      const img = new Image();
      img.src = URL.createObjectURL(file);
      await img.decode();

      const canvas = document.createElement('canvas');
      let width = img.width;
      let height = img.height;

      if (width > maxDimension || height > maxDimension) {
        if (width > height) {
          height = Math.round((height * maxDimension) / width);
          width = maxDimension;
        } else {
          width = Math.round((width * maxDimension) / height);
          height = maxDimension;
        }
      }

      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, width, height);

      return canvas.toDataURL('image/webp', 0.8);
    }

    // 正文内拖拽/粘贴图片转 WebP
    async function processAndUploadImage(file) {
      if (!file.type.startsWith('image/')) return;

      const placeholder = `\n![处理中...](Processing...)\n`;
      const cursorPos = mdInput.selectionStart;
      mdInput.value = mdInput.value.slice(0, cursorPos) + placeholder + mdInput.value.slice(cursorPos);
      updatePreview();

      try {
        const webpBase64 = await fileToWebPBase64(file);
        const imgMarkdown = `\n![${file.name || 'image'}](${webpBase64})\n`;
        mdInput.value = mdInput.value.replace(placeholder, imgMarkdown);
        updatePreview();
      } catch (e) {
        alert('图片本地转换 WebP 失败: ' + e.message);
        mdInput.value = mdInput.value.replace(placeholder, '');
        updatePreview();
      }
    }

    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-active'); });
    dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('drag-active'); });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-active');
      if (e.dataTransfer.files.length > 0) processAndUploadImage(e.dataTransfer.files[0]);
    });

    mdInput.addEventListener('paste', (e) => {
      const items = (e.clipboardData || e.originalEvent.clipboardData).items;
      for (const item of items) {
        if (item.kind === 'file') processAndUploadImage(item.getAsFile());
      }
    });

    async function loadArticleData() {
      await initToolsDropdown();
      document.getElementById('artLang').value = urlLang;

      if (articleId) {
        try {
          const res = await fetch(`/api/admin/articles?lang=${urlLang}`);
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            const decodedId = decodeURIComponent(articleId);
            const art = json.data.find(a => a.id === decodedId || a.id === articleId || a.slug === articleId);
            
            if (art) {
              document.getElementById('artSlug').value = art.slug || '';
              document.getElementById('artTitle').value = art.title || '';
              document.getElementById('artHeroImage').value = art.heroImage || '';
              document.getElementById('artRelatedTool').value = art.relatedTool || '';
              
              updateHeroPreview();

              if (art.content && art.content.trim() !== '') {
                mdInput.value = art.content;
              } else {
                mdInput.value = `# ${art.title}\n\n${art.description || ''}`;
              }
              
              updatePreview();
            }
          }
        } catch (e) {
          console.error('加载文章内容错误:', e);
        }
      }
    }

    // 保存处理逻辑
    document.getElementById('btnSaveArticle')?.addEventListener('click', async () => {
      const lang = document.getElementById('artLang').value;
      const rawSlug = document.getElementById('artSlug').value.trim().replace(/^\//, '');
      const title = document.getElementById('artTitle').value.trim();
      const heroImage = document.getElementById('artHeroImage').value.trim();
      const relatedTool = document.getElementById('artRelatedTool').value;
      const content = mdInput.value;

      if (!rawSlug || !title) {
        alert('请填写文章 Slug 与标题！');
        return;
      }

      const cleanSlug = rawSlug.replace(/\.(md|mdx)$/, '');
      const fullId = articleId || `${lang}/${cleanSlug}.md`;

      const btnSave = document.getElementById('btnSaveArticle');
      btnSave.textContent = '⏳ 保存中...';
      btnSave.disabled = true;

      try {
        const res = await fetch('/api/admin/articles/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            id: fullId, 
            lang: lang, 
            slug: cleanSlug, 
            title: title, 
            heroImage: heroImage,
            relatedTool: relatedTool, 
            content: content 
          })
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          alert('🎉 文章保存成功！');
          window.location.href = '/admin/articles';
        } else {
          alert('保存失败: ' + (data.message || `HTTP状态码 ${res.status}`));
        }
      } catch (e) {
        alert('网络请求异常/传输体积超限: ' + e.message);
      } finally {
        btnSave.textContent = '💾 保存文章';
        btnSave.disabled = false;
      }
    });

    loadArticleData();
  </script>
</AdminLayout>
