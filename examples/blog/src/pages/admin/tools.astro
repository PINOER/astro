---
// src/pages/admin/tools.astro
import AdminLayout from 'src/layouts/AdminLayout.astro';
import { sponsorItems } from 'src/data/tools';

export const prerender = false;

// 1. 读取 Cloudflare KV 中的工具自定义管理配置 (默认 ZH 初始数据)
let kvToolsConfigMap = new Map();
try {
  const runtime = (Astro.locals as any).runtime;
  const kv = runtime?.env?.ADMIN_KV;
  if (kv) {
    const raw = await kv.get('config_tools_v2_zh');
    if (raw) {
      const list = JSON.parse(raw);
      list.forEach((item: any) => {
        if (item.slug) kvToolsConfigMap.set(item.slug, item);
      });
    }
  }
} catch (e) {
  console.warn('SSR 读取 Cloudflare KV 失败:', e);
}

// 2. 自动化扫描与源码精准解析 (全语言静态预扫描，同步获取前端 pinned 初始状态)
const rawToolFiles = import.meta.glob('/src/pages/**/tools/*.astro', { query: '?raw', eager: true });
const allToolModules = import.meta.glob('/src/pages/**/tools/*.astro', { eager: true });

const autoDiscoveredTools = Object.entries(allToolModules).map(([filePath, module]: [string, any]) => {
  const filename = filePath.split('/').pop() || '';
  const slug = filename.replace('.astro', '');
  
  // 提取语言 path
  const pathParts = filePath.split('/');
  const toolsIndex = pathParts.indexOf('tools');
  let lang = 'en';
  if (toolsIndex > 0 && pathParts[toolsIndex - 1] !== 'pages') {
    lang = pathParts[toolsIndex - 1];
  } else if (filePath.includes('/zh/')) {
    lang = 'zh';
  }

  // 正则解析 .astro 源码中的元数据
  let meta: any = module?.frontmatter || module?.toolMeta || module?.toolInfo || {};
  const rawContent = (rawToolFiles[filePath] as any)?.default || '';
  if (rawContent) {
    try {
      const match = rawContent.match(/(?:export\s+)?const\s+(?:frontmatter|toolMeta|toolInfo|meta)\s*=\s*(\{[\s\S]*?\});/);
      if (match && match[1]) {
        const parsed = new Function(`return ${match[1]}`)();
        meta = { ...meta, ...parsed };
      }
    } catch (e) {}
  }

  const kvData = kvToolsConfigMap.get(slug) || {};

  const name = (kvData.name && kvData.name.trim() !== '' && kvData.name !== slug) ? kvData.name : (meta.title || meta.name || slug);
  const icon = (kvData.icon && kvData.icon.trim() !== '' && kvData.icon !== '🛠️') ? kvData.icon : (meta.icon || '🛠️');
  const category = (kvData.category && kvData.category.trim() !== '' && kvData.category !== 'general') ? kvData.category : (meta.tag || meta.category || 'general');

  return {
    id: slug,
    slug: slug,
    lang: lang,
    name: name,
    icon: icon,
    category: category,
    url: `/${lang}/tools/${slug}/`,
    defaultPriority: meta.priority || 10,
    defaultPinned: meta.pinned || false, // 👈 规则 1：完美获取前端配置中的 pinned 状态
    status: kvData.status || 'active',
    type: 'tool' as const,
  };
});

// 提取全语言广告赞助集合
const allSponsorItems = sponsorItems || {};
---

<AdminLayout title="综合排序与广告到期管理">
  <style>
    .action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      background: var(--admin-card);
      padding: 1rem 1.5rem;
      border-radius: 12px;
      border: 1px solid var(--admin-border);
    }

    .lang-select {
      background: #0b0f17;
      color: #fff;
      border: 1px solid #3b82f6;
      padding: 0.45em 0.8em;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      outline: none;
    }

    .tools-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--admin-card);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--admin-border);
      font-size: 0.88rem;
    }

    .tools-table th, .tools-table td {
      padding: 0.9rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--admin-border);
      vertical-align: middle;
    }

    .tools-table th {
      background: rgba(255, 255, 255, 0.02);
      color: var(--admin-muted);
      font-weight: 700;
    }

    .input-priority {
      width: 75px;
      background: var(--admin-bg);
      border: 1px solid var(--admin-border);
      color: #fff;
      padding: 0.4em 0.6em;
      border-radius: 6px;
      font-weight: 700;
      text-align: center;
      outline: none;
    }
    .input-priority:focus { border-color: var(--admin-accent); }

    .input-date {
      background: var(--admin-bg);
      border: 1px solid var(--admin-border);
      color: #fff;
      padding: 0.35em 0.5em;
      border-radius: 6px;
      font-size: 0.8rem;
      outline: none;
    }

    .badge {
      padding: 0.2em 0.6em;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 800;
    }

    .badge-sponsor {
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .badge-pinned {
      background: rgba(245, 158, 11, 0.2);
      color: #f59e0b;
      border: 1px solid rgba(245, 158, 11, 0.4);
    }

    .badge-expired {
      background: rgba(239, 68, 68, 0.15);
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-primary {
      background: var(--admin-accent);
      border: none;
      color: #fff;
      padding: 0.6em 1.2em;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .btn-primary:hover { opacity: 0.9; }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      border: 1px solid var(--admin-border);
      padding: 0.6em 1.2em;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
    }

    /* Modal 弹窗样式 */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }

    .modal-box {
      background: #111827;
      border: 1px solid #374151;
      border-radius: 12px;
      width: 550px;
      max-width: 90vw;
      padding: 1.5rem;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .form-group { margin-bottom: 1rem; }
    .form-group label {
      display: block;
      font-size: 0.82rem;
      font-weight: 700;
      color: #d1d5db;
      margin-bottom: 0.4rem;
    }

    .form-control {
      width: 100%;
      background: #0b0f17;
      border: 1px solid #374151;
      color: #fff;
      padding: 0.55rem 0.75rem;
      border-radius: 6px;
      font-size: 0.88rem;
      box-sizing: border-box;
    }
    .form-control:focus { border-color: #3b82f6; outline: none; }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.8rem;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid #1f2937;
    }
  </style>

  <div class="action-bar">
    <div style="display:flex; align-items:center; gap:1.2rem;">
      <div>
        <h3 style="margin:0 0 0.2rem 0; color:#fff; font-size:1.1rem;">全域综合排序与广告到期规则</h3>
        <p style="margin:0; color:var(--admin-muted); font-size:0.82rem;">广告项到期后将自动恢复为默认顺序与置顶状态</p>
      </div>
      
      <select class="lang-select" id="langSelect" onchange="switchLanguage(this.value)">
        <option value="zh">🇨🇳 中文 (ZH)</option>
        <option value="en">🇺🇸 English (EN)</option>
        <option value="ja">🇯🇵 日本語 (JA)</option>
        <option value="ko">🇰🇷 한국어 (KO)</option>
        <option value="de">🇩🇪 Deutsch (DE)</option>
      </select>
    </div>

    <div style="display:flex; gap:0.8rem;">
      <button class="btn-secondary" onclick="openAddSponsorModal()">➕ 新增广告</button>
      <button class="btn-primary" id="btnSaveSorting" type="button">💾 保存综合排序</button>
    </div>
  </div>

  <table class="tools-table">
    <thead>
      <tr>
        <th>卡片名称与路径</th>
        <th>分类</th>
        <th>排序权重 (Priority)</th>
        <th>置顶状态</th>
        <th>广告到期恢复日期 (Expires)</th>
        <th>预览</th>
      </tr>
    </thead>
    <tbody id="sortingTbody">
      <tr>
        <td colspan="6" style="text-align:center; color:var(--admin-muted);">正在同步与计算排序数据...</td>
      </tr>
    </tbody>
  </table>

  <!-- 新增广告 Modal -->
  <div id="addSponsorModal" class="modal-overlay" style="display: none;">
    <div class="modal-box">
      <h3 style="margin-top:0; color:#fff; font-size:1.1rem;">📢 新增广告卡片</h3>
      
      <div class="form-row">
        <div class="form-group">
          <label>投放语言 *</label>
          <select id="adLang" class="form-control">
            <option value="zh">🇨🇳 中文 (ZH)</option>
            <option value="en">🇺🇸 English (EN)</option>
            <option value="ja">🇯🇵 日本語 (JA)</option>
            <option value="ko">🇰🇷 한국어 (KO)</option>
            <option value="de">🇩🇪 Deutsch (DE)</option>
          </select>
        </div>
        <div class="form-group">
          <label>图标 / Emoji *</label>
          <input type="text" id="adIcon" class="form-control" value="💎" />
        </div>
      </div>

      <div class="form-group">
        <label>广告标题 *</label>
        <input type="text" id="adTitle" class="form-control" placeholder="例如：Cloudflare 高速 CDN 赞助" />
      </div>

      <div class="form-group">
        <label>跳转链接 URL *</label>
        <input type="url" id="adUrl" class="form-control" placeholder="https://example.com" />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>标签分类</label>
          <input type="text" id="adTag" class="form-control" value="赞助推广" />
        </div>
        <div class="form-group">
          <label>排序权重 (Priority)</label>
          <input type="number" id="adPriority" class="form-control" value="100" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>到期日期 (Expires)</label>
          <input type="date" id="adExpires" class="form-control" />
        </div>
        <div class="form-group" style="display:flex; align-items:flex-end;">
          <label style="cursor:pointer; display:flex; align-items:center; gap:0.5rem; margin-bottom:0.6rem;">
            <input type="checkbox" id="adPinned" checked />
            <span style="color:#fff;">📌 默认高亮置顶</span>
          </label>
        </div>
      </div>

      <div class="modal-actions">
        <button class="btn-secondary" onclick="closeAddSponsorModal()">取消</button>
        <button class="btn-primary" onclick="submitNewSponsor()">确认添加广告</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ autoDiscoveredTools, allSponsorItems }}>
    let currentLang = 'zh';
    let currentSortingList = [];

    window.switchLanguage = function(lang) {
      currentLang = lang;
      fetchAndMergeSortingConfig();
    };

    async function fetchAndMergeSortingConfig() {
      try {
        const tbody = document.getElementById('sortingTbody');
        if (tbody) tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--admin-muted);">正在加载 [${currentLang.toUpperCase()}] 排序数据...</td></tr>`;

        // 1. 获取对应语言的 工具管理 KV (tools_v2_zh)
        const toolsRes = await fetch(`/api/admin/config?type=tools_v2_${currentLang}`);
        const toolsJson = await toolsRes.json();
        const kvToolsMap = new Map();

        if (toolsJson.success && Array.isArray(toolsJson.data)) {
          toolsJson.data.forEach(t => { if (t.slug) kvToolsMap.set(t.slug, t); });
        }

        // 2. 过滤并提取对应语言的离线扫描工具
        const langDiscovered = autoDiscoveredTools.filter(t => t.lang === currentLang || (currentLang === 'zh' && t.lang === 'zh'));

        const toolsForLang = langDiscovered.map(localTool => {
          const kvData = kvToolsMap.get(localTool.slug);
          if (kvData) {
            return {
              ...localTool,
              name: (kvData.name && kvData.name.trim() !== '' && kvData.name !== localTool.slug) ? kvData.name : localTool.name,
              icon: (kvData.icon && kvData.icon.trim() !== '' && kvData.icon !== '🛠️') ? kvData.icon : localTool.icon,
              category: (kvData.category && kvData.category.trim() !== '' && kvData.category !== 'general') ? kvData.category : localTool.category,
              status: kvData.status || localTool.status
            };
          }
          return localTool;
        });

        // 3. 提取对应语言的赞助广告
        const sponsorsForLang = (allSponsorItems[currentLang] || []).map((sponsor) => ({
          id: sponsor.url,
          slug: sponsor.url,
          lang: currentLang,
          name: sponsor.title,
          icon: sponsor.icon || '💎',
          category: sponsor.tag || '赞助推广',
          url: sponsor.url,
          defaultPriority: sponsor.priority || 0,
          defaultPinned: sponsor.pinned || false, // 👈 规则 1：获取广告配置中的 pinned 状态
          status: 'active',
          type: 'sponsor'
        }));

        const fullMasterList = [...toolsForLang, ...sponsorsForLang];

        // 4. 读取对应语言的 综合排序 KV (config_sorting_v3 / sorting_v3_zh)
        const sortType = currentLang === 'zh' ? 'sorting_v3' : `sorting_v3_${currentLang}`;
        const sortRes = await fetch(`/api/admin/config?type=${sortType}`);
        const sortJson = await sortRes.json();
        const kvSortConfig = (sortJson.success && sortJson.data) ? sortJson.data : {};

        // 5. 比对到期日期与重新计权
        const now = new Date().getTime();

        currentSortingList = fullMasterList.map((item) => {
          const conf = kvSortConfig[item.id];
          let isExpired = false;

          if (conf?.expiresAt && item.type === 'sponsor') {
            const expTime = new Date(conf.expiresAt).getTime();
            if (now > expTime) isExpired = true;
          }

          // 👈 规则 1 修复：在没有手动设置 KV 覆盖时，完全使用 item.defaultPinned (前端源码) 补全置顶显示
          const pinnedState = (conf && conf.pinned !== undefined) ? (isExpired ? false : Boolean(conf.pinned)) : item.defaultPinned;
          const priorityVal = (conf && conf.priority !== undefined) ? (isExpired ? item.defaultPriority : Number(conf.priority)) : item.defaultPriority;

          return {
            ...item,
            priority: priorityVal,
            pinned: pinnedState,
            status: conf?.status || item.status || 'active',
            expiresAt: conf?.expiresAt || '',
            isExpired,
          };
        });

        // 排序：置顶优先 -> Priority 降序
        currentSortingList.sort((a, b) => {
          if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
          return b.priority - a.priority;
        });

        renderTable();
      } catch (e) {
        alert('读取排序配置失败: ' + e.message);
      }
    }

    function renderTable() {
      const tbody = document.getElementById('sortingTbody');
      if (!tbody) return;

      if (currentSortingList.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--admin-muted);">当前语言分类下无相关工具或广告</td></tr>`;
        return;
      }

      tbody.innerHTML = currentSortingList.map((item) => `
        <tr data-id="${item.id}" data-type="${item.type}">
          <td>
            <div style="font-weight: 700; display: flex; align-items: center; gap: 0.5rem; color:#fff;">
              <span style="font-size:1.2rem;">${item.icon}</span>
              <span>${item.name}</span>
              ${item.type === 'sponsor' ? '<span class="badge badge-sponsor">💎 赞助广告</span>' : ''}
            </div>
            <div style="font-size: 0.75rem; color: var(--admin-muted); margin-top: 0.2rem;">
              <code>${item.url}</code>
            </div>
          </td>
          <td>
            <span style="background:rgba(255,255,255,0.06); padding:0.2em 0.5em; border-radius:4px; font-size:0.78rem;">
              ${item.category}
            </span>
          </td>
          <td>
            <input class="input-priority" type="number" value="${item.priority}" />
          </td>
          <td>
            <label style="cursor: pointer; display: flex; align-items: center; gap: 0.4rem;">
              <input class="check-pinned" type="checkbox" ${item.pinned ? 'checked' : ''} />
              <span class="${item.pinned ? 'badge badge-pinned' : ''}">
                ${item.pinned ? '📌 已置顶' : '普通'}
              </span>
            </label>
          </td>
          <td>
            <!-- 👈 规则 3 修复：仅限赞助广告显示日期选择，工具项显示破折号 -->
            ${item.type === 'sponsor' ? `
              <input
                class="input-date"
                type="date"
                value="${item.expiresAt ? item.expiresAt.slice(0, 10) : ''}"
              />
              ${item.isExpired ? '<span class="badge badge-expired" style="margin-left: 0.3rem;">⏰ 已过期恢复</span>' : ''}
            ` : '<span style="color:var(--admin-muted);">—</span>'}
          </td>
          <td>
            <a
              href="${item.url}"
              target="_blank"
              style="color: var(--admin-accent); font-weight: 700; text-decoration: none; font-size: 0.82rem;"
            >
              🔗 打开
            </a>
          </td>
        </tr>
      `).join('');
    }

    /* 👈 规则 4：新增广告弹窗控制函数 */
    window.openAddSponsorModal = function() {
      document.getElementById('adLang').value = currentLang;
      document.getElementById('addSponsorModal').style.display = 'flex';
    };

    window.closeAddSponsorModal = function() {
      document.getElementById('addSponsorModal').style.display = 'none';
    };

    window.submitNewSponsor = function() {
      const lang = document.getElementById('adLang').value;
      const icon = document.getElementById('adIcon').value || '💎';
      const title = document.getElementById('adTitle').value.trim();
      const url = document.getElementById('adUrl').value.trim();
      const tag = document.getElementById('adTag').value.trim() || '赞助推广';
      const priority = Number(document.getElementById('adPriority').value) || 100;
      const dateVal = document.getElementById('adExpires').value;
      const pinned = document.getElementById('adPinned').checked;

      if (!title || !url) {
        alert('请填写广告标题与跳转链接 URL！');
        return;
      }

      const expiresAt = dateVal ? new Date(`${dateVal}T23:59:59Z`).toISOString() : null;

      const newSponsorItem = {
        id: url,
        slug: url,
        lang: lang,
        name: title,
        icon: icon,
        category: tag,
        url: url,
        priority: priority,
        defaultPriority: priority,
        pinned: pinned,
        defaultPinned: pinned,
        expiresAt: expiresAt,
        status: 'active',
        type: 'sponsor'
      };

      currentSortingList.unshift(newSponsorItem);
      renderTable();
      closeAddSponsorModal();
      alert(`✅ 已添加广告，请点击“💾 保存综合排序”提交生效！`);
    };

    document.getElementById('btnSaveSorting')?.addEventListener('click', async () => {
      const btn = document.getElementById('btnSaveSorting');
      btn.textContent = '⏳ 保存中...';
      btn.disabled = true;

      const rows = document.querySelectorAll('#sortingTbody tr');
      const configData = {};

      rows.forEach((row) => {
        const id = row.dataset.id;
        const type = row.dataset.type;
        const priorityInput = row.querySelector('.input-priority');
        const pinnedInput = row.querySelector('.check-pinned');
        const dateInput = row.querySelector('.input-date');

        if (id && priorityInput) {
          const priority = Number(priorityInput.value);
          const pinned = pinnedInput.checked;
          const dateVal = dateInput ? dateInput.value : '';

          const expiresAt = dateVal ? new Date(`${dateVal}T23:59:59Z`).toISOString() : null;
          configData[id] = { priority, pinned, status: 'active', expiresAt, type };
        }
      });

      try {
        const sortType = currentLang === 'zh' ? 'sorting_v3' : `sorting_v3_${currentLang}`;
        const res = await fetch('/api/admin/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: sortType, configData })
        });

        const data = await res.json();
        if (data.success) {
          alert(`🎉 [${currentLang.toUpperCase()}] 综合排序配置已成功保存至 Cloudflare KV！`);
          fetchAndMergeSortingConfig();
        } else {
          alert('保存失败：' + (data.message || '未知错误'));
        }
      } catch (err) {
        alert('网络同步失败，请检查登录状态或 KV 绑定');
      } finally {
        btn.textContent = '💾 保存综合排序';
        btn.disabled = false;
      }
    });

    fetchAndMergeSortingConfig();
  </script>
</AdminLayout>
