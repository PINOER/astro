---
// src/pages/admin/tools-config.astro
import AdminLayout from 'src/layouts/AdminLayout.astro';

export const prerender = false;

// 1. 服务端 SSR 阶段自动扫描所有多语言工具页面，全量抽取前台原本定义的 title, description, icon, category
const allToolModules = import.meta.glob('/src/pages/**/tools/*.astro', { eager: true });

const autoDiscoveredTools = Object.entries(allToolModules).map(([filePath, module]: [string, any]) => {
  const filename = filePath.split('/').pop() || '';
  const slug = filename.replace('.astro', '');
  
  // 从文件路径提取语言类型 (如: /src/pages/zh/tools/xxx -> zh)
  const pathParts = filePath.split('/');
  const toolsIndex = pathParts.indexOf('tools');
  let lang = 'en';
  if (toolsIndex > 0 && pathParts[toolsIndex - 1] !== 'pages') {
    lang = pathParts[toolsIndex - 1];
  } else if (filePath.includes('/zh/')) {
    lang = 'zh';
  }

  // 🔑 重点：全方位提取前台组件导出的元数据 (优先读取 toolMeta -> 其次 frontmatter -> 其次 toolInfo)
  const meta = module?.toolMeta || module?.frontmatter || module?.toolInfo || {};
  
  const pageTitle = meta.title || meta.name || slug;
  const description = meta.description || meta.desc || '';
  const icon = meta.icon || '🛠️';
  const category = meta.category || meta.tag || 'general';

  return {
    slug: slug,
    lang: lang,
    astroComponent: filePath,
    name: pageTitle,       // 👈 完美同步前台默认名称
    description: description, // 👈 完美同步前台默认简介
    icon: icon,            // 👈 完美同步前台默认图标
    category: category,    // 👈 完美同步前台默认分类
    priority: meta.priority || 10,
    status: 'active',
    seoTitle: '',
    seoDescription: ''
  };
});
---

<AdminLayout title="🛠️ 工具管理 (Tools Management)">
  <style>
    .action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      background: var(--admin-card, #111827);
      padding: 1rem 1.5rem;
      border-radius: 12px;
      border: 1px solid var(--admin-border, #1f2937);
    }

    .lang-select {
      background: #0b0f17;
      color: #fff;
      border: 1px solid #3b82f6;
      padding: 0.45em 0.8em;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      outline: none;
    }

    .btn-primary {
      background: #3b82f6;
      color: #fff;
      border: none;
      padding: 0.6em 1.2em;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-primary:hover { background: #2563eb; }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      border: 1px solid #374151;
      padding: 0.4em 0.8em;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.82rem;
    }
    .btn-secondary:hover { background: rgba(255, 255, 255, 0.15); }

    .tools-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--admin-card, #111827);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--admin-border, #1f2937);
    }

    .tools-table th, .tools-table td {
      padding: 0.9rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--admin-border, #1f2937);
      font-size: 0.88rem;
    }

    .tools-table th {
      background: rgba(255, 255, 255, 0.02);
      color: #9ca3af;
      font-weight: 700;
    }

    .status-select {
      background: #0b0f17;
      color: #fff;
      border: 1px solid #374151;
      padding: 0.3em 0.5em;
      border-radius: 6px;
      font-size: 0.82rem;
    }

    .readonly-field {
      background: rgba(255, 255, 255, 0.04) !important;
      color: #9ca3af !important;
      cursor: not-allowed !important;
      border-color: #1f2937 !important;
    }

    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }

    .modal-box {
      background: #111827;
      border: 1px solid #374151;
      border-radius: 12px;
      width: 650px;
      max-width: 90vw;
      max-height: 85vh;
      overflow-y: auto;
      padding: 1.5rem;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .form-group { margin-bottom: 1.1rem; }
    .form-group label {
      display: block;
      font-size: 0.82rem;
      font-weight: 700;
      color: #d1d5db;
      margin-bottom: 0.4rem;
    }

    .form-control {
      width: 100%;
      background: #0b0f17;
      border: 1px solid #374151;
      color: #fff;
      padding: 0.55rem 0.75rem;
      border-radius: 6px;
      font-size: 0.88rem;
      box-sizing: border-box;
    }
    .form-control:focus { border-color: #3b82f6; outline: none; }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.8rem;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid #1f2937;
    }
  </style>

  <div class="action-bar">
    <div style="display:flex; align-items:center; gap:1rem;">
      <span style="font-weight:700; color:#fff;">🛠️ 真实工具管理中心</span>
      
      <select class="lang-select" id="langSelect" onchange="switchLanguage(this.value)">
        <option value="zh">🇨🇳 中文 (ZH)</option>
        <option value="en">🇺🇸 English (EN)</option>
        <option value="ja">🇯🇵 日本語 (JA)</option>
        <option value="ko">🇰🇷 한국어 (KO)</option>
        <option value="de">🇩🇪 Deutsch (DE)</option>
      </select>
    </div>
    
    <button class="btn-primary" id="btnSaveConfig">💾 保存配置至 Cloudflare KV</button>
  </div>

  <table class="tools-table">
    <thead>
      <tr>
        <th style="width: 50px;">图标</th>
        <th>工具展示名称</th>
        <th>URL Slug</th>
        <th>分类</th>
        <th style="width: 90px;">排序权重</th>
        <th>状态</th>
        <th style="width: 100px;">操作</th>
      </tr>
    </thead>
    <tbody id="toolsTableBody">
      <tr>
        <td colspan="7" style="text-align:center; color:#9ca3af;">正在同步数据中...</td>
      </tr>
    </tbody>
  </table>

  <!-- 编辑 Modal -->
  <div id="editModal" class="modal-overlay" style="display: none;">
    <div class="modal-box">
      <h3 style="margin-top:0; color:#fff; font-size:1.1rem;" id="modalTitle">编辑工具属性</h3>
      
      <div class="form-row">
        <div class="form-group">
          <label>工具展示名称 *</label>
          <input type="text" id="editName" class="form-control" />
        </div>
        <div class="form-group">
          <label>URL Slug (物理绑定)</label>
          <input type="text" id="editSlug" class="form-control readonly-field" readonly />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>分类 (Category ID) *</label>
          <input type="text" id="editCategory" class="form-control" />
        </div>
        <div class="form-group">
          <label>图标 / Emoji</label>
          <input type="text" id="editIcon" class="form-control" />
        </div>
      </div>

      <div class="form-group">
        <div class="form-row">
          <div>
            <label>默认排序权重 (越大越靠前)</label>
            <input type="number" id="editPriority" class="form-control" value="10" />
          </div>
          <div>
            <label>Astro 文件路径 (物理绑定)</label>
            <input type="text" id="editAstroComponent" class="form-control readonly-field" readonly />
          </div>
        </div>
      </div>

      <div class="form-group">
        <label>工具简短描述 (Description)</label>
        <textarea id="editDescription" class="form-control" rows="2"></textarea>
      </div>

      <hr style="border: 0; border-top: 1px solid #1f2937; margin: 1.2rem 0;" />
      <div style="font-weight:700; color:#3b82f6; margin-bottom:0.8rem; font-size:0.88rem;">🔍 SEO 优化配置</div>

      <div class="form-group">
        <label>SEO Title (自定义网页标题)</label>
        <input type="text" id="editSeoTitle" class="form-control" placeholder="留空则默认使用工具展示名称" />
      </div>

      <div class="form-group">
        <label>Meta Description (SEO 搜索元描述)</label>
        <textarea id="editSeoDescription" class="form-control" rows="2" placeholder="专供 Google / AI Search 的网页摘要..."></textarea>
      </div>

      <div class="modal-actions">
        <button class="btn-secondary" onclick="closeModal()">取消</button>
        <button class="btn-primary" onclick="saveModalChanges()">确认修改</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ autoDiscoveredTools }}>
    let currentLang = 'zh';
    let currentFilteredTools = [];
    let currentEditIndex = -1;

    window.switchLanguage = function(lang) {
      currentLang = lang;
      fetchAndMergeToolsConfig();
    };

    async function fetchAndMergeToolsConfig() {
      try {
        const configType = `tools_v2_${currentLang}`;
        const res = await fetch(`/api/admin/config?type=${configType}`);
        const json = await res.json();
        const kvToolsMap = new Map();

        if (json.success && json.data && Array.isArray(json.data)) {
          json.data.forEach(item => {
            if (item.slug) kvToolsMap.set(item.slug, item);
          });
        }

        const langDiscovered = autoDiscoveredTools.filter(t => t.lang === currentLang || (currentLang === 'zh' && t.lang === 'zh'));

        // 🔑 核心合并规则：
        // 以物理文件提取出的“前台原生默认值”为底层 base，如果 KV 中有修改记录则覆盖；KV 中未修改的字段自动保持前台默认值！
        currentFilteredTools = (langDiscovered.length > 0 ? langDiscovered : autoDiscoveredTools).map(localTool => {
          const kvData = kvToolsMap.get(localTool.slug);
          if (kvData) {
            return {
              ...localTool,
              // 仅当 KV 中的字符串不为空时覆盖前台值
              name: (kvData.name && kvData.name.trim() !== '') ? kvData.name : localTool.name,
              description: (kvData.description && kvData.description.trim() !== '') ? kvData.description : localTool.description,
              icon: (kvData.icon && kvData.icon.trim() !== '') ? kvData.icon : localTool.icon,
              category: (kvData.category && kvData.category.trim() !== '') ? kvData.category : localTool.category,
              priority: kvData.priority !== undefined ? kvData.priority : localTool.priority,
              status: kvData.status || localTool.status,
              seoTitle: kvData.seoTitle || '',
              seoDescription: kvData.seoDescription || ''
            };
          }
          return localTool;
        });

        renderTable();
      } catch (e) {
        alert('加载工具配置失败: ' + e.message);
      }
    }

    function renderTable() {
      const tbody = document.getElementById('toolsTableBody');
      if (!tbody) return;

      tbody.innerHTML = currentFilteredTools.map((tool, index) => `
        <tr>
          <td style="font-size:1.3rem; text-align:center;">${tool.icon || '🛠️'}</td>
          <td>
            <div style="font-weight:700; color:#fff;">${tool.name || tool.slug}</div>
          </td>
          <td style="font-size:0.75rem; color:#9ca3af; font-family:monospace;">/${tool.slug}</td>
          <td><span style="background:rgba(255,255,255,0.06); padding:0.2em 0.5em; border-radius:4px; font-size:0.78rem;">${tool.category || 'general'}</span></td>
          <td><strong style="color:#3b82f6;">${tool.priority ?? 10}</strong></td>
          <td>
            <select class="status-select" onchange="updateStatus(${index}, this.value)">
              <option value="active" ${tool.status === 'active' ? 'selected' : ''}>🟢 开启</option>
              <option value="disabled" ${tool.status === 'disabled' ? 'selected' : ''}>🔴 禁用(404)</option>
              <option value="maintenance" ${tool.status === 'maintenance' ? 'selected' : ''}>🟡 维护</option>
            </select>
          </td>
          <td>
            <button class="btn-secondary" onclick="openEditModal(${index})">✏️ 编辑</button>
          </td>
        </tr>
      `).join('');
    }

    window.updateStatus = function(index, value) { currentFilteredTools[index].status = value; };

    window.openEditModal = function(index) {
      currentEditIndex = index;
      const tool = currentFilteredTools[index];

      document.getElementById('modalTitle').innerText = `编辑工具 [${currentLang.toUpperCase()}]: ${tool.name || tool.slug}`;
      document.getElementById('editName').value = tool.name || tool.slug;
      document.getElementById('editSlug').value = tool.slug;
      document.getElementById('editCategory').value = tool.category || '';
      document.getElementById('editIcon').value = tool.icon || '';
      document.getElementById('editPriority').value = tool.priority ?? 10;
      document.getElementById('editAstroComponent').value = tool.astroComponent;
      document.getElementById('editDescription').value = tool.description || '';
      document.getElementById('editSeoTitle').value = tool.seoTitle || '';
      document.getElementById('editSeoDescription').value = tool.seoDescription || '';

      document.getElementById('editModal').style.display = 'flex';
    };

    window.closeModal = function() {
      document.getElementById('editModal').style.display = 'none';
    };

    window.saveModalChanges = function() {
      if (currentEditIndex < 0) return;

      currentFilteredTools[currentEditIndex].name = document.getElementById('editName').value;
      currentFilteredTools[currentEditIndex].category = document.getElementById('editCategory').value;
      currentFilteredTools[currentEditIndex].icon = document.getElementById('editIcon').value;
      currentFilteredTools[currentEditIndex].priority = parseInt(document.getElementById('editPriority').value) || 0;
      currentFilteredTools[currentEditIndex].description = document.getElementById('editDescription').value;
      currentFilteredTools[currentEditIndex].seoTitle = document.getElementById('editSeoTitle').value;
      currentFilteredTools[currentEditIndex].seoDescription = document.getElementById('editSeoDescription').value;

      renderTable();
      closeModal();
    };

    document.getElementById('btnSaveConfig')?.addEventListener('click', async () => {
      try {
        const configType = `tools_v2_${currentLang}`;
        const res = await fetch('/api/admin/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: configType,
            configData: currentFilteredTools
          })
        });
        const json = await res.json();
        if (json.success) {
          alert(`✅ [${currentLang.toUpperCase()}] ` + json.message);
        } else {
          alert('❌ 保存失败: ' + (json.message || json.error));
        }
      } catch (e) {
        alert('保存网络异常: ' + e.message);
      }
    });

    fetchAndMergeToolsConfig();
  </script>
</AdminLayout>
