---
// src/pages/admin/tools-config.astro
import AdminLayout from 'src/layouts/AdminLayout.astro';

export const prerender = false;

// 1. 内置常用工具的中文名映射表（如果页面本身未导出 title，优先匹配此字典）
const TOOL_NAME_MAP: Record<string, string> = {
  'image-base64-converter': '图片转 Base64 & DataURI 工具',
  'base64-url-converter': 'Base64 & URL 编解码工具',
  'json-converter': 'JSON 格式化 & 语法校验工具',
  'json-to-ts': 'JSON 转 TypeScript 类型定义',
  'json-yaml-converter': 'JSON / YAML 互转工具',
  'markdown-cleaner': 'Markdown 排版与格式清理',
  'seo-meta-generator': 'Google SEO Meta 标签生成器',
  'ecommerce-seo-geo-generator': '电商 SEO & GEO 文案生成器',
  'token-calculator': 'LLM Token 消耗与上下文计算器',
  'compound-interest-fire-calculator': '复利 & FIRE 退休计算器',
  'c-text-adventure-builder': 'C 语言地牢文字冒险构建器',
  'hanoi-algorithm-visualizer': '汉诺塔算法可视化运行器',
  'laser-mirror-puzzle': '激光折射镜片解谜游戏',
  'logic-circuit-puzzle': '逻辑门电路设计解谜',
  'kids-maze-robot': '儿童编程迷宫机器人'
};

// 2. 服务端自动扫描所有多语言版本的工具页面文件
const allToolModules = import.meta.glob('/src/pages/**/tools/*.astro', { eager: true });

const autoDiscoveredTools = Object.entries(allToolModules).map(([filePath, module]: [string, any]) => {
  const filename = filePath.split('/').pop() || '';
  const slug = filename.replace('.astro', '');
  
  // 判断文件所属语言环境 (默认为 en，包含 /zh/ 的为 zh)
  const lang = filePath.includes('/zh/') ? 'zh' : 'en';
  
  // 智能推导友好显示名称：优先读取页面导出的 title/frontmatter -> 其次匹配预设字典 -> 最后使用 slug
  const pageTitle = module?.title || module?.frontmatter?.title;
  const friendlyName = pageTitle || (lang === 'zh' ? (TOOL_NAME_MAP[slug] || slug) : slug);

  return {
    slug: slug,
    lang: lang,
    astroComponent: filePath,
    name: friendlyName, // 解决文件名问题
    category: 'general',
    icon: '🛠️',
    priority: 10,
    status: 'active',
    description: '',
    seoTitle: '',
    seoDescription: ''
  };
});
---

<AdminLayout title="🛠️ 工具管理 (Tools Management)">
  <style>
    .action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      background: var(--admin-card, #111827);
      padding: 1rem 1.5rem;
      border-radius: 12px;
      border: 1px solid var(--admin-border, #1f2937);
    }

    .lang-switcher {
      display: flex;
      background: #0b0f17;
      border: 1px solid #374151;
      border-radius: 8px;
      padding: 3px;
      gap: 3px;
    }

    .lang-btn {
      background: transparent;
      border: none;
      color: #9ca3af;
      padding: 0.4em 0.9em;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }

    .lang-btn.active {
      background: #3b82f6;
      color: #fff;
    }

    .btn-primary {
      background: #3b82f6;
      color: #fff;
      border: none;
      padding: 0.6em 1.2em;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-primary:hover { background: #2563eb; }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      border: 1px solid #374151;
      padding: 0.4em 0.8em;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.82rem;
    }
    .btn-secondary:hover { background: rgba(255, 255, 255, 0.15); }

    .tools-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--admin-card, #111827);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--admin-border, #1f2937);
    }

    .tools-table th, .tools-table td {
      padding: 0.9rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--admin-border, #1f2937);
      font-size: 0.88rem;
    }

    .tools-table th {
      background: rgba(255, 255, 255, 0.02);
      color: #9ca3af;
      font-weight: 700;
    }

    .status-select {
      background: #0b0f17;
      color: #fff;
      border: 1px solid #374151;
      padding: 0.3em 0.5em;
      border-radius: 6px;
      font-size: 0.82rem;
    }

    .readonly-field {
      background: rgba(255, 255, 255, 0.04) !important;
      color: #9ca3af !important;
      cursor: not-allowed !important;
      border-color: #1f2937 !important;
    }

    /* Modal 编辑弹窗样式 */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }

    .modal-box {
      background: #111827;
      border: 1px solid #374151;
      border-radius: 12px;
      width: 650px;
      max-width: 90vw;
      max-height: 85vh;
      overflow-y: auto;
      padding: 1.5rem;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .form-group { margin-bottom: 1.1rem; }
    .form-group label {
      display: block;
      font-size: 0.82rem;
      font-weight: 700;
      color: #d1d5db;
      margin-bottom: 0.4rem;
    }

    .form-control {
      width: 100%;
      background: #0b0f17;
      border: 1px solid #374151;
      color: #fff;
      padding: 0.55rem 0.75rem;
      border-radius: 6px;
      font-size: 0.88rem;
      box-sizing: border-box;
    }
    .form-control:focus { border-color: #3b82f6; outline: none; }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.8rem;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid #1f2937;
    }
  </style>

  <div class="action-bar">
    <div style="display:flex; align-items:center; gap:1rem;">
      <span style="font-weight:700; color:#fff;">🛠️ 真实工具联动控制台</span>
      
      <!-- 🌐 多语言切换 Bar -->
      <div class="lang-switcher">
        <button class="lang-btn active" id="btnLangZh" onclick="switchLanguage('zh')">🇨🇳 中文 (ZH)</button>
        <button class="lang-btn" id="btnLangEn" onclick="switchLanguage('en')">🇺🇸 English (EN)</button>
      </div>
    </div>
    
    <button class="btn-primary" id="btnSaveConfig">💾 保存当前语言配置</button>
  </div>

  <table class="tools-table">
    <thead>
      <tr>
        <th style="width: 50px;">图标</th>
        <th>工具展示名称</th>
        <th>URL Slug</th>
        <th>分类</th>
        <th style="width: 90px;">排序权重</th>
        <th>状态</th>
        <th style="width: 100px;">操作</th>
      </tr>
    </thead>
    <tbody id="toolsTableBody">
      <tr>
        <td colspan="7" style="text-align:center; color:#9ca3af;">正在加载工具列表中...</td>
      </tr>
    </tbody>
  </table>

  <!-- 编辑 Modal -->
  <div id="editModal" class="modal-overlay" style="display: none;">
    <div class="modal-box">
      <h3 style="margin-top:0; color:#fff; font-size:1.1rem;" id="modalTitle">编辑工具属性</h3>
      
      <div class="form-row">
        <div class="form-group">
          <label>工具展示名称 (前端显示) *</label>
          <input type="text" id="editName" class="form-control" placeholder="如: 图片转 Base64 & DataURI 工具" />
        </div>
        <div class="form-group">
          <label>URL Slug (物理绑定)</label>
          <input type="text" id="editSlug" class="form-control readonly-field" readonly />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>分类 (Category ID) *</label>
          <input type="text" id="editCategory" class="form-control" placeholder="如: financial / programming" />
        </div>
        <div class="form-group">
          <label>图标 / Emoji</label>
          <input type="text" id="editIcon" class="form-control" placeholder="如: 📈 或 ⚔️" />
        </div>
      </div>

      <div class="form-group">
        <div class="form-row">
          <div>
            <label>默认排序权重 (越大越靠前)</label>
            <input type="number" id="editPriority" class="form-control" value="10" />
          </div>
          <div>
            <label>Astro 文件路径 (物理绑定)</label>
            <input type="text" id="editAstroComponent" class="form-control readonly-field" readonly />
          </div>
        </div>
      </div>

      <div class="form-group">
        <label>工具简短描述 (Description)</label>
        <textarea id="editDescription" class="form-control" rows="2" placeholder="卡片展示的简介..."></textarea>
      </div>

      <hr style="border: 0; border-top: 1px solid #1f2937; margin: 1.2rem 0;" />
      <div style="font-weight:700; color:#3b82f6; margin-bottom:0.8rem; font-size:0.88rem;">🔍 SEO 优化配置</div>

      <div class="form-group">
        <label>SEO Title (自定义网页标题)</label>
        <input type="text" id="editSeoTitle" class="form-control" placeholder="留空则使用工具展示名称" />
      </div>

      <div class="form-group">
        <label>Meta Description (SEO 搜索元描述)</label>
        <textarea id="editSeoDescription" class="form-control" rows="2" placeholder="专供 Google / AI Search 的网页摘要..."></textarea>
      </div>

      <div class="modal-actions">
        <button class="btn-secondary" onclick="closeModal()">取消</button>
        <button class="btn-primary" onclick="saveModalChanges()">确认修改</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ autoDiscoveredTools }}>
    let currentLang = 'zh'; // 默认语言为中文
    let currentFilteredTools = [];
    let currentEditIndex = -1;

    // 切换语言版本 (zh / en)
    window.switchLanguage = function(lang) {
      currentLang = lang;
      document.getElementById('btnLangZh').classList.toggle('active', lang === 'zh');
      document.getElementById('btnLangEn').classList.toggle('active', lang === 'en');
      fetchAndMergeToolsConfig();
    };

    async function fetchAndMergeToolsConfig() {
      try {
        // 根据不同语言动态读取对应的 KV Key：config_tools_v2_zh 或 config_tools_v2_en
        const configType = `tools_v2_${currentLang}`;
        const res = await fetch(`/api/admin/config?type=${configType}`);
        const json = await res.json();
        const kvToolsMap = new Map();

        if (json.success && json.data && Array.isArray(json.data)) {
          json.data.forEach(item => {
            if (item.slug) kvToolsMap.set(item.slug, item);
          });
        }

        // 筛选出对应语言下的物理文件，并与 KV 配置做 Merge
        const langDiscovered = autoDiscoveredTools.filter(t => t.lang === currentLang);

        currentFilteredTools = langDiscovered.map(localTool => {
          const kvData = kvToolsMap.get(localTool.slug);
          if (kvData) {
            return {
              ...localTool,
              ...kvData, // 包含用户保存过的自定义中文/英文名称
              astroComponent: localTool.astroComponent,
              slug: localTool.slug
            };
          }
          return localTool;
        });

        renderTable();
      } catch (e) {
        alert('加载工具配置失败: ' + e.message);
      }
    }

    function renderTable() {
      const tbody = document.getElementById('toolsTableBody');
      if (!tbody) return;

      if (currentFilteredTools.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:#9ca3af;">未找到 ${currentLang.toUpperCase()} 语言版本下的工具文件</td></tr>`;
        return;
      }

      tbody.innerHTML = currentFilteredTools.map((tool, index) => `
        <tr>
          <td style="font-size:1.3rem; text-align:center;">${tool.icon || '🛠️'}</td>
          <td>
            <div style="font-weight:700; color:#fff;">${tool.name || tool.slug}</div>
          </td>
          <td style="font-size:0.75rem; color:#9ca3af; font-family:monospace;">/${tool.slug}</td>
          <td><span style="background:rgba(255,255,255,0.06); padding:0.2em 0.5em; border-radius:4px; font-size:0.78rem;">${tool.category || 'general'}</span></td>
          <td><strong style="color:#3b82f6;">${tool.priority ?? 10}</strong></td>
          <td>
            <select class="status-select" onchange="updateStatus(${index}, this.value)">
              <option value="active" ${tool.status === 'active' ? 'selected' : ''}>🟢 开启</option>
              <option value="disabled" ${tool.status === 'disabled' ? 'selected' : ''}>🔴 禁用(404)</option>
              <option value="maintenance" ${tool.status === 'maintenance' ? 'selected' : ''}>🟡 维护</option>
            </select>
          </td>
          <td>
            <button class="btn-secondary" onclick="openEditModal(${index})">✏️ 编辑</button>
          </td>
        </tr>
      `).join('');
    }

    window.updateStatus = function(index, value) { currentFilteredTools[index].status = value; };

    window.openEditModal = function(index) {
      currentEditIndex = index;
      const tool = currentFilteredTools[index];

      document.getElementById('modalTitle').innerText = `编辑工具 [${currentLang.toUpperCase()}]: ${tool.name || tool.slug}`;
      document.getElementById('editName').value = tool.name || tool.slug;
      document.getElementById('editSlug').value = tool.slug;
      document.getElementById('editCategory').value = tool.category || 'general';
      document.getElementById('editIcon').value = tool.icon || '🛠️';
      document.getElementById('editPriority').value = tool.priority ?? 10;
      document.getElementById('editAstroComponent').value = tool.astroComponent;
      document.getElementById('editDescription').value = tool.description || '';
      document.getElementById('editSeoTitle').value = tool.seoTitle || '';
      document.getElementById('editSeoDescription').value = tool.seoDescription || '';

      document.getElementById('editModal').style.display = 'flex';
    };

    window.closeModal = function() {
      document.getElementById('editModal').style.display = 'none';
    };

    window.saveModalChanges = function() {
      if (currentEditIndex < 0) return;

      currentFilteredTools[currentEditIndex].name = document.getElementById('editName').value;
      currentFilteredTools[currentEditIndex].category = document.getElementById('editCategory').value;
      currentFilteredTools[currentEditIndex].icon = document.getElementById('editIcon').value;
      currentFilteredTools[currentEditIndex].priority = parseInt(document.getElementById('editPriority').value) || 0;
      currentFilteredTools[currentEditIndex].description = document.getElementById('editDescription').value;
      currentFilteredTools[currentEditIndex].seoTitle = document.getElementById('editSeoTitle').value;
      currentFilteredTools[currentEditIndex].seoDescription = document.getElementById('editSeoDescription').value;

      renderTable();
      closeModal();
    };

    // 点击保存，按当前所选语言分发存储至 KV：config_tools_v2_zh 或 config_tools_v2_en
    document.getElementById('btnSaveConfig')?.addEventListener('click', async () => {
      try {
        const configType = `tools_v2_${currentLang}`;
        const res = await fetch('/api/admin/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: configType,
            configData: currentFilteredTools
          })
        });
        const json = await res.json();
        if (json.success) {
          alert(`✅ [${currentLang.toUpperCase()}] ` + json.message);
        } else {
          alert('❌ 保存失败: ' + (json.message || json.error));
        }
      } catch (e) {
        alert('保存网络异常: ' + e.message);
      }
    });

    fetchAndMergeToolsConfig();
  </script>
</AdminLayout>
