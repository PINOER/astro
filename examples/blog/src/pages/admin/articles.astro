---
// src/pages/admin/articles.astro
import AdminLayout from 'src/layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="博客文章管理 (Blog Management)">
  <style>
    .action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      background: var(--admin-card);
      padding: 1rem 1.5rem;
      border-radius: 12px;
      border: 1px solid var(--admin-border);
    }

    .lang-select {
      background: #0b0f17;
      color: #fff;
      border: 1px solid #3b82f6;
      padding: 0.45em 0.8em;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      outline: none;
    }

    .articles-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--admin-card);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--admin-border);
      font-size: 0.88rem;
    }

    .articles-table th, .articles-table td {
      padding: 0.85rem 0.8rem;
      border-bottom: 1px solid var(--admin-border);
      vertical-align: middle;
    }

    .articles-table th:first-child,
    .articles-table td:first-child {
      text-align: left;
    }

    .articles-table th:not(:first-child),
    .articles-table td:not(:first-child) {
      text-align: center;
    }

    .articles-table th {
      background: rgba(255, 255, 255, 0.02);
      color: var(--admin-muted);
      font-weight: 700;
    }

    .input-priority, .input-views {
      width: 52px;
      background: var(--admin-bg);
      border: 1px solid var(--admin-border);
      color: #fff;
      padding: 0.35em 0.3em;
      border-radius: 6px;
      font-weight: 700;
      text-align: center;
      outline: none;
      font-size: 0.85rem;
    }
    .input-priority:focus, .input-views:focus { border-color: var(--admin-accent); }

    .select-status {
      background: var(--admin-bg);
      border: 1px solid var(--admin-border);
      color: #fff;
      padding: 0.35em 0.5em;
      border-radius: 6px;
      font-size: 0.8rem;
      outline: none;
    }

    .badge {
      padding: 0.2em 0.6em;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 800;
      display: inline-block;
    }

    .badge-pinned {
      background: rgba(245, 158, 11, 0.2);
      color: #f59e0b;
      border: 1px solid rgba(245, 158, 11, 0.4);
    }

    .btn-primary {
      background: var(--admin-accent);
      border: none;
      color: #fff;
      padding: 0.6em 1.2em;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .btn-primary:hover { opacity: 0.9; }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      border: 1px solid var(--admin-border);
      padding: 0.6em 1.2em;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-action-edit {
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.3);
      color: #60a5fa;
      padding: 0.25em 0.55em;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      margin-right: 0.3rem;
    }
  </style>

  <div class="action-bar">
    <div style="display:flex; align-items:center; gap:1.2rem;">
      <div>
        <h3 style="margin:0 0 0.2rem 0; color:#fff; font-size:1.1rem;">📝 博客文章管理 (Blog Management)</h3>
        <p style="margin:0; color:var(--admin-muted); font-size:0.82rem;">实时双栏 Markdown 编辑、关联交互工具挂件与多语言 Slug 管理</p>
      </div>
      
      <select class="lang-select" id="langSelect" onchange="switchLanguage(this.value)">
        <option value="zh">🇨🇳 中文 (ZH)</option>
        <option value="en">🇺🇸 English (EN)</option>
        <option value="ja">🇯🇵 日本語 (JA)</option>
        <option value="ko">🇰🇷 한국어 (KO)</option>
        <option value="de">🇩🇪 Deutsch (DE)</option>
      </select>
    </div>

    <div style="display:flex; gap:0.8rem;">
      <a href="/admin/articles/edit" class="btn-secondary">➕ 新建 Markdown 文章</a>
      <button class="btn-primary" id="btnSaveArticles" type="button">💾 保存规则与权重</button>
    </div>
  </div>

  <table class="articles-table">
    <thead>
      <tr>
        <th>文章标题与 Slug</th>
        <th>关联交互工具</th>
        <th>排序权重</th>
        <th>阅读量</th>
        <th>置顶状态</th>
        <th>展示状态</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody id="articlesTbody">
      <tr>
        <td colspan="7" style="text-align:center; color:var(--admin-muted);">正在同步文章数据...</td>
      </tr>
    </tbody>
  </table>

  <script is:inline>
    let currentLang = 'zh';
    let currentArticles = [];

    window.switchLanguage = function(lang) {
      currentLang = lang;
      fetchArticles();
    };

    async function fetchArticles() {
      try {
        const tbody = document.getElementById('articlesTbody');
        if (tbody) tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:var(--admin-muted);">正在读取 [${currentLang.toUpperCase()}] 语言文章...</td></tr>`;

        const res = await fetch(`/api/admin/articles?lang=${currentLang}`);
        const json = await res.json();

        currentArticles = (json.success && Array.isArray(json.data)) ? json.data : [];
        renderTable();
      } catch (e) {
        alert('读取文章失败: ' + e.message);
      }
    }

    function renderTable() {
      const tbody = document.getElementById('articlesTbody');
      if (!tbody) return;

      if (currentArticles.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:var(--admin-muted);">当前语言下无相关的 Content Collection 博客文章</td></tr>`;
        return;
      }

      tbody.innerHTML = currentArticles.map((item) => `
        <tr data-id="${item.id}">
          <td>
            <div style="font-weight: 700; color:#fff; font-size:0.92rem;">
              📝 ${item.title}
            </div>
            <div style="font-size: 0.75rem; color: var(--admin-muted); margin-top: 0.2rem;">
              <code>${currentLang}/${item.slug}</code>
            </div>
          </td>
          <td>
            <span style="background:rgba(99, 102, 241, 0.15); color:#818cf8; border:1px solid rgba(99, 102, 241, 0.3); padding:0.2em 0.5em; border-radius:6px; font-size:0.78rem;">
              ${item.relatedTool ? '🛠️ ' + item.relatedTool : '未关联'}
            </span>
          </td>
          <td>
            <input class="input-priority" type="number" value="${item.priority}" />
          </td>
          <td>
            <input class="input-views" type="number" value="${item.views}" />
          </td>
          <td>
            <label style="cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;">
              <input class="check-pinned" type="checkbox" ${item.pinned ? 'checked' : ''} />
              <span class="${item.pinned ? 'badge badge-pinned' : ''}">
                ${item.pinned ? '📌 置顶' : '普通'}
              </span>
            </label>
          </td>
          <td>
            <select class="select-status">
              <option value="active" ${item.status === 'active' ? 'selected' : ''}>✅ 展示</option>
              <option value="disabled" ${item.status === 'disabled' ? 'selected' : ''}>🚫 下架</option>
            </select>
          </td>
          <td>
            <a href="/admin/articles/edit?id=${encodeURIComponent(item.id)}&lang=${currentLang}" class="btn-action-edit">✏️ 编辑</a>
            <a href="${item.url}" target="_blank" style="color: var(--admin-accent); font-weight: 700; text-decoration: none; font-size: 0.82rem;">🔗 预览</a>
          </td>
        </tr>
      `).join('');
    }

    document.getElementById('btnSaveArticles')?.addEventListener('click', async () => {
      const btn = document.getElementById('btnSaveArticles');
      btn.textContent = '⏳ 保存中...';
      btn.disabled = true;

      const rows = document.querySelectorAll('#articlesTbody tr');
      const configData = [];

      rows.forEach((row) => {
        const id = row.dataset.id;
        const priorityInput = row.querySelector('.input-priority');
        const viewsInput = row.querySelector('.input-views');
        const pinnedInput = row.querySelector('.check-pinned');
        const statusSelect = row.querySelector('.select-status');

        if (id && priorityInput) {
          const item = currentArticles.find(a => a.id === id);
          configData.push({
            id: id,
            title: item?.title || '',
            description: item?.description || '',
            relatedTool: item?.relatedTool || '',
            priority: Number(priorityInput.value),
            views: Number(viewsInput.value),
            pinned: pinnedInput.checked,
            status: statusSelect.value
          });
        }
      });

      try {
        const res = await fetch('/api/admin/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: `articles_v1_${currentLang}`, configData })
        });

        const data = await res.json();
        if (data.success) {
          alert(`🎉 [${currentLang.toUpperCase()}] 文章配置保存成功！`);
          fetchArticles();
        } else {
          alert('保存失败：' + (data.message || '未知错误'));
        }
      } catch (err) {
        alert('网络同步失败，请检查登录');
      } finally {
        btn.textContent = '💾 保存规则与权重';
        btn.disabled = false;
      }
    });

    fetchArticles();
  </script>
</AdminLayout>
