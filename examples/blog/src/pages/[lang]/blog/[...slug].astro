---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

export const prerender = false; // 动态 SSR 模式以实时读取 Cloudflare KV 数据

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => {
		const rawPath = post.slug || post.id.replace(/\.(md|mdx)$/, '');
		const [lang, ...slugParts] = rawPath.split('/');
		const slug = slugParts.join('/');

		return {
			params: { lang: lang || 'en', slug: slug || '' },
			props: post,
		};
	});
}

type Props = CollectionEntry<'blog'>;

// 1. 获取基础路线参数与 Props
const { lang = 'en', slug = '' } = Astro.params;
let post = Astro.props as CollectionEntry<'blog'>;

// 2. 回退检索 Content Collection
if (!post) {
	const posts = await getCollection('blog');
	const matchedPost = posts.find((p) => {
		const rawPath = p.slug || p.id.replace(/\.(md|mdx)$/, '');
		return rawPath === `${lang}/${slug}` || p.id.includes(slug);
	});
	if (matchedPost) {
		post = matchedPost;
	}
}

if (!post) {
	return Astro.redirect('/404');
}

// 3. SSR 阶段尝试从 Cloudflare KV 读取最新保存的正文与数据
let updatedContent: string | null = null;
let updatedTitle = post.data.title;

try {
	const runtime = (Astro.locals as any).runtime;
	const kv = runtime?.env?.ADMIN_KV;
	if (kv) {
		const raw = await kv.get(`articles_v1_${lang}`);
		if (raw) {
			const articlesList = JSON.parse(raw);
			const kvArticle = articlesList.find(
				(item: any) => item.id === post.id || item.slug === slug || item.id === `${lang}/${slug}.md`
			);

			if (kvArticle) {
				if (kvArticle.title) updatedTitle = kvArticle.title;
				if (kvArticle.content && kvArticle.content.trim() !== '') {
					updatedContent = kvArticle.content;
				}
			}
		}
	}
} catch (e) {
	console.warn('SSR 从 KV 读取最新文章数据失败，回退使用本地 MD:', e);
}

// 4. 零依赖原生 Markdown 解析器 (支持 标题、段落、加粗、Base64 图片与链接)
function parseSimpleMarkdown(md: string): string {
	return md
		// 转换图片 ![alt](url) -> 支持 Base64 实时展示
		.replace(/!\[(.*?)\]\((.*?)\)/g, '<img src="$2" alt="$1" style="max-width:100%; height:auto; border-radius:8px; margin:1em 0;" />')
		// 转换链接 [text](url)
		.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
		// 转换标题 # - ###
		.replace(/^### (.*$)/gim, '<h3>$1</h3>')
		.replace(/^## (.*$)/gim, '<h2>$1</h2>')
		.replace(/^# (.*$)/gim, '<h1>$1</h1>')
		// 转换粗体 **text**
		.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
		// 转换换行段落
		.split('\n\n')
		.map((p) => (p.trim().startsWith('<') ? p : `<p>${p.replace(/\n/g, '<br/>')}</p>`))
		.join('');
}

// 5. 准备渲染数据
const { Content } = await render(post);
const kvRenderedHtml = updatedContent ? parseSimpleMarkdown(updatedContent) : null;
const postData = { ...post.data, title: updatedTitle };
---

<BlogPost {...postData}>
	{
		kvRenderedHtml ? (
			/* ⚡ 渲染从 KV 读取的最新正文（内置原生态 Markdown 解析，零依赖） */
			<div class="markdown-body" set:html={kvRenderedHtml} />
		) : (
			/* ⚡ 默认使用 Astro 原生 Content 组件 */
			<Content />
		)
	}
</BlogPost>
