---
// src/layouts/AdminLayout.astro
import BaseHead from 'src/components/BaseHead.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;

// 规范化当前路径（去除末尾斜杠，保证匹配精准度）
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const menuItems = [
	{ name: '数据概览', icon: '📊', path: '/admin/dashboard' },
	{ name: '工具管理', icon: '🛠️', path: '/admin/tools-config' },
	{ name: '分类管理', icon: '🏷️', path: '/admin/categories' },
	{ name: '文章管理', icon: '📝', path: '/admin/articles' },
	{ name: '广告变现', icon: '📢', path: '/admin/ads' },
	{ name: '综合排序', icon: '🔢', path: '/admin/tools' },
	{ name: '媒体文件库', icon: '🖼️', path: '/admin/media' },
	{ name: 'SEO / GEO 引擎', icon: '🔍', path: '/admin/seo' },
	{ name: '系统与权限', icon: '👥', path: '/admin/system' },
	{ name: '站点全局配置', icon: '⚙️', path: '/admin/settings' },
];

// 精确校验当前菜单激活状态
const isNavActive = (itemPath: string) => {
	const cleanItemPath = itemPath.replace(/\/$/, '');
	return currentPath === cleanItemPath || currentPath.startsWith(`${cleanItemPath}/`);
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} — HelpMini 后台控制中心`} description="HelpMini Admin Dashboard" />
		
		<!-- ⚡ 安全防御：双重强制搜索引擎禁收录指令（消除谷歌快照） -->
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
		<meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
		
		<style is:global>
			:root {
				--admin-bg: #0b0f17;
				--admin-card: #151c28;
				--admin-border: #232d3f;
				--admin-text: #f1f5f9;
				--admin-muted: #94a3b8;
				--admin-accent: #6366f1;
				--admin-accent-hover: #4f46e5;
			}

			body {
				margin: 0;
				padding: 0;
				background-color: var(--admin-bg);
				color: var(--admin-text);
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				display: flex;
				min-height: 100vh;
				width: 100%;
			}

			/* 👈 侧边栏样式 */
			.admin-sidebar {
				width: 240px;
				background: var(--admin-card);
				border-right: 1px solid var(--admin-border);
				display: flex;
				flex-direction: column;
				flex-shrink: 0;
				position: fixed;
				top: 0;
				bottom: 0;
				left: 0;
				z-index: 100;
			}

			.sidebar-brand {
				padding: 1.5rem;
				font-size: 1.2rem;
				font-weight: 800;
				border-bottom: 1px solid var(--admin-border);
				display: flex;
				align-items: center;
				gap: 0.6rem;
				color: #fff;
			}

			.sidebar-nav {
				padding: 1rem 0.8rem;
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				overflow-y: auto;
				flex-grow: 1;
			}

			.nav-item {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.75rem 1rem;
				border-radius: 10px;
				color: var(--admin-muted);
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 600;
				transition: all 0.2s ease;
			}

			.nav-item:hover {
				background: rgba(255, 255, 255, 0.05);
				color: #fff;
			}

			.nav-item.active {
				background: var(--admin-accent);
				color: #fff;
				box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
			}

			.sidebar-footer {
				padding: 1rem 1.2rem;
				border-top: 1px solid var(--admin-border);
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.btn-logout {
				background: rgba(239, 68, 68, 0.15);
				border: 1px solid rgba(239, 68, 68, 0.3);
				color: #ef4444;
				padding: 0.4em 0.8em;
				border-radius: 6px;
				font-size: 0.8rem;
				font-weight: 700;
				cursor: pointer;
			}

			/* 👉 主内容区（修复版） */
			.admin-main {
				margin-left: 240px;
				width: calc(100% - 240px);
				min-height: 100vh;
				flex-grow: 1;
				padding: 2rem;
				max-width: 100%;
				box-sizing: border-box;
			}

			.page-header {
				margin-bottom: 2rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.page-header h1 {
				margin: 0;
				font-size: 1.6rem;
				font-weight: 800;
			}

			@media (max-width: 768px) {
				.admin-sidebar { width: 70px; }
				.sidebar-brand span:last-child, .nav-item span:last-child { display: none; }
				.admin-main { 
					margin-left: 70px; 
					width: calc(100% - 70px);
					padding: 1rem; 
				}
			}
		</style>
	</head>
	<body>
		<aside class="admin-sidebar">
			<div class="sidebar-brand">
				<span>⚡</span>
				<span>HelpMini Admin</span>
			</div>
			<nav class="sidebar-nav">
				{menuItems.map((item) => (
					<a href={item.path} class={`nav-item ${isNavActive(item.path) ? 'active' : ''}`}>
						<span>{item.icon}</span>
						<span>{item.name}</span>
					</a>
				))}
			</nav>
			<div class="sidebar-footer">
				<a href="/zh/" target="_blank" style="color:var(--admin-muted); text-decoration:none; font-size:0.8rem; font-weight:700;">🔗 打开前台</a>
				<button class="btn-logout" id="btnLogout">退出</button>
			</div>
		</aside>

		<main class="admin-main">
			<div class="page-header">
				<h1>{title}</h1>
				<div style="font-size: 0.85rem; color: var(--admin-muted);">
					系统节点: <span style="color:#10b981; font-weight:700;">Cloudflare Edge (KV Online)</span>
				</div>
			</div>
			<slot />
		</main>

		<!-- ⚡ 防暴露兜底校验与退出逻辑 -->
		<script is:inline>
			(function checkAuthFallback() {
				// 避免在登录页死循环重定向
				if (window.location.pathname.startsWith('/admin/login')) return;
				
				// 简单校验 Cookie 中是否存在凭证，如无凭证则前端直接切断访问
				const hasAuthCookie = document.cookie.split('; ').some(row => row.startsWith('admin_session='));
				if (!hasAuthCookie) {
					window.location.href = '/admin/login';
				}
			})();

			document.getElementById('btnLogout')?.addEventListener('click', async () => {
				if (confirm('确认退出后台管理面板？')) {
					await fetch('/api/admin/auth', { method: 'DELETE' });
					window.location.href = '/admin/login';
				}
			});
		</script>
	</body>
</html>
