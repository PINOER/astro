---
import BaseHead from 'src/components/BaseHead.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

// 校验 Admin Session
const session = Astro.cookies.get('admin_session')?.value;
if (session !== 'astro_admin_secure_session_token_2026') {
	return Astro.redirect('/admin/login');
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} — 控制台管理后台`} description="系统管理后台" />
		<style>
			:root {
				--admin-bg: #090d16;
				--admin-card: #111827;
				--admin-border: #1e293b;
				--admin-accent: #3b82f6;
				--admin-text: #f8fafc;
				--admin-muted: #94a3b8;
			}

			body {
				margin: 0;
				padding: 0;
				background: var(--admin-bg);
				color: var(--admin-text);
				font-family: system-ui, -apple-system, sans-serif;
				display: flex;
				min-height: 100vh;
			}

			.admin-sidebar {
				width: 240px;
				background: var(--admin-card);
				border-right: 1px solid var(--admin-border);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding: 1.5rem 1rem;
				box-sizing: border-box;
				flex-shrink: 0;
			}

			.brand-logo {
				font-size: 1.2rem;
				font-weight: 800;
				color: var(--admin-text);
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 2rem;
			}

			.nav-list {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.nav-item a {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.7em 0.9em;
				color: var(--admin-muted);
				text-decoration: none;
				border-radius: 10px;
				font-weight: 600;
				font-size: 0.88rem;
				transition: all 0.15s ease;
			}

			.nav-item a:hover,
			.nav-item.active a {
				background: rgba(59, 130, 246, 0.15);
				color: var(--admin-accent);
			}

			.admin-content {
				flex-grow: 1;
				padding: 2rem;
				overflow-y: auto;
				box-sizing: border-box;
			}

			.top-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.8rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--admin-border);
			}

			.btn-logout {
				background: rgba(239, 68, 68, 0.15);
				border: 1px solid rgba(239, 68, 68, 0.4);
				color: #ef4444;
				padding: 0.4em 0.8em;
				border-radius: 8px;
				cursor: pointer;
				font-weight: 700;
				font-size: 0.82rem;
				transition: background 0.2s;
			}

			.btn-logout:hover {
				background: rgba(239, 68, 68, 0.25);
			}

			@media (max-width: 768px) {
				body {
					flex-direction: column;
				}
				.admin-sidebar {
					width: 100%;
					border-right: none;
					border-bottom: 1px solid var(--admin-border);
				}
			}
		</style>
	</head>
	<body>
		<aside class="admin-sidebar">
			<div>
				<div class="brand-logo">⚙️ 站点后台管理</div>
				<ul class="nav-list">
					<li class={`nav-item ${currentPath.includes('/admin/tools') ? 'active' : ''}`}>
						<a href="/admin/tools">🛠️ 工具与排序管理</a>
					</li>
					<li class={`nav-item ${currentPath.includes('/admin/posts') ? 'active' : ''}`}>
						<a href="/admin/posts">📝 博客文章管理</a>
					</li>
					<li class={`nav-item ${currentPath.includes('/admin/ads') ? 'active' : ''}`}>
						<a href="/admin/ads">📢 全局广告配置</a>
					</li>
				</ul>
			</div>

			<button class="btn-logout" id="btnLogout" type="button">🔒 退出登录</button>
		</aside>

		<main class="admin-content">
			<div class="top-bar">
				<h2 style="margin:0; font-size: 1.4rem;">{title}</h2>
				<span style="font-size:0.85rem; color:var(--admin-muted);">当前身份：管理员 (Admin)</span>
			</div>
			<slot />
		</main>

		<script is:inline>
			document.getElementById('btnLogout')?.addEventListener('click', async () => {
				if (confirm('确定要退出后台管理系统吗？')) {
					await fetch('/api/admin/auth', { method: 'DELETE' });
					window.location.href = '/admin/login';
				}
			});
		</script>
	</body>
</html>
