---
// src/layouts/ToolLayout.astro
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import RelatedTools from 'src/components/RelatedTools.astro';
import { SITE_TITLE } from 'src/consts';

interface Props {
	frontmatter: {
		title: string;
		description: string;
		icon?: string;
		tag?: string;
		keywords?: string;
		pinned?: boolean;
		priority?: number;
	};
	lang?: 'en' | 'zh';
}

const { frontmatter, lang = 'en' } = Astro.props;
const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<slot name="head" />
	</head>
	<body>
		<Header lang={lang} />
		<main>
			<div class="tool-header">
				<h1>{frontmatter.icon || '🛠️'} {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<!-- 1. 页面主工具内容注入区 -->
			<slot />

			<!-- 2. FAQ 专属插槽挂载点 -->
			<slot name="faq" />

			<!-- 3. 自动识别同类工具 + 商业化推荐模块（全自动化） -->
			<RelatedTools 
				currentPath={currentPath} 
				tag={frontmatter.tag || 'General'} 
				lang={lang} 
			/>
		</main>
		<Footer />

		<!-- 页面脚本注入区 -->
		<slot name="scripts" />
	</body>
</html>

<style>
	.content-section {
		margin-top: 2.5rem;
		background: var(--bg-card);
		border: 1px solid var(--card-border);
		border-radius: 16px;
		padding: 2em;
		box-sizing: border-box; /* 确保 padding 不挤爆宽度 */
	}
	.content-section h2 {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 1.2rem;
	}
	.related-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.related-card {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.9rem;
		background: var(--code-bg);
		border: 1px solid var(--card-border);
		border-radius: 10px;
		text-decoration: none !important;
		transition: border-color 0.2s, transform 0.2s;
		box-sizing: border-box;
		width: 100%;       /* 锁定 100% 宽度不超出网格容器 */
		min-width: 0;      /* 关键：允许子元素溢出截断 */
	}
	.related-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.related-card.sponsor-card {
		border-color: rgba(245, 158, 11, 0.4);
		background: linear-gradient(135deg, var(--code-bg) 0%, rgba(245, 158, 11, 0.05) 100%);
	}
	.card-icon {
		font-size: 1.6rem;
		flex-shrink: 0;
	}
	.card-body {
		flex: 1;
		min-width: 0;      /* 关键：允许文本内缩 */
	}
	.card-header-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.2rem;
		min-width: 0;      /* 关键：允许标题栏缩小 */
	}
	.related-card h4 {
		margin: 0;
		color: var(--text-main);
		font-size: 0.92rem;
		font-weight: 700;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		flex: 1;           /* 允许标题自动分配剩余宽度 */
		min-width: 0;      /* 关键：强制超长标题显示省略号 ... */
	}
	.related-card p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: break-word; /* 防止超级长词汇（如 URL）撑破宽度 */
	}
	.sponsor-badge {
		font-size: 0.68rem;
		padding: 0.15em 0.5em;
		background: rgba(245, 158, 11, 0.15);
		color: #f59e0b;
		border: 1px solid rgba(245, 158, 11, 0.3);
		border-radius: 4px;
		font-weight: 700;
		text-transform: uppercase;
		flex-shrink: 0;   /* 确保赞助 Badge 不会被拉伸压缩 */
	}

	@media (max-width: 768px) {
		.content-section {
			padding: 1.25em 1rem; /* 手机端适当收紧内边距 */
		}
		.related-grid {
			grid-template-columns: 1fr; /* 手机端单列全宽展示 */
		}
		.related-card {
			padding: 0.8rem;
		}
		.card-icon {
			font-size: 1.4rem;
		}
	}
</style>
