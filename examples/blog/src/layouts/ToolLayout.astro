---
// src/layouts/ToolLayout.astro
import BaseHead from 'src/components/BaseHead.astro';
import Header from 'src/components/Header.astro';
import Footer from 'src/components/Footer.astro';
import RelatedTools from 'src/components/RelatedTools.astro';
import { SITE_TITLE } from 'src/consts';

interface Props {
	frontmatter: {
		title: string;
		description: string;
		icon?: string;
		tag?: string;
		keywords?: string;
		pinned?: boolean;
		priority?: number;
	};
	lang?: 'en' | 'zh';
}

const { frontmatter, lang = 'en' } = Astro.props;
const pageTitle = `${frontmatter.title} — ${SITE_TITLE}`;
const pageDescription = frontmatter.description;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<slot name="head" />
	</head>
	<body>
		<Header lang={lang} />
		<main>
			<div class="tool-header">
				<h1>{frontmatter.icon || '🛠️'} {frontmatter.title}</h1>
				<p>{frontmatter.description}</p>
			</div>

			<!-- 1. 页面主工具内容注入区 -->
			<slot />

			<!-- 2. FAQ 专属插槽挂载点 -->
			<slot name="faq" />

			<!-- 3. 自动识别同类工具 + 商业化推荐模块（全自动化） -->
			<RelatedTools 
				currentPath={currentPath} 
				tag={frontmatter.tag || 'General'} 
				lang={lang} 
			/>
		</main>
		<Footer />

		<!-- 页面脚本注入区 -->
		<slot name="scripts" />
	</body>
</html>

<style is:global>
	/* 1. 主页面容器基础样式 (修复 PC 端变窄) */
	main {
		width: 900px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em 5em;
		box-sizing: border-box;
	}
	.tool-header {
		text-align: center;
		margin-bottom: 2em;
	}
	.tool-header h1 {
		font-size: 2.2rem;
		font-weight: 800;
		margin-bottom: 0.3em;
		background: var(--hero-title-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.tool-header p {
		color: var(--text-muted);
		font-size: 1.05rem;
	}
	.tool-box {
		background: var(--bg-card);
		backdrop-filter: blur(12px);
		border: 1px solid var(--card-border);
		border-radius: 16px;
		padding: 2em;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		box-sizing: border-box;
		width: 100%;
	}

	/* 2. 推荐与赞助工具模块全局样式 (支持穿透至 RelatedTools 组件) */
	.content-section {
		margin-top: 2.5rem;
		background: var(--bg-card);
		border: 1px solid var(--card-border);
		border-radius: 16px;
		padding: 2em;
		box-sizing: border-box;
		width: 100%;
	}
	.content-section h2 {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 1.2rem;
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		width: 100%;
		box-sizing: border-box;
	}
	.related-card {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.9rem;
		background: var(--code-bg);
		border: 1px solid var(--card-border);
		border-radius: 10px;
		text-decoration: none !important;
		transition: border-color 0.2s, transform 0.2s;
		box-sizing: border-box;
		width: 100%;
		min-width: 0;
		height: auto;
	}
	.related-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.related-card.sponsor-card {
		border-color: rgba(245, 158, 11, 0.4);
		background: linear-gradient(135deg, var(--code-bg) 0%, rgba(245, 158, 11, 0.05) 100%);
	}
	.card-icon {
		font-size: 1.6rem;
		flex-shrink: 0;
	}
	.card-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.card-header-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.25rem;
		min-width: 0;
	}
	.related-card h4 {
		margin: 0;
		color: var(--text-main);
		font-size: 0.92rem;
		font-weight: 700;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		flex: 1;
		min-width: 0;
	}
	.related-card p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: break-word;
	}
	.sponsor-badge {
		font-size: 0.68rem;
		padding: 0.15em 0.5em;
		background: rgba(245, 158, 11, 0.15);
		color: #f59e0b;
		border: 1px solid rgba(245, 158, 11, 0.3);
		border-radius: 4px;
		font-weight: 700;
		text-transform: uppercase;
		flex-shrink: 0;
	}

	/* 3. 📱 移动端自适应适配 */
	@media (max-width: 768px) {
		main {
			width: 100%;
			max-width: calc(100% - 1.2em);
			padding: 1.5em 0.6em 3em;
		}
		.tool-box {
			padding: 1.25em 1rem;
		}
		.tool-header h1 {
			font-size: 1.65rem;
		}
		.tool-header p {
			font-size: 0.92rem;
		}

		/* 移动端卡片自适应高度与排版 */
		.content-section {
			padding: 1.25em 1rem;
		}
		.related-grid {
			grid-template-columns: 1fr;
			gap: 0.8rem;
		}
		.related-card {
			padding: 0.9rem 1rem;
			height: auto;
			align-items: flex-start;
		}
		.card-icon {
			font-size: 1.5rem;
			margin-top: 0.1rem;
		}
		.card-header-row {
			flex-wrap: wrap;
			align-items: flex-start;
			margin-bottom: 0.35rem;
		}
		.related-card h4 {
			white-space: normal;
			font-size: 0.95rem;
			line-height: 1.35;
		}
		.related-card p {
			-webkit-line-clamp: unset;
			font-size: 0.82rem;
			line-height: 1.45;
		}
	}
</style>
