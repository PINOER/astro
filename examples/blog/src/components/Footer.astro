---
// 1. 接收外部传入的 lang 参数（可选）
const { lang: propLang } = Astro.props;

// 2. 获取当前 URL 路径判断语言
const pathname = Astro.url.pathname;

let currentLang = propLang || 'en';
if (!propLang) {
	if (pathname.startsWith('/zh') || pathname.includes('/zh/')) {
		currentLang = 'zh';
	}
}

const isChinese = currentLang === 'zh';
const today = new Date();

// 基础路径前缀
const langPrefix = isChinese ? '/zh' : '';

// 链接文案配置
const links = {
	help: isChinese ? '帮助' : 'Help',
	feedback: isChinese ? '发送反馈' : 'Send feedback',
	privacy: isChinese ? '隐私政策' : 'Privacy',
	terms: isChinese ? '服务条款' : 'Terms',
};
---

<footer>
	<div class="footer-container">
		<p class="copyright">
			&copy; {today.getFullYear()} HelpMini. {isChinese ? '保留所有权利。' : 'All rights reserved.'}
		</p>
		
		<nav class="footer-nav" aria-label="Footer navigation">
			<a href={`${langPrefix}/help/`}>{links.help}</a>
			<span class="divider">•</span>
			<a href={`${langPrefix}/feedback/`}>{links.feedback}</a>
			<span class="divider">•</span>
			<a href={`${langPrefix}/privacy/`}>{links.privacy}</a>
			<span class="divider">•</span>
			<a href={`${langPrefix}/terms/`}>{links.terms}</a>
		</nav>
	</div>
</footer>

<style>
	/* 默认（暗黑主题）样式 */
	footer {
		padding: 2.5em 1em 4em;
		background: var(--footer-bg, rgba(8, 9, 10, 0.4));
		backdrop-filter: blur(8px);
		border-top: 1px solid var(--card-border, rgba(255, 255, 255, 0.08));
		color: var(--text-muted, #8e9bb0);
		text-align: center;
		font-size: 0.88rem;
		transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
	}

	.footer-container {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8em;
	}

	.copyright {
		margin: 0;
		color: inherit;
	}

	.footer-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.8em;
		flex-wrap: wrap;
	}

	.footer-nav a {
		color: inherit;
		text-decoration: none;
		font-size: 0.85rem;
		transition: color 0.2s ease;
	}

	.footer-nav a:hover {
		color: var(--text-main, #ffffff);
		text-decoration: underline;
	}

	.divider {
		color: rgba(140, 150, 165, 0.4);
		font-size: 0.75rem;
		user-select: none;
	}

	/* ☀️ 浅色主题（Light Mode）覆盖：纯白背景、深黑文字 */
	:global([data-theme="light"]) footer {
		background: #ffffff !important;
		border-top: 1px solid #e2e8f0 !important;
		color: #1e293b !important; /* 深黑灰色文本 */
	}

	:global([data-theme="light"]) .copyright {
		color: #334155 !important;
	}

	:global([data-theme="light"]) .footer-nav a {
		color: #475569 !important;
	}

	:global([data-theme="light"]) .footer-nav a:hover {
		color: #0f172a !important; /* 悬浮深黑色 */
	}

	:global([data-theme="light"]) .divider {
		color: #cbd5e1 !important;
	}

	@media (max-width: 480px) {
		.footer-nav {
			gap: 0.5em;
		}
	}
</style>
