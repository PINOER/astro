---
// 1. 接收外部传入的 lang 参数（可选）
const { lang: propLang } = Astro.props;

// 2. 获取当前 URL 路径判断语言
const pathname = Astro.url.pathname;

let currentLang = propLang || 'en';
if (!propLang) {
	if (pathname.startsWith('/zh') || pathname.includes('/zh/')) {
		currentLang = 'zh';
	}
}

const isChinese = currentLang === 'zh';
const today = new Date();

// 基础路径前缀
const langPrefix = isChinese ? '/zh' : '';

// 链接文案配置
const links = {
	help: isChinese ? '帮助' : 'Help',
	feedback: isChinese ? '发送反馈' : 'Send feedback',
	privacy: isChinese ? '隐私政策' : 'Privacy',
	terms: isChinese ? '服务条款' : 'Terms',
};
---

<footer>
	<div class="footer-container">
		<p class="copyright">
			&copy; {today.getFullYear()} HelpMini. {isChinese ? '保留所有权利。' : 'All rights reserved.'}
		</p>
		
		<nav class="footer-nav" aria-label="Footer navigation">
			<a href={`${langPrefix}/help/`}>{links.help}</a>
			<span class="divider">•</span>
			<a href={`${langPrefix}/feedback/`}>{links.feedback}</a>
			<span class="divider">•</span>
			<a href={`${langPrefix}/privacy/`}>{links.privacy}</a>
			<span class="divider">•</span>
			<a href={`${langPrefix}/terms/`}>{links.terms}</a>
		</nav>
	</div>
</footer>

<style>
	footer {
		padding: 2.5em 1em 4em;
		background: rgba(8, 9, 10, 0.4);
		backdrop-filter: blur(8px);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		color: #8e9bb0;
		text-align: center;
		font-size: 0.88rem;
	}

	.footer-container {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8em;
	}

	.copyright {
		margin: 0;
		color: #8e9bb0;
	}

	.footer-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.8em;
		flex-wrap: wrap;
	}

	.footer-nav a {
		color: #8e9bb0;
		text-decoration: none;
		font-size: 0.85rem;
		transition: color 0.2s ease;
	}

	.footer-nav a:hover {
		color: #f8fafc;
		text-decoration: underline;
	}

	.divider {
		color: rgba(255, 255, 255, 0.2);
		font-size: 0.75rem;
		user-select: none;
	}

	@media (max-width: 480px) {
		.footer-nav {
			gap: 0.5em;
		}
	}
</style>
