---
import { SITE_TITLE } from '../consts';

// 1. 接收外部传入的 lang 参数（可选）
const { lang: propLang } = Astro.props;

// 2. 获取当前 URL 路径并判断语言
const pathname = Astro.url.pathname;

let currentLang = propLang || 'en';
if (!propLang) {
	if (pathname.startsWith('/zh') || pathname.includes('/zh/')) {
		currentLang = 'zh';
	} else if (pathname.startsWith('/es') || pathname.includes('/es/')) {
		currentLang = 'es';
	} else if (pathname.startsWith('/de') || pathname.includes('/de/')) {
		currentLang = 'de';
	} else if (pathname.startsWith('/ja') || pathname.includes('/ja/')) {
		currentLang = 'ja';
	}
}

// 3. 提取去除了语言前缀的“纯路径”（例如 /zh/about -> /about）
const purePath = pathname.replace(/^\/(zh|es|de|ja)(\/|$)/, '/');

// 4. 动态构建各语言的目标跳转路径
const getPathForLang = (lang: string) => {
	if (lang === 'en') return purePath || '/';
	return purePath === '/' ? `/${lang}/` : `/${lang}${purePath}`;
};

// 首页 Link 拼接
const homeLink = currentLang === 'en' ? '/' : `/${currentLang}/`;
---

<header>
	<nav>
		<!-- 👈 左侧 Logo 品牌区域 -->
		<a href={homeLink} class="site-title">
			HelpMini
		</a>

		<!-- 👉 右侧操作与功能区域 -->
		<div class="nav-right">
			<!-- 1. 分享按钮 -->
			<button id="share-btn" class="icon-btn" aria-label="Share" type="button" title="Share Page">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="18" cy="5" r="3"></circle>
					<circle cx="6" cy="12" r="3"></circle>
					<circle cx="18" cy="19" r="3"></circle>
					<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
					<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
				</svg>
			</button>

			<!-- 2. 多语言下拉选择框 -->
			<div class="lang-select-wrapper">
				<select id="language-select" aria-label="Language selector">
					<option value={getPathForLang('en')} selected={currentLang === 'en'}>English</option>
					<option value={getPathForLang('zh')} selected={currentLang === 'zh'}>简体中文</option>
				</select>
			</div>

			<!-- 3. 🌙/☀️ 主题切换按钮 -->
			<button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle theme" type="button">
				<span class="icon-dark">🌙</span>
				<span class="icon-light">☀️</span>
			</button>

			<!-- 4. 👤 预留用户头像 / 个人中心 -->
			<a href="/admin/dashboard" class="user-avatar-btn" aria-label="User Profile" title="Account Center / Admin">
				<div class="avatar-circle">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
						<circle cx="12" cy="7" r="4"></circle>
					</svg>
				</div>
			</a>
		</div>
	</nav>
</header>

<script>
	// 1. 语言切换器交互
	const selectEl = document.getElementById('language-select') as HTMLSelectElement;
	if (selectEl) {
		selectEl.addEventListener('change', (e) => {
			const targetUrl = (e.target as HTMLSelectElement).value;
			if (targetUrl) {
				window.location.href = targetUrl;
			}
		});
	}

	// 2. 暗黑 / 亮色主题切换交互
	const themeToggleBtn = document.getElementById('theme-toggle');
	themeToggleBtn?.addEventListener('click', () => {
		const isLight = document.documentElement.getAttribute('data-theme') === 'light';
		if (isLight) {
			document.documentElement.removeAttribute('data-theme');
			localStorage.setItem('theme', 'dark');
		} else {
			document.documentElement.setAttribute('data-theme', 'light');
			localStorage.setItem('theme', 'light');
		}
	});

	// 3. 原生分享 / 剪贴板复制链接
	const shareBtn = document.getElementById('share-btn');
	shareBtn?.addEventListener('click', async () => {
		if (navigator.share) {
			try {
				await navigator.share({
					title: document.title,
					url: window.location.href,
				});
			} catch (err) {
				// 用户取消分享不做处理
			}
		} else {
			// 降级方案：复制当前 URL 到剪贴板
			await navigator.clipboard.writeText(window.location.href);
			alert('页面链接已复制到剪贴板！');
		}
	});
</script>

<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: var(--header-bg, #090d14);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--card-border, #1e293b);
		position: sticky;
		top: 0;
		z-index: 100;
		transition: background-color 0.3s ease, border-color 0.3s ease;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		height: 60px;
		margin: 0 auto;
	}

	/* Logo Brand 标题 */
	.site-title {
		font-size: 1.35rem;
		font-weight: 800;
		color: var(--text-main, #f8fafc);
		text-decoration: none;
		letter-spacing: -0.3px;
		display: flex;
		align-items: center;
		transition: opacity 0.2s;
	}
	.site-title:hover {
		opacity: 0.85;
	}

	/* 右侧工具节点集合 */
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	/* 图标纯按钮（如分享按钮） */
	.icon-btn {
		background: transparent;
		border: none;
		color: var(--text-muted, #94a3b8);
		padding: 0.4em;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		transition: all 0.2s ease;
	}
	.icon-btn:hover {
		color: var(--text-main, #f8fafc);
		background-color: var(--gray-light, rgba(255, 255, 255, 0.05));
	}

	/* 多语言选择框 */
	.lang-select-wrapper {
		display: inline-flex;
		align-items: center;
	}

	.lang-select-wrapper select {
		appearance: none;
		-webkit-appearance: none;
		background-color: var(--card-border, #1e2d42);
		border: 1px solid var(--card-border, #2d3e55);
		border-radius: 8px;
		padding: 0.4em 2em 0.4em 0.8em;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-main, #f8fafc) !important;
		cursor: pointer;
		outline: none;
		transition: all 0.2s ease;
		background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
		background-repeat: no-repeat;
		background-position: right 0.6em center;
		background-size: 12px;
	}

	.lang-select-wrapper select:hover {
		border-color: var(--accent, #6366f1);
	}

	.lang-select-wrapper select option {
		background-color: var(--bg-card, #0f172a) !important;
		color: var(--text-main, #f8fafc) !important;
		padding: 0.5em;
	}

	/* 主题切换按钮 */
	.theme-toggle-btn {
		background-color: var(--card-border, #1e2d42);
		border: 1px solid var(--card-border, #2d3e55);
		border-radius: 8px;
		padding: 0.35em 0.6em;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.95rem;
		transition: all 0.2s ease;
		height: 34px;
		width: 38px;
	}
	.theme-toggle-btn:hover {
		border-color: var(--accent, #6366f1);
	}

	/* 主题图标逻辑 */
	.icon-light { display: none; }
	.icon-dark { display: inline; }

	:global([data-theme="light"]) .icon-light { display: inline; }
	:global([data-theme="light"]) .icon-dark { display: none; }

	/* 👤 头像按钮设计 */
	.user-avatar-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		margin-left: 0.2rem;
	}
	.avatar-circle {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background-color: var(--card-border, #1e2d42);
		border: 1px solid var(--card-border, #2d3e55);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted, #94a3b8);
		transition: all 0.2s ease;
	}
	.user-avatar-btn:hover .avatar-circle {
		border-color: var(--accent, #6366f1);
		color: var(--accent, #6366f1);
		background-color: var(--badge-bg, rgba(99, 102, 241, 0.1));
	}

	@media (max-width: 600px) {
		header {
			padding: 0 1em;
		}
		.nav-right {
			gap: 0.4rem;
		}
	}
</style>
