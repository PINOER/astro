---
import { SITE_TITLE } from '../consts';
import { sponsorItems } from '../data/tools';

// 1. 接收外部传入的 lang 参数（可选）
const { lang: propLang } = Astro.props;

// 2. 获取当前 URL 路径并判断语言
const pathname = Astro.url.pathname;

let currentLang = propLang || 'en';
if (!propLang) {
	if (pathname.startsWith('/zh') || pathname.includes('/zh/')) {
		currentLang = 'zh';
	} else if (pathname.startsWith('/es') || pathname.includes('/es/')) {
		currentLang = 'es';
	} else if (pathname.startsWith('/de') || pathname.includes('/de/')) {
		currentLang = 'de';
	} else if (pathname.startsWith('/ja') || pathname.includes('/ja/')) {
		currentLang = 'ja';
	}
}

// 3. 提取去除了语言前缀的纯路径
const purePath = pathname.replace(/^\/(zh|es|de|ja)(\/|$)/, '/');

// 4. 动态构建各语言的目标跳转路径
const getPathForLang = (lang: string) => {
	if (lang === 'en') return purePath || '/';
	return purePath === '/' ? `/${lang}/` : `/${lang}${purePath}`;
};

// 首页与常用页面 Link 拼接
const homeLink = currentLang === 'en' ? '/' : `/${currentLang}/`;
const blogLink = currentLang === 'en' ? '/blog/' : `/${currentLang}/blog/`;
const aboutLink = currentLang === 'en' ? '/about/' : `/${currentLang}/about/`;
const isZh = currentLang === 'zh';

// ⚡ 标准 Vite Glob 表达式扫描物理工具文件
const zhFilesRaw = import.meta.glob('/src/pages/zh/tools/*.astro', { query: '?raw', eager: true });
const zhFiles = import.meta.glob('/src/pages/zh/tools/*.astro', { eager: true });

const enFilesRaw = import.meta.glob('/src/pages/tools/*.astro', { query: '?raw', eager: true });
const enFiles = import.meta.glob('/src/pages/tools/*.astro', { eager: true });

// 根据当前语言选择对应文件组
const toolFiles = currentLang === 'zh' ? zhFiles : enFiles;
const toolFilesRaw = currentLang === 'zh' ? zhFilesRaw : enFilesRaw;

const buildTimeTools = Object.entries(toolFiles).map(([path, file]: [string, any]) => {
	const slug = path.split('/').pop().replace('.astro', '');
	let rawFm: any = file.frontmatter || file.toolMeta || file.toolInfo || {};
	const rawContent = (toolFilesRaw[path] as any)?.default || '';

	if (rawContent) {
		try {
			const match = rawContent.match(/(?:export\s+)?const\s+(?:frontmatter|toolMeta|toolInfo|meta)\s*=\s*(\{[\s\S]*?\});/);
			if (match && match[1]) {
				const parsed = new Function(`return ${match[1]}`)();
				rawFm = { ...rawFm, ...parsed };
			}
		} catch (e) {}
	}

	const title = rawFm.title || rawFm.name || slug;
	const desc = rawFm.description || rawFm.desc || '';
	const icon = rawFm.icon || '⚡';
	const keywords = `${title} ${rawFm.keywords || ''}`;
	const url = currentLang === 'en' ? `/tools/${slug}/` : `/${currentLang}/tools/${slug}/`;

	return { slug, title, desc, url, icon, keywords };
});

// 结合赞助商卡片
const currentSponsorItems = sponsorItems[currentLang] || sponsorItems['en'] || [];
const buildTimeSponsors = currentSponsorItems.map((s: any) => ({
	slug: s.url,
	title: s.title,
	desc: s.desc,
	url: s.url,
	icon: s.icon || '⭐',
	keywords: `${s.title} ${s.keywords || ''}`
}));

// SSR 构建出的全量初始搜索库
const serverToolsData = [...buildTimeTools, ...buildTimeSponsors];
---

<header class="header-bar">
	<nav class="nav-container">
		<!-- 1. 最左侧 HelpMini 品牌标题 -->
		<div class="nav-left">
			<a href={homeLink} class="site-title" title="HelpMini Homepage">
				<span class="logo-text">HelpMini</span>
			</a>
		</div>

		<!-- 2. 中间：搜索框与口号 -->
		<div class="nav-center">
			<div class="search-box-trigger" id="headerSearchTrigger">
				<span class="search-icon">🔍</span>
				<span class="search-placeholder">
					<span class="slogan-text">{isZh ? '小微工具，大有作为' : 'Small Tools, Big Impact.'}</span>
					<span class="mobile-short-placeholder">{isZh ? '搜索...' : 'Search...'}</span>
				</span>
				<kbd class="kbd-badge">⌘K</kbd>
			</div>
		</div>

		<!-- 3. 右侧：功能控制与操作组 -->
		<div class="nav-right">
			<!-- 分享按钮 -->
			<button id="share-btn" class="icon-btn" aria-label="Share" type="button" title={isZh ? '分享页面' : 'Share Page'}>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="18" cy="5" r="3"></circle>
					<circle cx="6" cy="12" r="3"></circle>
					<circle cx="18" cy="19" r="3"></circle>
					<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
					<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
				</svg>
			</button>

			<!-- 九宫格应用矩阵 Dropdown -->
			<div class="menu-dropdown-wrapper">
				<button class="icon-btn" id="appGridBtn" aria-label="Apps Menu" type="button" title={isZh ? '快捷工具分类' : 'Tools Matrix'}>
					<svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
						<rect x="3" y="3" width="4" height="4" rx="1"></rect>
						<rect x="10" y="3" width="4" height="4" rx="1"></rect>
						<rect x="17" y="3" width="4" height="4" rx="1"></rect>
						<rect x="3" y="10" width="4" height="4" rx="1"></rect>
						<rect x="10" y="10" width="4" height="4" rx="1"></rect>
						<rect x="17" y="10" width="4" height="4" rx="1"></rect>
						<rect x="3" y="17" width="4" height="4" rx="1"></rect>
						<rect x="10" y="17" width="4" height="4" rx="1"></rect>
						<rect x="17" y="17" width="4" height="4" rx="1"></rect>
					</svg>
				</button>
				<div class="dropdown-panel grid-panel" id="appGridPanel">
					<div class="panel-header">{isZh ? '热门分类与应用' : 'Quick Categories'}</div>
					<div class="app-grid">
						<a href={`${homeLink}?search=SEO`} class="app-item">
							<span class="app-icon">📈</span>
							<span class="app-label">SEO & GEO</span>
						</a>
						<a href={`${homeLink}?search=计算器`} class="app-item">
							<span class="app-icon">🧮</span>
							<span class="app-label">{isZh ? '利润计算' : 'Calculators'}</span>
						</a>
						<a href={`${homeLink}?search=提示词`} class="app-item">
							<span class="app-icon">🎨</span>
							<span class="app-label">{isZh ? 'AI 提示词' : 'AI Prompts'}</span>
						</a>
						<a href={`${homeLink}?search=JSON`} class="app-item">
							<span class="app-icon">🛠️</span>
							<span class="app-label">{isZh ? '开发者工具' : 'Dev Tools'}</span>
						</a>
						<a href={`${homeLink}?search=文本`} class="app-item">
							<span class="app-icon">📝</span>
							<span class="app-label">{isZh ? '文本转换' : 'Text Tools'}</span>
						</a>
						<a href={homeLink} class="app-item">
							<span class="app-icon">🚀</span>
							<span class="app-label">{isZh ? '全部工具' : 'All Tools'}</span>
						</a>
					</div>
				</div>
			</div>

			<!-- 个人头像与综合设置 Dropdown -->
			<div class="menu-dropdown-wrapper">
				<button class="avatar-btn" id="userMenuBtn" aria-label="User Center" type="button" title={isZh ? '个人中心与设置' : 'Account & Settings'}>
					<div class="avatar-circle">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
					</div>
				</button>

				<div class="dropdown-panel user-panel" id="userMenuPanel">
					<div class="user-menu-list">
						<a href="/admin/feedback" class="menu-item highlight">
							<span class="menu-icon">👤</span>
							<span>{isZh ? '管理后台' : 'Admin Center'}</span>
						</a>

						<hr class="menu-divider" />

						<div class="menu-item-static">
							<span class="menu-icon">🌐</span>
							<span class="menu-label">{isZh ? '语言/Language' : 'Language'}</span>
							<div class="sub-lang-select">
								<a href={getPathForLang('en')} class={`lang-pill ${currentLang === 'en' ? 'active' : ''}`}>EN</a>
								<a href={getPathForLang('zh')} class={`lang-pill ${currentLang === 'zh' ? 'active' : ''}`}>中文</a>
							</div>
						</div>

						<button type="button" class="menu-item" id="themeToggleMenuItem">
							<span class="menu-icon theme-icon-dark">🌙</span>
							<span class="menu-icon theme-icon-light">☀️</span>
							<span>{isZh ? '外观模式' : 'Theme Mode'}</span>
							<span class="theme-status-text"></span>
						</button>

						<hr class="menu-divider" />

						<a href={blogLink} class="menu-item">
							<span class="menu-icon">📰</span>
							<span>{isZh ? '博客文章' : 'Blog'}</span>
						</a>
						<a href={aboutLink} class="menu-item">
							<span class="menu-icon">ℹ️</span>
							<span>{isZh ? '关于我们' : 'About Us'}</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</nav>
</header>

<!-- 全局 ⌘K 快捷键搜索 Modal 弹窗 -->
<div class="search-modal-backdrop" id="searchModal">
	<div class="search-modal-card" id="searchModalCard">
		<div class="search-modal-header">
			<span class="search-modal-icon">🔍</span>
			<input type="text" id="modalSearchInput" placeholder={isZh ? "输入关键词搜索工具 (如 SEO, 计算器, Base64)..." : "Search tools (e.g. SEO, JSON, Calculator)..."} autocomplete="off" />
		</div>
		<div class="search-modal-results" id="modalSearchResults">
			<div class="modal-hint">{isZh ? '输入工具名称，即时过滤与跳转' : 'Type to search and jump to tools...'}</div>
		</div>
	</div>
</div>

<!-- 注入 SSR 构建好的静态工具数据字典与语言偏好，传递给客户端 JS -->
<script is:inline define:vars={{ serverToolsData, currentLang, isZh }}>
	window.__INITIAL_SEARCH_TOOLS__ = serverToolsData;
	window.__CURRENT_LANG__ = currentLang;
	window.__IS_ZH__ = isZh;
</script>

<script>
	// 1. 顶部搜索框触发器与 Modal 控制
	const headerSearchTrigger = document.getElementById('headerSearchTrigger');
	const searchModal = document.getElementById('searchModal');
	const searchModalCard = document.getElementById('searchModalCard');
	const modalSearchInput = document.getElementById('modalSearchInput') as HTMLInputElement;
	const modalSearchResults = document.getElementById('modalSearchResults');

	// 内存数据库，拿 SSR 服务端列表打底
	let searchableToolsData: Array<{ slug?: string; title: string; desc: string; url: string; icon: string; keywords: string; disabled?: boolean }> = (window as any).__INITIAL_SEARCH_TOOLS__ || [];

	// ⚡ 异步客户端同步：如果在首页，提取页面上由 KV 管理的动态节点补充更新；如果在子页面，异步尝试刷新 KV 配置
	async function syncToolsWithKv() {
		try {
			// 如果在首页，优先抓取 DOM 中被 KV 覆写后的最新节点
			const domCards = document.querySelectorAll('.searchable-item');
			if (domCards.length > 0) {
				const domMap = new Map();
				domCards.forEach(card => {
					const title = card.querySelector('h3')?.textContent || card.getAttribute('data-title') || '';
					const desc = card.querySelector('p')?.textContent || card.getAttribute('data-desc') || '';
					const url = card.getAttribute('href') || '#';
					const icon = card.querySelector('.tool-icon')?.textContent || '⚡';
					const keywords = card.getAttribute('data-keywords') || '';
					if (title && url !== '#') {
						domMap.set(url, { title, desc, url, icon, keywords });
					}
				});
				if (domMap.size > 0) {
					searchableToolsData = Array.from(domMap.values());
					return;
				}
			}

			// 如果在子页面，请求 KV 覆盖接口
			const currentLang = (window as any).__CURRENT_LANG__ || 'en';
			const res = await fetch(`/api/admin/config?type=tools_v2_${currentLang}`);
			const json = await res.json();

			if (json.success && Array.isArray(json.data)) {
				const kvMap = new Map();
				json.data.forEach((t: any) => kvMap.set(t.slug, t));

				searchableToolsData = searchableToolsData.map((tool) => {
					if (!tool.slug) return tool;
					const conf = kvMap.get(tool.slug);
					if (conf) {
						if (conf.status === 'disabled') {
							return { ...tool, disabled: true };
						}
						return {
							...tool,
							disabled: false,
							title: (conf.name && conf.name.trim() !== '' && conf.name !== tool.slug) ? conf.name : tool.title,
							desc: (conf.description && conf.description.trim() !== '') ? conf.description : tool.desc,
							icon: (conf.icon && conf.icon.trim() !== '' && conf.icon !== '🛠️') ? conf.icon : tool.icon,
						};
					}
					return tool;
				}).filter(t => !t.disabled);
			}
		} catch (e) {
			console.warn('Header 搜索框同步 KV 数据异常，使用预渲染索引');
		}
	}

	function openSearch() {
		if (searchModal && modalSearchInput) {
			searchModal.classList.add('active');
			modalSearchInput.value = '';
			modalSearchInput.focus();
			syncToolsWithKv();
			renderSearchResults('');
		}
	}

	function closeSearch() {
		if (searchModal) searchModal.classList.remove('active');
	}

	headerSearchTrigger?.addEventListener('click', openSearch);

	// 点击外部空白区域关闭 Modal
	searchModal?.addEventListener('click', (e) => {
		if (searchModalCard && !searchModalCard.contains(e.target as Node)) {
			closeSearch();
		}
	});

	// 快捷键 ⌘K / Ctrl+K 唤醒
	window.addEventListener('keydown', (e) => {
		if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
			e.preventDefault();
			openSearch();
		}
	});

	// 动态匹配过滤与结果渲染（⚡ 优化点 2：增加多语言提示逻辑）
	function renderSearchResults(query: string) {
		if (!modalSearchResults) return;
		const q = query.toLowerCase().trim();
		const isZh = (window as any).__IS_ZH__;

		if (!q) {
			const hintText = isZh 
				? (searchableToolsData.length > 0 ? `共加载 ${searchableToolsData.length} 个在线工具` : '输入工具名称，即时过滤与跳转')
				: (searchableToolsData.length > 0 ? `Loaded ${searchableToolsData.length} tools, type to search...` : 'Type to search and jump to tools...');
			modalSearchResults.innerHTML = `<div class="modal-hint">${hintText}</div>`;
			return;
		}

		const results = searchableToolsData.filter(item => 
			!item.disabled && (
				item.title.toLowerCase().includes(q) || 
				item.desc.toLowerCase().includes(q) || 
				item.keywords.toLowerCase().includes(q)
			)
		);

		if (results.length === 0) {
			const noResultText = isZh ? `未找到匹配 "${query}" 的工具` : `No tools found for "${query}"`;
			modalSearchResults.innerHTML = `<div class="modal-hint">${noResultText}</div>`;
			return;
		}

		modalSearchResults.innerHTML = results.map(item => `
			<a href="${item.url}" class="modal-result-item">
				<span class="result-icon">${item.icon}</span>
				<div class="result-info">
					<div class="result-title">${item.title}</div>
					<div class="result-desc">${item.desc}</div>
				</div>
			</a>
		`).join('');

		// 如果在首页，同步联动首页的搜索过滤
		const pageSearchInput = document.getElementById('searchInput') as HTMLInputElement;
		if (pageSearchInput) {
			pageSearchInput.value = query;
			pageSearchInput.dispatchEvent(new Event('input', { bubbles: true }));
		}
	}

	modalSearchInput?.addEventListener('input', (e) => {
		renderSearchResults((e.target as HTMLInputElement).value);
	});

	// 2. 下拉面板互斥切换逻辑
	const appGridBtn = document.getElementById('appGridBtn');
	const appGridPanel = document.getElementById('appGridPanel');
	const userMenuBtn = document.getElementById('userMenuBtn');
	const userMenuPanel = document.getElementById('userMenuPanel');

	appGridBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		userMenuPanel?.classList.remove('active');
		appGridPanel?.classList.toggle('active');
	});

	userMenuBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		appGridPanel?.classList.remove('active');
		userMenuPanel?.classList.toggle('active');
	});

	window.addEventListener('click', () => {
		appGridPanel?.classList.remove('active');
		userMenuPanel?.classList.remove('active');
	});

	appGridPanel?.addEventListener('click', (e) => e.stopPropagation());
	userMenuPanel?.addEventListener('click', (e) => e.stopPropagation());

	// 3. 菜单内外观模式切换
	const themeToggleMenuItem = document.getElementById('themeToggleMenuItem');
	const themeStatusText = themeToggleMenuItem?.querySelector('.theme-status-text');

	function updateThemeText() {
		const isLight = document.documentElement.getAttribute('data-theme') === 'light';
		if (themeStatusText) {
			themeStatusText.textContent = isLight ? 'Light' : 'Dark';
		}
	}

	themeToggleMenuItem?.addEventListener('click', () => {
		const isLight = document.documentElement.getAttribute('data-theme') === 'light';
		if (isLight) {
			document.documentElement.removeAttribute('data-theme');
			localStorage.setItem('theme', 'dark');
		} else {
			document.documentElement.setAttribute('data-theme', 'light');
			localStorage.setItem('theme', 'light');
		}
		updateThemeText();
	});

	updateThemeText();

	// 4. 原生分享逻辑
	const shareBtn = document.getElementById('share-btn');
	shareBtn?.addEventListener('click', async () => {
		if (navigator.share) {
			try {
				await navigator.share({
					title: document.title,
					url: window.location.href,
				});
			} catch (err) {}
		} else {
			await navigator.clipboard.writeText(window.location.href);
			alert('页面链接已复制到剪贴板！');
		}
	});
</script>

<style>
	header.header-bar {
		margin: 0;
		padding: 0 1.5em;
		background: var(--header-bg, rgba(9, 13, 20, 0.85));
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--card-border, #1e293b);
		position: sticky;
		top: 0;
		z-index: 100;
		transition: background-color 0.3s ease, border-color 0.3s ease;
	}

	.nav-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		height: 60px;
		margin: 0 auto;
		gap: 1rem;
	}

	/* 1. 左侧 Brand Logo：防挤压 */
	.nav-left {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.site-title {
		font-size: 1.35rem;
		font-weight: 800;
		color: var(--text-main, #f8fafc);
		text-decoration: none !important;
		letter-spacing: -0.3px;
		display: flex;
		align-items: center;
		transition: opacity 0.2s;
	}
	.site-title:hover {
		opacity: 0.85;
	}

	/* 2. 中间搜索框：增加 Safari 伸缩保护 */
	.nav-center {
		flex: 1;
		max-width: 460px;
		min-width: 0; /* ⚡ 允许 Flex 子项缩到最小，防止 Safari 撑爆容器 */
		display: flex;
		justify-content: center;
	}

	.search-box-trigger {
		width: 100%;
		height: 38px;
		background-color: var(--card-border, rgba(30, 45, 66, 0.6));
		border: 1px solid var(--card-border, rgba(45, 62, 85, 0.8));
		border-radius: 20px;
		padding: 0 0.9em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		cursor: pointer;
		transition: all 0.2s ease;
		user-select: none;
		min-width: 0; /* ⚡ 阻止触发器自身被隐式文本撑开 */
	}

	.search-box-trigger:hover {
		border-color: var(--accent, #6366f1);
		background-color: var(--card-border, rgba(30, 45, 66, 0.9));
		box-shadow: 0 0 12px var(--accent-glow, rgba(99, 102, 241, 0.2));
	}

	.search-icon {
		font-size: 0.9rem;
		opacity: 0.6;
		margin-right: 0.5rem;
		flex-shrink: 0;
	}

	.search-placeholder {
		flex: 1;
		font-size: 0.88rem;
		color: var(--text-muted, #94a3b8);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		display: flex;
		align-items: center;
		min-width: 0; /* ⚡ 保证椭圆截断（...）在 iOS/Safari 上正常工作 */
	}

	.slogan-text {
		opacity: 0.85;
		font-weight: 500;
	}

	.mobile-short-placeholder {
		display: none; /* 默认桌面端隐藏短占位符 */
	}

	.kbd-badge {
		background: var(--bg-card, #0f172a);
		border: 1px solid var(--card-border, #2d3e55);
