---
import { SITE_TITLE } from '../consts';

// 1. 接收外部传入的 lang 参数（可选）
const { lang: propLang } = Astro.props;

// 2. 获取当前 URL 路径并判断语言
const pathname = Astro.url.pathname;

let currentLang = propLang || 'en';
if (!propLang) {
	if (pathname.startsWith('/zh') || pathname.includes('/zh/')) {
		currentLang = 'zh';
	} else if (pathname.startsWith('/es') || pathname.includes('/es/')) {
		currentLang = 'es';
	} else if (pathname.startsWith('/de') || pathname.includes('/de/')) {
		currentLang = 'de';
	} else if (pathname.startsWith('/ja') || pathname.includes('/ja/')) {
		currentLang = 'ja';
	}
}

// 3. 提取去除了语言前缀的纯路径
const purePath = pathname.replace(/^\/(zh|es|de|ja)(\/|$)/, '/');

// 4. 动态构建各语言的目标跳转路径
const getPathForLang = (lang: string) => {
	if (lang === 'en') return purePath || '/';
	return purePath === '/' ? `/${lang}/` : `/${lang}${purePath}`;
};

// 首页与常用页面 Link 拼接
const homeLink = currentLang === 'en' ? '/' : `/${currentLang}/`;
const blogLink = currentLang === 'en' ? '/blog/' : `/${currentLang}/blog/`;
const aboutLink = currentLang === 'en' ? '/about/' : `/${currentLang}/about/`;
const isZh = currentLang === 'zh';
---

<header class="header-bar">
	<nav class="nav-container">
		<!-- ⚡ 1. 最左侧：固定显示 HelpMini 品牌标题 -->
		<div class="nav-left">
			<a href={homeLink} class="site-title" title="HelpMini Homepage">
				<span class="logo-text">HelpMini</span>
			</a>
		</div>

		<!-- 2. 中间：搜索框与口号 -->
		<div class="nav-center">
			<div class="search-box-trigger" id="headerSearchTrigger">
				<span class="search-icon">🔍</span>
				<span class="search-placeholder">
					<span class="slogan-text">{isZh ? '小微工具，大有作为' : 'Small Tools, Big Impact.'}</span>
				</span>
				<kbd class="kbd-badge">⌘K</kbd>
			</div>
		</div>

		<!-- 3. 右侧：功能控制与操作组 -->
		<div class="nav-right">
			<!-- 分享按钮 -->
			<button id="share-btn" class="icon-btn" aria-label="Share" type="button" title={isZh ? '分享页面' : 'Share Page'}>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="18" cy="5" r="3"></circle>
					<circle cx="6" cy="12" r="3"></circle>
					<circle cx="18" cy="19" r="3"></circle>
					<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
					<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
				</svg>
			</button>

			<!-- 九宫格应用矩阵 Dropdown -->
			<div class="menu-dropdown-wrapper">
				<button class="icon-btn" id="appGridBtn" aria-label="Apps Menu" type="button" title={isZh ? '快捷工具分类' : 'Tools Matrix'}>
					<svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
						<rect x="3" y="3" width="4" height="4" rx="1"></rect>
						<rect x="10" y="3" width="4" height="4" rx="1"></rect>
						<rect x="17" y="3" width="4" height="4" rx="1"></rect>
						<rect x="3" y="10" width="4" height="4" rx="1"></rect>
						<rect x="10" y="10" width="4" height="4" rx="1"></rect>
						<rect x="17" y="10" width="4" height="4" rx="1"></rect>
						<rect x="3" y="17" width="4" height="4" rx="1"></rect>
						<rect x="10" y="17" width="4" height="4" rx="1"></rect>
						<rect x="17" y="17" width="4" height="4" rx="1"></rect>
					</svg>
				</button>
				<!-- 九宫格下拉面板 -->
				<div class="dropdown-panel grid-panel" id="appGridPanel">
					<div class="panel-header">{isZh ? '热门分类与应用' : 'Quick Categories'}</div>
					<div class="app-grid">
						<a href={`${homeLink}?search=SEO`} class="app-item">
							<span class="app-icon">📈</span>
							<span class="app-label">SEO & GEO</span>
						</a>
						<a href={`${homeLink}?search=计算器`} class="app-item">
							<span class="app-icon">🧮</span>
							<span class="app-label">{isZh ? '利润计算' : 'Calculators'}</span>
						</a>
						<a href={`${homeLink}?search=提示词`} class="app-item">
							<span class="app-icon">🎨</span>
							<span class="app-label">{isZh ? 'AI 提示词' : 'AI Prompts'}</span>
						</a>
						<a href={`${homeLink}?search=JSON`} class="app-item">
							<span class="app-icon">🛠️</span>
							<span class="app-label">{isZh ? '开发者工具' : 'Dev Tools'}</span>
						</a>
						<a href={`${homeLink}?search=文本`} class="app-item">
							<span class="app-icon">📝</span>
							<span class="app-label">{isZh ? '文本转换' : 'Text Tools'}</span>
						</a>
						<a href={homeLink} class="app-item">
							<span class="app-icon">🚀</span>
							<span class="app-label">{isZh ? '全部工具' : 'All Tools'}</span>
						</a>
					</div>
				</div>
			</div>

			<!-- 个人头像与综合设置 Dropdown -->
			<div class="menu-dropdown-wrapper">
				<button class="avatar-btn" id="userMenuBtn" aria-label="User Center" type="button" title={isZh ? '个人中心与设置' : 'Account & Settings'}>
					<div class="avatar-circle">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
					</div>
				</button>

				<!-- 综合下拉菜单 -->
				<div class="dropdown-panel user-panel" id="userMenuPanel">
					<div class="user-menu-list">
						<!-- 账号/后台入口 -->
						<a href="/admin/feedback" class="menu-item highlight">
							<span class="menu-icon">👤</span>
							<span>{isZh ? '管理后台' : 'Admin Center'}</span>
						</a>

						<hr class="menu-divider" />

						<!-- 语言切换组 -->
						<div class="menu-item-static">
							<span class="menu-icon">🌐</span>
							<span class="menu-label">{isZh ? '语言/Language' : 'Language'}</span>
							<div class="sub-lang-select">
								<a href={getPathForLang('en')} class={`lang-pill ${currentLang === 'en' ? 'active' : ''}`}>EN</a>
								<a href={getPathForLang('zh')} class={`lang-pill ${currentLang === 'zh' ? 'active' : ''}`}>中文</a>
							</div>
						</div>

						<!-- 主题切换 -->
						<button type="button" class="menu-item" id="themeToggleMenuItem">
							<span class="menu-icon theme-icon-dark">🌙</span>
							<span class="menu-icon theme-icon-light">☀️</span>
							<span>{isZh ? '外观模式' : 'Theme Mode'}</span>
							<span class="theme-status-text"></span>
						</button>

						<hr class="menu-divider" />

						<!-- 博客与关于我们 -->
						<a href={blogLink} class="menu-item">
							<span class="menu-icon">📰</span>
							<span>{isZh ? '博客文章' : 'Blog'}</span>
						</a>
						<a href={aboutLink} class="menu-item">
							<span class="menu-icon">ℹ️</span>
							<span>{isZh ? '关于我们' : 'About Us'}</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</nav>
</header>

<!-- 全局 ⌘K 快捷键搜索 Modal 弹窗 -->
<div class="search-modal-backdrop" id="searchModal">
	<div class="search-modal-card" id="searchModalCard">
		<div class="search-modal-header">
			<span class="search-modal-icon">🔍</span>
			<input type="text" id="modalSearchInput" placeholder={isZh ? "输入关键词搜索工具 (如 SEO, 计算器, Base64)..." : "Search tools (e.g. SEO, JSON, Calculator)..."} autocomplete="off" />
		</div>
		<div class="search-modal-results" id="modalSearchResults">
			<div class="modal-hint">{isZh ? '输入工具名称，即时过滤与跳转' : 'Type to search and jump to tools...'}</div>
		</div>
	</div>
</div>

<script>
	// 1. 顶部搜索框触发器与 Modal 控制
	const headerSearchTrigger = document.getElementById('headerSearchTrigger');
	const searchModal = document.getElementById('searchModal');
	const searchModalCard = document.getElementById('searchModalCard');
	const modalSearchInput = document.getElementById('modalSearchInput') as HTMLInputElement;
	const modalSearchResults = document.getElementById('modalSearchResults');

	// ⚡ 全局兜底工具配置字典（确保在任何子页面都能 100% 检索到完整工具列表）
	const fallbackTools = [
		{ title: 'Stripe / PayPal 手续费计算器', desc: '精准计算跨境电商及独立站 Stripe 与 PayPal 交易手续费及净收入', url: '/zh/tools/stripe-paypal-fee-calculator/', icon: '🧮', keywords: 'stripe paypal 手续费 计算器 跨境 电商 利润' },
		{ title: 'SEO / GEO 结构化数据代码工具', desc: '一键生成符合 Google 规范的 JSON-LD 结构化代码，提升搜索引擎排名', url: '/zh/tools/schema-generator/', icon: '📈', keywords: 'seo geo json-ld 结构化 数据 谷歌 优化' },
		{ title: '男装/女装 AI 商拍提示词生成器', desc: '专为服装卖家打造的 AI 模特及拍摄场景提示词（Prompt）生成器', url: '/zh/tools/fashion-prompt-generator/', icon: '🎨', keywords: 'ai 提示词 prompt 商拍 服装 模特 场景' },
		{ title: 'JSON 格式化 / 压缩工具', desc: '快速格式化、美化与压缩 JSON 数据，支持语法校验', url: '/zh/tools/json-formatter/', icon: '🛠️', keywords: 'json 格式化 校验 压缩 开发者' },
		{ title: 'Base64 编解码工具', desc: '轻量安全的字符串与图片 Base64 编码解码工具', url: '/zh/tools/base64-encoder/', icon: '🔐', keywords: 'base64 编码 解码 字符串 图片' },
		{ title: '字数统计与文本分析工具', desc: '实时统计字数、字符数、段落数及中英文阅读时间估算', url: '/zh/tools/word-counter/', icon: '📝', keywords: '字数统计 文本 分析 阅读时间 字符' }
	];

	let searchableToolsData: Array<{ title: string; desc: string; url: string; icon: string; keywords: string }> = [];

	// 提取页面已渲染节点，并合并静态字典
	function collectToolsData() {
		const map = new Map();
		
		// 1. 先注入静态全量工具
		fallbackTools.forEach(t => map.set(t.url, t));

		// 2. 如果在首页，动态读取页面最新的 KV / 排序卡片数据并覆盖
		const cards = document.querySelectorAll('.searchable-item');
		cards.forEach(card => {
			const title = card.querySelector('h3')?.textContent || card.getAttribute('data-title') || '';
			const desc = card.querySelector('p')?.textContent || card.getAttribute('data-desc') || '';
			const url = card.getAttribute('href') || '#';
			const icon = card.querySelector('.tool-icon')?.textContent || '⚡';
			const keywords = card.getAttribute('data-keywords') || '';
			if (title && url !== '#') {
				map.set(url, { title, desc, url, icon, keywords });
			}
		});

		searchableToolsData = Array.from(map.values());
	}

	function openSearch() {
		if (searchModal && modalSearchInput) {
			searchModal.classList.add('active');
			modalSearchInput.value = '';
			modalSearchInput.focus();
			collectToolsData();
			renderSearchResults('');
		}
	}

	function closeSearch() {
		if (searchModal) searchModal.classList.remove('active');
	}

	headerSearchTrigger?.addEventListener('click', openSearch);

	// 点击搜索框以外的区域（Backdrop 背景）关闭 Modal
	searchModal?.addEventListener('click', (e) => {
		if (searchModalCard && !searchModalCard.contains(e.target as Node)) {
			closeSearch();
		}
	});

	// 监听 ⌘K 或 Ctrl+K 快捷键
	window.addEventListener('keydown', (e) => {
		if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
			e.preventDefault();
			openSearch();
		}
	});

	// 实现在模态框内的搜索过滤与快速跳转
	function renderSearchResults(query: string) {
		if (!modalSearchResults) return;
		const q = query.toLowerCase().trim();

		if (!q) {
			modalSearchResults.innerHTML = `<div class="modal-hint">${searchableToolsData.length > 0 ? '共加载 ' + searchableToolsData.length + ' 个工具，支持即时搜索' : '输入工具名称，即时过滤与跳转'}</div>`;
			return;
		}

		const results = searchableToolsData.filter(item => 
			item.title.toLowerCase().includes(q) || 
			item.desc.toLowerCase().includes(q) || 
			item.keywords.toLowerCase().includes(q)
		);

		if (results.length === 0) {
			modalSearchResults.innerHTML = `<div class="modal-hint">未找到匹配 "${query}" 的工具</div>`;
			return;
		}

		modalSearchResults.innerHTML = results.map(item => `
			<a href="${item.url}" class="modal-result-item">
				<span class="result-icon">${item.icon}</span>
				<div class="result-info">
					<div class="result-title">${item.title}</div>
					<div class="result-desc">${item.desc}</div>
				</div>
			</a>
		`).join('');

		// 同步联动首页的大搜索框（如果在首页）
		const pageSearchInput = document.getElementById('searchInput') as HTMLInputElement;
		if (pageSearchInput) {
			pageSearchInput.value = query;
			pageSearchInput.dispatchEvent(new Event('input', { bubbles: true }));
		}
	}

	modalSearchInput?.addEventListener('input', (e) => {
		renderSearchResults((e.target as HTMLInputElement).value);
	});

	// 2. 下拉面板互斥切换控制 (九宫格 & 个人中心)
	const appGridBtn = document.getElementById('appGridBtn');
	const appGridPanel = document.getElementById('appGridPanel');
	const userMenuBtn = document.getElementById('userMenuBtn');
	const userMenuPanel = document.getElementById('userMenuPanel');

	appGridBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		userMenuPanel?.classList.remove('active');
		appGridPanel?.classList.toggle('active');
	});

	userMenuBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		appGridPanel?.classList.remove('active');
		userMenuPanel?.classList.toggle('active');
	});

	window.addEventListener('click', () => {
		appGridPanel?.classList.remove('active');
		userMenuPanel?.classList.remove('active');
	});

	appGridPanel?.addEventListener('click', (e) => e.stopPropagation());
	userMenuPanel?.addEventListener('click', (e) => e.stopPropagation());

	// 3. 菜单内外观模式切换
	const themeToggleMenuItem = document.getElementById('themeToggleMenuItem');
	const themeStatusText = themeToggleMenuItem?.querySelector('.theme-status-text');

	function updateThemeText() {
		const isLight = document.documentElement.getAttribute('data-theme') === 'light';
		if (themeStatusText) {
			themeStatusText.textContent = isLight ? 'Light' : 'Dark';
		}
	}

	themeToggleMenuItem?.addEventListener('click', () => {
		const isLight = document.documentElement.getAttribute('data-theme') === 'light';
		if (isLight) {
			document.documentElement.removeAttribute('data-theme');
			localStorage.setItem('theme', 'dark');
		} else {
			document.documentElement.setAttribute('data-theme', 'light');
			localStorage.setItem('theme', 'light');
		}
		updateThemeText();
	});

	updateThemeText();

	// 4. 原生分享逻辑
	const shareBtn = document.getElementById('share-btn');
	shareBtn?.addEventListener('click', async () => {
		if (navigator.share) {
			try {
				await navigator.share({
					title: document.title,
					url: window.location.href,
				});
			} catch (err) {}
		} else {
			await navigator.clipboard.writeText(window.location.href);
			alert('页面链接已复制到剪贴板！');
		}
	});
</script>

<style>
	header.header-bar {
		margin: 0;
		padding: 0 1.5em;
		background: var(--header-bg, rgba(9, 13, 20, 0.85));
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--card-border, #1e293b);
		position: sticky;
		top: 0;
		z-index: 100;
		transition: background-color 0.3s ease, border-color 0.3s ease;
	}

	.nav-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		height: 60px;
		margin: 0 auto;
		gap: 1rem;
	}

	/* ⚡ 1. 最左侧 HelpMini 品牌标题样式 */
	.nav-left {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.site-title {
		font-size: 1.35rem;
		font-weight: 800;
		color: var(--text-main, #f8fafc);
		text-decoration: none !important;
		letter-spacing: -0.3px;
		display: flex;
		align-items: center;
		transition: opacity 0.2s;
	}
	.site-title:hover {
		opacity: 0.85;
	}

	/* 2. 中间：搜索框与品牌口号 */
	.nav-center {
		flex: 1;
		max-width: 460px;
		display: flex;
		justify-content: center;
	}

	.search-box-trigger {
		width: 100%;
		height: 38px;
		background-color: var(--card-border, rgba(30, 45, 66, 0.6));
		border: 1px solid var(--card-border, rgba(45, 62, 85, 0.8));
		border-radius: 20px;
		padding: 0 0.9em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		cursor: pointer;
		transition: all 0.2s ease;
		user-select: none;
	}

	.search-box-trigger:hover {
		border-color: var(--accent, #6366f1);
		background-color: var(--card-border, rgba(30, 45, 66, 0.9));
		box-shadow: 0 0 12px var(--accent-glow, rgba(99, 102, 241, 0.2));
	}

	.search-icon {
		font-size: 0.9rem;
		opacity: 0.6;
		margin-right: 0.5rem;
	}

	.search-placeholder {
		flex: 1;
		font-size: 0.88rem;
		color: var(--text-muted, #94a3b8);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		display: flex;
		align-items: center;
	}

	.slogan-text {
		opacity: 0.85;
		font-weight: 500;
	}

	.kbd-badge {
		background: var(--bg-card, #0f172a);
		border: 1px solid var(--card-border, #2d3e55);
		color: var(--text-muted, #94a3b8);
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.15em 0.5em;
		border-radius: 6px;
		font-family: inherit;
	}

	/* 3. 右侧操作区 */
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
	}

	.icon-btn {
		background: transparent;
		border: none;
		color: var(--text-muted, #94a3b8);
		padding: 0.5em;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		transition: all 0.2s ease;
	}
	.icon-btn:hover {
		color: var(--text-main, #f8fafc);
		background-color: var(--gray-light, rgba(255, 255, 255, 0.08));
	}

	/* 下拉容器与面板基类 */
	.menu-dropdown-wrapper {
		position: relative;
		display: inline-block;
	}

	.dropdown-panel {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		background: var(--bg-card, #0f172a);
		border: 1px solid var(--card-border, #2d3e55);
		border-radius: 16px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
		padding: 0.8em;
		display: none;
		z-index: 110;
		backdrop-filter: blur(20px);
		animation: fadeIn 0.2s ease;
	}

	.dropdown-panel.active {
		display: block;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(-8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	/* 九宫格面板 */
	.grid-panel {
		width: 280px;
	}

	.panel-header {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-muted, #94a3b8);
		padding: 0.3em 0.5em 0.6em;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.app-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
	}

	.app-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 0.8em 0.4em;
		border-radius: 12px;
		text-decoration: none !important;
		color: var(--text-main, #f8fafc);
		transition: background 0.2s;
