---
// src/components/RelatedTools.astro
import { sponsorItems } from '../data/tools';

interface Props {
	currentPath: string; // 用于过滤当前工具自身
	tag: string;         // 当前工具的分类标签 (如 "Developer", "E-commerce", "AI Tools")
	lang?: 'en' | 'zh';  // 当前语言维度
	limit?: number;      // 展示数量 (默认 2 个)
}

const { currentPath = '', tag = 'General', lang = 'en', limit = 2 } = Astro.props;

// 1. 自动抓取同语言路径下的所有 .astro 工具页面
let toolModules: Record<string, any> = {};
if (lang === 'zh') {
	toolModules = import.meta.glob('../pages/zh/tools/*.astro', { eager: true });
} else {
	toolModules = import.meta.glob('../pages/tools/*.astro', { eager: true });
}

// 2. 解析每个本地工具页面的 frontmatter 与 URL
const localTools = Object.entries(toolModules)
	.map(([filePath, mod]) => {
		const fm = mod.frontmatter || mod.default?.frontmatter || {};
		
		const pagesIndex = filePath.indexOf('/pages');
		let url = '';
		if (pagesIndex !== -1) {
			url = filePath.substring(pagesIndex + 6).replace('.astro', '/');
		} else {
			url = filePath.replace('../pages', '').replace('.astro', '/');
		}

		return {
			url,
			title: fm.title || '',
			description: fm.description || '',
			icon: fm.icon || '🛠️',
			tag: fm.tag || 'General',
			priority: fm.priority || 0,
			isExternal: false,
			sponsorText: ''
		};
	})
	.filter(t => t.title !== '');

// 3. 规范化加载 src/data/tools.ts 里的第三方/赞助推广数据
const rawSponsors = sponsorItems[lang] || sponsorItems['en'] || [];
const sponsorTools = rawSponsors.map(item => ({
	url: item.url,
	title: item.title,
	description: item.desc,
	icon: item.icon || '💎',
	tag: item.tag || (lang === 'zh' ? '赞助推广' : 'Sponsored'),
	priority: item.priority ?? 999,
	isExternal: true,
	sponsorText: lang === 'zh' ? '赞助推荐' : 'Sponsored'
}));

// 4. 标准化路径对比 (统一转小写、去掉首尾斜杠)
const cleanPath = (p: string) => p.toLowerCase().replace(/\/+$|^\/+/g, '');
const normalizedCurrent = cleanPath(currentPath);

const candidateTools = localTools.filter(t => cleanPath(t.url) !== normalizedCurrent);

// 5. 寻找匹配的赞助项：优先标签匹配，若无标签完全匹配则默认显示全局第一个赞助广告
const matchedSponsor = sponsorTools.find(s => s.tag.toLowerCase() === tag.toLowerCase()) || sponsorTools[0];

// 6. 本地工具算法排序：同 Tag 优先 (+1000 分) > 按 priority 降序
const sortedLocalTools = candidateTools.sort((a, b) => {
	const aMatch = a.tag.toLowerCase() === tag.toLowerCase() ? 1000 : 0;
	const bMatch = b.tag.toLowerCase() === tag.toLowerCase() ? 1000 : 0;
	const aScore = aMatch + a.priority;
	const bScore = bMatch + b.priority;
	return bScore - aScore;
});

// 7. 组合最终展示列表 (含 1 个赞助项 + N-1 个相关本地工具)
let finalRecommendations = [];
if (matchedSponsor) {
	finalRecommendations = [matchedSponsor, ...sortedLocalTools.slice(0, limit - 1)];
} else {
	finalRecommendations = sortedLocalTools.slice(0, limit);
}
---

{finalRecommendations.length > 0 && (
	<section class="content-section">
		<h2>{lang === 'zh' ? '你可能也会用到' : 'You Might Also Like'}</h2>
		<div class="related-grid">
			{finalRecommendations.map((tool) => (
				<a 
					href={tool.url} 
					class={`related-card ${tool.isExternal ? 'sponsor-card' : ''}`}
					target={tool.isExternal ? "_blank" : "_self"}
					rel={tool.isExternal ? "noopener sponsored" : ""}
				>
					<span class="card-icon">{tool.icon}</span>
					<div class="card-body">
						<div class="card-header-row">
							<h4>{tool.title}</h4>
							{tool.isExternal && (
								<span class="sponsor-badge">{tool.sponsorText || 'Ad'}</span>
							)}
						</div>
						<p>{tool.description}</p>
					</div>
				</a>
			))}
		</div>
	</section>
)}

<style>
	.content-section {
		margin-top: 2.5rem;
		background: var(--bg-card);
		border: 1px solid var(--card-border);
		border-radius: 16px;
		padding: 2em;
		box-sizing: border-box;
		width: 100%;
	}
	.content-section h2 {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 1.2rem;
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		width: 100%;
		box-sizing: border-box;
	}
	.related-card {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.9rem;
		background: var(--code-bg);
		border: 1px solid var(--card-border);
		border-radius: 10px;
		text-decoration: none !important;
		transition: border-color 0.2s, transform 0.2s;
		box-sizing: border-box;
		width: 100%;
		min-width: 0;
		height: auto;
	}
	.related-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.related-card.sponsor-card {
		border-color: rgba(245, 158, 11, 0.4);
		background: linear-gradient(135deg, var(--code-bg) 0%, rgba(245, 158, 11, 0.05) 100%);
	}
	.card-icon {
		font-size: 1.6rem;
		flex-shrink: 0;
	}
	.card-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.card-header-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.25rem;
		min-width: 0;
	}
	.related-card h4 {
		margin: 0;
		color: var(--text-main);
		font-size: 0.92rem;
		font-weight: 700;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		flex: 1;
		min-width: 0;
	}
	.related-card p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: break-word;
	}
	.sponsor-badge {
		font-size: 0.68rem;
		padding: 0.15em 0.5em;
		background: rgba(245, 158, 11, 0.15);
		color: #f59e0b;
		border: 1px solid rgba(245, 158, 11, 0.3);
		border-radius: 4px;
		font-weight: 700;
		text-transform: uppercase;
		flex-shrink: 0;
	}

	/* 📱 移动端强力自适应适配 */
	@media (max-width: 768px) {
		.content-section {
			padding: 1.25em 1rem;
		}
		.related-grid {
			grid-template-columns: 1fr;
			gap: 0.8rem;
		}
		.related-card {
			padding: 0.9rem 1rem;
			height: auto;               /* 自适应高度 */
			align-items: flex-start;    /* 顶部对齐 */
		}
		.card-icon {
			font-size: 1.5rem;
			margin-top: 0.1rem;
		}
		.card-header-row {
			flex-wrap: wrap;            /* 允许换行 */
			align-items: flex-start;
			margin-bottom: 0.35rem;
		}
		.related-card h4 {
			white-space: normal;        /* 彻底解除单行限制，允许自然换行 */
			font-size: 0.95rem;
			line-height: 1.35;
		}
		.related-card p {
			-webkit-line-clamp: unset;  /* 取消两行截断限制 */
			font-size: 0.82rem;
			line-height: 1.45;
		}
	}
</style>
